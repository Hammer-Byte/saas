<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> /
                    <a href="/app/gem-tenders" class="text-decoration-none">GEM Tenders</a> /
                    Scanner
                </p>
                <h1 class="h3 mb-1">Scanner</h1>
                <p class="text-secondary mb-0">
                    Select keywords and/or GEM categories, then run one scan (keywords first, then categories).
                </p>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <a
                    href="/app/gem-tender-scan-history"
                    class="btn btn-outline-secondary"
                    id="gem-scanner-history-btn"
                >
                    History
                </a>
                <button
                    type="button"
                    class="btn btn-success"
                    id="gem-scanner-scan-btn"
                    disabled
                >
                    Scan
                </button>
            </div>
        </div>

        <div id="gem-scanner-alert" class="alert d-none" role="alert"></div>

        <ul class="nav nav-tabs mb-4" id="gem-scanner-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link active"
                    id="gem-direct-search-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#gem-direct-search-pane"
                    type="button"
                    role="tab"
                    aria-controls="gem-direct-search-pane"
                    aria-selected="true"
                >
                    Direct Search
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link"
                    id="gem-advance-search-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#gem-advance-search-pane"
                    type="button"
                    role="tab"
                    aria-controls="gem-advance-search-pane"
                    aria-selected="false"
                >
                    Advance Search
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link"
                    id="gem-categories-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#gem-categories-pane"
                    type="button"
                    role="tab"
                    aria-controls="gem-categories-pane"
                    aria-selected="false"
                >
                    Categories
                </button>
            </li>
        </ul>

        <div class="tab-content">
            <%# Direct Search %>
            <div class="tab-pane fade show active" id="gem-direct-search-pane" role="tabpanel" aria-labelledby="gem-direct-search-tab" tabindex="0">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h2 class="h5 mb-1">Direct Search</h2>
                                <p class="text-secondary small mb-0">
                                    Search GeM for each selected keyword. Matched tenders are stored under the keyword's HammerByte category.
                                </p>
                            </div>
                            <button type="button" class="btn btn-outline-primary" id="gem-keyword-add-btn">
                                + Add keyword
                            </button>
                        </div>

                        <div class="form-check border-bottom pb-2 mb-2" id="gem-keyword-select-all-wrap">
                            <input class="form-check-input" type="checkbox" id="gem-keyword-select-all" />
                            <label class="form-check-label fw-semibold" for="gem-keyword-select-all">Select all</label>
                        </div>
                        <div id="gem-keywords-list"></div>
                        <p class="text-secondary mb-0 d-none" id="gem-keywords-empty">
                            No keywords yet. Add one to start scanning.
                        </p>
                    </div>
                </div>
            </div>

            <%# Advance Search %>
            <div class="tab-pane fade" id="gem-advance-search-pane" role="tabpanel" aria-labelledby="gem-advance-search-tab" tabindex="0">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <h2 class="h5 mb-1">Advance Search</h2>
                        <p class="text-secondary small mb-0">
                            Group GeM categories, pick a HammerByte category for each group, then scan selected categories.
                        </p>
                    </div>
                    <button type="button" class="btn btn-outline-primary" id="gem-group-add-btn">+ Add group</button>
                </div>
                <div class="form-check mb-3 d-none" id="gem-advance-select-all-wrap">
                    <input class="form-check-input" type="checkbox" id="gem-advance-select-all" />
                    <label class="form-check-label fw-semibold" for="gem-advance-select-all">
                        Select all categories
                    </label>
                </div>
                <div class="row g-3" id="gem-groups-list"></div>
                <div class="card border-0 shadow-sm d-none" id="gem-groups-empty">
                    <div class="card-body p-4 text-secondary">No groups yet. Add one to get started.</div>
                </div>
            </div>

            <%# Categories %>
            <div class="tab-pane fade" id="gem-categories-pane" role="tabpanel" aria-labelledby="gem-categories-tab" tabindex="0">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                            <div>
                                <h2 class="h5 mb-1">Categories</h2>
                                <p class="text-secondary small mb-0">
                                    HammerByte categories used to organise matched tenders from both scan types.
                                </p>
                            </div>
                            <button type="button" class="btn btn-outline-primary" id="gem-tender-category-add-btn">
                                + Add category
                            </button>
                        </div>
                        <div
                            id="gem-tender-categories-empty"
                            class="text-secondary d-none"
                        >
                            No categories yet. Add one to start.
                        </div>
                        <div class="table-responsive" id="gem-tender-categories-table-wrap">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">ID</th>
                                        <th scope="col">Category</th>
                                        <th scope="col" class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="gem-tender-categories-tbody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="gem-keyword-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="gem-keyword-form" novalidate>
            <div class="modal-header">
                <h5 class="modal-title" id="gem-keyword-modal-title">Add keyword</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="gem-keyword-form-alert" class="alert alert-danger d-none" role="alert"></div>
                <input type="hidden" id="gem-keyword-id" value="" />
                <div class="mb-3">
                    <label for="gem-keyword-input" class="form-label">Keyword</label>
                    <input type="text" class="form-control" id="gem-keyword-input" maxlength="512" required />
                </div>
                <div class="mb-3">
                    <label for="gem-keyword-tender-category" class="form-label">HammerByte category</label>
                    <select class="form-select" id="gem-keyword-tender-category" required></select>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="gem-keyword-exact-search" />
                    <label class="form-check-label" for="gem-keyword-exact-search">Exact search</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" id="gem-keyword-submit-btn">Save</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="gem-group-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="gem-group-form" novalidate>
            <div class="modal-header">
                <h5 class="modal-title" id="gem-group-modal-title">Add group</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="gem-group-form-alert" class="alert alert-danger d-none" role="alert"></div>
                <input type="hidden" id="gem-group-id" value="" />
                <div class="mb-3">
                    <label for="gem-group-name" class="form-label">Group name</label>
                    <input
                        type="text"
                        class="form-control"
                        id="gem-group-name"
                        maxlength="255"
                        placeholder="e.g. Desktops"
                        required
                    />
                </div>
                <div class="mb-0">
                    <label for="gem-group-tender-category" class="form-label">HammerByte category</label>
                    <select class="form-select" id="gem-group-tender-category"></select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" id="gem-group-submit-btn">Save</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="gem-category-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="gem-category-form" novalidate>
            <div class="modal-header">
                <h5 class="modal-title" id="gem-category-modal-title">Add GEM category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="gem-category-form-alert" class="alert alert-danger d-none" role="alert"></div>
                <input type="hidden" id="gem-category-id" value="" />
                <input type="hidden" id="gem-category-group-id" value="" />
                <div class="mb-0">
                    <label for="gem-category-name" class="form-label">GEM category name</label>
                    <input
                        type="text"
                        class="form-control"
                        id="gem-category-name"
                        maxlength="512"
                        placeholder="e.g. High End Desktop Computer"
                        required
                    />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" id="gem-category-submit-btn">Save</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="gem-tender-category-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" id="gem-tender-category-form" novalidate>
            <div class="modal-header">
                <h5 class="modal-title" id="gem-tender-category-modal-title">Add category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="gem-tender-category-form-alert" class="alert alert-danger d-none" role="alert"></div>
                <input type="hidden" id="gem-tender-category-id" value="" />
                <div class="mb-0">
                    <label for="gem-tender-category-name" class="form-label">Category name</label>
                    <input
                        type="text"
                        class="form-control"
                        id="gem-tender-category-name"
                        maxlength="255"
                        required
                    />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" id="gem-tender-category-submit-btn">Save</button>
            </div>
        </form>
    </div>
</div>

<script>
    window.__GEM_CATEGORIES_PAGE__ = <%- JSON.stringify({
        groups: groups || [],
        categories: categories || [],
        scanKeywords: scanKeywords || [],
        tenderCategories: tenderCategories || [],
    }).replace(/</g, "\\u003c") %>;
</script>
<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/gem-categories.js" defer></script>
<%- include('common/footer') %>

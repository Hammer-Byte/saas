<%- include('common/header') %>

<%- include('common/app-navbar', { wide: true }) %>

<main class="hb-main">
    <div class="container-fluid hb-page-wide">
        <div class="mb-3 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> /
                    <a href="/app/crm" class="text-decoration-none">CRM</a> /
                    Topics
                </p>
                <h1 class="h3 mb-1">Consultation topics</h1>
                <p class="text-secondary mb-0">Topics guests pick when booking a free consultation.</p>
            </div>
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#topic-modal"
                id="open-add-topic-btn"
            >
                Add topic
            </button>
        </div>

        <div id="topics-alert" class="alert d-none" role="alert"></div>

        <div class="table-responsive" id="topics-table-wrap">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="topics-tbody">
                    <% (topics || []).forEach((topic) => { %>
                    <tr
                        data-id="<%= topic.id %>"
                        data-title="<%= topic.title %>"
                        data-description="<%= topic.description %>"
                        data-active="<%= topic.active ? '1' : '0' %>"
                    >
                        <td><%= topic.title %></td>
                        <td class="text-secondary"><%= topic.description %></td>
                        <td>
                            <% if (topic.active) { %>
                            <span class="badge text-bg-success">Active</span>
                            <% } else { %>
                            <span class="badge text-bg-secondary">Inactive</span>
                            <% } %>
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-secondary topic-edit-btn">Edit</button>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <% if (!(topics || []).length) { %>
        <p class="text-secondary mt-3" id="topics-empty">No topics yet.</p>
        <% } %>
    </div>
</main>

<div class="modal fade" id="topic-modal" tabindex="-1" aria-labelledby="topic-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" id="topic-form">
            <div class="modal-header">
                <h2 class="modal-title h5" id="topic-modal-label">Add topic</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="topic-form-alert" class="alert d-none" role="alert"></div>
                <input type="hidden" id="topic-id" value="" />
                <div class="mb-3">
                    <label for="topic-title" class="form-label">Title</label>
                    <input type="text" class="form-control" id="topic-title" maxlength="128" required />
                </div>
                <div class="mb-3">
                    <label for="topic-description" class="form-label">One-line description</label>
                    <input type="text" class="form-control" id="topic-description" maxlength="255" required />
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="topic-active" checked />
                    <label class="form-check-label" for="topic-active">Active</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" id="topic-submit-btn">Save</button>
            </div>
        </form>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/crm-consultation-topics.js" defer></script>
<%- include('common/footer') %>

<%- include('common/header') %>

<%
    const stateLabels = TASK_STATE_LABELS || {};
    const priorityLabels = TASK_PRIORITY_LABELS || {};
    const stateValues = Object.values(TASK_STATES || {});
    const priorityValues = Object.values(TASK_PRIORITIES || {});
    const currentUserId = Number(userId || 0);
    const assigneeUserId = task.assignee_user_id ? Number(task.assignee_user_id) : null;
    const reviewerUserId = task.reviewer_user_id ? Number(task.reviewer_user_id) : null;
    const projectId = task.project_id ? Number(task.project_id) : null;
    const canEditTask = !!canMoveTask;
    const taskAdmin = !!isTaskAdmin;
    const invoiced = !!(task.customer_invoice_id);
    const invoices = projectInvoices || [];
    const selectedSprintWeek = task.sprint_week_start
        ? String(task.sprint_week_start).slice(0, 10)
        : "";
    const weekOptions = sprintWeekOptions || [];
    const burntHours = task.actual_hours != null ? Number(task.actual_hours) : 0;
    const assigneeHourlyRate = task.assignee_hourly_rate != null ? Number(task.assignee_hourly_rate) : 0;
    const assigneeCharge =
        Number.isFinite(burntHours) && Number.isFinite(assigneeHourlyRate)
            ? Math.round(burntHours * assigneeHourlyRate * 100) / 100
            : 0;
    const canAddToInvoice =
        taskAdmin &&
        !invoiced &&
        !!projectId &&
        (task.state || "") === TASK_STATES.DONE &&
        burntHours > 0;
%>

<%- include('common/app-navbar') %>

<main class="hb-main">
    <div class="container hb-page">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> /
                    <a href="/app/tasks" class="text-decoration-none">Tasks</a> /
                    <%= task.title %>
                </p>
                <h1 class="h3 mb-1"><%= task.title %></h1>
                <p class="text-secondary mb-0">
                    Created by <%= task.created_by_full_name || task.created_by_email || "—" %>
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <% if (canAddToInvoice) { %>
                    <button
                        type="button"
                        class="btn btn-outline-primary"
                        id="task-move-to-invoice-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#task-move-to-invoice-modal"
                    >
                        Add to invoice
                    </button>
                <% } %>
                <% if ((task.state || "") === TASK_STATES.BACKLOG || !selectedSprintWeek) { %>
                    <a href="/app/tasks/backlog" class="btn btn-outline-secondary">Backlog</a>
                <% } else { %>
                    <a href="/app/tasks" class="btn btn-outline-secondary">Sprint board</a>
                <% } %>
            </div>
        </div>

        <div id="task-alert" class="alert d-none" role="alert"></div>

        <% if (invoiced) { %>
            <div class="alert alert-info" role="status">
                Added to invoice
                <a href="/app/invoices/<%= task.customer_invoice_id %>" class="alert-link">
                    #<%= task.customer_invoice_id %><% if (task.invoice_hbt_sequence) { %> (HBT-<%= task.invoice_hbt_sequence %>)<% } %>
                </a>.
            </div>
        <% } %>

        <div
            class="card border-0 shadow-sm mb-4"
            id="task-detail"
            data-id="<%= task.id %>"
            data-current-user-id="<%= currentUserId %>"
            data-is-task-admin="<%= taskAdmin ? '1' : '0' %>"
            data-can-move="<%= canEditTask ? '1' : '0' %>"
            data-state="<%= task.state || '' %>"
            data-assignee-id="<%= assigneeUserId || '' %>"
            data-reviewer-id="<%= reviewerUserId || '' %>"
            data-initial-assignee-id="<%= assigneeUserId || '' %>"
            data-assignee-hourly-rate="<%= Number.isFinite(assigneeHourlyRate) ? assigneeHourlyRate : '' %>"
            data-burnt-hours="<%= Number.isFinite(burntHours) ? burntHours : '' %>"
            data-assignee-charge="<%= assigneeCharge > 0 ? assigneeCharge : '' %>"
            data-invoiced="<%= invoiced ? '1' : '0' %>"
            data-can-add-to-invoice="<%= canAddToInvoice ? '1' : '0' %>"
        >
            <div class="card-body p-4">
                <% if (!canEditTask) { %>
                    <div class="alert alert-secondary" role="status">
                        View only — only the assignee, reviewer, or an admin can change this task.
                    </div>
                <% } %>

                <form id="task-edit-form" novalidate <%= canEditTask ? '' : 'data-readonly="1"' %>>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="task-quick-state" class="form-label">Quick state</label>
                            <select class="form-select" id="task-quick-state" <%= canEditTask ? '' : 'disabled' %>>
                                <% stateValues.forEach(function (state) { %>
                                    <option
                                        value="<%= state %>"
                                        <%= (task.state || TASK_STATES.BACKLOG) === state ? "selected" : "" %>
                                    >
                                        <%= stateLabels[state] || state %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-6 d-flex align-items-end gap-2 flex-wrap">
                            <% if (canEditTask) { %>
                                <button type="button" class="btn btn-outline-success" id="task-mark-done-btn">Mark done</button>
                                <button type="button" class="btn btn-outline-secondary" id="task-duplicate-btn">Duplicate</button>
                                <button type="button" class="btn btn-outline-danger" id="task-delete-btn">Delete</button>
                            <% } %>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label for="task-edit-title" class="form-label">Title</label>
                            <input
                                type="text"
                                class="form-control"
                                id="task-edit-title"
                                name="title"
                                maxlength="128"
                                value="<%= task.title %>"
                                required
                            />
                        </div>
                        <div class="col-12">
                            <label for="task-edit-description" class="form-label">Description</label>
                            <textarea
                                class="form-control"
                                id="task-edit-description"
                                name="description"
                                rows="4"
                            ><%= task.description || "" %></textarea>
                        </div>
                        <div class="col-md-3">
                            <label for="task-edit-expected-hours" class="form-label">Expected hours</label>
                            <input
                                type="number"
                                class="form-control"
                                id="task-edit-expected-hours"
                                name="expected_hours"
                                min="0"
                                max="8"
                                step="0.25"
                                value="<%= task.expected_hours != null ? task.expected_hours : '' %>"
                            />
                            <div class="form-text">Max 8 hours.</div>
                        </div>
                        <div class="col-md-3">
                            <label for="task-edit-actual-hours" class="form-label">Burnt efforts</label>
                            <input
                                type="number"
                                class="form-control"
                                id="task-edit-actual-hours"
                                name="actual_hours"
                                min="0"
                                max="8"
                                step="0.25"
                                value="<%= task.actual_hours != null ? task.actual_hours : '' %>"
                            />
                            <div class="form-text">Hours spent (max 8).</div>
                        </div>
                        <div class="col-md-3">
                            <label for="task-edit-start-at" class="form-label">Start</label>
                            <input
                                type="text"
                                class="form-control js-datetime-input"
                                id="task-edit-start-at"
                                name="start_at"
                                placeholder="dd/mm/yyyy hh:mm"
                                autocomplete="off"
                                data-date-value="<%= task.start_at || '' %>"
                                value="<%= task.start_at || '' %>"
                            />
                            <div class="form-text">Inside sprint week.</div>
                        </div>
                        <div class="col-md-3">
                            <label for="task-edit-end-at" class="form-label">End</label>
                            <input
                                type="text"
                                class="form-control js-datetime-input"
                                id="task-edit-end-at"
                                name="end_at"
                                placeholder="dd/mm/yyyy hh:mm"
                                autocomplete="off"
                                data-date-value="<%= task.end_at || '' %>"
                                value="<%= task.end_at || '' %>"
                            />
                            <div class="form-text">Inside sprint week.</div>
                        </div>
                        <div class="col-md-4">
                            <label for="task-edit-state" class="form-label">State</label>
                            <select class="form-select" id="task-edit-state" name="state" required>
                                <% stateValues.forEach(function (state) { %>
                                    <option
                                        value="<%= state %>"
                                        <%= (task.state || TASK_STATES.BACKLOG) === state ? "selected" : "" %>
                                    >
                                        <%= stateLabels[state] || state %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="task-edit-priority" class="form-label">Priority</label>
                            <select class="form-select" id="task-edit-priority" name="priority" required>
                                <% priorityValues.forEach(function (priority) { %>
                                    <option
                                        value="<%= priority %>"
                                        <%= (task.priority || TASK_PRIORITIES.MEDIUM) === priority ? "selected" : "" %>
                                    >
                                        <%= priorityLabels[priority] || priority %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="task-edit-assignee" class="form-label">Assignee</label>
                            <select class="form-select" id="task-edit-assignee" name="assignee_user_id">
                                <option value="">Unassigned</option>
                                <% (users || []).forEach(function (user) { %>
                                    <option value="<%= user.id %>" <%= assigneeUserId === Number(user.id) ? "selected" : "" %>>
                                        <%= user.full_name %> (<%= user.email %>)
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="task-edit-reviewer" class="form-label">Reviewer</label>
                            <select class="form-select" id="task-edit-reviewer" name="reviewer_user_id">
                                <option value="">No reviewer</option>
                                <% (users || []).forEach(function (user) { %>
                                    <option value="<%= user.id %>" <%= reviewerUserId === Number(user.id) ? "selected" : "" %>>
                                        <%= user.full_name %> (<%= user.email %>)
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="task-edit-project" class="form-label">Project</label>
                            <% if (taskAdmin) { %>
                                <select class="form-select" id="task-edit-project" name="project_id">
                                    <option value="">No project</option>
                                    <% (projects || []).forEach(function (project) { %>
                                        <option value="<%= project.id %>" <%= projectId === Number(project.id) ? "selected" : "" %>>
                                            <%= project.title %><% if (project.customer_name) { %> — <%= project.customer_name %><% } %>
                                        </option>
                                    <% }) %>
                                </select>
                            <% } else { %>
                                <input
                                    type="text"
                                    class="form-control"
                                    value="<%= task.project_title || 'No project' %>"
                                    disabled
                                />
                                <input type="hidden" id="task-edit-project" value="<%= projectId || '' %>" />
                                <div class="form-text">Only admins can change project.</div>
                            <% } %>
                        </div>
                        <div class="col-md-4">
                            <label for="task-edit-sprint-week" class="form-label">Sprint week</label>
                            <select class="form-select" id="task-edit-sprint-week" name="sprint_week_start">
                                <option value="" <%= !selectedSprintWeek ? "selected" : "" %>>Backlog (no week)</option>
                                <% weekOptions.forEach(function (week) { %>
                                    <option
                                        value="<%= week.value %>"
                                        <%= selectedSprintWeek === week.value ? "selected" : "" %>
                                    >
                                        <%= week.label %><%= week.isCurrent ? " (current)" : "" %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <p class="form-label mb-1">Assignee charge</p>
                            <p class="mb-0 fw-semibold" id="task-assignee-charge-display">
                                <% if (assigneeHourlyRate > 0 && burntHours > 0) { %>
                                    <%= assigneeHourlyRate.toFixed(2) %> × <%= burntHours %> = <%= assigneeCharge.toFixed(2) %>
                                <% } else { %>
                                    —
                                <% } %>
                            </p>
                            <div class="form-text">Assignee hourly rate × burnt efforts.</div>
                        </div>
                        <div class="col-md-4">
                            <p class="form-label mb-1">Completed on</p>
                            <p class="mb-0">
                                <% if (task.completed_on) { %>
                                    <span data-readable-date="<%= task.completed_on %>" data-date-format="DD/MM/YYYY HH:mm"></span>
                                <% } else { %>
                                    —
                                <% } %>
                            </p>
                        </div>
                    </div>
                    <% if (canEditTask) { %>
                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary" id="task-save-btn">Save</button>
                        </div>
                    <% } %>
                </form>

                <hr class="my-4" />
                <label class="form-label">Attachments</label>
                <div id="task-attachments-list" class="mb-2">
                    <% if (!(attachments || []).length) { %>
                        <p class="text-secondary small mb-2" id="task-attachments-empty">No attachments yet.</p>
                    <% } %>
                    <ul class="list-group list-group-flush">
                        <% (attachments || []).forEach(function (attachment) { %>
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center gap-2" data-id="<%= attachment.id %>">
                                <div>
                                    <a href="/api/media/<%= attachment.media_id %>" target="_blank" rel="noopener">
                                        <%= attachment.media_name || attachment.description || ("File #" + attachment.media_id) %>
                                    </a>
                                    <% if (attachment.description) { %>
                                        <div class="small text-secondary"><%= attachment.description %></div>
                                    <% } %>
                                </div>
                                <% if (canEditTask) { %>
                                    <button type="button" class="btn btn-sm btn-outline-danger task-attachment-delete-btn">Remove</button>
                                <% } %>
                            </li>
                        <% }) %>
                    </ul>
                </div>
                <% if (canEditTask) { %>
                    <form id="task-attachment-form" class="row g-2 align-items-end" novalidate>
                        <div class="col-md-7">
                            <input type="file" class="form-control form-control-sm" id="task-attachment-file" required />
                        </div>
                        <div class="col-md-3">
                            <input
                                type="text"
                                class="form-control form-control-sm"
                                id="task-attachment-description"
                                placeholder="Note (optional)"
                            />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-sm btn-outline-primary w-100" id="task-attachment-submit-btn">
                                Upload
                            </button>
                        </div>
                        <div class="col-12">
                            <div id="task-attachment-form-alert" class="alert d-none mb-0" role="alert"></div>
                        </div>
                    </form>
                <% } %>
            </div>
        </div>

        <ul class="nav nav-tabs" id="task-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link active"
                    id="task-comments-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#task-comments-pane"
                    type="button"
                    role="tab"
                >
                    Comments
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link"
                    id="task-activities-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#task-activities-pane"
                    type="button"
                    role="tab"
                >
                    Activities
                </button>
            </li>
        </ul>

        <div class="tab-content border border-top-0 bg-white rounded-bottom shadow-sm p-4 mb-5">
            <div class="tab-pane fade show active" id="task-comments-pane" role="tabpanel">
                <form id="task-comment-form" class="mb-4" novalidate>
                    <div id="task-comment-form-alert" class="alert d-none" role="alert"></div>
                    <label for="task-comment-text" class="form-label">Add comment</label>
                    <textarea class="form-control mb-2" id="task-comment-text" rows="3" required></textarea>
                    <label for="task-comment-file" class="form-label">Attachment (optional)</label>
                    <input type="file" class="form-control mb-3" id="task-comment-file" />
                    <button type="submit" class="btn btn-primary btn-sm" id="task-comment-submit-btn">Add comment</button>
                </form>

                <div id="task-comments-empty" class="text-secondary <%= comments && comments.length ? 'd-none' : '' %>">
                    No comments yet.
                </div>
                <ul class="list-group list-group-flush" id="task-comments-list">
                    <% (comments || []).forEach(function (comment) { %>
                        <li class="list-group-item px-0" data-id="<%= comment.id %>">
                            <div class="d-flex justify-content-between gap-3">
                                <div>
                                    <strong><%= comment.user_full_name || comment.user_email %></strong>
                                    <div
                                        class="small text-secondary mb-1"
                                        data-readable-date="<%= comment.created_on %>"
                                        data-date-format="DD/MM/YYYY HH:mm:ss"
                                    ></div>
                                    <div style="white-space: pre-wrap;"><%= comment.comment %></div>
                                    <% if (comment.media_id) { %>
                                        <div class="mt-1">
                                            <a href="/api/media/<%= comment.media_id %>" target="_blank" rel="noopener">Attachment</a>
                                        </div>
                                    <% } %>
                                </div>
                                <% if (Number(comment.user_id) === currentUserId) { %>
                                    <div class="d-flex flex-column gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-secondary task-comment-edit-btn">Edit</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger task-comment-delete-btn">Delete</button>
                                    </div>
                                <% } %>
                            </div>
                        </li>
                    <% }) %>
                </ul>
            </div>

            <div class="tab-pane fade" id="task-activities-pane" role="tabpanel">
                <div id="task-activities-empty" class="text-secondary <%= activities && activities.length ? 'd-none' : '' %>">
                    No activity yet.
                </div>
                <ul class="list-group list-group-flush">
                    <% (activities || []).forEach(function (activity) { %>
                        <li class="list-group-item px-0">
                            <div class="d-flex justify-content-between gap-3">
                                <div>
                                    <strong><%= activity.user_full_name || activity.user_email %></strong>
                                    <span class="text-secondary">— <%= activity.activity %></span>
                                </div>
                                <span
                                    class="text-secondary small text-nowrap"
                                    data-readable-date="<%= activity.created_on %>"
                                    data-date-format="DD/MM/YYYY HH:mm:ss"
                                ></span>
                            </div>
                        </li>
                    <% }) %>
                </ul>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="task-comment-edit-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="task-comment-edit-form" novalidate>
                <input type="hidden" id="task-comment-edit-id" value="" />
                <div class="modal-header">
                    <h2 class="modal-title h5">Edit comment</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="task-comment-edit-alert" class="alert d-none" role="alert"></div>
                    <textarea class="form-control" id="task-comment-edit-text" rows="5" required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="task-comment-edit-save-btn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<% if (canAddToInvoice) { %>
<div class="modal fade" id="task-move-to-invoice-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="task-move-to-invoice-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5">Add to invoice</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="task-move-to-invoice-alert" class="alert d-none" role="alert"></div>
                    <div class="mb-3">
                        <label for="task-invoice-select" class="form-label">Project invoice</label>
                        <select class="form-select" id="task-invoice-select" required>
                            <option value="">Select invoice…</option>
                            <% invoices.forEach(function (invoice) { %>
                                <option value="<%= invoice.id %>">
                                    #<%= invoice.id %><% if (invoice.hbt_sequence) { %> · HBT-<%= invoice.hbt_sequence %><% } %>
                                    · <%= invoice.due_date ? String(invoice.due_date).slice(0, 10) : "" %>
                                    · total <%= Number(invoice.total || 0).toFixed(2) %>
                                </option>
                            <% }) %>
                        </select>
                        <% if (!invoices.length) { %>
                            <div class="form-text text-danger">No invoices found for this project.</div>
                        <% } %>
                    </div>
                    <div class="mb-3">
                        <label for="task-invoice-item" class="form-label">Title</label>
                        <input
                            type="text"
                            class="form-control"
                            id="task-invoice-item"
                            maxlength="128"
                            value="<%= (task.title || '').replace(/"/g, '&quot;') %>"
                            required
                        />
                    </div>
                    <div class="mb-3">
                        <p class="form-label mb-1">Assignee charge (cost basis)</p>
                        <p class="mb-1 fw-semibold" id="task-invoice-assignee-cost">
                            <% if (assigneeCharge > 0) { %>
                                <%= assigneeHourlyRate.toFixed(2) %> × <%= burntHours %> = <%= assigneeCharge.toFixed(2) %>
                            <% } else { %>
                                —
                            <% } %>
                        </p>
                        <div class="form-text">Use this to judge margin before setting the invoice price.</div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="task-invoice-cost" class="form-label">Price</label>
                            <input
                                type="number"
                                class="form-control"
                                id="task-invoice-cost"
                                min="0"
                                step="0.01"
                                value=""
                                required
                                data-assignee-cost="<%= assigneeCharge > 0 ? assigneeCharge : '' %>"
                            />
                            <div class="btn-group btn-group-sm mt-2" role="group" aria-label="Price markup">
                                <button type="button" class="btn btn-outline-secondary task-invoice-markup-btn" data-markup="1.10">+10%</button>
                                <button type="button" class="btn btn-outline-secondary task-invoice-markup-btn" data-markup="1.15">+15%</button>
                                <button type="button" class="btn btn-outline-secondary task-invoice-markup-btn" data-markup="1.20">+20%</button>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label for="task-invoice-quantity" class="form-label">Quantity</label>
                            <input type="number" class="form-control" id="task-invoice-quantity" min="0.01" step="0.01" value="1" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="task-move-to-invoice-submit" <%= invoices.length ? '' : 'disabled' %>>
                        Add to invoice
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<% } %>


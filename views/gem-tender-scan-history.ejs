<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> /
                    <a href="/app/gem-tenders" class="text-decoration-none">GEM Tenders</a> /
                    History
                </p>
                <h1 class="h3 mb-1">Scan History</h1>
                <p class="text-secondary mb-0">Past GEM tender scan runs, keyword counts, and new tenders stored.</p>
            </div>
            <a href="/app/gem-tender-keywords" class="btn btn-outline-primary">Keyword + scan</a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <% if (!runs || !runs.length) { %>
                    <div class="p-4 p-md-5 text-center text-secondary">No scan runs yet.</div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">ID</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Started by</th>
                                    <th scope="col">Keywords</th>
                                    <th scope="col">New tenders</th>
                                    <th scope="col">Started</th>
                                    <th scope="col">Finished</th>
                                    <th scope="col">Error</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% runs.forEach(function (run) { %>
                                    <tr>
                                        <td><%= run.id %></td>
                                        <td><%= run.status %></td>
                                        <td><%= run.created_by_name || run.created_by_email || "—" %></td>
                                        <td><%= Number(run.keyword_count || 0) %></td>
                                        <td><%= Number(run.tender_count || 0) %></td>
                                        <td>
                                            <span
                                                data-readable-date="<%= run.started_on || '' %>"
                                                data-date-format="DD/MM/YYYY HH:mm:ss"
                                            ></span>
                                        </td>
                                        <td>
                                            <span
                                                data-readable-date="<%= run.finished_on || '' %>"
                                                data-date-format="DD/MM/YYYY HH:mm:ss"
                                            ></span>
                                        </td>
                                        <td class="small text-secondary"><%= run.error_message || "—" %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<%- include('common/footer') %>

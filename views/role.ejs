<%- include('common/header') %>
<%- include('common/app-navbar') %>

<main class="hb-main">
    <div class="container hb-page">
        <%- include('common/page-header', {
            breadcrumbs: [{ href: '/app', label: 'App' }, { href: '/app/roles', label: 'Roles' }, { label: role.title }],
            heading: role.title,
            subtitle: role.active ? "Active role" : "Inactive role",
        }) %>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">ID</dt><dd class="col-sm-9"><%= role.id %></dd>
                    <dt class="col-sm-3">Title</dt><dd class="col-sm-9"><%= role.title %></dd>
                    <dt class="col-sm-3">Active</dt><dd class="col-sm-9"><%= role.active ? "Yes" : "No" %></dd>
                </dl>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 pt-3">
                <h2 class="h5 mb-0">Authorities</h2>
            </div>
            <div class="card-body p-0">
                <% if (!roleAuthorities || !roleAuthorities.length) { %>
                    <div class="hb-empty">No authorities assigned.</div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Title</th>
                                    <th scope="col">Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% roleAuthorities.forEach(function (authority) { %>
                                    <tr>
                                        <td><%= authority.title %></td>
                                        <td><%= authority.description || "—" %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <a href="/app/roles" class="btn btn-outline-secondary btn-sm">Back to roles</a>
    </div>
</main>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<%- include('common/footer') %>

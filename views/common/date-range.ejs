<%
    const resolvedFormAction = typeof action !== "undefined" ? action : "";
    const resolvedFormMethod = typeof method !== "undefined" ? method : "get";
    const resolvedStartName = typeof startName !== "undefined" ? startName : "start";
    const resolvedEndName = typeof endName !== "undefined" ? endName : "end";
    const resolvedStartId = typeof startId !== "undefined" ? startId : resolvedStartName;
    const resolvedEndId = typeof endId !== "undefined" ? endId : resolvedEndName;
    const resolvedStartValue = typeof start !== "undefined" ? start : "";
    const resolvedEndValue = typeof end !== "undefined" ? end : "";
    const resolvedStartLabel = typeof startLabel !== "undefined" ? startLabel : "Start date";
    const resolvedEndLabel = typeof endLabel !== "undefined" ? endLabel : "End date";
    const resolvedSubmitLabel = typeof submitLabel !== "undefined" ? submitLabel : "Apply range";
    const resolvedFormClass =
        typeof formClass !== "undefined" ? formClass : "card border-0 shadow-sm mb-4 hb-date-range";
%>
<form class="<%= resolvedFormClass %>" method="<%= resolvedFormMethod %>" action="<%= resolvedFormAction %>">
    <div class="card-body p-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label for="<%= resolvedStartId %>" class="form-label"><%= resolvedStartLabel %></label>
                <input
                    type="text"
                    class="form-control js-date-input"
                    id="<%= resolvedStartId %>"
                    name="<%= resolvedStartName %>"
                    placeholder="dd/mm/yyyy"
                    autocomplete="off"
                    inputmode="numeric"
                    data-date-value="<%= resolvedStartValue %>"
                    value="<%= resolvedStartValue %>"
                    required
                />
            </div>
            <div class="col-md-4">
                <label for="<%= resolvedEndId %>" class="form-label"><%= resolvedEndLabel %></label>
                <input
                    type="text"
                    class="form-control js-date-input"
                    id="<%= resolvedEndId %>"
                    name="<%= resolvedEndName %>"
                    placeholder="dd/mm/yyyy"
                    autocomplete="off"
                    inputmode="numeric"
                    data-date-value="<%= resolvedEndValue %>"
                    value="<%= resolvedEndValue %>"
                    required
                />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-outline-primary w-100"><%= resolvedSubmitLabel %></button>
            </div>
        </div>
    </div>
</form>

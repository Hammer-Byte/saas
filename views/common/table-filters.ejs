<%
    const searchId = typeof searchId !== "undefined" ? searchId : "table-search";
    const searchPlaceholder = typeof searchPlaceholder !== "undefined" ? searchPlaceholder : "Search…";
    const searchValue = typeof searchValue !== "undefined" ? searchValue : "";
    const showSearch = typeof showSearch !== "undefined" ? !!showSearch : true;
    const filterStatusId = typeof filterStatusId !== "undefined" ? filterStatusId : "";
%>
<div class="card border-0 shadow-sm mb-3 hb-filters">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <% if (showSearch) { %>
                <div class="col-md-4 col-lg-3">
                    <label for="<%= searchId %>" class="form-label visually-hidden">Search</label>
                    <input
                        type="search"
                        class="form-control form-control-sm"
                        id="<%= searchId %>"
                        placeholder="<%= searchPlaceholder %>"
                        value="<%= searchValue %>"
                        autocomplete="off"
                    />
                </div>
            <% } %>
            <% if (typeof extraFilters !== "undefined" && extraFilters) { %>
                <%- extraFilters %>
            <% } %>
            <% if (filterStatusId) { %>
                <div class="col-auto ms-md-auto">
                    <p class="hb-filter-status mb-0" id="<%= filterStatusId %>"></p>
                </div>
            <% } %>
        </div>
    </div>
</div>

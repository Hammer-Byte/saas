<%
    const resolvedSearchId = typeof searchId !== "undefined" ? searchId : "table-search";
    const resolvedSearchPlaceholder =
        typeof searchPlaceholder !== "undefined" ? searchPlaceholder : "Search…";
    const resolvedSearchValue = typeof searchValue !== "undefined" ? searchValue : "";
    const resolvedShowSearch = typeof showSearch !== "undefined" ? !!showSearch : true;
    const resolvedFilterStatusId = typeof filterStatusId !== "undefined" ? filterStatusId : "";
%>
<div class="card border-0 shadow-sm mb-3 hb-filters">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <% if (resolvedShowSearch) { %>
                <div class="col-md-4 col-lg-3">
                    <label for="<%= resolvedSearchId %>" class="form-label visually-hidden">Search</label>
                    <input
                        type="search"
                        class="form-control form-control-sm"
                        id="<%= resolvedSearchId %>"
                        placeholder="<%= resolvedSearchPlaceholder %>"
                        value="<%= resolvedSearchValue %>"
                        autocomplete="off"
                    />
                </div>
            <% } %>
            <% if (typeof extraFilters !== "undefined" && extraFilters) { %>
                <%- extraFilters %>
            <% } %>
            <% if (resolvedFilterStatusId) { %>
                <div class="col-auto ms-md-auto">
                    <p class="hb-filter-status mb-0" id="<%= resolvedFilterStatusId %>"></p>
                </div>
            <% } %>
        </div>
    </div>
</div>

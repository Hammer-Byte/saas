<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
    crossorigin="anonymous"
></script>
<script>
    window.__MAX_REQUEST_BODY_SIZE__ = <%=
        typeof maxRequestBodySize !== "undefined" && Number(maxRequestBodySize) > 0
            ? Number(maxRequestBodySize)
            : 1536 * 1024 * 1024
    %>;
</script>
<% if (typeof locals.authorities !== "undefined") { %>
<script>
    window.__AUTHORITIES__ = <%- JSON.stringify(authorities || []) %>;
</script>
<script src="/public/authorities.js"></script>
<% } %>
</body>

</html>

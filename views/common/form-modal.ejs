<%
    const resolvedModalId = typeof id !== "undefined" ? id : "form-modal";
    const resolvedModalLabelId = resolvedModalId + "-label";
    const resolvedModalTitle = typeof modalTitle !== "undefined" ? modalTitle : "Form";
    const resolvedFormId = typeof formId !== "undefined" ? formId : resolvedModalId + "-form";
    const resolvedDialogClass = typeof dialogClass !== "undefined" ? dialogClass : "modal-dialog";
    const resolvedFormClass = resolvedDialogClass.includes("modal-dialog-scrollable")
        ? "hb-modal-scrollable-form"
        : "";
    const resolvedAlertId =
        typeof alertId !== "undefined" ? alertId : resolvedFormId + "-alert";
    const resolvedSubmitLabel = typeof submitLabel !== "undefined" ? submitLabel : "Save";
    const resolvedCancelLabel = typeof cancelLabel !== "undefined" ? cancelLabel : "Cancel";
    const resolvedSubmitId =
        typeof submitId !== "undefined" ? submitId : resolvedFormId + "-submit";
%>
<div class="modal fade" id="<%= resolvedModalId %>" tabindex="-1" aria-labelledby="<%= resolvedModalLabelId %>" aria-hidden="true">
    <div class="<%= resolvedDialogClass %>">
        <div class="modal-content">
            <form id="<%= resolvedFormId %>"<% if (resolvedFormClass) { %> class="<%= resolvedFormClass %>"<% } %> novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="<%= resolvedModalLabelId %>"><%= resolvedModalTitle %></h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="<%= resolvedAlertId %>" class="alert d-none" role="alert"></div>
                    <% if (typeof body !== "undefined" && body) { %>
                        <%- body %>
                    <% } %>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= resolvedCancelLabel %></button>
                    <button type="submit" class="btn btn-primary" id="<%= resolvedSubmitId %>"><%= resolvedSubmitLabel %></button>
                </div>
            </form>
        </div>
    </div>
</div>

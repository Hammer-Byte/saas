<%
    const modalId = typeof id !== "undefined" ? id : "form-modal";
    const modalLabelId = modalId + "-label";
    const modalTitle = typeof modalTitle !== "undefined" ? modalTitle : "Form";
    const formId = typeof formId !== "undefined" ? formId : modalId + "-form";
    const dialogClass = typeof dialogClass !== "undefined" ? dialogClass : "modal-dialog";
    const alertId = typeof alertId !== "undefined" ? alertId : formId + "-alert";
    const submitLabel = typeof submitLabel !== "undefined" ? submitLabel : "Save";
    const cancelLabel = typeof cancelLabel !== "undefined" ? cancelLabel : "Cancel";
    const submitId = typeof submitId !== "undefined" ? submitId : formId + "-submit";
%>
<div class="modal fade" id="<%= modalId %>" tabindex="-1" aria-labelledby="<%= modalLabelId %>" aria-hidden="true">
    <div class="<%= dialogClass %>">
        <div class="modal-content">
            <form id="<%= formId %>" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="<%= modalLabelId %>"><%= modalTitle %></h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="<%= alertId %>" class="alert d-none" role="alert"></div>
                    <% if (typeof body !== "undefined" && body) { %>
                        <%- body %>
                    <% } %>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= cancelLabel %></button>
                    <button type="submit" class="btn btn-primary" id="<%= submitId %>"><%= submitLabel %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<%
    const resolvedPanelId = typeof id !== "undefined" ? id : "comments";
    const resolvedPanelTitle = typeof panelTitle !== "undefined" ? panelTitle : "Comments";
    const resolvedFormId = resolvedPanelId + "-form";
    const resolvedTextId = resolvedPanelId + "-text";
    const resolvedSubmitId = resolvedPanelId + "-submit-btn";
    const resolvedListId = resolvedPanelId + "-list";
    const resolvedEmptyId = resolvedPanelId + "-empty";
    const resolvedFileId = resolvedPanelId + "-file";
    const resolvedAllowAttachments =
        typeof allowAttachments !== "undefined" ? !!allowAttachments : false;
    const resolvedCanAdd = typeof canAdd !== "undefined" ? !!canAdd : true;
    const resolvedItems =
        typeof comments !== "undefined" && Array.isArray(comments) ? comments : [];
    const resolvedBodyField = typeof bodyField !== "undefined" ? bodyField : "comment";
    const resolvedAuthorField =
        typeof authorField !== "undefined" ? authorField : "author_name";
    const resolvedCreatedField =
        typeof createdField !== "undefined" ? createdField : "created_on";
    const resolvedItemClass =
        typeof itemClass !== "undefined" ? itemClass : "hb-comment-item";
    const resolvedEditBtnClass =
        typeof editBtnClass !== "undefined" ? editBtnClass : "hb-comment-edit-btn";
    const resolvedDeleteBtnClass =
        typeof deleteBtnClass !== "undefined" ? deleteBtnClass : "hb-comment-delete-btn";
    const resolvedCanManage =
        typeof canManageComments !== "undefined" ? !!canManageComments : false;
%>
<div class="card border-0 shadow-sm hb-comments-panel" id="<%= resolvedPanelId %>-panel">
    <div class="card-header bg-white border-0 pt-3 pb-0">
        <h2 class="h5 mb-0"><%= resolvedPanelTitle %></h2>
    </div>
    <div class="card-body">
        <% if (resolvedCanAdd) { %>
            <form id="<%= resolvedFormId %>" class="mb-4" novalidate>
                <label for="<%= resolvedTextId %>" class="form-label">Add comment</label>
                <textarea class="form-control" id="<%= resolvedTextId %>" rows="3" required></textarea>
                <% if (resolvedAllowAttachments) { %>
                    <label for="<%= resolvedFileId %>" class="form-label mt-2">Attachment (optional)</label>
                    <input type="file" class="form-control" id="<%= resolvedFileId %>" />
                <% } %>
                <button type="submit" class="btn btn-primary mt-3" id="<%= resolvedSubmitId %>">
                    Add comment
                </button>
            </form>
        <% } %>
        <div
            id="<%= resolvedEmptyId %>"
            class="text-secondary <%= resolvedItems.length ? 'd-none' : '' %>"
        >
            No comments yet.
        </div>
        <ul class="list-group list-group-flush" id="<%= resolvedListId %>">
            <% resolvedItems.forEach(function (comment) { %>
                <li
                    class="list-group-item px-0 <%= resolvedItemClass %>"
                    data-id="<%= comment.id %>"
                >
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                        <p class="hb-comment-meta mb-0">
                            <strong><%= comment[resolvedAuthorField] || comment.created_by_name || "User" %></strong>
                            <% if (comment[resolvedCreatedField]) { %>
                                ·
                                <span
                                    data-readable-date="<%= comment[resolvedCreatedField] %>"
                                    data-date-format="DD/MM/YYYY HH:mm"
                                ><%= comment[resolvedCreatedField] %></span>
                            <% } %>
                        </p>
                        <% if (resolvedCanManage) { %>
                            <div class="d-inline-flex gap-1">
                                <button
                                    type="button"
                                    class="btn btn-sm btn-outline-secondary <%= resolvedEditBtnClass %>"
                                >
                                    Edit
                                </button>
                                <button
                                    type="button"
                                    class="btn btn-sm btn-outline-danger <%= resolvedDeleteBtnClass %>"
                                >
                                    Delete
                                </button>
                            </div>
                        <% } %>
                    </div>
                    <p class="mb-0 hb-comment-body"><%= comment[resolvedBodyField] || comment.note || "" %></p>
                </li>
            <% }) %>
        </ul>
    </div>
</div>

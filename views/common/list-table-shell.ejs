<%
    const resolvedEmptyId = typeof emptyId !== "undefined" ? emptyId : "";
    const resolvedLoadingId = typeof loadingId !== "undefined" ? loadingId : "";
    const resolvedTableWrapId = typeof tableWrapId !== "undefined" ? tableWrapId : "";
    const resolvedEmptyText = typeof emptyText !== "undefined" ? emptyText : "No records found.";
    const resolvedLoadingText = typeof loadingText !== "undefined" ? loadingText : "Loading…";
    const resolvedHasRows = typeof hasRows !== "undefined" ? !!hasRows : true;
    const resolvedShowLoading = typeof showLoading !== "undefined" ? !!showLoading : false;
%>
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <% if (resolvedLoadingId) { %>
            <div
                id="<%= resolvedLoadingId %>"
                class="hb-loading <%= resolvedShowLoading ? '' : 'd-none' %>"
            >
                <%= resolvedLoadingText %>
            </div>
        <% } %>
        <div
            <% if (resolvedEmptyId) { %>id="<%= resolvedEmptyId %>"<% } %>
            class="hb-empty <%= resolvedHasRows || resolvedShowLoading ? 'd-none' : '' %>"
        >
            <%= resolvedEmptyText %>
        </div>
        <div
            class="table-responsive <%= !resolvedHasRows || resolvedShowLoading ? 'd-none' : '' %>"
            <% if (resolvedTableWrapId) { %>id="<%= resolvedTableWrapId %>"<% } %>
        >
            <%- tableHtml %>
        </div>
    </div>
</div>

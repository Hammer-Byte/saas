                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-4">
                                <label class="form-label small" for="dber-cooldown">Cool off (seconds)</label>
                                <input type="number" class="form-control form-control-sm" id="dber-cooldown" min="60" max="86400" value="<%= dberCfg.cooldown_seconds || 600 %>" />
                            </div>
                        </div>
                        <p class="text-secondary small mb-3">

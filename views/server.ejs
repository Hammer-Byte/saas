                            <button class="btn btn-sm btn-outline-secondary alert-add-person-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#dber-add-person-body" aria-expanded="false" aria-controls="dber-add-person-body">
                                Add person
                            </button>
                            <div class="collapse mt-2" id="dber-add-person-body">
                                <div class="border rounded p-2">
                                    <div class="small fw-semibold mb-2 alert-add-person-title">Add person</div>
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <label class="form-label small" for="dber-add-name">Name</label>
                                            <input type="text" class="form-control form-control-sm alert-add-name" id="dber-add-name" maxlength="128" autocomplete="off" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small" for="dber-add-email">Email</label>
                                            <input type="email" class="form-control form-control-sm alert-add-email" id="dber-add-email" maxlength="255" autocomplete="off" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small" for="dber-add-phone">Phone / mobile</label>

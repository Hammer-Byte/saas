<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4">
            <p class="text-secondary small mb-1">
                <a href="/app" class="text-decoration-none">App</a> /
                <a href="/app/servers" class="text-decoration-none">Servers</a> /
                <%= server.name %>
            </p>
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <div>
                    <h1 class="h3 mb-1"><%= server.name %></h1>
                    <p class="text-secondary mb-0"><%= server.location %></p>
                </div>
                <a href="/app/servers" class="btn btn-outline-secondary">Back to servers</a>
            </div>
        </div>

        <div
            class="card border-0 shadow-sm mb-4"
            id="server-project-card"
            data-id="<%= server.id %>"
            data-name="<%= server.name %>"
            data-location="<%= server.location %>"
            data-active="<%= server.active ? '1' : '0' %>"
            data-notes="<%= server.notes || '' %>"
            data-tag-mapped="<%= server.tag_mapped ? '1' : '0' %>"
        >
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Server</h2>
                <%
                    const canManageServerMapping =
                        !!super_admin
                        || (authorities || []).includes(AUTHORITIES.MANAGE_SERVER_MAPPING);
                %>
                <div class="server-meta-row d-flex flex-wrap align-items-end gap-3 small">
                    <div class="server-meta-field">
                        <div class="text-secondary mb-1">Project</div>
                        <% if (canManageServerMapping) { %>
                            <select class="form-select form-select-sm server-meta-project-select" id="server-project-select">
                                <option value="">No project</option>
                                <% (projects || []).forEach(function (project) { %>
                                    <option
                                        value="<%= project.id %>"
                                        <%= Number(server.project_id) === Number(project.id) ? "selected" : "" %>
                                    >
                                        <%= project.title %><% if (project.customer_name) { %> — <%= project.customer_name %><% } %>
                                    </option>
                                <% }) %>
                            </select>
                        <% } else if (server.project_id) { %>
                            <div>
                                <%= server.project_title || ("Project #" + server.project_id) %><% if (server.customer_name) { %> — <%= server.customer_name %><% } %>
                            </div>
                        <% } else { %>
                            <div class="text-secondary">—</div>
                        <% } %>
                    </div>
                    <% if (canManageServerMapping) { %>
                        <div class="server-meta-save d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-primary" id="server-project-save-btn">
                                Save
                            </button>
                            <span class="small d-none" id="server-project-feedback" role="status"></span>
                        </div>
                    <% } %>
                    <div class="server-meta-field">
                        <div class="text-secondary mb-1">Tag</div>
                        <code class="small text-break"><%= server.tag %></code>
                    </div>
                    <div class="server-meta-field">
                        <div class="text-secondary mb-1">Mapped</div>
                        <% if (canManageServerMapping) { %>
                            <div class="d-flex align-items-center gap-2">
                                <div class="form-check form-switch mb-0">
                                    <input
                                        class="form-check-input"
                                        type="checkbox"
                                        role="switch"
                                        id="server-mapped-toggle"
                                        <%= server.tag_mapped ? "checked" : "" %>
                                        <%= server.tag_mapped ? "" : "disabled" %>
                                    />
                                    <label class="form-check-label visually-hidden" for="server-mapped-toggle">Mapped</label>
                                </div>
                                <span class="small d-none" id="server-unmap-feedback" role="status"></span>
                            </div>
                        <% } else { %>
                            <div><%= server.tag_mapped ? "Yes" : "No" %></div>
                        <% } %>
                    </div>
                    <div class="server-meta-field">
                        <div class="text-secondary mb-1">OTP</div>
                        <code><%= server.otp %></code>
                    </div>
                    <div class="server-meta-field">
                        <div class="text-secondary mb-1">Utility user</div>
                        <% if (server.utility_username) { %>
                            <code class="small"><%= server.utility_username %></code>
                        <% } else { %>
                            <div class="text-secondary">—</div>
                        <% } %>
                    </div>
                    <div class="server-meta-field">
                        <div class="text-secondary mb-1">Utility password</div>
                        <% if (server.utility_password) { %>
                            <div class="d-flex align-items-center gap-2">
                                <code
                                    class="small"
                                    id="server-utility-password"
                                    data-password="<%= encodeURIComponent(server.utility_password) %>"
                                    data-hidden="1"
                                >••••••••</code>
                                <button
                                    type="button"
                                    class="btn btn-sm btn-outline-secondary py-0 px-1"
                                    id="server-utility-password-toggle"
                                    title="Show password"
                                    aria-label="Show password"
                                    aria-pressed="false"
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                        <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                                    </svg>
                                </button>
                            </div>
                        <% } else { %>
                            <div class="text-secondary">—</div>
                        <% } %>
                    </div>
                    <div class="server-meta-field">
                        <div class="text-secondary mb-1">Active</div>
                        <div><%= server.active ? "Yes" : "No" %></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                    <h2 class="h5 mb-0">Ping</h2>
                    <% if (aliveStatus === "alive") { %>
                        <span class="badge text-bg-success">Alive</span>
                    <% } else if (aliveStatus === "offline") { %>
                        <span class="badge text-bg-danger">Offline</span>
                    <% } else { %>
                        <span class="badge text-bg-secondary">No ping yet</span>
                    <% } %>
                </div>
                <%
                    const pingPublicIp = metrics && metrics.publicIp && metrics.publicIp.value
                        ? metrics.publicIp.value
                        : null;
                    const pingPublicIpSource = metrics && metrics.publicIp && metrics.publicIp.source
                        ? metrics.publicIp.source
                        : null;
                %>
                <div class="row g-3 small">
                    <div class="col-md-4">
                        <div class="text-secondary">Last ping</div>
                        <% if (latestPing) { %>
                            <span
                                data-readable-date="<%= latestPing.received_on || '' %>"
                                data-date-format="DD/MM/YYYY HH:mm:ss"
                            ><%= latestPing.received_on || "—" %></span>
                            <span class="text-secondary">
                                (alive if within <%= aliveWithinSeconds %>s)
                            </span>
                        <% } else { %>
                            <span class="text-secondary">—</span>
                        <% } %>
                    </div>
                    <div class="col-md-4">
                        <div class="text-secondary">Client timestamp</div>
                        <%= latestPing && latestPing.client_timestamp ? latestPing.client_timestamp : "—" %>
                    </div>
                    <div class="col-md-4">
                        <div class="text-secondary">Public IP</div>
                        <% if (pingPublicIp) { %>
                            <code class="small"><%= pingPublicIp %></code>
                            <% if (pingPublicIpSource) { %>
                                <span class="text-secondary">(<%= pingPublicIpSource %>)</span>
                            <% } %>
                        <% } else { %>
                            <span class="text-secondary">—</span>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 pt-3 px-3 pb-0 d-flex flex-wrap justify-content-between align-items-baseline gap-2">
                <h2 class="h6 mb-0">Metrics</h2>
                <% if (latestMetricReceivedOn) { %>
                    <span class="text-secondary small">
                        Received
                        <span
                            data-readable-date="<%= latestMetricReceivedOn %>"
                            data-date-format="DD/MM/YYYY HH:mm:ss"
                        ><%= latestMetricReceivedOn %></span>
                    </span>
                <% } %>
            </div>
            <div class="card-body p-3">
                <% if (!metrics) { %>
                    <p class="text-secondary small mb-0">No metrics received yet.</p>
                <% } else {
                    const memTotal = metrics.memory && metrics.memory.totalMb != null ? Number(metrics.memory.totalMb) : null;
                    const memUsed = metrics.memory && metrics.memory.usedMb != null ? Number(metrics.memory.usedMb) : null;
                    const memFree = metrics.memory && metrics.memory.freeMb != null ? Number(metrics.memory.freeMb) : null;
                    const memPct = memTotal && memUsed != null && memTotal > 0
                        ? Math.min(100, Math.round((memUsed / memTotal) * 100))
                        : null;
                    const memPctClass = memPct == null ? "bg-secondary" : memPct >= 90 ? "bg-danger" : memPct >= 75 ? "bg-warning" : "bg-success";
                    const userLabel = (metrics.userDomain ? metrics.userDomain + "\\" : "") + (metrics.userName || "—");
                    const localIps = Array.isArray(metrics.localIps) && metrics.localIps.length ? metrics.localIps.join(", ") : "—";
                    const macs = Array.isArray(metrics.macAddresses) && metrics.macAddresses.length ? metrics.macAddresses.join(", ") : "—";
                    const cpuBits = [];
                    if (metrics.cpu) {
                        if (metrics.cpu.cores != null) cpuBits.push(metrics.cpu.cores + "c");
                        if (metrics.cpu.logicalProcessors != null) cpuBits.push(metrics.cpu.logicalProcessors + "t");
                        if (metrics.cpu.maxClockMhz != null) cpuBits.push(metrics.cpu.maxClockMhz + " MHz");
                    }
                    const cpuRaw = metrics.cpu
                        ? (metrics.cpu.usagePercent ?? metrics.cpu.percent ?? metrics.cpu.usage)
                        : null;
                    const cpuPct = cpuRaw != null && Number.isFinite(Number(cpuRaw))
                        ? Math.min(100, Math.max(0, Math.round(Number(cpuRaw))))
                        : null;
                    const cpuPctClass = cpuPct == null ? "bg-secondary" : cpuPct >= 90 ? "bg-danger" : cpuPct >= 75 ? "bg-warning" : "bg-success";
                    let tempC = null;
                    const tempBlock = metrics.temperatureCelsius;
                    if (tempBlock && typeof tempBlock === "object" && tempBlock.unavailable !== true) {
                        const readings = Array.isArray(tempBlock.readings) ? tempBlock.readings : [];
                        for (const reading of readings) {
                            let value = null;
                            if (typeof reading === "number") value = reading;
                            else if (reading && typeof reading === "object") {
                                value = Number(reading.celsius ?? reading.value ?? reading.temp);
                            }
                            if (!Number.isFinite(value)) continue;
                            if (tempC == null || value > tempC) tempC = value;
                        }
                        if (tempC != null) tempC = Math.round(tempC * 10) / 10;
                    }
                %>
                    <div class="metrics-identity small mb-3">
                        <div class="row g-2">
                            <div class="col-sm-6 col-lg-3">
                                <span class="text-secondary">Host</span>
                                <div class="fw-semibold text-truncate" title="<%= metrics.machineName || metrics.hostName || '' %>"><%= metrics.machineName || metrics.hostName || "—" %></div>
                            </div>
                            <div class="col-sm-6 col-lg-3">
                                <span class="text-secondary">User</span>
                                <div class="text-truncate" title="<%= userLabel %>"><%= userLabel %></div>
                            </div>
                            <div class="col-sm-6 col-lg-3">
                                <span class="text-secondary">Uptime</span>
                                <div><%= metrics.uptime || "—" %></div>
                            </div>
                            <div class="col-sm-6 col-lg-3">
                                <span class="text-secondary">Captured</span>
                                <div class="text-truncate" title="<%= metrics.capturedAt || '' %>"><%= metrics.capturedAt || "—" %></div>
                            </div>
                            <div class="col-12">
                                <span class="text-secondary">OS</span>
                                <div class="text-truncate" title="<%= metrics.osVersion || '' %>"><%= metrics.osVersion || "—" %></div>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-secondary">Local IPs</span>
                                <div class="text-truncate" title="<%= localIps %>"><%= localIps %></div>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-secondary">MACs</span>
                                <div class="text-truncate" title="<%= macs %>"><code class="small"><%= macs %></code></div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6 col-lg-3">
                            <div class="metrics-stat h-100">
                                <div class="d-flex justify-content-between align-items-baseline gap-2">
                                    <span class="text-secondary small text-uppercase">Memory</span>
                                    <span class="small fw-semibold"><%= memPct != null ? (memPct + "%") : "—" %></span>
                                </div>
                                <% if (metrics.memory) { %>
                                    <div class="progress metrics-progress my-1" role="progressbar" aria-valuenow="<%= memPct || 0 %>" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar <%= memPctClass %>" style="width: <%= memPct != null ? memPct : 0 %>%"></div>
                                    </div>
                                    <div class="small">
                                        <%= memUsed != null ? memUsed.toFixed(0) : "—" %>
                                        /
                                        <%= memTotal != null ? memTotal.toFixed(0) : "—" %> MB
                                        <span class="text-secondary">free <%= memFree != null ? memFree.toFixed(0) : "—" %></span>
                                    </div>
                                <% } else { %>
                                    <div class="text-secondary small mt-1">—</div>
                                <% } %>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="metrics-stat h-100">
                                <div class="d-flex justify-content-between align-items-baseline gap-2">
                                    <span class="text-secondary small text-uppercase">CPU</span>
                                    <span class="small fw-semibold"><%= cpuPct != null ? (cpuPct + "%") : "—" %></span>
                                </div>
                                <% if (cpuPct != null) { %>
                                    <div class="progress metrics-progress my-1" role="progressbar" aria-valuenow="<%= cpuPct %>" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar <%= cpuPctClass %>" style="width: <%= cpuPct %>%"></div>
                                    </div>
                                <% } %>
                                <% if (metrics.cpu) { %>
                                    <div class="small fw-semibold text-truncate mt-1" title="<%= metrics.cpu.name || '' %>"><%= metrics.cpu.name || "—" %></div>
                                    <div class="small text-secondary"><%= cpuBits.length ? cpuBits.join(" · ") : "—" %></div>
                                <% } else { %>
                                    <div class="text-secondary small mt-1">—</div>
                                <% } %>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="metrics-stat h-100">
                                <div class="text-secondary small text-uppercase">Temp</div>
                                <div class="fs-5 fw-semibold mt-1">
                                    <%= tempC != null ? (tempC + "°C") : "—" %>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="metrics-stat h-100">
                                <div class="text-secondary small text-uppercase">Processes</div>
                                <div class="fs-5 fw-semibold mt-1">
                                    <%= metrics.processes && metrics.processes.count != null ? metrics.processes.count : "—" %>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <h3 class="h6 mb-0">Storage</h3>
                    </div>
                    <% if (!Array.isArray(metrics.storage) || !metrics.storage.length) { %>
                        <p class="text-secondary small mb-3">No storage data.</p>
                    <% } else { %>
                        <div class="table-responsive mb-3">
                            <table class="table table-sm align-middle mb-0 metrics-table">
                                <thead class="table-light">
                                    <tr>
                                        <th>Volume</th>
                                        <th class="d-none d-md-table-cell">Format</th>
                                        <th style="min-width: 8rem;">Usage</th>
                                        <th class="text-end">Free</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% metrics.storage.forEach(function (disk) {
                                        const totalGb = disk.totalGb != null ? Number(disk.totalGb) : null;
                                        const freeGb = disk.freeGb != null ? Number(disk.freeGb) : null;
                                        const usedGb = totalGb != null && freeGb != null ? Math.max(0, totalGb - freeGb) : null;
                                        const diskPct = totalGb && usedGb != null && totalGb > 0
                                            ? Math.min(100, Math.round((usedGb / totalGb) * 100))
                                            : null;
                                        const diskClass = diskPct == null ? "bg-secondary" : diskPct >= 90 ? "bg-danger" : diskPct >= 75 ? "bg-warning" : "bg-success";
                                        const volumeLabel = (disk.name || "—") + (disk.label ? " (" + disk.label + ")" : "");
                                    %>
                                        <tr>
                                            <td>
                                                <div class="small fw-semibold text-truncate" style="max-width: 14rem;" title="<%= volumeLabel %>"><%= volumeLabel %></div>
                                                <div class="text-secondary" style="font-size: 0.7rem;"><%= disk.type || "" %></div>
                                            </td>
                                            <td class="d-none d-md-table-cell small"><%= disk.format || "—" %></td>
                                            <td>
                                                <% if (diskPct != null) { %>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="progress metrics-progress flex-grow-1" role="progressbar" aria-valuenow="<%= diskPct %>" aria-valuemin="0" aria-valuemax="100">
                                                            <div class="progress-bar <%= diskClass %>" style="width: <%= diskPct %>%"></div>
                                                        </div>
                                                        <span class="small text-nowrap"><%= diskPct %>%</span>
                                                    </div>
                                                    <div class="text-secondary" style="font-size: 0.7rem;"><%= usedGb.toFixed(1) %> / <%= totalGb.toFixed(1) %> GB</div>
                                                <% } else { %>
                                                    <span class="text-secondary small">—</span>
                                                <% } %>
                                            </td>
                                            <td class="text-end small text-nowrap"><%= freeGb != null ? freeGb.toFixed(1) + " GB" : "—" %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>

                    <details class="metrics-details mb-2">
                        <summary class="small fw-semibold">Network interfaces<% if (Array.isArray(metrics.networkInterfaces) && metrics.networkInterfaces.length) { %> (<%= metrics.networkInterfaces.length %>)<% } %></summary>
                        <% if (!Array.isArray(metrics.networkInterfaces) || !metrics.networkInterfaces.length) { %>
                            <p class="text-secondary small mb-0 mt-2">No network interface data.</p>
                        <% } else { %>
                            <div class="table-responsive mt-2">
                                <table class="table table-sm align-middle mb-0 metrics-table">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Name</th>
                                            <th>Status</th>
                                            <th class="d-none d-md-table-cell">MAC</th>
                                            <th>Speed</th>
                                            <th>IPv4</th>
                                            <th class="d-none d-lg-table-cell">Gateway</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% metrics.networkInterfaces.forEach(function (networkInterface) { %>
                                            <tr>
                                                <td class="small"><%= networkInterface.name || "—" %></td>
                                                <td class="small"><%= networkInterface.status || "—" %></td>
                                                <td class="d-none d-md-table-cell"><code class="small"><%= networkInterface.mac || "—" %></code></td>
                                                <td class="small text-nowrap"><%= networkInterface.speedMbps != null ? (networkInterface.speedMbps + " Mbps") : "—" %></td>
                                                <td class="small"><%= Array.isArray(networkInterface.ipv4) ? networkInterface.ipv4.join(", ") : "—" %></td>
                                                <td class="d-none d-lg-table-cell small"><%= Array.isArray(networkInterface.gateway) ? networkInterface.gateway.join(", ") : "—" %></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </details>

                    <% if (metrics.processes && Array.isArray(metrics.processes.items) && metrics.processes.items.length) { %>
                        <details class="metrics-details mb-2">
                            <summary class="small fw-semibold">Top processes (<%= Math.min(10, metrics.processes.items.length) %>)</summary>
                            <div class="table-responsive mt-2">
                                <table class="table table-sm align-middle mb-0 metrics-table">
                                    <thead class="table-light">
                                        <tr>
                                            <th>PID</th>
                                            <th>Name</th>
                                            <th class="text-end">Memory MB</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% metrics.processes.items.slice(0, 10).forEach(function (processItem) { %>
                                            <tr>
                                                <td class="small"><%= processItem.pid != null ? processItem.pid : "—" %></td>
                                                <td class="small text-truncate" style="max-width: 16rem;"><%= processItem.name || "—" %></td>
                                                <td class="small text-end"><%= processItem.memoryMb != null ? Number(processItem.memoryMb).toFixed(1) : "—" %></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    <% } %>

                    <%
                        const hardwareHealth = metrics.hardwareHealth && typeof metrics.hardwareHealth === "object"
                            ? metrics.hardwareHealth
                            : null;
                        const hardwareDisks = hardwareHealth && Array.isArray(hardwareHealth.disks)
                            ? hardwareHealth.disks
                            : [];
                        const hardwareModules = hardwareHealth && Array.isArray(hardwareHealth.memoryModules)
                            ? hardwareHealth.memoryModules
                            : [];
                    %>
                    <% if (hardwareHealth) { %>
                        <details class="metrics-details">
                            <summary class="small fw-semibold">Hardware health</summary>
                            <% if (hardwareHealth.unavailable || hardwareHealth.skipped) { %>
                                <p class="text-secondary small mb-0 mt-2">
                                    <%= hardwareHealth.error || (hardwareHealth.skipped ? "Skipped (e.g. virtual machine)." : "Unavailable.") %>
                                </p>
                            <% } else { %>
                                <% if (hardwareHealth.checkedAt || hardwareHealth.nextDueAt) { %>
                                    <p class="text-secondary small mt-2 mb-2">
                                        <% if (hardwareHealth.checkedAt) { %>Checked <%= hardwareHealth.checkedAt %><% } %>
                                        <% if (hardwareHealth.checkedAt && hardwareHealth.nextDueAt) { %> · <% } %>
                                        <% if (hardwareHealth.nextDueAt) { %>Next due <%= hardwareHealth.nextDueAt %><% } %>
                                    </p>
                                <% } %>
                                <% if (hardwareDisks.length) { %>
                                    <div class="small fw-semibold mb-1">Disks</div>
                                    <div class="table-responsive mb-2">
                                        <table class="table table-sm align-middle mb-0 metrics-table">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Name</th>
                                                    <th>Media</th>
                                                    <th>Health</th>
                                                    <th class="text-end">Size</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% hardwareDisks.forEach(function (disk) { %>
                                                    <tr>
                                                        <td class="small"><%= disk.name || "—" %></td>
                                                        <td class="small"><%= disk.mediaType || "—" %></td>
                                                        <td class="small">
                                                            <%= disk.healthStatus || "—" %><% if (disk.healthPercent != null) { %> (<%= disk.healthPercent %>%)<% } %>
                                                            <% if (disk.predictFailure) { %>
                                                                <span class="badge text-bg-danger ms-1">predict failure</span>
                                                            <% } %>
                                                        </td>
                                                        <td class="small text-end"><%= disk.sizeGb != null ? (Number(disk.sizeGb).toFixed(0) + " GB") : "—" %></td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } %>
                                <% if (hardwareModules.length) { %>
                                    <div class="small fw-semibold mb-1">Memory modules</div>
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle mb-0 metrics-table">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Name</th>
                                                    <th>Bank</th>
                                                    <th class="text-end">Capacity</th>
                                                    <th class="text-end">Speed</th>
                                                    <th>Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% hardwareModules.forEach(function (module) { %>
                                                    <tr>
                                                        <td class="small"><%= module.name || "—" %></td>
                                                        <td class="small"><%= module.bankLabel || "—" %></td>
                                                        <td class="small text-end"><%= module.capacityGb != null ? (Number(module.capacityGb).toFixed(0) + " GB") : "—" %></td>
                                                        <td class="small text-end"><%= module.speedMhz != null ? (module.speedMhz + " MHz") : "—" %></td>
                                                        <td class="small"><%= module.status || "—" %></td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } %>
                                <% if (!hardwareDisks.length && !hardwareModules.length) { %>
                                    <p class="text-secondary small mb-0 mt-2">No disk or memory module details in this sample.</p>
                                <% } %>
                            <% } %>
                        </details>
                    <% } %>
                <% } %>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h2 class="h5 mb-0">Services</h2>
            </div>
            <div class="card-body px-4 pb-4">
                <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="services-tab-dataer" data-bs-toggle="tab" data-bs-target="#services-pane-dataer" type="button" role="tab">Dataer</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="services-tab-dber" data-bs-toggle="tab" data-bs-target="#services-pane-dber" type="button" role="tab">DBer</button>
                    </li>
                </ul>
                <div class="tab-content pt-3">
                    <div class="tab-pane fade show active" id="services-pane-dataer" role="tabpanel">
                        <% if (!dataerRuns || !dataerRuns.length) { %>
                            <p class="text-secondary small mb-0">No Dataer runs yet.</p>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0 service-runs-table">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="service-run-when">Received</th>
                                            <th class="service-run-when">Finished</th>
                                            <th>Host</th>
                                            <th class="service-run-paths">Remote → Local</th>
                                            <th class="service-run-status">Status</th>
                                            <th>Duration</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% dataerRuns.forEach(function (run) { %>
                                            <tr>
                                                <td
                                                    class="service-run-when"
                                                    data-readable-date="<%= run.received_on || '' %>"
                                                    data-date-format="DD/MM/YYYY HH:mm:ss"
                                                ><%= run.received_on || "—" %></td>
                                                <td class="service-run-when"><%= run.finished_at || "—" %></td>
                                                <td><%= run.host || "—" %></td>
                                                <td class="small service-run-paths">
                                                    <div><%= run.remote || "—" %></div>
                                                    <div class="text-secondary">→ <%= run.local_path || "—" %></div>
                                                </td>
                                                <td class="service-run-status">
                                                    <span class="badge <%= run.run_status_badge || 'text-bg-secondary' %>"><%= run.run_status_label || "—" %></span>
                                                    <% if (run.run_result_summary) { %>
                                                        <div class="small text-secondary mt-1"><%= run.run_result_summary %></div>
                                                    <% } %>
                                                </td>
                                                <td><%= run.duration_seconds != null ? Number(run.duration_seconds).toFixed(1) + "s" : "—" %></td>
                                                <td class="text-end">
                                                    <button
                                                        type="button"
                                                        class="btn btn-sm btn-outline-secondary run-detail-btn"
                                                        title="Run detail"
                                                        aria-label="Run detail"
                                                        data-title="Dataer run detail"
                                                        data-detail="<%= encodeURIComponent(run.detail || '') %>"
                                                    >
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                                                            <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.195-.304-.533zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0"/>
                                                        </svg>
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </div>
                    <div class="tab-pane fade" id="services-pane-dber" role="tabpanel">
                        <% if (!dberRuns || !dberRuns.length) { %>
                            <p class="text-secondary small mb-0">No DBer runs yet.</p>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0 service-runs-table">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="service-run-when">Received</th>
                                            <th class="service-run-when">Finished</th>
                                            <th>From</th>
                                            <th>To</th>
                                            <th class="service-run-status">Status</th>
                                            <th>Duration</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% dberRuns.forEach(function (run) { %>
                                            <tr>
                                                <td
                                                    class="service-run-when"
                                                    data-readable-date="<%= run.received_on || '' %>"
                                                    data-date-format="DD/MM/YYYY HH:mm:ss"
                                                ><%= run.received_on || "—" %></td>
                                                <td class="service-run-when"><%= run.finished_at || "—" %></td>
                                                <td class="small">
                                                    <div><%= run.from_host || "—" %></div>
                                                    <div class="text-secondary"><%= run.from_database || "—" %></div>
                                                </td>
                                                <td class="small">
                                                    <div><%= run.to_host || "—" %></div>
                                                    <div class="text-secondary"><%= run.to_database || "—" %></div>
                                                </td>
                                                <td class="service-run-status">
                                                    <span class="badge <%= run.run_status_badge || 'text-bg-secondary' %>"><%= run.run_status_label || "—" %></span>
                                                    <% if (run.run_result_summary) { %>
                                                        <div class="small text-secondary mt-1"><%= run.run_result_summary %></div>
                                                    <% } %>
                                                    <% if (run.bacpac_path) { %>
                                                        <div class="text-secondary mt-1"><code class="small"><%= run.bacpac_path %></code></div>
                                                    <% } %>
                                                </td>
                                                <td><%= run.duration_seconds != null ? Number(run.duration_seconds).toFixed(1) + "s" : "—" %></td>
                                                <td class="text-end">
                                                    <button
                                                        type="button"
                                                        class="btn btn-sm btn-outline-secondary run-detail-btn"
                                                        title="Run detail"
                                                        aria-label="Run detail"
                                                        data-title="DBer run detail"
                                                        data-detail="<%= encodeURIComponent(run.detail || '') %>"
                                                    >
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                                                            <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.195-.304-.533zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0"/>
                                                        </svg>
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 pt-4 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h2 class="h5 mb-0">Alerts</h2>
                <button
                    type="button"
                    class="btn btn-sm btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#server-alerts-modal"
                    id="open-server-alerts-btn"
                >
                    Configure alerts
                </button>
            </div>
            <div class="card-body px-4 pb-4">
                <p class="text-secondary small mb-3">
                    Sent alerts are listed below. Configure Pinger / Metricer / Dataer / DBer recipients and thresholds with the button above.
                </p>
                <form class="row g-2 align-items-end mb-3" method="get" action="/app/servers/<%= server.id %>">
                    <div class="col-sm-4 col-md-3">
                        <label class="form-label small mb-1" for="alert-log-start">From</label>
                        <input
                            type="text"
                            class="form-control form-control-sm js-date-input"
                            id="alert-log-start"
                            name="start"
                            placeholder="dd/mm/yyyy"
                            autocomplete="off"
                            inputmode="numeric"
                            data-date-value="<%= alertLogStart || '' %>"
                            value="<%= alertLogStart || '' %>"
                            required
                        />
                    </div>
                    <div class="col-sm-4 col-md-3">
                        <label class="form-label small mb-1" for="alert-log-end">To</label>
                        <input
                            type="text"
                            class="form-control form-control-sm js-date-input"
                            id="alert-log-end"
                            name="end"
                            placeholder="dd/mm/yyyy"
                            autocomplete="off"
                            inputmode="numeric"
                            data-date-value="<%= alertLogEnd || '' %>"
                            value="<%= alertLogEnd || '' %>"
                            required
                        />
                    </div>
                    <div class="col-sm-4 col-md-3">
                        <button type="submit" class="btn btn-sm btn-outline-primary">Apply range</button>
                    </div>
                </form>
                <% const logs = Array.isArray(alertLogs) ? alertLogs : []; %>
                <% if (!logs.length) { %>
                    <p class="text-secondary small mb-0">No alerts sent in this date range.</p>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>When</th>
                                    <th>Alert</th>
                                    <th>Detail</th>
                                    <th>Sent to</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% logs.forEach(function (row) { %>
                                    <tr>
                                        <td class="small text-nowrap">
                                            <span
                                                data-readable-date="<%= row.sent_on || '' %>"
                                                data-date-format="DD/MM/YYYY HH:mm:ss"
                                            ><%= row.sent_on || "—" %></span>
                                        </td>
                                        <td class="small fw-semibold"><%= row.kind_label || row.kind || "—" %></td>
                                        <td class="small"><%= row.detail || "—" %></td>
                                        <td class="small"><%= row.recipients || "—" %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<%
    const alertCfg = typeof alertConfig === "object" && alertConfig ? alertConfig : { pinger: {}, metricer: {}, dataer: {}, dber: {} };
    const pingerCfg = alertCfg.pinger || {};
    const metricerCfg = alertCfg.metricer || {};
    const dataerCfg = alertCfg.dataer || {};
    const dberCfg = alertCfg.dber || {};
    const candidates = Array.isArray(alertCandidates) ? alertCandidates : [];
%>

<div
    class="modal fade"
    id="server-alerts-modal"
    tabindex="-1"
    aria-labelledby="server-alerts-modal-label"
    aria-hidden="true"
    data-server-id="<%= server.id %>"
    data-alert-config="<%= encodeURIComponent(JSON.stringify(alertCfg)) %>"
    data-alert-candidates="<%= encodeURIComponent(JSON.stringify(candidates)) %>"
    data-storage-drives="<%= encodeURIComponent(JSON.stringify(Array.isArray(metricStorageDrives) ? metricStorageDrives : [])) %>"
>
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="server-alerts-modal-label">Configure alerts</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="server-alerts-form-alert" class="alert d-none" role="alert"></div>
                <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="alerts-tab-pinger" data-bs-toggle="tab" data-bs-target="#alerts-pane-pinger" type="button" role="tab">Pinger</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="alerts-tab-metricer" data-bs-toggle="tab" data-bs-target="#alerts-pane-metricer" type="button" role="tab">Metricer</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="alerts-tab-dataer" data-bs-toggle="tab" data-bs-target="#alerts-pane-dataer" type="button" role="tab">Dataer</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="alerts-tab-dber" data-bs-toggle="tab" data-bs-target="#alerts-pane-dber" type="button" role="tab">DBer</button>
                    </li>
                </ul>
                <div class="tab-content pt-3">
                    <div class="tab-pane fade show active" id="alerts-pane-pinger" role="tabpanel">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="pinger-enabled" <%= pingerCfg.enabled ? "checked" : "" %> />
                            <label class="form-check-label" for="pinger-enabled">Enable Pinger alerts</label>
                        </div>
                        <h3 class="h6">Whom</h3>
                        <div id="pinger-recipients" class="mb-2"></div>
                        <div class="mb-3 alert-add-person" data-section="pinger">
                            <button class="btn btn-sm btn-outline-secondary alert-add-person-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#pinger-add-person-body" aria-expanded="false" aria-controls="pinger-add-person-body">
                                Add person
                            </button>
                            <div class="collapse mt-2" id="pinger-add-person-body">
                                <div class="border rounded p-2">
                                    <div class="small fw-semibold mb-2 alert-add-person-title">Add person</div>
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <label class="form-label small" for="pinger-add-name">Name</label>
                                            <input type="text" class="form-control form-control-sm alert-add-name" id="pinger-add-name" maxlength="128" autocomplete="off" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small" for="pinger-add-email">Email</label>
                                            <input type="email" class="form-control form-control-sm alert-add-email" id="pinger-add-email" maxlength="255" autocomplete="off" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small" for="pinger-add-phone">Phone / mobile</label>
                                            <input type="text" class="form-control form-control-sm alert-add-phone" id="pinger-add-phone" maxlength="20" autocomplete="off" />
                                        </div>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2 mt-2">
                                        <button type="button" class="btn btn-sm btn-primary alert-add-person-btn">Add</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary alert-add-person-cancel d-none">Cancel</button>
                                    </div>
                                    <div class="small text-danger d-none mt-1 alert-add-person-error"></div>
                                </div>
                            </div>
                        </div>
                        <h3 class="h6">Criteria</h3>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small" for="pinger-missed">No ping for (seconds)</label>
                                <input type="number" class="form-control form-control-sm" id="pinger-missed" min="30" max="86400" value="<%= pingerCfg.missed_ping_seconds || 180 %>" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small" for="pinger-cooldown">Cooldown off (seconds)</label>
                                <input type="number" class="form-control form-control-sm" id="pinger-cooldown" min="60" max="86400" value="<%= pingerCfg.cooldown_seconds || 900 %>" />
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="alerts-pane-metricer" role="tabpanel">
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="metricer-enabled" <%= metricerCfg.enabled ? "checked" : "" %> />
                            <label class="form-check-label" for="metricer-enabled">Enable Metricer alerts</label>
                        </div>
                        <h3 class="h6">Whom</h3>
                        <div id="metricer-recipients" class="mb-2"></div>
                        <div class="mb-3 alert-add-person" data-section="metricer">
                            <button class="btn btn-sm btn-outline-secondary alert-add-person-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#metricer-add-person-body" aria-expanded="false" aria-controls="metricer-add-person-body">
                                Add person
                            </button>
                            <div class="collapse mt-2" id="metricer-add-person-body">
                                <div class="border rounded p-2">
                                    <div class="small fw-semibold mb-2 alert-add-person-title">Add person</div>
                                    <div class="row g-2">
                                        <div class="col-md-4">
                                            <label class="form-label small" for="metricer-add-name">Name</label>
                                            <input type="text" class="form-control form-control-sm alert-add-name" id="metricer-add-name" maxlength="128" autocomplete="off" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small" for="metricer-add-email">Email</label>
                                            <input type="email" class="form-control form-control-sm alert-add-email" id="metricer-add-email" maxlength="255" autocomplete="off" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small" for="metricer-add-phone">Phone / mobile</label>
                                            <input type="text" class="form-control form-control-sm alert-add-phone" id="metricer-add-phone" maxlength="20" autocomplete="off" />
                                        </div>
                                    </div>
                                    <div class="d-flex flex-wrap gap-2 mt-2">
                                        <button type="button" class="btn btn-sm btn-primary alert-add-person-btn">Add</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary alert-add-person-cancel d-none">Cancel</button>
                                    </div>
                                    <div class="small text-danger d-none mt-1 alert-add-person-error"></div>
                                </div>
                            </div>
                        </div>
                        <h3 class="h6">Criteria</h3>
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="metricer-ram-enabled" <%= metricerCfg.ram_enabled !== false ? "checked" : "" %> />
                                    <label class="form-check-label" for="metricer-ram-enabled">RAM above %</label>
                                </div>
                                <input type="number" class="form-control form-control-sm mt-1" id="metricer-ram-percent" min="1" max="100" value="<%= metricerCfg.ram_percent || 90 %>" />
                            </div>
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="metricer-cpu-enabled" <%= metricerCfg.cpu_enabled !== false ? "checked" : "" %> />
                                    <label class="form-check-label" for="metricer-cpu-enabled">CPU above %</label>
                                </div>
                                <input type="number" class="form-control form-control-sm mt-1" id="metricer-cpu-percent" min="1" max="100" value="<%= metricerCfg.cpu_percent || 90 %>" />
                            </div>
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="metricer-temp-enabled" <%= metricerCfg.temp_enabled ? "checked" : "" %> />
                                    <label class="form-check-label" for="metricer-temp-enabled">Temperature above °C</label>
                                </div>
                                <input type="number" class="form-control form-control-sm mt-1" id="metricer-temp-celsius" min="1" max="150" value="<%= metricerCfg.temp_celsius || 80 %>" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small" for="metricer-cooldown">Cool off (seconds)</label>
                                <input type="number" class="form-control form-control-sm" id="metricer-cooldown" min="60" max="86400" value="<%= metricerCfg.cooldown_seconds || 900 %>" />
                            </div>
                            <div class="col-12">
                                <%
                                    const storageDriveOptions = Array.isArray(metricStorageDrives) ? metricStorageDrives : [];
                                    const selectedDrives = Array.isArray(metricerCfg.storage_drives) ? metricerCfg.storage_drives : [];
                                    const selectedDriveSet = new Set(selectedDrives.map(function (name) { return String(name || "").toLowerCase(); }));
                                    const driveSelectSize = Math.min(Math.max(storageDriveOptions.length, 2), 6);
                                %>
                                <div class="small fw-semibold mb-1">Storage</div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="metricer-storage-enabled" <%= metricerCfg.storage_enabled !== false ? "checked" : "" %> />
                                    <label class="form-check-label" for="metricer-storage-enabled">Storage above %</label>
                                </div>
                                <input type="number" class="form-control form-control-sm mt-1 mb-2" id="metricer-storage-percent" min="1" max="100" value="<%= metricerCfg.storage_percent || 90 %>" style="max-width: 8rem;" />
                                <label class="form-label small mb-1" for="metricer-storage-drives">Drives</label>
                                <% if (!storageDriveOptions.length) { %>
                                    <p class="text-secondary small mb-0">No Fixed drives in latest metrics yet.</p>
                                <% } else { %>
                                    <select
                                        id="metricer-storage-drives"
                                        class="form-select form-select-sm"
                                        multiple
                                        size="<%= driveSelectSize %>"
                                    >
                                        <% storageDriveOptions.forEach(function (drive) {
                                            const selected = selectedDriveSet.has(String(drive.name || "").toLowerCase());
                                            const driveLabel = drive.name + (drive.label ? (" (" + drive.label + ")") : "");
                                        %>
                                            <option value="<%= drive.name %>" <%= selected ? "selected" : "" %>><%= driveLabel %></option>
                                        <% }) %>
                                    </select>
                                    <p class="text-secondary small mt-1 mb-0">Only selected Fixed volumes are checked against the storage % threshold. Hold Ctrl/Cmd to select multiple.</p>
                                <% } %>
                            </div>
                        </div>
                    </div>

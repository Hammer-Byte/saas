<%
    const alertCpuEnabled = Boolean(server.alert_cpu_enabled);
    const alertMemoryEnabled = Boolean(
        server.alert_memory_enabled != null ? server.alert_memory_enabled : server.alert,
    );
    const alertPingEnabled = Boolean(server.alert_ping_enabled);
    const alertCpuPercent = Number(server.alert_cpu_percent);
    const alertMemoryPercent = Number(server.alert_memory_percent);
    const alertPingSeconds = Number(server.alert_ping_seconds);
%>
<table class="table table-sm align-middle mb-0">
    <thead>
        <tr>
            <th scope="col">Alert</th>
            <th scope="col">Threshold</th>
            <th scope="col">On</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>CPU usage</td>
            <td>
                <div class="input-group input-group-sm" style="max-width: 9rem;">
                    <input type="number" class="form-control alert-field" data-alert-key="alert_cpu_percent" min="1" max="100" value="<%= Number.isFinite(alertCpuPercent) ? alertCpuPercent : 80 %>" disabled />
                    <span class="input-group-text">%</span>
                </div>
            </td>
            <td><input class="form-check-input alert-field" type="checkbox" data-alert-key="alert_cpu_enabled" <%= alertCpuEnabled ? "checked" : "" %> disabled /></td>
        </tr>
        <tr>
            <td>Memory usage</td>
            <td>
                <div class="input-group input-group-sm" style="max-width: 9rem;">
                    <input type="number" class="form-control alert-field" data-alert-key="alert_memory_percent" min="1" max="100" value="<%= Number.isFinite(alertMemoryPercent) ? alertMemoryPercent : 80 %>" disabled />
                    <span class="input-group-text">%</span>
                </div>
            </td>
            <td><input class="form-check-input alert-field" type="checkbox" data-alert-key="alert_memory_enabled" <%= alertMemoryEnabled ? "checked" : "" %> disabled /></td>
        </tr>
        <tr>
            <td>Agent silent</td>
            <td>
                <div class="input-group input-group-sm" style="max-width: 12rem;">
                    <input type="number" class="form-control alert-field" data-alert-key="alert_ping_seconds" min="60" max="604800" value="<%= Number.isFinite(alertPingSeconds) ? alertPingSeconds : 180 %>" disabled />
                    <span class="input-group-text">seconds</span>
                </div>
                <div class="form-text">Email when the agent has not polled for this long (it polls every 10s).</div>
            </td>
            <td><input class="form-check-input alert-field" type="checkbox" data-alert-key="alert_ping_enabled" <%= alertPingEnabled ? "checked" : "" %> disabled /></td>
        </tr>
    </tbody>
</table>

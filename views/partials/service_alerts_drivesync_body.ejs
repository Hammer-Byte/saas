<%
    const cfg = (typeof config === "object" && config) ? config : {};
    const onStart = cfg.alert_on_start !== false;
    const onComplete = cfg.alert_on_complete !== false;
%>
<div class="d-flex flex-column gap-2 mb-1">
    <div class="form-check">
        <input class="form-check-input alert-field" type="checkbox" id="drivesync-alert-on-start" data-alert-key="alert_on_start" <%= onStart ? "checked" : "" %> disabled />
        <label class="form-check-label small" for="drivesync-alert-on-start">Email when a sync cycle starts</label>
    </div>
    <div class="form-check">
        <input class="form-check-input alert-field" type="checkbox" id="drivesync-alert-on-complete" data-alert-key="alert_on_complete" <%= onComplete ? "checked" : "" %> disabled />
        <label class="form-check-label small" for="drivesync-alert-on-complete">Email when a sync cycle finishes (with stats)</label>
    </div>
</div>

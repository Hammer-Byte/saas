<%
    const sid = String(serviceId || "service");
    const mode = String(saveMode || "service");
    const title = cardTitle || "Alerts";
    const intro = introText || "";
%>
<div
    class="border rounded p-3 mb-4 bg-white service-alerts-card"
    data-service="<%= sid %>"
    data-server-id="<%= server.id %>"
    data-save-mode="<%= mode %>"
>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h3 class="h6 mb-0"><%= title %></h3>
        <div class="d-flex gap-2 align-items-center">
            <button type="button" class="btn btn-sm btn-outline-secondary server-icon-btn service-alerts-edit-btn" title="Edit alerts" aria-label="Edit alerts">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                </svg>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary d-none service-alerts-cancel-btn">Cancel</button>
            <button type="button" class="btn btn-sm btn-primary d-none service-alerts-save-btn">Save</button>
        </div>
    </div>
    <% if (intro) { %>
        <p class="form-text mt-0 mb-3"><%= intro %></p>
    <% } %>

    <% if (bodyPartial) { %>
        <%- include(bodyPartial, typeof bodyLocals === "object" && bodyLocals ? bodyLocals : {}) %>
    <% } %>

    <%- include('partials/service_alert_recipients', {
        serviceId: sid,
        server: server,
        selectedEmails: typeof selectedEmails !== "undefined" ? selectedEmails : [],
        extraEmails: typeof extraEmails !== "undefined" ? extraEmails : [],
        candidates: typeof candidates !== "undefined" ? candidates : [],
        helpText: typeof recipientsHelp !== "undefined" ? recipientsHelp : "",
    }) %>

    <div class="service-alerts-feedback small text-secondary d-none mt-2" role="status"></div>
</div>

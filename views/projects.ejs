<%- include('common/header') %>

<%- include('common/app-navbar') %>

<main class="hb-main">
    <div class="container hb-page">
        <div class="mb-4">
            <p class="text-secondary small mb-1">
                <a href="/app" class="text-decoration-none">App</a> / Projects
            </p>
            <h1 class="h3 mb-1">Projects</h1>
            <p class="text-secondary mb-0">All customer projects.</p>
        </div>

        <% if (!projects || projects.length === 0) { %>
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5 text-center text-secondary">
                    No projects found.
                </div>
            </div>
        <% } else { %>
            <%- include('common/table-filters', {
                searchId: "projects-search",
                searchPlaceholder: "Search projects…",
                filterStatusId: "projects-filter-status",
            }) %>
            <p class="text-secondary small mb-3 d-none" id="projects-empty" role="status">No projects match your search.</p>
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive" id="projects-table-wrap">
                        <table class="table table-hover align-middle mb-0" id="projects-table">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="hb-sortable" data-sort-key="id">ID</th>
                                    <th scope="col" class="hb-sortable" data-sort-key="title">Title</th>
                                    <th scope="col" class="hb-sortable" data-sort-key="description">Description</th>
                                    <th scope="col" class="hb-sortable" data-sort-key="customer">Customer</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% projects.forEach(function (project) { %>
                                    <tr
                                        class="hb-row-link"
                                        data-href="/app/projects/<%= project.id %>"
                                        data-id="<%= project.id %>"
                                        data-title="<%= project.title || '' %>"
                                        data-description="<%= project.description || '' %>"
                                        data-customer="<%= project.customer_name || '' %>"
                                    >
                                        <td><%= project.id %></td>
                                        <td><%= project.title %></td>
                                        <td><%= project.description || "-" %></td>
                                        <td><%= project.customer_name || "-" %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</main>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/projects.js" defer></script>
<%- include('common/footer') %>
<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= typeof username !== "undefined" && username ? username : "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4">
            <p class="text-secondary small mb-1">
                <a href="/app" class="text-decoration-none">App</a> / Projects
            </p>
            <h1 class="h3 mb-1">Projects</h1>
            <p class="text-secondary mb-0">All projects from PROJECTS.</p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <% if (!projects || projects.length === 0) { %>
                    <div class="p-4 p-md-5 text-center text-secondary">
                        No projects found.
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">ID</th>
                                    <th scope="col">Title</th>
                                    <th scope="col">Description</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% projects.forEach(function (project) { %>
                                    <tr>
                                        <td><%= project.id %></td>
                                        <td><%= project.title %></td>
                                        <td><%= project.description || "-" %></td>
                                        <td>
                                            <a href="/app/projects/<%= project.id %>" class="btn btn-sm btn-outline-primary">
                                                Manage
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<script src="/public/app.js" defer></script>
<%- include('common/footer') %>

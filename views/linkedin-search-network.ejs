<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> /
                    <a href="/app/linkedin" class="text-decoration-none">LinkedIn</a> /
                    SearchNetwork
                </p>
                <h1 class="h3 mb-1">SearchNetwork</h1>
                <p class="text-secondary mb-0">Select designations and LinkedIn users, then search people and send connect requests.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a href="/app/linkedin-search-network-history" class="btn btn-outline-secondary">History</a>
                <button
                    type="button"
                    class="btn btn-success"
                    id="linkedin-search-start-btn"
                    <% if (processing) { %>disabled<% } %>
                >
                    <% if (processing) { %>
                        Running…
                    <% } else { %>
                        Start
                    <% } %>
                </button>
            </div>
        </div>

        <div id="linkedin-search-alert" class="alert d-none" role="alert"></div>

        <div class="row g-4">
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <h2 class="h5 mb-3">Designations</h2>
                        <p class="small text-secondary mb-3">
                            Manage designations on the
                            <a href="/app/linkedin-designations">Designations</a>
                            page. Each selected designation becomes a people-search keyword.
                        </p>
                        <div
                            id="linkedin-search-designations-empty"
                            class="text-secondary <%= designations && designations.length ? 'd-none' : '' %>"
                        >
                            No designations yet.
                            <a href="/app/linkedin-designations">Add designations</a>
                            first.
                        </div>
                        <div id="linkedin-search-designations-list" class="<%= !designations || !designations.length ? 'd-none' : '' %>">
                            <% (designations || []).forEach(function (designation) { %>
                                <div class="form-check py-2 border-bottom">
                                    <input
                                        class="form-check-input linkedin-designation-check"
                                        type="checkbox"
                                        value="<%= designation.id %>"
                                        id="search-designation-<%= designation.id %>"
                                    />
                                    <label class="form-check-label" for="search-designation-<%= designation.id %>">
                                        <%= designation.name %>
                                    </label>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <h2 class="h5 mb-3">Accounts</h2>
                        <div
                            id="linkedin-search-users-empty"
                            class="text-secondary <%= linkedinUsers && linkedinUsers.length ? 'd-none' : '' %>"
                        >
                            No LinkedIn users yet.
                            <a href="/app/linkedin-users">Add users</a>
                            first.
                        </div>
                        <div id="linkedin-search-users-list" class="<%= !linkedinUsers || !linkedinUsers.length ? 'd-none' : '' %>">
                            <% (linkedinUsers || []).forEach(function (linkedinUser) { %>
                                <div class="form-check py-2 border-bottom">
                                    <input
                                        class="form-check-input linkedin-user-check"
                                        type="checkbox"
                                        value="<%= linkedinUser.id %>"
                                        id="search-user-<%= linkedinUser.id %>"
                                    />
                                    <label class="form-check-label" for="search-user-<%= linkedinUser.id %>">
                                        <%= linkedinUser.name %>
                                    </label>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="linkedin-search-start-modal" tabindex="-1" aria-labelledby="linkedin-search-start-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="linkedin-search-start-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="linkedin-search-start-modal-label">Start SearchNetwork</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-0">
                        <label for="linkedin-search-pages-input" class="form-label">Pages per designation</label>
                        <input
                            type="number"
                            class="form-control"
                            id="linkedin-search-pages-input"
                            name="page_count"
                            min="1"
                            step="1"
                            value="4"
                            required
                        />
                        <div class="form-text">
                            Walk this many result pages and send a connect to every available person.
                        </div>
                    </div>
                    <div id="linkedin-search-start-form-alert" class="alert d-none mt-3 mb-0" role="alert"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success" id="linkedin-search-start-submit-btn">Start run</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/linkedin-search-network.js" defer></script>
<%- include('common/footer') %>

<%- include('common/header') %>

<%
    const stageLabels = GEM_KEYWORD_TENDER_STAGE_LABELS || {};
    const stageValues = Object.keys(stageLabels);
    const canAssignOthers = (authorities || []).includes(AUTHORITIES.ASSIGN_GEM_TENDER_ASSIGNEE);
    const canBulkChangeStage = (authorities || []).includes(AUTHORITIES.MARK_GEM_TENDER_MASS_STAGE_CHANGE);
    const currentUserId = Number(userId || 0);
%>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light gem-tenders-page">
    <div class="container-fluid px-3 px-lg-4 py-3 gem-tenders-page-inner">
        <div class="gem-tenders-page-header mb-3 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> /
                    <a href="/app/gem-tenders" class="text-decoration-none">GEM Tenders</a> /
                    Tenders
                </p>
                <h1 class="h3 mb-1">Tenders</h1>
                <p class="text-secondary mb-0">Matched GEM tenders by end date range. Open a tender for details and actions.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button
                    type="button"
                    class="btn btn-primary"
                    id="gem-add-tender-btn"
                    data-bs-toggle="modal"
                    data-bs-target="#gem-add-tender-modal"
                >
                    Add tender
                </button>
                <a
                    href="/app/gem-keyword-tender-report?from=<%= from %>&to=<%= to %>"
                    class="btn btn-outline-primary"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Report
                </a>
            </div>
        </div>

        <div id="gem-add-tender-alert" class="alert d-none" role="alert"></div>

        <div
            id="gem-tenders-bulk-assign-bar"
            class="card border-0 shadow-sm mb-3 d-none"
            data-current-user-id="<%= currentUserId %>"
            data-can-assign-others="<%= canAssignOthers ? '1' : '0' %>"
            data-can-bulk-change-stage="<%= canBulkChangeStage ? '1' : '0' %>"
        >
            <div class="card-body py-2 px-3 d-flex flex-wrap align-items-center gap-2">
                <span class="small text-secondary" id="gem-tenders-selected-count">0 selected</span>
                <select class="form-select form-select-sm" id="gem-bulk-assignee" style="max-width: 280px;">
                    <option value="">Choose assignee…</option>
                    <% if (currentUserId) { %>
                        <option value="<%= currentUserId %>">Assign to me</option>
                    <% } %>
                    <% if (canAssignOthers) { %>
                        <% (users || []).forEach(function (user) { %>
                            <% if (Number(user.id) !== currentUserId) { %>
                                <option value="<%= user.id %>"><%= user.full_name %> (<%= user.email %>)</option>
                            <% } %>
                        <% }) %>
                    <% } %>
                </select>
                <button type="button" class="btn btn-sm btn-primary" id="gem-bulk-assign-btn" disabled>
                    Assign
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="gem-bulk-clear-btn">
                    Clear selection
                </button>
                <span class="small text-danger d-none" id="gem-bulk-assign-status" role="status"></span>
            </div>
        </div>

        <% if (canBulkChangeStage) { %>
            <div id="gem-tenders-bulk-stage-bar" class="card border-0 shadow-sm mb-3 d-none">
                <div class="card-body py-2 px-3">
                    <div class="d-flex flex-wrap align-items-start gap-2">
                        <span class="small text-secondary pt-1" id="gem-tenders-stage-selected-count">0 selected</span>
                        <div style="min-width: 180px; max-width: 240px;">
                            <label for="gem-bulk-stage" class="form-label small mb-1">
                                Stage <span class="text-danger">*</span>
                            </label>
                            <select class="form-select form-select-sm" id="gem-bulk-stage">
                                <option value="">Choose stage…</option>
                                <% stageValues.forEach(function (stage) { %>
                                    <option value="<%= stage %>"><%= stageLabels[stage] || stage %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="flex-grow-1" style="min-width: 220px; max-width: 520px;">
                            <label for="gem-bulk-stage-comment" class="form-label small mb-1">
                                Comment <span class="text-danger">*</span>
                            </label>
                            <textarea
                                class="form-control form-control-sm"
                                id="gem-bulk-stage-comment"
                                rows="2"
                                placeholder="Required comment for selected tenders…"
                                maxlength="2000"
                            ></textarea>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-2 pt-4">
                            <button type="button" class="btn btn-sm btn-primary" id="gem-bulk-stage-btn" disabled>
                                Change stage
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="gem-bulk-stage-clear-btn">
                                Clear selection
                            </button>
                        </div>
                    </div>
                    <span class="small text-danger d-none mt-1 d-inline-block" id="gem-bulk-stage-status" role="status"></span>
                </div>
            </div>
        <% } %>

        <div class="card border-0 shadow-sm mb-3 gem-tenders-filters-card">
            <div class="card-header bg-white border-0 d-flex flex-wrap justify-content-between align-items-center gap-2 py-3 px-3 px-md-4">
                <button
                    type="button"
                    class="btn btn-outline-secondary btn-sm"
                    data-bs-toggle="collapse"
                    data-bs-target="#gem-tenders-filters"
                    aria-expanded="false"
                    aria-controls="gem-tenders-filters"
                    id="gem-tenders-filters-toggle"
                >
                    Filters
                </button>
                <p class="text-secondary small mb-0" id="gem-tenders-filter-status" role="status"></p>
            </div>
            <div class="collapse" id="gem-tenders-filters">
                <div class="card-body border-top pt-3 px-3 px-md-4 pb-3">
                    <form
                        class="row g-2 align-items-end gem-tenders-date-range mb-2"
                        method="get"
                        action="/app/gem-keyword-tenders"
                        id="gem-tenders-date-form"
                    >
                        <div class="col-6 col-md-3 col-xl-2">
                            <label for="gem-tenders-from" class="form-label">Ends from</label>
                            <input
                                type="text"
                                class="form-control form-control-sm js-date-input"
                                id="gem-tenders-from"
                                name="from"
                                placeholder="dd/mm/yyyy"
                                autocomplete="off"
                                inputmode="numeric"
                                data-date-value="<%= from %>"
                                value="<%= from %>"
                                required
                            />
                        </div>
                        <div class="col-6 col-md-3 col-xl-2">
                            <label for="gem-tenders-to" class="form-label">Ends to</label>
                            <input
                                type="text"
                                class="form-control form-control-sm js-date-input"
                                id="gem-tenders-to"
                                name="to"
                                placeholder="dd/mm/yyyy"
                                autocomplete="off"
                                inputmode="numeric"
                                data-date-value="<%= to %>"
                                value="<%= to %>"
                                required
                            />
                        </div>
                        <div class="col-12 col-md-3 col-xl-2">
                            <button type="submit" class="btn btn-primary btn-sm w-100">Apply dates</button>
                        </div>
                    </form>
                    <div class="row g-2 align-items-end gem-tenders-filters-row">
                        <div class="col-6 col-md-4 col-xl-2">
                            <span class="form-label d-block">Keyword</span>
                            <div class="dropdown gem-multi-filter w-100" id="gem-filter-keyword" data-empty-label="All keywords">
                                <button
                                    class="btn btn-outline-secondary btn-sm dropdown-toggle w-100 text-start gem-multi-filter-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    data-bs-auto-close="outside"
                                    aria-expanded="false"
                                >
                                    <span class="gem-multi-filter-label">All keywords</span>
                                </button>
                                <div class="dropdown-menu gem-multi-filter-menu p-2 shadow">
                                    <% (keywords || []).forEach(function (keyword) { %>
                                        <div class="form-check">
                                            <input
                                                class="form-check-input gem-multi-filter-option"
                                                type="checkbox"
                                                value="<%= keyword.id %>"
                                                id="gem-filter-keyword-<%= keyword.id %>"
                                                data-label="<%= keyword.keyword %>"
                                            />
                                            <label class="form-check-label" for="gem-filter-keyword-<%= keyword.id %>">
                                                <%= keyword.keyword %>
                                            </label>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <span class="form-label d-block">Stage</span>
                            <div class="dropdown gem-multi-filter w-100" id="gem-filter-stage" data-empty-label="All stages">
                                <button
                                    class="btn btn-outline-secondary btn-sm dropdown-toggle w-100 text-start gem-multi-filter-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    data-bs-auto-close="outside"
                                    aria-expanded="false"
                                >
                                    <span class="gem-multi-filter-label">All stages</span>
                                </button>
                                <div class="dropdown-menu gem-multi-filter-menu p-2 shadow">
                                    <% stageValues.forEach(function (stage) { %>
                                        <div class="form-check">
                                            <input
                                                class="form-check-input gem-multi-filter-option"
                                                type="checkbox"
                                                value="<%= stage %>"
                                                id="gem-filter-stage-<%= stage %>"
                                                data-label="<%= stageLabels[stage] %>"
                                            />
                                            <label class="form-check-label" for="gem-filter-stage-<%= stage %>">
                                                <%= stageLabels[stage] %>
                                            </label>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <label for="gem-tenders-search" class="form-label">Search</label>
                            <input
                                type="search"
                                class="form-control form-control-sm"
                                id="gem-tenders-search"
                                placeholder="Tender ID…"
                                autocomplete="off"
                            />
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <span class="form-label d-block">Assignee</span>
                            <div class="dropdown gem-multi-filter w-100" id="gem-filter-assignee" data-empty-label="All assignees">
                                <button
                                    class="btn btn-outline-secondary btn-sm dropdown-toggle w-100 text-start gem-multi-filter-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    data-bs-auto-close="outside"
                                    aria-expanded="false"
                                >
                                    <span class="gem-multi-filter-label">All assignees</span>
                                </button>
                                <div class="dropdown-menu gem-multi-filter-menu p-2 shadow">
                                    <div class="form-check">
                                        <input
                                            class="form-check-input gem-multi-filter-option"
                                            type="checkbox"
                                            value="unassigned"
                                            id="gem-filter-assignee-unassigned"
                                            data-label="Unassigned"
                                        />
                                        <label class="form-check-label" for="gem-filter-assignee-unassigned">
                                            Unassigned
                                        </label>
                                    </div>
                                    <% (users || []).forEach(function (user) { %>
                                        <div class="form-check">
                                            <input
                                                class="form-check-input gem-multi-filter-option"
                                                type="checkbox"
                                                value="<%= user.id %>"
                                                id="gem-filter-assignee-<%= user.id %>"
                                                data-label="<%= user.full_name %>"
                                            />
                                            <label class="form-check-label" for="gem-filter-assignee-<%= user.id %>">
                                                <%= user.full_name %>
                                            </label>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-1">
                            <label for="gem-filter-past-experience" class="form-label">Past exp.</label>
                            <select
                                class="form-select form-select-sm gem-tender-column-filter"
                                id="gem-filter-past-experience"
                                data-column="pastExperience"
                            >
                                <option value="">All</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-4 col-xl-1">
                            <label for="gem-filter-mse-exp" class="form-label">MSE exp exc…</label>
                            <select
                                class="form-select form-select-sm gem-tender-column-filter"
                                id="gem-filter-mse-exp"
                                data-column="mseExp"
                            >
                                <option value="">All</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-4 col-xl-1">
                            <label for="gem-filter-mse-turnover" class="form-label">MSE turn exc…</label>
                            <select
                                class="form-select form-select-sm gem-tender-column-filter"
                                id="gem-filter-mse-turnover"
                                data-column="mseTurnover"
                            >
                                <option value="">All</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <label for="gem-filter-quantity-upto" class="form-label">Qty up to</label>
                            <div class="input-group input-group-sm">
                                <input
                                    type="number"
                                    class="form-control"
                                    id="gem-filter-quantity-upto"
                                    min="1"
                                    step="1"
                                    placeholder="e.g. 10"
                                    inputmode="numeric"
                                />
                                <button
                                    type="button"
                                    class="btn btn-outline-secondary"
                                    id="gem-filter-quantity-clear"
                                    title="Clear quantity"
                                >
                                    Clear
                                </button>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl-auto d-flex flex-wrap align-items-end gap-2">
                            <div class="form-check mb-1">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    id="gem-filter-show-all"
                                />
                                <label class="form-check-label small" for="gem-filter-show-all">
                                    Show out of scope / unattended / missed
                                </label>
                            </div>
                            <button
                                type="button"
                                class="btn btn-outline-secondary btn-sm"
                                id="gem-filters-reset-btn"
                            >
                                Reset filters
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm gem-tenders-list-card">
            <div
                id="gem-tenders-empty"
                class="p-4 p-md-5 text-center text-secondary <%= tenders && tenders.length ? 'd-none' : '' %>"
            >
                No tenders ending in this date range.
            </div>
            <div
                id="gem-tenders-table-wrap"
                class="gem-tenders-list-scroll <%= !tenders || !tenders.length ? 'd-none' : '' %>"
            >
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small" id="gem-tenders-table">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" style="width: 2rem;">
                                    <input
                                        type="checkbox"
                                        class="form-check-input"
                                        id="gem-tenders-select-all"
                                        aria-label="Select all visible tenders"
                                    />
                                </th>
                                <th scope="col">Tender ID</th>
                                <th scope="col">Keyword</th>
                                <th scope="col">Stage</th>
                                <th scope="col">Assignee</th>
                                <th
                                    scope="col"
                                    class="gem-tenders-sortable"
                                    data-sort-key="endAt"
                                    aria-sort="none"
                                    role="columnheader"
                                    tabindex="0"
                                    title="Sort by ends at"
                                >
                                    Ends at <span class="gem-tenders-sort-indicator" aria-hidden="true"></span>
                                </th>
                                <th scope="col">Buyer</th>
                                <th
                                    scope="col"
                                    class="gem-tenders-sortable"
                                    data-sort-key="quantity"
                                    aria-sort="none"
                                    role="columnheader"
                                    tabindex="0"
                                    title="Sort by quantity"
                                >
                                    Qty <span class="gem-tenders-sort-indicator" aria-hidden="true"></span>
                                </th>
                                <th scope="col">Past exp.</th>
                                <th scope="col">MSE Experience Relaxation</th>
                                <th scope="col">MSE Turnover Relaxation</th>
                            </tr>
                        </thead>
                        <tbody id="gem-tenders-tbody">
                                <% (tenders || []).forEach(function (tender) { %>
                                    <% const stage = tender.stage || "new"; %>
                                    <tr
                                        data-id="<%= tender.id %>"
                                        data-keyword-id="<%= tender.keyword_id %>"
                                        data-assignee-user-id="<%= tender.assignee_user_id || '' %>"
                                        data-stage="<%= stage %>"
                                        data-past-experience="<%= tender.required_past_experice_years || '' %>"
                                        data-mse-exp="<%= tender.mse_experience_relaxation || '' %>"
                                        data-mse-turnover="<%= tender.mse_turnover_relaxation || '' %>"
                                        data-quantity="<%= Number(tender.quantity || 0) %>"
                                        data-end-at="<%= tender.end_date_time || '' %>"
                                    >
                                    <td>
                                        <input
                                            type="checkbox"
                                            class="form-check-input gem-tender-select"
                                            value="<%= tender.id %>"
                                            aria-label="Select tender <%= tender.tender_id %>"
                                        />
                                    </td>
                                    <td>
                                        <a
                                            href="/app/gem-keyword-tenders/<%= tender.id %>"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            <%= tender.tender_id %>
                                        </a>
                                    </td>
                                    <td><%= tender.keyword || "-" %></td>
                                    <td><%= stageLabels[stage] || stage || "New" %></td>
                                    <td><%= tender.assignee_full_name || "-" %></td>
                                    <td
                                        data-readable-date="<%= tender.end_date_time || '' %>"
                                        data-date-format="DD/MM/YYYY HH:mm:ss"
                                    ></td>
                                    <td>
                                        <%
                                            const buyerParts = [
                                                tender.ministry,
                                                tender.department,
                                                tender.organization,
                                                tender.office,
                                            ].filter(Boolean);
                                        %>
                                        <% if (buyerParts.length) { %>
                                            <%= buyerParts.join(" / ") %>
                                        <% } else { %>
                                            -
                                        <% } %>
                                    </td>
                                    <td><%= Number(tender.quantity || 0) > 0 ? Number(tender.quantity) : "NA" %></td>
                                    <td><%= tender.required_past_experice_years || "-" %></td>
                                    <td><%= tender.mse_experience_relaxation || "-" %></td>
                                    <td><%= tender.mse_turnover_relaxation || "-" %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<style>
    .gem-tenders-page {
        height: calc(100vh - 56px);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .gem-tenders-page-inner {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }
    .gem-tenders-page-header,
    #gem-tenders-bulk-assign-bar,
    #gem-tenders-bulk-stage-bar,
    .gem-tenders-filters-card {
        flex: 0 0 auto;
    }
    #gem-tenders-bulk-assign-bar,
    #gem-tenders-bulk-stage-bar {
        position: sticky;
        top: 0;
        z-index: 2;
    }
    .gem-tenders-list-card {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .gem-tenders-list-scroll {
        flex: 1 1 auto;
        min-height: 0;
        overflow: auto;
    }
    #gem-tenders-table thead th {
        position: sticky;
        top: 0;
        z-index: 1;
    }
    #gem-tenders-table thead th.gem-tenders-sortable {
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
    }
    #gem-tenders-table thead th.gem-tenders-sortable:hover,
    #gem-tenders-table thead th.gem-tenders-sortable:focus-visible {
        background: #e9ecef;
        outline: none;
    }
    .gem-tenders-sort-indicator::before {
        content: "⇅";
        margin-left: 0.25rem;
        opacity: 0.35;
        font-size: 0.75em;
    }
    th.gem-tenders-sortable[aria-sort="ascending"] .gem-tenders-sort-indicator::before {
        content: "▲";
        opacity: 0.85;
    }
    th.gem-tenders-sortable[aria-sort="descending"] .gem-tenders-sort-indicator::before {
        content: "▼";
        opacity: 0.85;
    }
    .gem-tenders-filters-row .form-label {
        font-size: 0.75rem;
        margin-bottom: 0.25rem;
    }
    .gem-multi-filter .gem-multi-filter-toggle {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .gem-multi-filter-menu {
        max-height: 240px;
        overflow: auto;
        min-width: 100%;
    }
    .gem-multi-filter-menu .form-check {
        margin-bottom: 0.25rem;
    }
</style>

<div class="modal fade" id="gem-add-tender-modal" tabindex="-1" aria-labelledby="gem-add-tender-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="gem-add-tender-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="gem-add-tender-modal-label">Add tender</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-secondary small">
                        Enter a GeM search text (same as a keyword search). Matching tenders will be scanned and added. The search text is not saved as a keyword.
                    </p>
                    <div class="mb-3">
                        <label for="gem-add-tender-query" class="form-label">Search text</label>
                        <input
                            type="text"
                            class="form-control"
                            id="gem-add-tender-query"
                            maxlength="255"
                            placeholder="e.g. Desktop Computer or GEM tender number"
                            required
                            autocomplete="off"
                        />
                    </div>
                    <div class="form-check">
                        <input
                            type="checkbox"
                            class="form-check-input"
                            id="gem-add-tender-exact-search"
                        />
                        <label class="form-check-label" for="gem-add-tender-exact-search">
                            Exact search
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="gem-add-tender-submit-btn">
                        Scan &amp; add
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/gem-keyword-tenders.js" defer></script>
<%- include('common/footer') %>

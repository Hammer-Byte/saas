<%- include('common/header') %>

<%
    const stageLabels = GEM_KEYWORD_TENDER_STAGE_LABELS || {};
    const eligibilityValues = GEM_KEYWORD_TENDER_ELIGIBILITY || {};
    const eligibilityLabels = GEM_KEYWORD_TENDER_ELIGIBILITY_LABELS || {};

    function resolveEligibility(value) {
        if (value === true || value === 1 || value === "1") return eligibilityValues.ELIGIBLE;
        if (value === false || value === 0 || value === "0") return eligibilityValues.NEED_TO_CHECK;
        return value || eligibilityValues.NEED_TO_CHECK;
    }
%>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light gem-tenders-page">
    <div class="container-fluid px-3 px-lg-4 py-3 gem-tenders-page-inner">
        <div class="gem-tenders-page-header mb-3 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> /
                    <a href="/app/gem-tenders" class="text-decoration-none">Gem Tenders Analyzer</a> /
                    Tenders
                </p>
                <h1 class="h3 mb-1">Tenders</h1>
                <p class="text-secondary mb-0">Matched GEM tenders by end date range. Open a tender for details and actions.</p>
            </div>
            <a
                href="/app/gem-keyword-tender-report?from=<%= from %>&to=<%= to %>"
                class="btn btn-outline-primary"
                target="_blank"
                rel="noopener noreferrer"
            >
                Report
            </a>
        </div>

        <div class="card border-0 shadow-sm mb-3 gem-tenders-filters-card">
            <div class="card-header bg-white border-0 d-flex flex-wrap justify-content-between align-items-center gap-2 py-3 px-3 px-md-4">
                <button
                    type="button"
                    class="btn btn-outline-secondary btn-sm"
                    data-bs-toggle="collapse"
                    data-bs-target="#gem-tenders-filters"
                    aria-expanded="false"
                    aria-controls="gem-tenders-filters"
                    id="gem-tenders-filters-toggle"
                >
                    Filters
                </button>
                <p class="text-secondary small mb-0" id="gem-tenders-filter-status" role="status"></p>
            </div>
            <div class="collapse" id="gem-tenders-filters">
                <div class="card-body border-top pt-3 px-3 px-md-4 pb-3">
                    <div class="row g-2 align-items-end gem-tenders-filters-row">
                        <div class="col-6 col-md-4 col-xl-1">
                            <label for="gem-tenders-from" class="form-label">End from</label>
                            <input
                                type="date"
                                class="form-control form-control-sm"
                                id="gem-tenders-from"
                                name="from"
                                value="<%= from %>"
                            />
                        </div>
                        <div class="col-6 col-md-4 col-xl-1">
                            <label for="gem-tenders-to" class="form-label">End to</label>
                            <input
                                type="date"
                                class="form-control form-control-sm"
                                id="gem-tenders-to"
                                name="to"
                                value="<%= to %>"
                            />
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <label for="gem-filter-keyword" class="form-label">Keyword</label>
                            <select class="form-select form-select-sm" id="gem-filter-keyword">
                                <option value="">All</option>
                                <% (keywords || []).forEach(function (keyword) { %>
                                    <option value="<%= keyword.id %>"><%= keyword.keyword %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-6 col-md-4 col-xl-2">
                            <label for="gem-tenders-search" class="form-label">Search</label>
                            <input
                                type="search"
                                class="form-control form-control-sm"
                                id="gem-tenders-search"
                                placeholder="Tender ID…"
                                autocomplete="off"
                            />
                        </div>
                        <div class="col-6 col-md-4 col-xl-1">
                            <label for="gem-filter-assignee" class="form-label">Assignee</label>
                            <select class="form-select form-select-sm" id="gem-filter-assignee">
                                <option value="">All</option>
                                <option value="unassigned">Unassigned</option>
                                <% (users || []).forEach(function (user) { %>
                                    <option value="<%= user.id %>"><%= user.full_name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-6 col-md-4 col-xl-1">
                            <label for="gem-filter-past-experience" class="form-label">Past exp.</label>
                            <select
                                class="form-select form-select-sm gem-tender-column-filter"
                                id="gem-filter-past-experience"
                                data-column="pastExperience"
                            >
                                <option value="">All</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-4 col-xl-1">
                            <label for="gem-filter-mse-exp" class="form-label">MSE exp.</label>
                            <select class="form-select form-select-sm gem-tender-column-filter" id="gem-filter-mse-exp" data-column="mseExp">
                                <option value="">All</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-4 col-xl-1">
                            <label for="gem-filter-mse-turnover" class="form-label">MSE turn.</label>
                            <select class="form-select form-select-sm gem-tender-column-filter" id="gem-filter-mse-turnover" data-column="mseTurnover">
                                <option value="">All</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-4 col-xl-1">
                            <label for="gem-filter-eligible" class="form-label">Eligibility</label>
                            <select class="form-select form-select-sm gem-tender-column-filter" id="gem-filter-eligible" data-column="eligible">
                                <option value="">All</option>
                                <% Object.keys(eligibilityLabels).forEach(function (value) { %>
                                    <option value="<%= value %>"><%= eligibilityLabels[value] %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-6 col-md-4 col-xl-1">
                            <label for="gem-filter-filed" class="form-label">Filed</label>
                            <select class="form-select form-select-sm gem-tender-column-filter" id="gem-filter-filed" data-column="filed">
                                <option value="">All</option>
                                <option value="1">Yes</option>
                                <option value="0">No</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-4 col-xl-auto">
                            <div class="form-check mt-4">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    id="gem-filter-show-all"
                                />
                                <label class="form-check-label small" for="gem-filter-show-all">
                                    Show all
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm gem-tenders-list-card">
            <div
                id="gem-tenders-empty"
                class="p-4 p-md-5 text-center text-secondary <%= tenders && tenders.length ? 'd-none' : '' %>"
            >
                No tenders ending in this date range.
            </div>
            <div
                id="gem-tenders-table-wrap"
                class="gem-tenders-list-scroll <%= !tenders || !tenders.length ? 'd-none' : '' %>"
            >
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small" id="gem-tenders-table">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Tender ID</th>
                                <th scope="col">Keyword</th>
                                <th scope="col">Stage</th>
                                <th scope="col">Assignee</th>
                                <th scope="col">Start</th>
                                <th scope="col">End</th>
                                <th scope="col">Buyer</th>
                                <th scope="col">MSE Experience Relaxation</th>
                                <th scope="col">MSE Turnover Relaxation</th>
                                <th scope="col">Eligible</th>
                                <th scope="col">Filed</th>
                            </tr>
                        </thead>
                        <tbody id="gem-tenders-tbody">
                                <% (tenders || []).forEach(function (tender) { %>
                                    <% const eligibility = resolveEligibility(tender.eligible); %>
                                    <tr
                                        data-id="<%= tender.id %>"
                                        data-keyword-id="<%= tender.keyword_id %>"
                                        data-assignee-user-id="<%= tender.assignee_user_id || '' %>"
                                        data-past-experience="<%= tender.required_past_experice_years || '' %>"
                                        data-mse-exp="<%= tender.mse_experience_relaxation || '' %>"
                                        data-mse-turnover="<%= tender.mse_turnover_relaxation || '' %>"
                                        data-eligible="<%= eligibility %>"
                                        data-filed="<%= tender.filed ? '1' : '0' %>"
                                        data-hidden="<%= tender.hidden ? '1' : '0' %>"
                                    >
                                    <td>
                                        <a
                                            href="/app/gem-keyword-tenders/<%= tender.id %>"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            <%= tender.tender_id %>
                                        </a>
                                    </td>
                                    <td><%= tender.keyword || "-" %></td>
                                    <td><%= stageLabels[tender.stage] || tender.stage || "New" %></td>
                                    <td><%= tender.assignee_full_name || "-" %></td>
                                    <td><%= tender.start_date_time || "-" %></td>
                                    <td><%= tender.end_date_time || "-" %></td>
                                    <td>
                                        <%
                                            const buyerParts = [
                                                tender.ministry,
                                                tender.department,
                                                tender.organization,
                                                tender.office,
                                            ].filter(Boolean);
                                        %>
                                        <% if (buyerParts.length) { %>
                                            <%= buyerParts.join(" / ") %>
                                        <% } else { %>
                                            -
                                        <% } %>
                                    </td>
                                    <td><%= tender.mse_experience_relaxation || "-" %></td>
                                    <td><%= tender.mse_turnover_relaxation || "-" %></td>
                                        <td><%= eligibilityLabels[eligibility] || eligibility || "-" %></td>
                                        <td><%= tender.filed ? "Yes" : "No" %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<style>
    .gem-tenders-page {
        height: calc(100vh - 56px);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .gem-tenders-page-inner {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }
    .gem-tenders-page-header,
    .gem-tenders-filters-card {
        flex: 0 0 auto;
    }
    .gem-tenders-list-card {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .gem-tenders-list-scroll {
        flex: 1 1 auto;
        min-height: 0;
        overflow: auto;
    }
    #gem-tenders-table thead th {
        position: sticky;
        top: 0;
        z-index: 1;
    }
    .gem-tenders-filters-row .form-label {
        font-size: 0.75rem;
        margin-bottom: 0.25rem;
    }
</style>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/gem-keyword-tenders.js" defer></script>
<%- include('common/footer') %>

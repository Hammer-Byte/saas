<%- include('common/header') %>

<%
    const stageLabels = GEM_KEYWORD_TENDER_STAGE_LABELS || {};
    const stageValues = Object.keys(stageLabels);
    const mseDisplay = function (value) {
        if (value === true || value === 1 || value === "1") return "Yes";
        if (value === false || value === 0 || value === "0") return "No";
        return "-";
    };
    const canAssignOthers = (authorities || []).includes(AUTHORITIES.ASSIGN_GEM_TENDER_ASSIGNEE);
    const canBulkChangeStage = (authorities || []).includes(AUTHORITIES.MARK_GEM_TENDER_MASS_STAGE_CHANGE);
    const currentUserId = Number(userId || 0);
%>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light gem-tenders-page">
    <div class="container-fluid px-3 px-lg-4 py-3 gem-tenders-page-inner">
        <div class="gem-tenders-page-header mb-3 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> /
                    <a href="/app/gem-tenders" class="text-decoration-none">GEM Tenders</a> /
                    Tenders
                </p>
                <h1 class="h3 mb-1">Tenders</h1>
                <p class="text-secondary mb-0">
                    Matched GEM tenders by end date range
                    <span
                        class="gem-tenders-range-highlight"
                        title="Selected ends-at date range"
                    >
                        <span data-readable-date="<%= from %>" data-date-format="DD/MM/YYYY"><%= from %></span>
                        –
                        <span data-readable-date="<%= to %>" data-date-format="DD/MM/YYYY"><%= to %></span>
                    </span>.
                    Open a tender for details and actions.
                </p>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <button
                    type="button"
                    class="btn btn-outline-secondary rounded-circle gem-tenders-refresh-btn"
                    id="gem-tenders-refresh-btn"
                    title="Refresh tenders"
                    aria-label="Refresh tenders"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        fill="currentColor"
                        viewBox="0 0 16 16"
                        aria-hidden="true"
                        class="gem-tenders-refresh-icon"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M8 3a5 5 0 1 0 4.546 2.5.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"
                        />
                        <path
                            d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.975 2.14a.25.25 0 0 1 0 .384l-2.975 2.14a.25.25 0 0 1-.41-.192"
                        />
                    </svg>
                </button>
                <button
                    type="button"
                    class="btn btn-outline-secondary"
                    id="gem-tenders-filters-toggle"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#gem-tenders-filters-panel"
                    aria-controls="gem-tenders-filters-panel"
                >
                    Filters &amp; Columns
                </button>
                <button
                    type="button"
                    class="btn btn-primary"
                    id="gem-add-tender-btn"
                    data-bs-toggle="modal"
                    data-bs-target="#gem-add-tender-modal"
                >
                    Add tenders
                </button>
                <a
                    id="gem-tenders-report-link"
                    href="/app/gem-keyword-tender-report?from=<%= from %>&to=<%= to %>"
                    class="btn btn-outline-primary"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Report
                </a>
            </div>
        </div>
        <p class="text-secondary small mb-3" id="gem-tenders-filter-status" role="status"></p>

        <div id="gem-add-tender-alert" class="alert d-none" role="alert"></div>

        <div
            id="gem-tenders-bulk-assign-bar"
            class="card border-0 shadow-sm mb-3 d-none"
            data-current-user-id="<%= currentUserId %>"
            data-can-assign-others="<%= canAssignOthers ? '1' : '0' %>"
            data-can-bulk-change-stage="<%= canBulkChangeStage ? '1' : '0' %>"
        >
            <div class="card-body py-2 px-3 d-flex flex-wrap align-items-center gap-2">
                <span class="small text-secondary" id="gem-tenders-selected-count">0 selected</span>
                <select class="form-select form-select-sm" id="gem-bulk-assignee" style="max-width: 280px;">
                    <option value="">Choose assignee…</option>
                    <% if (currentUserId) { %>
                        <option value="<%= currentUserId %>">Assign to me</option>
                    <% } %>
                    <% if (canAssignOthers) { %>
                        <% (users || []).forEach(function (user) { %>
                            <% if (Number(user.id) !== currentUserId) { %>
                                <option value="<%= user.id %>"><%= user.full_name %> (<%= user.email %>)</option>
                            <% } %>
                        <% }) %>
                    <% } %>
                </select>
                <button type="button" class="btn btn-sm btn-primary" id="gem-bulk-assign-btn" disabled>
                    Assign
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="gem-bulk-clear-btn">
                    Clear selection
                </button>
                <span class="small text-danger d-none" id="gem-bulk-assign-status" role="status"></span>
            </div>
        </div>

        <% if (canBulkChangeStage) { %>
            <div id="gem-tenders-bulk-stage-bar" class="card border-0 shadow-sm mb-3 d-none">
                <div class="card-body py-2 px-3">
                    <div class="d-flex flex-wrap align-items-start gap-2">
                        <span class="small text-secondary pt-1" id="gem-tenders-stage-selected-count">0 selected</span>
                        <div style="min-width: 180px; max-width: 240px;">
                            <label for="gem-bulk-stage" class="form-label small mb-1">
                                Stage <span class="text-danger">*</span>
                            </label>
                            <select class="form-select form-select-sm" id="gem-bulk-stage">
                                <option value="">Choose stage…</option>
                                <% stageValues.forEach(function (stage) { %>
                                    <option value="<%= stage %>"><%= stageLabels[stage] || stage %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="flex-grow-1" style="min-width: 220px; max-width: 520px;">
                            <label for="gem-bulk-stage-comment" class="form-label small mb-1">
                                Comment <span class="text-danger">*</span>
                            </label>
                            <textarea
                                class="form-control form-control-sm"
                                id="gem-bulk-stage-comment"
                                rows="2"
                                placeholder="Required comment for selected tenders…"
                                maxlength="2000"
                            ></textarea>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-2 pt-4">
                            <button type="button" class="btn btn-sm btn-primary" id="gem-bulk-stage-btn" disabled>
                                Change stage
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="gem-bulk-stage-clear-btn">
                                Clear selection
                            </button>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-2 pt-2 border-top">
                        <span class="small text-secondary me-1">Lock selected:</span>
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-danger"
                            id="gem-bulk-out-of-scope-btn"
                            disabled
                        >
                            Mark out of scope
                        </button>
                        <button
                            type="button"
                            class="btn btn-sm btn-outline-danger"
                            id="gem-bulk-not-eligible-btn"
                            disabled
                        >
                            Mark not eligible
                        </button>
                    </div>
                    <span class="small text-danger d-none mt-1 d-inline-block" id="gem-bulk-stage-status" role="status"></span>
                </div>
            </div>
        <% } %>

        <div
            class="offcanvas offcanvas-end gem-tenders-filters-panel"
            tabindex="-1"
            id="gem-tenders-filters-panel"
            aria-labelledby="gem-tenders-filters-panel-label"
        >
            <div class="offcanvas-header border-bottom">
                <h2 class="offcanvas-title h5 mb-0" id="gem-tenders-filters-panel-label">Filters &amp; Columns</h2>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column p-0">
                <ul class="nav nav-tabs px-3 pt-2 mb-0" id="gem-tenders-sidebar-tabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button
                            class="nav-link active"
                            id="gem-tenders-tab-filters"
                            data-bs-toggle="tab"
                            data-bs-target="#gem-tenders-pane-filters"
                            type="button"
                            role="tab"
                            aria-controls="gem-tenders-pane-filters"
                            aria-selected="true"
                        >
                            Filters
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button
                            class="nav-link"
                            id="gem-tenders-tab-columns"
                            data-bs-toggle="tab"
                            data-bs-target="#gem-tenders-pane-columns"
                            type="button"
                            role="tab"
                            aria-controls="gem-tenders-pane-columns"
                            aria-selected="false"
                        >
                            Columns
                        </button>
                    </li>
                </ul>
                <div class="tab-content flex-grow-1 overflow-auto">
                <div
                    class="tab-pane fade show active p-3 gem-tenders-filters-form"
                    id="gem-tenders-pane-filters"
                    role="tabpanel"
                    aria-labelledby="gem-tenders-tab-filters"
                    tabindex="0"
                >
                <div
                    id="gem-tenders-filters-form"
                    autocomplete="off"
                >
                    <div class="mb-3">
                        <div class="row g-2">
                            <div class="col-6">
                                <label for="gem-tenders-from" class="form-label">Ends from</label>
                                <input
                                    type="date"
                                    class="form-control form-control-sm"
                                    id="gem-tenders-from"
                                    value="<%= from %>"
                                    data-page-from="<%= from %>"
                                    autocomplete="off"
                                />
                            </div>
                            <div class="col-6">
                                <label for="gem-tenders-to" class="form-label">Ends to</label>
                                <input
                                    type="date"
                                    class="form-control form-control-sm"
                                    id="gem-tenders-to"
                                    value="<%= to %>"
                                    data-page-to="<%= to %>"
                                    autocomplete="off"
                                />
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-date-quick-btn" data-range="today">
                                Today
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-date-quick-btn" data-range="this-week">
                                This week
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-date-quick-btn" data-range="next-15-days">
                                Next 15 days
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-date-quick-btn" data-range="this-month">
                                This month
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-date-quick-btn" data-range="last-month">
                                Last month
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-date-quick-btn" data-range="this-quarter">
                                This quarter
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-date-quick-btn" data-range="last-quarter">
                                Last quarter
                            </button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <span class="form-label d-block">Category</span>
                        <div class="d-flex gap-1 align-items-stretch">
                            <div class="dropdown gem-multi-filter flex-grow-1" id="gem-filter-category" data-empty-label="All categories">
                                <button
                                    class="btn btn-outline-secondary btn-sm dropdown-toggle w-100 text-start gem-multi-filter-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    data-bs-auto-close="outside"
                                    data-bs-display="static"
                                    aria-expanded="false"
                                >
                                    <span class="gem-multi-filter-label">All categories</span>
                                </button>
                                <div class="dropdown-menu gem-multi-filter-menu p-2 shadow">
                                    <div class="form-check">
                                        <input
                                            class="form-check-input gem-multi-filter-option"
                                            type="checkbox"
                                            value="none"
                                            id="gem-filter-category-none"
                                            data-label="No category"
                                        />
                                        <label class="form-check-label" for="gem-filter-category-none">
                                            No category
                                        </label>
                                    </div>
                                    <% if ((tenderCategories || []).length) { %>
                                        <hr class="dropdown-divider my-2" />
                                    <% } %>
                                    <% (tenderCategories || []).forEach(function (category) { %>
                                        <div class="form-check">
                                            <input
                                                class="form-check-input gem-multi-filter-option"
                                                type="checkbox"
                                                value="<%= category.id %>"
                                                id="gem-filter-category-<%= category.id %>"
                                                data-label="<%= category.name %>"
                                            />
                                            <label class="form-check-label" for="gem-filter-category-<%= category.id %>">
                                                <%= category.name %>
                                            </label>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                            <button
                                type="button"
                                class="btn btn-outline-secondary btn-sm gem-filter-clear-btn gem-filter-clear-x"
                                data-clear-multi="gem-filter-category"
                                title="Clear category"
                                aria-label="Clear category"
                            >×</button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <span class="form-label d-block">Stage</span>
                        <div class="d-flex gap-1 align-items-stretch">
                            <div class="dropdown gem-multi-filter flex-grow-1" id="gem-filter-stage" data-empty-label="All stages">
                                <button
                                    class="btn btn-outline-secondary btn-sm dropdown-toggle w-100 text-start gem-multi-filter-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    data-bs-auto-close="outside"
                                    data-bs-display="static"
                                    aria-expanded="false"
                                >
                                    <span class="gem-multi-filter-label">All stages</span>
                                </button>
                                <div class="dropdown-menu gem-multi-filter-menu p-2 shadow">
                                    <% stageValues.forEach(function (stage) { %>
                                        <div class="form-check">
                                            <input
                                                class="form-check-input gem-multi-filter-option"
                                                type="checkbox"
                                                value="<%= stage %>"
                                                id="gem-filter-stage-<%= stage %>"
                                                data-label="<%= stageLabels[stage] %>"
                                            />
                                            <label class="form-check-label" for="gem-filter-stage-<%= stage %>">
                                                <%= stageLabels[stage] %>
                                            </label>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                            <button
                                type="button"
                                class="btn btn-outline-secondary btn-sm gem-filter-clear-btn gem-filter-clear-x"
                                data-clear-multi="gem-filter-stage"
                                title="Clear stage"
                                aria-label="Clear stage"
                            >×</button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="gem-tenders-search" class="form-label">Search</label>
                        <div class="input-group input-group-sm">
                            <input
                                type="search"
                                class="form-control"
                                id="gem-tenders-search"
                                placeholder="Tender ID…"
                                autocomplete="off"
                            />
                            <button
                                type="button"
                                class="btn btn-outline-secondary gem-filter-clear-btn gem-filter-clear-x"
                                data-clear-input="gem-tenders-search"
                                title="Clear search"
                                aria-label="Clear search"
                            >×</button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <span class="form-label d-block">Assignee</span>
                        <div class="d-flex gap-1 align-items-stretch">
                            <div class="dropdown gem-multi-filter flex-grow-1" id="gem-filter-assignee" data-empty-label="All assignees">
                                <button
                                    class="btn btn-outline-secondary btn-sm dropdown-toggle w-100 text-start gem-multi-filter-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    data-bs-auto-close="outside"
                                    data-bs-display="static"
                                    aria-expanded="false"
                                >
                                    <span class="gem-multi-filter-label">All assignees</span>
                                </button>
                                <div class="dropdown-menu gem-multi-filter-menu p-2 shadow">
                                    <div class="form-check">
                                        <input
                                            class="form-check-input gem-multi-filter-option"
                                            type="checkbox"
                                            value="unassigned"
                                            id="gem-filter-assignee-unassigned"
                                            data-label="Unassigned"
                                        />
                                        <label class="form-check-label" for="gem-filter-assignee-unassigned">
                                            Unassigned
                                        </label>
                                    </div>
                                    <% (users || []).forEach(function (user) { %>
                                        <div class="form-check">
                                            <input
                                                class="form-check-input gem-multi-filter-option"
                                                type="checkbox"
                                                value="<%= user.id %>"
                                                id="gem-filter-assignee-<%= user.id %>"
                                                data-label="<%= user.full_name %>"
                                            />
                                            <label class="form-check-label" for="gem-filter-assignee-<%= user.id %>">
                                                <%= user.full_name %>
                                            </label>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                            <button
                                type="button"
                                class="btn btn-outline-secondary btn-sm gem-filter-clear-btn gem-filter-clear-x"
                                data-clear-multi="gem-filter-assignee"
                                title="Clear assignee"
                                aria-label="Clear assignee"
                            >×</button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="gem-filter-past-experience" class="form-label">Past exp.</label>
                        <div class="input-group input-group-sm">
                            <select
                                class="form-select gem-tender-column-filter"
                                id="gem-filter-past-experience"
                                data-column="pastExperience"
                            >
                                <option value="">All</option>
                            </select>
                            <button
                                type="button"
                                class="btn btn-outline-secondary gem-filter-clear-btn gem-filter-clear-x"
                                data-clear-select="gem-filter-past-experience"
                                title="Clear past experience"
                                aria-label="Clear past experience"
                            >×</button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="gem-filter-mse-exp" class="form-label">Experience Relaxation</label>
                        <div class="input-group input-group-sm">
                            <select
                                class="form-select gem-tender-column-filter"
                                id="gem-filter-mse-exp"
                                data-column="mseExp"
                            >
                                <option value="">All</option>
                            </select>
                            <button
                                type="button"
                                class="btn btn-outline-secondary gem-filter-clear-btn gem-filter-clear-x"
                                data-clear-select="gem-filter-mse-exp"
                                title="Clear experience relaxation"
                                aria-label="Clear experience relaxation"
                            >×</button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="gem-filter-mse-turnover" class="form-label">Turnover Relaxation</label>
                        <div class="input-group input-group-sm">
                            <select
                                class="form-select gem-tender-column-filter"
                                id="gem-filter-mse-turnover"
                                data-column="mseTurnover"
                            >
                                <option value="">All</option>
                            </select>
                            <button
                                type="button"
                                class="btn btn-outline-secondary gem-filter-clear-btn gem-filter-clear-x"
                                data-clear-select="gem-filter-mse-turnover"
                                title="Clear turnover relaxation"
                                aria-label="Clear turnover relaxation"
                            >×</button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="gem-filter-quantity-upto" class="form-label">Quantity up to</label>
                        <div class="input-group input-group-sm">
                            <input
                                type="number"
                                class="form-control"
                                id="gem-filter-quantity-upto"
                                min="1"
                                step="1"
                                placeholder="e.g. 10"
                                inputmode="numeric"
                                autocomplete="off"
                            />
                            <button
                                type="button"
                                class="btn btn-outline-secondary gem-filter-clear-btn gem-filter-clear-x"
                                data-clear-input="gem-filter-quantity-upto"
                                id="gem-filter-quantity-clear"
                                title="Clear quantity"
                                aria-label="Clear quantity"
                            >×</button>
                        </div>
                    </div>
                    <div class="mb-1">
                        <div class="form-check">
                            <input
                                class="form-check-input"
                                type="checkbox"
                                id="gem-filter-include-hidden"
                            />
                            <label class="form-check-label small" for="gem-filter-include-hidden">
                                Include hidden
                            </label>
                        </div>
                    </div>
                </div>
                </div>
                <div
                    class="tab-pane fade p-3"
                    id="gem-tenders-pane-columns"
                    role="tabpanel"
                    aria-labelledby="gem-tenders-tab-columns"
                    tabindex="0"
                >
                    <p class="text-secondary small mb-3">
                        Choose which table columns to show. Selection is saved for this browser.
                    </p>
                    <div class="d-flex flex-wrap gap-1 mb-3">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="gem-columns-show-all-btn">
                            Show all
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="gem-columns-reset-btn">
                            Reset columns
                        </button>
                    </div>
                    <div class="d-grid gap-2" id="gem-tenders-column-checks">
                        <div class="form-check">
                            <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-tenderId" value="tenderId" checked disabled />
                            <label class="form-check-label" for="gem-col-tenderId">Tender ID</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-endAt" value="endAt" checked />
                            <label class="form-check-label" for="gem-col-endAt">Ends at</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-category" value="category" checked />
                            <label class="form-check-label" for="gem-col-category">Category</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-buyer" value="buyer" checked />
                            <label class="form-check-label" for="gem-col-buyer">Buyer</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-quantity" value="quantity" checked />
                            <label class="form-check-label" for="gem-col-quantity">Quantity</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-emd" value="emd" checked />
                            <label class="form-check-label" for="gem-col-emd">EMD</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-pastExp" value="pastExp" checked />
                            <label class="form-check-label" for="gem-col-pastExp">Past exp.</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-mseExp" value="mseExp" checked />
                            <label class="form-check-label" for="gem-col-mseExp">Experience Relaxation</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-mseTurnover" value="mseTurnover" checked />
                            <label class="form-check-label" for="gem-col-mseTurnover">Turnover Relaxation</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-stage" value="stage" checked />
                            <label class="form-check-label" for="gem-col-stage">Stage</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-locked" value="locked" checked />
                            <label class="form-check-label" for="gem-col-locked">Locked</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-assignee" value="assignee" checked />
                            <label class="form-check-label" for="gem-col-assignee">Assignee</label>
                        </div>
                    </div>
                </div>
                </div>
                <div class="border-top p-3 d-grid gap-2 gem-tenders-filters-actions">
                    <button type="button" class="btn btn-primary" id="gem-filters-apply-btn">
                        Apply filters
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="gem-filters-reset-btn">
                        Reset filters
                    </button>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm gem-tenders-list-card position-relative">
            <div
                id="gem-tenders-loading"
                class="gem-tenders-loading <%= !tenders || !tenders.length ? 'd-none' : '' %>"
                role="status"
                aria-live="polite"
            >
                <div class="spinner-border text-primary" aria-hidden="true"></div>
                <span class="ms-2">Loading tenders…</span>
            </div>
            <div
                id="gem-tenders-empty"
                class="p-4 p-md-5 text-center text-secondary d-none"
            >
                No tenders ending in this date range.
            </div>
            <div
                id="gem-tenders-table-wrap"
                class="gem-tenders-list-scroll d-none"
                aria-busy="true"
            >
                <div class="table-responsive">
                    <table
                        class="table table-hover align-middle mb-0 small"
                        id="gem-tenders-table"
                        data-stage-labels="<%= JSON.stringify(stageLabels).replace(/"/g, '&quot;') %>"
                    >
                        <thead class="table-light">
                            <tr>
                                <th scope="col" data-col="select" style="width: 2rem;">
                                    <input
                                        type="checkbox"
                                        class="form-check-input"
                                        id="gem-tenders-select-all"
                                        aria-label="Select all visible tenders"
                                    />
                                </th>
                                <th scope="col" data-col="tenderId">Tender ID</th>
                                <th
                                    scope="col"
                                    data-col="endAt"
                                    class="gem-tenders-sortable"
                                    data-sort-key="endAt"
                                    aria-sort="none"
                                    role="columnheader"
                                    tabindex="0"
                                    title="Sort by ends at"
                                >
                                    Ends at <span class="gem-tenders-sort-indicator" aria-hidden="true"></span>
                                </th>
                                <th scope="col" data-col="category">Category</th>
                                <th scope="col" data-col="buyer" class="gem-tenders-buyer-col">Buyer</th>
                                <th
                                    scope="col"
                                    data-col="quantity"
                                    class="gem-tenders-sortable"
                                    data-sort-key="quantity"
                                    aria-sort="none"
                                    role="columnheader"
                                    tabindex="0"
                                    title="Sort by quantity"
                                >
                                    Quantity <span class="gem-tenders-sort-indicator" aria-hidden="true"></span>
                                </th>
                                <th scope="col" data-col="emd">EMD</th>
                                <th scope="col" data-col="pastExp">Past exp.</th>
                                <th scope="col" data-col="mseExp">Experience Relaxation</th>
                                <th scope="col" data-col="mseTurnover">Turnover Relaxation</th>
                                <th scope="col" data-col="stage">Stage</th>
                                <th scope="col" data-col="locked" class="text-center" style="width: 4.5rem;">Locked</th>
                                <th scope="col" data-col="assignee">Assignee</th>
                            </tr>
                        </thead>
                        <tbody id="gem-tenders-tbody">
                                <% (tenders || []).forEach(function (tender) { %>
                                    <% const stage = tender.stage || "new"; %>
                                    <% const emdAmount = Number(tender.emd_amount || 0); %>
                                    <%
                                        const buyerParts = [
                                            tender.ministry,
                                            tender.department,
                                            tender.organization,
                                            tender.office,
                                        ].filter(Boolean);
                                        const buyerText = buyerParts.length ? buyerParts.join(" / ") : "-";
                                        const assigneeName = tender.assignee_full_name || "-";
                                        const stageLabel = stageLabels[stage] || stage || "New";
                                        const isLocked = !!Number(tender.locked);
                                        const isHidden = !!Number(tender.hidden) || tender.hidden === true;
                                    %>
                                    <tr
                                        data-id="<%= tender.id %>"
                                        data-tender-category-id="<%= tender.tender_category_id != null ? tender.tender_category_id : '' %>"
                                        data-tender-category-name="<%= tender.tender_category_name || '' %>"
                                        data-locked="<%= isLocked ? '1' : '0' %>"
                                        data-hidden="<%= isHidden ? '1' : '0' %>"
                                        data-assignee-user-id="<%= tender.assignee_user_id != null ? tender.assignee_user_id : '' %>"
                                        data-stage="<%= stage %>"
                                        data-past-experience="<%= tender.required_past_experice_years || '' %>"
                                        data-mse-exp="<%= mseDisplay(tender.mse_experience_relaxation) === '-' ? '' : mseDisplay(tender.mse_experience_relaxation) %>"
                                        data-mse-turnover="<%= mseDisplay(tender.mse_turnover_relaxation) === '-' ? '' : mseDisplay(tender.mse_turnover_relaxation) %>"
                                        data-quantity="<%= Number(tender.quantity || 0) %>"
                                        data-end-at="<%= tender.end_date_time || '' %>"
                                    >
                                    <td data-col="select">
                                        <input
                                            type="checkbox"
                                            class="form-check-input gem-tender-select"
                                            value="<%= tender.id %>"
                                            aria-label="Select tender <%= tender.tender_id %>"
                                        />
                                    </td>
                                    <td data-col="tenderId">
                                        <a
                                            href="/app/gem-keyword-tenders/<%= tender.id %>"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            <%= tender.tender_id %>
                                        </a>
                                    </td>
                                    <td
                                        data-col="endAt"
                                        class="gem-tenders-ends-at"
                                        data-readable-date="<%= tender.end_date_time || '' %>"
                                        data-date-format="DD/MM/YYYY HH:mm:ss"
                                    ></td>
                                    <td data-col="category"><%= tender.tender_category_name || "-" %></td>
                                    <td data-col="buyer" class="gem-tenders-buyer-col">
                                        <span class="gem-tenders-buyer-text" title="<%= buyerText %>">
                                            <%= buyerText %>
                                        </span>
                                    </td>
                                    <td data-col="quantity"><%= Number(tender.quantity || 0) > 0 ? Number(tender.quantity) : "NA" %></td>
                                    <td data-col="emd">
                                        <%= emdAmount > 0
                                            ? emdAmount.toLocaleString("en-IN", { maximumFractionDigits: 2 })
                                            : "NA" %>
                                    </td>
                                    <td data-col="pastExp"><%= tender.required_past_experice_years || "-" %></td>
                                    <td data-col="mseExp"><%= mseDisplay(tender.mse_experience_relaxation) %></td>
                                    <td data-col="mseTurnover"><%= mseDisplay(tender.mse_turnover_relaxation) %></td>
                                    <td data-col="stage">
                                        <span class="gem-tender-tag gem-tender-stage-tag gem-tender-stage-<%= stage %>">
                                            <%= stageLabel %>
                                        </span>
                                    </td>
                                    <td data-col="locked" class="text-center">
                                        <input
                                            type="checkbox"
                                            class="form-check-input gem-tender-locked-check"
                                            <%= isLocked ? "checked" : "" %>
                                            disabled
                                            aria-label="<%= isLocked ? (tender.lock_message || 'Locked') : 'Not locked' %>"
                                            title="<%= isLocked ? (tender.lock_message || 'Locked') : 'Not locked' %>"
                                        />
                                    </td>
                                    <td data-col="assignee">
                                        <span class="gem-tender-tag gem-tender-assignee-tag<%= tender.assignee_user_id ? '' : ' gem-tender-assignee-empty' %>">
                                            <%= assigneeName %>
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<style>
    .gem-tenders-page {
        height: calc(100vh - 56px);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .gem-tenders-page-inner {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }
    .gem-tenders-page-header,
    #gem-tenders-filter-status,
    #gem-tenders-bulk-assign-bar,
    #gem-tenders-bulk-stage-bar {
        flex: 0 0 auto;
    }
    .gem-tenders-range-highlight {
        display: inline-block;
        margin: 0 0.15rem;
        padding: 0.1rem 0.45rem;
        border-radius: 0.35rem;
        background: #fff3cd;
        color: #7a5b00;
        font-weight: 600;
        white-space: nowrap;
    }
    .gem-tenders-refresh-btn {
        width: 2.25rem;
        height: 2.25rem;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .gem-tenders-refresh-btn.is-loading .gem-tenders-refresh-icon {
        animation: gem-tenders-refresh-spin 0.8s linear infinite;
    }
    @keyframes gem-tenders-refresh-spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .gem-tenders-filters-panel {
        width: min(24rem, 100vw);
    }
    .gem-tenders-filters-form .form-label {
        font-size: 0.8rem;
        margin-bottom: 0.3rem;
    }
    .gem-tenders-filters-actions {
        flex: 0 0 auto;
        background: #fff;
    }
    .gem-filter-clear-x {
        width: 2rem;
        min-width: 2rem;
        padding-left: 0;
        padding-right: 0;
        line-height: 1;
        font-size: 1.1rem;
        font-weight: 600;
    }
    .input-group .gem-filter-clear-x {
        width: 2rem;
    }
    #gem-tenders-bulk-assign-bar,
    #gem-tenders-bulk-stage-bar {
        position: sticky;
        top: 0;
        z-index: 2;
    }
    .gem-tenders-list-card {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .gem-tenders-loading {
        flex: 1 1 auto;
        min-height: 12rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6c757d;
        font-size: 0.95rem;
    }
    .gem-tenders-list-scroll {
        flex: 1 1 auto;
        min-height: 0;
        overflow: auto;
    }
    #gem-tenders-table thead th {
        position: sticky;
        top: 0;
        z-index: 1;
    }
    #gem-tenders-table thead th.gem-tenders-sortable {
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
    }
    #gem-tenders-table thead th.gem-tenders-sortable:hover,
    #gem-tenders-table thead th.gem-tenders-sortable:focus-visible {
        background: #e9ecef;
        outline: none;
    }
    .gem-tenders-sort-indicator::before {
        content: "⇅";
        margin-left: 0.25rem;
        opacity: 0.35;
        font-size: 0.75em;
    }
    th.gem-tenders-sortable[aria-sort="ascending"] .gem-tenders-sort-indicator::before {
        content: "▲";
        opacity: 0.85;
    }
    th.gem-tenders-sortable[aria-sort="descending"] .gem-tenders-sort-indicator::before {
        content: "▼";
        opacity: 0.85;
    }
    .gem-multi-filter .gem-multi-filter-toggle {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .gem-multi-filter-menu {
        max-height: 240px;
        overflow: auto;
        min-width: 100%;
    }
    .gem-multi-filter-menu .form-check {
        margin-bottom: 0.25rem;
    }
    .gem-tenders-buyer-col {
        max-width: 10rem;
        width: 10rem;
    }
    .gem-tenders-buyer-text {
        display: block;
        max-width: 10rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .gem-tender-tag {
        display: inline-block;
        max-width: 100%;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        border: 1px solid transparent;
        font-size: 0.72rem;
        font-weight: 600;
        line-height: 1.2;
        white-space: nowrap;
        vertical-align: middle;
    }
    .gem-tender-stage-tag {
        color: #1f2937;
        background: #e5e7eb;
        border-color: #d1d5db;
    }
    .gem-tender-stage-new {
        color: #1e3a8a;
        background: #dbeafe;
        border-color: #93c5fd;
    }
    .gem-tender-stage-assigned {
        color: #164e63;
        background: #cffafe;
        border-color: #67e8f9;
    }
    .gem-tender-stage-waiting_for_docs {
        color: #713f12;
        background: #fef3c7;
        border-color: #fcd34d;
    }
    .gem-tender-stage-waiting_for_gem {
        color: #1e3a8a;
        background: #e0e7ff;
        border-color: #a5b4fc;
    }
    .gem-tender-stage-waiting_for_quote {
        color: #9a3412;
        background: #ffedd5;
        border-color: #fdba74;
    }
    .gem-tender-stage-preparing_docs {
        color: #7c2d12;
        background: #ffedd5;
        border-color: #fdba74;
    }
    .gem-tender-stage-eligible {
        color: #14532d;
        background: #dcfce7;
        border-color: #86efac;
    }
    .gem-tender-locked-check:disabled {
        opacity: 1;
        pointer-events: none;
    }

    .gem-tender-locked-check:disabled:checked {
        background-color: #842029;
        border-color: #842029;
    }
    .gem-tender-stage-filed {
        color: #312e81;
        background: #e0e7ff;
        border-color: #a5b4fc;
    }
    .gem-tender-assignee-tag {
        color: #5b21b6;
        background: #ede9fe;
        border-color: #c4b5fd;
    }
    .gem-tender-assignee-empty {
        color: #6b7280;
        background: #f3f4f6;
        border-color: #d1d5db;
        font-weight: 500;
    }
    #gem-tenders-table tbody tr.gem-tender-ends-soon {
        animation: gem-tender-ends-soon-blink 1.2s ease-in-out infinite;
    }
    #gem-tenders-table tbody tr.gem-tender-ends-soon .gem-tenders-ends-at {
        color: #b91c1c;
        font-weight: 700;
    }
    #gem-tenders-table tbody tr.gem-tender-ends-soon-filed {
        animation: gem-tender-ends-soon-filed-blink 1.2s ease-in-out infinite;
    }
    #gem-tenders-table tbody tr.gem-tender-ends-soon-filed .gem-tenders-ends-at {
        color: #166534;
        font-weight: 700;
    }
    @keyframes gem-tender-ends-soon-blink {
        0%,
        100% {
            background-color: #ffe5e5;
            box-shadow: inset 0 0 0 1px rgba(220, 53, 69, 0.15);
        }
        50% {
            background-color: #ffc9c9;
            box-shadow: inset 0 0 0 1px rgba(220, 53, 69, 0.4);
        }
    }
    @keyframes gem-tender-ends-soon-filed-blink {
        0%,
        100% {
            background-color: #e8f8ee;
            box-shadow: inset 0 0 0 1px rgba(22, 163, 74, 0.15);
        }
        50% {
            background-color: #c6f0d4;
            box-shadow: inset 0 0 0 1px rgba(22, 163, 74, 0.4);
        }
    }
</style>

<div class="modal fade" id="gem-add-tender-modal" tabindex="-1" aria-labelledby="gem-add-tender-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="gem-add-tender-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="gem-add-tender-modal-label">Add tenders</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-secondary small">
                        Enter one GeM category name or Bid/RA number per line. Matching tenders will be scanned and added. No category is assigned automatically — set it on the tender detail page if needed.
                    </p>
                    <div class="mb-3">
                        <label for="gem-add-tender-query" class="form-label">Search texts</label>
                        <textarea
                            class="form-control"
                            id="gem-add-tender-query"
                            rows="6"
                            placeholder="Custom Bid for Services&#10;GEM/2024/B/1234567&#10;Desktop Computers"
                            required
                            autocomplete="off"
                        ></textarea>
                        <div class="form-text">One category or Bid/RA number per line. Max 50 lines.</div>
                    </div>
                    <% if (super_admin) { %>
                        <div class="form-check">
                            <input
                                type="checkbox"
                                class="form-check-input"
                                id="gem-add-tender-exact-search"
                            />
                            <label class="form-check-label" for="gem-add-tender-exact-search">
                                Exact category
                            </label>
                        </div>
                    <% } %>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="gem-add-tender-submit-btn">
                        Scan &amp; add
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/gem-keyword-tenders.js" defer></script>
<%- include('common/footer') %>

<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> /
                    <a href="/app/gem-tenders" class="text-decoration-none">Gem Tenders Analyzer</a> /
                    <a href="/app/gem-keyword-tenders?from=<%= from %>&to=<%= to %>" class="text-decoration-none">Tenders</a> /
                    Report
                </p>
                <h1 class="h3 mb-1">Tenders report</h1>
                <p class="text-secondary mb-0">
                    Workload and progress for tenders ending
                    <strong><%= from %></strong> to <strong><%= to %></strong>.
                </p>
            </div>
            <a
                href="/app/gem-keyword-tenders?from=<%= from %>&to=<%= to %>"
                class="btn btn-outline-secondary"
            >
                Back to tenders
            </a>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3 p-md-4">
                <form class="row g-3 align-items-end" method="get" action="/app/gem-keyword-tender-report">
                    <div class="col-6 col-md-3 col-lg-2">
                        <label for="report-from" class="form-label">End date from</label>
                        <input type="date" class="form-control" id="report-from" name="from" value="<%= from %>" required />
                    </div>
                    <div class="col-6 col-md-3 col-lg-2">
                        <label for="report-to" class="form-label">End date to</label>
                        <input type="date" class="form-control" id="report-to" name="to" value="<%= to %>" required />
                    </div>
                    <div class="col-12 col-md-3 col-lg-2">
                        <button type="submit" class="btn btn-primary w-100">Apply range</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Tenders</p>
                        <p class="h4 mb-0"><%= report.totals.tenders %></p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Assigned</p>
                        <p class="h4 mb-0"><%= report.totals.assigned %></p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Unassigned</p>
                        <p class="h4 mb-0"><%= report.totals.unassigned %></p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Need to check</p>
                        <p class="h4 mb-0"><%= report.totals.need_to_check %></p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Filed</p>
                        <p class="h4 mb-0"><%= report.totals.filed %></p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Untouched assigned</p>
                        <p class="h4 mb-0"><%= report.totals.untouched_assigned %></p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="h6 mb-3">Tenders by assignee</h2>
                        <canvas id="chart-tenders-by-assignee" height="220"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="h6 mb-3">Activity by person</h2>
                        <canvas id="chart-activity-by-user" height="220"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="h6 mb-3">Eligibility mix</h2>
                        <canvas id="chart-eligibility" height="220"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="h6 mb-3">Stage mix</h2>
                        <canvas id="chart-stages" height="220"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-0">
                <div class="p-3 p-md-4 border-bottom">
                    <h2 class="h5 mb-1">Assignee working summary</h2>
                    <p class="text-secondary small mb-0">
                        Untouched = assigned, still New, eligibility still Need to check, not filed.
                        Use this to spot people who are assigned but not progressing.
                    </p>
                </div>
                <% if (!report.workingSummary || !report.workingSummary.length) { %>
                    <div class="p-4 text-center text-secondary">No assigned tenders in this range.</div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Assignee</th>
                                    <th>Assigned</th>
                                    <th>Untouched</th>
                                    <th>Progressed</th>
                                    <th>Progress %</th>
                                    <th>Need check</th>
                                    <th>Eligible</th>
                                    <th>Filed</th>
                                    <th>WIP</th>
                                    <th>Quote req</th>
                                    <th>Activities</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% report.workingSummary.forEach(function (row) { %>
                                    <tr>
                                        <td><%= row.label %></td>
                                        <td><%= row.assigned_count %></td>
                                        <td><%= row.untouched %></td>
                                        <td><%= row.progressed %></td>
                                        <td><%= row.progress_rate %>%</td>
                                        <td><%= row.need_to_check %></td>
                                        <td><%= row.eligible %></td>
                                        <td><%= row.filed %></td>
                                        <td><%= row.stage_work_in_progress %></td>
                                        <td><%= row.stage_requested_for_quote %></td>
                                        <td><%= row.activity_count %></td>
                                        <td>
                                            <% if (row.status === "On track") { %>
                                                <span class="badge text-bg-success"><%= row.status %></span>
                                            <% } else if (row.status === "Needs attention" || row.status === "Low activity") { %>
                                                <span class="badge text-bg-warning"><%= row.status %></span>
                                            <% } else { %>
                                                <span class="badge text-bg-danger"><%= row.status %></span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="p-3 p-md-4 border-bottom">
                    <h2 class="h5 mb-0">All assignee buckets</h2>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Assignee</th>
                                <th>Assigned</th>
                                <th>Need check</th>
                                <th>Eligible</th>
                                <th>Not eligible</th>
                                <th>Filed</th>
                                <th>Hidden</th>
                                <th>New</th>
                                <th>WIP</th>
                                <th>Quote req</th>
                                <th>Waiting tech</th>
                                <th>Waiting finance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% (report.assigneeSummary || []).forEach(function (row) { %>
                                <tr>
                                    <td><%= row.label %></td>
                                    <td><%= row.assigned_count %></td>
                                    <td><%= row.need_to_check %></td>
                                    <td><%= row.eligible %></td>
                                    <td><%= row.not_eligible %></td>
                                    <td><%= row.filed %></td>
                                    <td><%= row.hidden %></td>
                                    <td><%= row.stage_new %></td>
                                    <td><%= row.stage_work_in_progress %></td>
                                    <td><%= row.stage_requested_for_quote %></td>
                                    <td><%= row.stage_waiting_for_technical %></td>
                                    <td><%= row.stage_waiting_for_financial %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<script id="gem-tender-report-data" type="application/json">
<%- JSON.stringify(report.charts || {}) %>
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>
<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/gem-keyword-tender-report.js" defer></script>
<%- include('common/footer') %>

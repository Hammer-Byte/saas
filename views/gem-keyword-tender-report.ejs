<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> /
                    <a href="/app/gem-tenders" class="text-decoration-none">GEM Tenders</a> /
                    <a href="/app/gem-keyword-tenders?from=<%= from %>&to=<%= to %>" class="text-decoration-none">Tenders</a> /
                    Report
                </p>
                <h1 class="h3 mb-1">Tenders report</h1>
                <p class="text-secondary mb-0">
                    Day-by-day stage and lock activity for
                    <strong data-readable-date="<%= from %>" data-date-format="DD/MM/YYYY"></strong>
                    to
                    <strong data-readable-date="<%= to %>" data-date-format="DD/MM/YYYY"></strong>.
                </p>
            </div>
            <a
                href="/app/gem-keyword-tenders?from=<%= from %>&to=<%= to %>"
                class="btn btn-outline-secondary"
            >
                Back to tenders
            </a>
        </div>

        <% const dailyEvents = report.dailyEvents || { series: [], dates: [], overall: { values: {}, total: 0 }, people: [] }; %>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3 p-md-4">
                <form class="row g-3 align-items-end" method="get" action="/app/gem-keyword-tender-report" id="gem-report-range-form">
                    <div class="col-6 col-md-3 col-lg-2">
                        <label for="report-from" class="form-label">From</label>
                        <input
                            type="date"
                            class="form-control"
                            id="report-from"
                            name="from"
                            value="<%= from %>"
                            required
                        />
                    </div>
                    <div class="col-6 col-md-3 col-lg-2">
                        <label for="report-to" class="form-label">To</label>
                        <input
                            type="date"
                            class="form-control"
                            id="report-to"
                            name="to"
                            value="<%= to %>"
                            required
                        />
                    </div>
                    <div class="col-12 col-md-3 col-lg-2">
                        <button type="submit" class="btn btn-primary w-100">Apply range</button>
                    </div>
                    <div class="col-12">
                        <div class="d-flex flex-wrap gap-1" id="gem-report-quick-ranges">
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-report-quick-btn" data-range="today">Today</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-report-quick-btn" data-range="this-week">This week</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-report-quick-btn" data-range="last-7-days">Last 7 days</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-report-quick-btn" data-range="last-15-days">Last 15 days</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-report-quick-btn" data-range="this-month">This month</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-report-quick-btn" data-range="last-month">Last month</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-report-quick-btn" data-range="this-quarter">This quarter</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-report-quick-btn" data-range="last-quarter">Last quarter</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                    <div>
                        <h2 class="h5 mb-1">Series</h2>
                        <p class="text-secondary small mb-0">Choose stages and lock outcomes to show on the charts.</p>
                    </div>
                    <div class="d-flex flex-wrap gap-1">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="gem-report-series-all">Select all</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="gem-report-series-stages">Stages only</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="gem-report-series-locks">Locks only</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="gem-report-series-none">Clear</button>
                    </div>
                </div>
                <div class="row g-2" id="gem-report-series-checks">
                    <% (dailyEvents.series || []).forEach(function (series) { %>
                        <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                            <div class="form-check">
                                <input
                                    class="form-check-input gem-report-series-check"
                                    type="checkbox"
                                    id="gem-report-series-<%= series.key %>"
                                    value="<%= series.key %>"
                                    data-kind="<%= series.kind %>"
                                    checked
                                />
                                <label class="form-check-label small" for="gem-report-series-<%= series.key %>">
                                    <span
                                        class="gem-report-series-swatch"
                                        style="background: <%= series.color %>;"
                                    ></span>
                                    <%= series.label %>
                                </label>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3 p-md-4">
                <h2 class="h5 mb-1">Overall — by day</h2>
                <p class="text-secondary small mb-3">
                    Stacked counts of stage entries and lock outcomes each day.
                    <strong>New</strong> uses tender created date; other series use activity logs.
                </p>
                <div class="gem-report-chart-box gem-report-chart-box-tall">
                    <canvas id="chart-daily-overall"></canvas>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
                    <div>
                        <h2 class="h5 mb-1">Person-wise — by day</h2>
                        <p class="text-secondary small mb-0">
                            Stage changes and locks attributed to the person who performed them.
                        </p>
                    </div>
                    <div style="min-width: 220px; max-width: 320px;">
                        <label for="gem-report-person-select" class="form-label small mb-1">Person</label>
                        <select class="form-select form-select-sm" id="gem-report-person-select">
                            <% if (!(dailyEvents.people || []).length) { %>
                                <option value="">No person activity</option>
                            <% } else { %>
                                <% dailyEvents.people.forEach(function (person, index) { %>
                                    <option value="<%= person.key %>" <%= index === 0 ? "selected" : "" %>>
                                        <%= person.label %> (<%= person.total %>)
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                </div>
                <div class="gem-report-chart-box gem-report-chart-box-tall">
                    <canvas id="chart-daily-person"></canvas>
                </div>
            </div>
        </div>

        <div class="mb-2">
            <h2 class="h6 text-secondary mb-0">
                Snapshot by tender end date
                (<span data-readable-date="<%= from %>" data-date-format="DD/MM/YYYY"></span>
                –
                <span data-readable-date="<%= to %>" data-date-format="DD/MM/YYYY"></span>)
            </h2>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Total tenders</p>
                        <p class="h4 mb-0"><%= report.totals.tenders %></p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">With assignee</p>
                        <p class="h4 mb-0"><%= report.totals.assigned %></p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Unassigned</p>
                        <p class="h4 mb-0"><%= report.totals.unassigned %></p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Untouched assigned</p>
                        <p class="h4 mb-0"><%= report.totals.untouched_assigned %></p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Locked</p>
                        <p class="h4 mb-0"><%= report.totals.locked || 0 %></p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="h6 mb-3">Tenders by assignee</h2>
                        <div class="gem-report-chart-box">
                            <canvas id="chart-tenders-by-assignee"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="h6 mb-3">Activity by person</h2>
                        <div class="gem-report-chart-box">
                            <canvas id="chart-activity-by-user"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="h6 mb-3">Lock reasons</h2>
                        <div class="gem-report-chart-box gem-report-chart-box-doughnut">
                            <canvas id="chart-lock-reasons"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="h6 mb-3">Stage mix</h2>
                        <div class="gem-report-chart-box gem-report-chart-box-doughnut">
                            <canvas id="chart-stages"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<style>
    .gem-report-chart-box {
        position: relative;
        width: 100%;
        height: 260px;
        max-height: 260px;
        overflow: hidden;
    }

    .gem-report-chart-box-tall {
        height: 360px;
        max-height: 360px;
    }

    .gem-report-chart-box-doughnut {
        height: 240px;
        max-height: 240px;
    }

    .gem-report-chart-box canvas {
        display: block;
        width: 100% !important;
        height: 100% !important;
        max-width: 100%;
    }

    .gem-report-series-swatch {
        display: inline-block;
        width: 0.7rem;
        height: 0.7rem;
        border-radius: 0.15rem;
        margin-right: 0.35rem;
        vertical-align: -0.05rem;
    }
</style>
<script id="gem-tender-report-data" type="application/json">
<%- JSON.stringify(report.charts || {}) %>
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>
<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/gem-keyword-tender-report.js" defer></script>
<%- include('common/footer') %>

<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> /
                    <a href="/app/gem-tenders" class="text-decoration-none">GEM Tenders</a> /
                    <a href="/app/gem-keyword-tenders?from=<%= from %>&to=<%= to %>" class="text-decoration-none">Tenders</a> /
                    Report
                </p>
                <h1 class="h3 mb-1">Tenders report</h1>
                <p class="text-secondary mb-0">
                    Workload and progress for tenders ending
                    <strong data-readable-date="<%= from %>" data-date-format="DD/MM/YYYY"></strong>
                    to
                    <strong data-readable-date="<%= to %>" data-date-format="DD/MM/YYYY"></strong>.
                </p>
            </div>
            <a
                href="/app/gem-keyword-tenders?from=<%= from %>&to=<%= to %>"
                class="btn btn-outline-secondary"
            >
                Back to tenders
            </a>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3 p-md-4">
                <form class="row g-3 align-items-end" method="get" action="/app/gem-keyword-tender-report">
                    <div class="col-6 col-md-3 col-lg-2">
                        <label for="report-from" class="form-label">End date from</label>
                        <input
                            type="text"
                            class="form-control js-date-input"
                            id="report-from"
                            name="from"
                            placeholder="dd/mm/yyyy"
                            autocomplete="off"
                            inputmode="numeric"
                            data-date-value="<%= from %>"
                            value="<%= from %>"
                            required
                        />
                    </div>
                    <div class="col-6 col-md-3 col-lg-2">
                        <label for="report-to" class="form-label">End date to</label>
                        <input
                            type="text"
                            class="form-control js-date-input"
                            id="report-to"
                            name="to"
                            placeholder="dd/mm/yyyy"
                            autocomplete="off"
                            inputmode="numeric"
                            data-date-value="<%= to %>"
                            value="<%= to %>"
                            required
                        />
                    </div>
                    <div class="col-12 col-md-3 col-lg-2">
                        <button type="submit" class="btn btn-primary w-100">Apply range</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Total tenders</p>
                        <p class="h4 mb-0"><%= report.totals.tenders %></p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">With assignee</p>
                        <p class="h4 mb-0"><%= report.totals.assigned %></p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Unassigned</p>
                        <p class="h4 mb-0"><%= report.totals.unassigned %></p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-2">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Untouched assigned</p>
                        <p class="h4 mb-0"><%= report.totals.untouched_assigned %></p>
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-2">
            <h2 class="h6 text-secondary mb-0">Stage-wise tenders</h2>
        </div>
        <div class="row g-3 mb-3">
            <% (report.stageTotals || []).forEach(function (row) { %>
                <div class="col-6 col-md-4 col-xl-2">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <p class="text-secondary small mb-1"><%= row.label %></p>
                            <p class="h4 mb-0"><%= row.count %></p>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="h6 mb-3">Person-wise assigned</h2>
                        <% const personRows = report.personWiseAssigned || []; %>
                        <% if (!personRows.length) { %>
                            <p class="text-secondary small mb-0">No assigned tenders in this range.</p>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Person</th>
                                            <th class="text-end">Assigned</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% personRows.forEach(function (row) { %>
                                            <tr>
                                                <td><%= row.label %></td>
                                                <td class="text-end"><%= row.assigned_count %></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="h6 mb-3">Stage-wise counts</h2>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Stage</th>
                                        <th class="text-end">Count</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% (report.stageTotals || []).forEach(function (row) { %>
                                        <tr>
                                            <td><%= row.label %></td>
                                            <td class="text-end"><%= row.count %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="h6 mb-3">Tenders by assignee</h2>
                        <div class="gem-report-chart-box">
                            <canvas id="chart-tenders-by-assignee"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="h6 mb-3">Activity by person</h2>
                        <div class="gem-report-chart-box">
                            <canvas id="chart-activity-by-user"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="h6 mb-3">Eligibility mix</h2>
                        <div class="gem-report-chart-box gem-report-chart-box-doughnut">
                            <canvas id="chart-eligibility"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-3 p-md-4">
                        <h2 class="h6 mb-3">Stage mix</h2>
                        <div class="gem-report-chart-box gem-report-chart-box-doughnut">
                            <canvas id="chart-stages"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-0">
                <div class="p-3 p-md-4 border-bottom">
                    <h2 class="h5 mb-1">Assignee working summary</h2>
                    <p class="text-secondary small mb-0">
                        Untouched = still in Assigned stage (pending eligibility decision).
                        Use this to spot people who are assigned but not progressing.
                    </p>
                </div>
                <% if (!report.workingSummary || !report.workingSummary.length) { %>
                    <div class="p-4 text-center text-secondary">No assigned tenders in this range.</div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Assignee</th>
                                    <th>Assigned</th>
                                    <th>Untouched</th>
                                    <th>Progressed</th>
                                    <th>Progress %</th>
                                    <th>Assigned stage</th>
                                    <th>Waiting for docs</th>
                                    <th>Preparing docs</th>
                                    <th>Eligible</th>
                                    <th>Not eligible</th>
                                    <th>Filed</th>
                                    <th>Activities</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% report.workingSummary.forEach(function (row) { %>
                                    <tr>
                                        <td><%= row.label %></td>
                                        <td><%= row.assigned_count %></td>
                                        <td><%= row.untouched %></td>
                                        <td><%= row.progressed %></td>
                                        <td><%= row.progress_rate %>%</td>
                                        <td><%= row.stage_assigned %></td>
                                        <td><%= row.stage_waiting_for_docs || 0 %></td>
                                        <td><%= row.stage_preparing_docs || 0 %></td>
                                        <td><%= row.stage_eligible %></td>
                                        <td><%= row.stage_not_eligible %></td>
                                        <td><%= row.stage_filed %></td>
                                        <td><%= row.activity_count %></td>
                                        <td>
                                            <% if (row.status === "On track") { %>
                                                <span class="badge text-bg-success"><%= row.status %></span>
                                            <% } else if (row.status === "Needs attention" || row.status === "Low activity") { %>
                                                <span class="badge text-bg-warning"><%= row.status %></span>
                                            <% } else { %>
                                                <span class="badge text-bg-danger"><%= row.status %></span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="p-3 p-md-4 border-bottom">
                    <h2 class="h5 mb-0">All assignee buckets</h2>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                            <tr>
                                <th>Assignee</th>
                                <th>Count</th>
                                <th>New</th>
                                <th>Out of scope</th>
                                <th>Unattended</th>
                                <th>Assigned</th>
                                <th>Waiting for docs</th>
                                <th>Preparing docs</th>
                                <th>Eligible</th>
                                <th>Not eligible</th>
                                <th>Filed</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% (report.assigneeSummary || []).forEach(function (row) { %>
                                <tr>
                                    <td><%= row.label %></td>
                                    <td><%= row.assigned_count %></td>
                                    <td><%= row.stage_new %></td>
                                    <td><%= row.stage_out_of_scope %></td>
                                    <td><%= row.stage_unattended || 0 %></td>
                                    <td><%= row.stage_assigned %></td>
                                    <td><%= row.stage_waiting_for_docs || 0 %></td>
                                    <td><%= row.stage_preparing_docs || 0 %></td>
                                    <td><%= row.stage_eligible %></td>
                                    <td><%= row.stage_not_eligible %></td>
                                    <td><%= row.stage_filed %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<style>
    .gem-report-chart-box {
        position: relative;
        width: 100%;
        height: 260px;
        max-height: 260px;
        overflow: hidden;
    }

    .gem-report-chart-box-doughnut {
        height: 240px;
        max-height: 240px;
    }

    .gem-report-chart-box canvas {
        display: block;
        width: 100% !important;
        height: 100% !important;
        max-width: 100%;
    }
</style>
<script id="gem-tender-report-data" type="application/json">
<%- JSON.stringify(report.charts || {}) %>
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>
<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/gem-keyword-tender-report.js" defer></script>
<%- include('common/footer') %>

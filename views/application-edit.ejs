<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= typeof username !== "undefined" && username ? username : "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4">
            <p class="text-secondary small mb-1">
                <a href="/app" class="text-decoration-none">App</a> /
                <a href="/app/applications" class="text-decoration-none">Applications</a> /
                Edit
            </p>
            <h1 class="h3 mb-1">Edit <%= application.title %></h1>
            <p class="text-secondary mb-0">Update application title, token, status, and project tag.</p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div id="application-alert" class="alert d-none" role="alert"></div>

                <form id="application-edit-form" data-application-id="<%= application.id %>" novalidate>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="title" class="form-label">Title</label>
                            <input
                                type="text"
                                class="form-control"
                                id="title"
                                name="title"
                                maxlength="56"
                                value="<%= application.title %>"
                                required
                            />
                        </div>
                        <div class="col-md-6">
                            <label for="token" class="form-label">Token</label>
                            <input
                                type="text"
                                class="form-control"
                                id="token"
                                name="token"
                                maxlength="16"
                                value="<%= application.token %>"
                                required
                            />
                        </div>
                        <div class="col-md-6">
                            <label for="project_tag_id" class="form-label">Project</label>
                            <select class="form-select" id="project_tag_id" name="project_tag_id">
                                <option value="">No project</option>
                                <% (projectTags || []).forEach(function (tag) { %>
                                    <option
                                        value="<%= tag.id %>"
                                        <%= Number(application.project_tag_id) === Number(tag.id) ? "selected" : "" %>
                                    >
                                        <%= tag.title %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="active" class="form-label">Status</label>
                            <select class="form-select" id="active" name="active">
                                <option value="true" <%= application.active ? "selected" : "" %>>Active</option>
                                <option value="false" <%= !application.active ? "selected" : "" %>>Inactive</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a href="/app/applications" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

<script src="/public/app.js" defer></script>
<script src="/public/application-edit.js" defer></script>
<%- include('common/footer') %>

<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= typeof username !== "undefined" && username ? username : "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4">
            <p class="text-secondary small mb-1">
                <a href="/app" class="text-decoration-none">App</a> /
                <a href="/app/applications" class="text-decoration-none">Applications</a> /
                Invoices
            </p>
            <h1 class="h3 mb-1">Invoices for <%= application.title %></h1>
            <p class="text-secondary mb-0">Invoice management for this application.</p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5 text-center text-secondary">
                <!-- Invoice content will go here -->
            </div>
        </div>

        <div class="mt-3">
            <a href="/app/applications" class="btn btn-outline-secondary btn-sm">← Back to Applications</a>
        </div>
    </div>
</main>

<script src="/public/app.js" defer></script>
<%- include('common/footer') %>

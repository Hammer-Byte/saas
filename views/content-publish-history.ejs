<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> /
                    <a href="/app/automation" class="text-decoration-none">Automation</a> /
                    <a href="/app/content-publish" class="text-decoration-none">Content Publishing</a> /
                    <a href="/app/content-publish-image" class="text-decoration-none">Image</a> /
                    History
                </p>
                <h1 class="h3 mb-1">Image publish history</h1>
                <p class="text-secondary mb-0">Past image publish runs and per-platform results.</p>
            </div>
            <a href="/app/content-publish-start" class="btn btn-outline-primary">New publish</a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <% if (!runs || !runs.length) { %>
                    <div class="p-4 p-md-5 text-center text-secondary">No publish runs yet.</div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Status</th>
                                    <th>User</th>
                                    <th>Platforms</th>
                                    <th>Started</th>
                                    <th>Finished</th>
                                    <th>Error</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% runs.forEach(function (run) { %>
                                    <tr>
                                        <td><%= run.id %></td>
                                        <td><%= run.status %></td>
                                        <td><%= run.user_name %></td>
                                        <td>
                                            <% (run.targets || []).forEach(function (target) { %>
                                                <div class="small mb-2">
                                                    <div>
                                                        <%= target.platform %>: <%= target.status %>
                                                        <% if (target.error_message) { %>
                                                            <span class="text-danger">(<%= target.error_message %>)</span>
                                                        <% } %>
                                                    </div>
                                                    <% if (target.screenshot_file) { %>
                                                        <a
                                                            href="/api/content-publish/screenshots/<%= encodeURIComponent(target.screenshot_file) %>"
                                                            target="_blank"
                                                            rel="noopener noreferrer"
                                                            class="d-inline-block mt-1"
                                                        >
                                                            <img
                                                                src="/api/content-publish/screenshots/<%= encodeURIComponent(target.screenshot_file) %>"
                                                                alt="<%= target.platform %> failure screenshot"
                                                                class="border rounded"
                                                                style="max-width: 220px; max-height: 140px; object-fit: contain;"
                                                            >
                                                        </a>
                                                    <% } %>
                                                </div>
                                            <% }) %>
                                        </td>
                                        <td>
                                            <span data-readable-date="<%= run.started_on || '' %>" data-date-format="DD/MM/YYYY HH:mm:ss"></span>
                                        </td>
                                        <td>
                                            <span data-readable-date="<%= run.finished_on || '' %>" data-date-format="DD/MM/YYYY HH:mm:ss"></span>
                                        </td>
                                        <td class="small text-secondary"><%= run.error_message || "—" %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<%- include('common/footer') %>

<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> /
                    <a href="/app/automation" class="text-decoration-none">Automation</a> /
                    History
                </p>
                <h1 class="h3 mb-1">Publish history</h1>
                <p class="text-secondary mb-0">
                    Per-run results and screenshots. Live queue control is on
                    <a href="/app/selenium">Selenium pipeline</a>.
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a href="/app/selenium" class="btn btn-outline-secondary">Selenium</a>
                <a href="/app/content-publish-image" class="btn btn-outline-primary">Publish image</a>
                <a href="/app/content-publish-video" class="btn btn-outline-primary">Publish video</a>
            </div>
        </div>

        <form class="card border-0 shadow-sm mb-4" method="get" action="/app/content-publish-history">
            <div class="card-body p-4">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label for="start" class="form-label">Start date</label>
                        <input
                            type="text"
                            class="form-control js-date-input"
                            id="start"
                            name="start"
                            placeholder="dd/mm/yyyy"
                            autocomplete="off"
                            inputmode="numeric"
                            data-date-value="<%= start %>"
                            value="<%= start %>"
                            required
                        />
                    </div>
                    <div class="col-md-4">
                        <label for="end" class="form-label">End date</label>
                        <input
                            type="text"
                            class="form-control js-date-input"
                            id="end"
                            name="end"
                            placeholder="dd/mm/yyyy"
                            autocomplete="off"
                            inputmode="numeric"
                            data-date-value="<%= end %>"
                            value="<%= end %>"
                            required
                        />
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-outline-primary w-100">Apply range</button>
                    </div>
                </div>
                <p class="text-secondary small mb-0 mt-3">
                    Showing runs started from <strong><%= start %></strong> to <strong><%= end %></strong>
                    (default last 3 days).
                </p>
            </div>
        </form>

        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body py-3">
                        <div class="text-secondary small">Queued</div>
                        <div class="h4 mb-0"><%= (queue && queue.queued) || 0 %></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body py-3">
                        <div class="text-secondary small">Running<%= processing ? " (worker busy)" : "" %></div>
                        <div class="h4 mb-0"><%= (queue && queue.running) || 0 %></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body py-3">
                        <div class="text-secondary small">Completed</div>
                        <div class="h4 mb-0"><%= (queue && queue.completed) || 0 %></div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body py-3">
                        <div class="text-secondary small">Failed</div>
                        <div class="h4 mb-0"><%= (queue && queue.failed) || 0 %></div>
                    </div>
                </div>
            </div>
        </div>

        <% if (!runs || !runs.length) { %>
            <div class="card border-0 shadow-sm">
                <div class="p-4 p-md-5 text-center text-secondary">
                    No publish runs in this date range.
                </div>
            </div>
        <% } else { %>
            <div class="d-flex flex-column gap-3">
                <% runs.forEach(function (run) {
                    var opts = run.run_options && typeof run.run_options === "object" ? run.run_options : {};
                    var igDests = run.instagram_destinations || [];
                    var platforms = (run.targets || []).map(function (t) { return t.platform; });
                    var mediaKind = run.media_kind || "image";
                    var isVideo = mediaKind === "video";
                    var runStatus = String(run.status || "").toLowerCase();
                    var runFinished = runStatus !== "queued" && runStatus !== "running";
                    var canRetryRun = runFinished
                        && run.automation_user_id
                        && String(run.source || "") !== "application";
                    var failedPlatforms = (run.targets || [])
                        .filter(function (t) { return String(t.status || "").toLowerCase() === "failed"; })
                        .map(function (t) { return t.platform; })
                        .filter(Boolean);
                    var uniqueFailed = failedPlatforms.filter(function (platform, index) {
                        return failedPlatforms.indexOf(platform) === index;
                    });
                %>
                    <div class="card border-0 shadow-sm" data-run-id="<%= run.id %>">
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-12 col-md-3 col-lg-2">
                                    <% if (run.media_id) { %>
                                        <a
                                            href="/api/media/<%= run.media_id %>"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="d-block text-decoration-none"
                                        >
                                            <% if (isVideo) { %>
                                                <div
                                                    class="border rounded bg-dark text-white d-flex flex-column align-items-center justify-content-center"
                                                    style="min-height: 140px;"
                                                >
                                                    <div class="small text-uppercase opacity-75">Video</div>
                                                    <div class="fw-semibold">Open file</div>
                                                </div>
                                            <% } else { %>
                                                <img
                                                    src="/api/media/<%= run.media_id %>"
                                                    alt="<%= run.media_name || ('media ' + run.media_id) %>"
                                                    class="img-fluid border rounded w-100"
                                                    style="max-height: 180px; object-fit: contain; background: #f8f9fa;"
                                                >
                                            <% } %>
                                        </a>
                                        <div class="small text-secondary mt-2 text-break">
                                            <div><strong>#<%= run.media_id %></strong> <%= run.media_name || "—" %></div>
                                            <div class="text-truncate" title="<%= run.media_file || '' %>"><%= run.media_file || "" %></div>
                                        </div>
                                    <% } else { %>
                                        <div class="border rounded bg-light text-secondary small p-3">No media</div>
                                    <% } %>
                                </div>

                                <div class="col-12 col-md-9 col-lg-10">
                                    <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                                        <div>
                                            <span class="fw-semibold">Run #<%= run.id %></span>
                                            <span class="badge text-bg-secondary ms-1"><%= run.status %></span>
                                            <span class="badge text-bg-light text-dark border ms-1"><%= mediaKind %></span>
                                            <% if (platforms.length) { %>
                                                <% platforms.forEach(function (platform) { %>
                                                    <span class="badge text-bg-primary-subtle text-primary-emphasis border ms-1"><%= platform %></span>
                                                <% }) %>
                                            <% } %>
                                            <% if (opts.retried_from_run_id) { %>
                                                <span class="badge text-bg-info-subtle text-info-emphasis border ms-1">
                                                    retry of #<%= opts.retried_from_run_id %>
                                                </span>
                                            <% } %>
                                        </div>
                                        <div class="d-flex flex-column align-items-end gap-2">
                                            <div class="small text-secondary text-end">
                                                <div>
                                                    Started
                                                    <span data-readable-date="<%= run.started_on || '' %>" data-date-format="DD/MM/YYYY HH:mm:ss"></span>
                                                </div>
                                                <div>
                                                    Finished
                                                    <span data-readable-date="<%= run.finished_on || '' %>" data-date-format="DD/MM/YYYY HH:mm:ss"></span>
                                                </div>
                                            </div>
                                            <% if (canRetryRun && uniqueFailed.length > 1) { %>
                                                <button
                                                    type="button"
                                                    class="btn btn-sm btn-outline-danger js-retry-publish"
                                                    data-run-id="<%= run.id %>"
                                                    data-platforms="<%= uniqueFailed.join(',') %>"
                                                >
                                                    Retry failed (<%= uniqueFailed.join(", ") %>)
                                                </button>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="row g-3 small">
                                        <div class="col-sm-6 col-lg-4">
                                            <div class="text-secondary">Scheduled by</div>
                                            <div><%= run.scheduled_by_name || "—" %></div>
                                            <div class="text-secondary">source: <%= run.source || "user" %></div>
                                            <% if (run.application_id) { %>
                                                <div class="text-secondary">app id: <%= run.application_id %></div>
                                            <% } %>
                                        </div>
                                        <div class="col-sm-6 col-lg-4">
                                            <div class="text-secondary">Automation account</div>
                                            <div><%= run.user_name || "—" %></div>
                                            <% if (run.automation_user_id) { %>
                                                <div class="text-secondary">user id: <%= run.automation_user_id %></div>
                                            <% } else { %>
                                                <div class="text-secondary">external credentials (per request)</div>
                                            <% } %>
                                        </div>
                                        <div class="col-sm-6 col-lg-4">
                                            <div class="text-secondary">Destinations</div>
                                            <% if (igDests.length) { %>
                                                <div>Instagram: <%= igDests.join(" + ") %></div>
                                            <% } %>
                                            <% if (run.youtube_destination) { %>
                                                <div>YouTube: <%= run.youtube_destination %></div>
                                            <% } %>
                                            <% if (!igDests.length && !run.youtube_destination) { %>
                                                <div>—</div>
                                            <% } %>
                                        </div>

                                        <% if (opts.instagram_user_id || run.instagram_caption) { %>
                                            <div class="col-sm-6 col-lg-4">
                                                <div class="text-secondary">Instagram</div>
                                                <% if (opts.instagram_user_id) { %>
                                                    <div>user id: <code><%= opts.instagram_user_id %></code></div>
                                                <% } %>
                                                <% if (igDests.length) { %>
                                                    <div>dest: <%= igDests.join(", ") %></div>
                                                <% } %>
                                                <% if (run.instagram_caption) { %>
                                                    <div class="mt-1 text-break" style="white-space: pre-wrap;"><%= run.instagram_caption %></div>
                                                <% } %>
                                            </div>
                                        <% } %>

                                        <% if (opts.youtube_channel_id || run.youtube_title || run.youtube_description) { %>
                                            <div class="col-sm-6 col-lg-4">
                                                <div class="text-secondary">YouTube</div>
                                                <% if (opts.youtube_channel_id) { %>
                                                    <div>channel: <code><%= opts.youtube_channel_id %></code></div>
                                                <% } %>
                                                <% if (run.youtube_destination) { %>
                                                    <div>dest: <%= run.youtube_destination %></div>
                                                <% } %>
                                                <% if (run.youtube_title) { %>
                                                    <div>title: <%= run.youtube_title %></div>
                                                <% } %>
                                                <% if (run.youtube_description) { %>
                                                    <div class="mt-1 text-break" style="white-space: pre-wrap;"><%= run.youtube_description %></div>
                                                <% } %>
                                            </div>
                                        <% } %>

                                        <% if (opts.linkedin_company_id || run.linkedin_caption) { %>
                                            <div class="col-sm-6 col-lg-4">
                                                <div class="text-secondary">LinkedIn</div>
                                                <% if (opts.linkedin_company_id) { %>
                                                    <div>company id: <code><%= opts.linkedin_company_id %></code></div>
                                                <% } %>
                                                <% if (run.linkedin_caption) { %>
                                                    <div class="mt-1 text-break" style="white-space: pre-wrap;"><%= run.linkedin_caption %></div>
                                                <% } %>
                                            </div>
                                        <% } %>
                                    </div>

                                    <% if (run.error_message) { %>
                                        <div class="alert alert-danger py-2 px-3 small mt-3 mb-0">
                                            <%= run.error_message %>
                                        </div>
                                    <% } %>

                                    <div class="mt-3">
                                        <div class="text-secondary small mb-2">Platform results</div>
                                        <% if (!(run.targets || []).length) { %>
                                            <div class="small text-secondary">No targets</div>
                                        <% } %>
                                        <% (run.targets || []).forEach(function (target) {
                                            var targetFailed = String(target.status || "").toLowerCase() === "failed";
                                        %>
                                            <div class="border rounded p-2 mb-2">
                                                <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
                                                    <div class="d-flex flex-wrap gap-2 align-items-baseline">
                                                        <strong class="text-capitalize"><%= target.platform %></strong>
                                                        <span class="badge text-bg-secondary"><%= target.status %></span>
                                                        <% if (target.error_message) { %>
                                                            <span class="small text-danger"><%= target.error_message %></span>
                                                        <% } %>
                                                    </div>
                                                    <% if (canRetryRun && targetFailed) { %>
                                                        <button
                                                            type="button"
                                                            class="btn btn-sm btn-outline-danger js-retry-publish"
                                                            data-run-id="<%= run.id %>"
                                                            data-platforms="<%= target.platform %>"
                                                        >
                                                            Retry
                                                        </button>
                                                    <% } %>
                                                </div>
                                                <%
                                                    var shotFiles = [];
                                                    if (target.screenshot_files) {
                                                        try {
                                                            var parsedShots = typeof target.screenshot_files === "string"
                                                                ? JSON.parse(target.screenshot_files)
                                                                : target.screenshot_files;
                                                            if (Array.isArray(parsedShots)) {
                                                                shotFiles = parsedShots.filter(Boolean);
                                                            }
                                                        } catch (e) {}
                                                    }
                                                %>
                                                <% if (shotFiles.length) { %>
                                                    <div class="d-flex flex-wrap gap-2 mt-2">
                                                        <% shotFiles.forEach(function (shotFile, shotIndex) { %>
                                                            <a
                                                                href="/api/content-publish/screenshots/<%= encodeURIComponent(shotFile) %>"
                                                                target="_blank"
                                                                rel="noopener noreferrer"
                                                                class="d-inline-block"
                                                                title="Step <%= shotIndex + 1 %>: <%= shotFile %>"
                                                            >
                                                                <img
                                                                    src="/api/content-publish/screenshots/<%= encodeURIComponent(shotFile) %>"
                                                                    alt="<%= target.platform %> step <%= shotIndex + 1 %>"
                                                                    class="border rounded"
                                                                    style="max-width: 140px; max-height: 100px; object-fit: contain;"
                                                                >
                                                                <div class="small text-secondary text-truncate" style="max-width: 140px;">
                                                                    <%= shotIndex + 1 %>. <%= String(shotFile).replace(/-\d+\.png$/, "").slice(0, 28) %>
                                                                </div>
                                                            </a>
                                                        <% }) %>
                                                    </div>
                                                <% } %>
                                            </div>
                                        <% }) %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
</main>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/content-publish-history.js" defer></script>
<%- include('common/footer') %>

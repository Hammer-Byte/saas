<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — HammerByte ERP</title>
    <link rel="stylesheet" href="/public/style.css" />
</head>

<body class="auth-page">
    <header class="header-logo auth-header">
        <a href="/">
            <img src="/public/images/hammerbyte-logo.avif" alt="hammerbyte logo" />
        </a>
    </header>

    <main class="auth-main">
        <div class="auth-card">
            <div class="auth-card-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path
                        d="M17 2H7C5.895 2 5 2.895 5 4V20C5 21.105 5.895 22 7 22H17C18.105 22 19 21.105 19 20V4C19 2.895 18.105 2 17 2ZM12 18C11.448 18 11 17.552 11 17C11 16.448 11.448 16 12 16C12.552 16 13 16.448 13 17C13 17.552 12.552 18 12 18Z"
                        fill="#5c8aa5" />
                </svg>
            </div>
            <h1 class="auth-card-title">Login to HammerByte ERP</h1>
            <p class="auth-card-subtitle">Enter your mobile number to receive a one-time password.</p>

            <form class="auth-form" id="loginForm" action="/verification" method="get">
                <label class="auth-label" for="mobile">Mobile number</label>
                <input
                    class="auth-input"
                    type="tel"
                    id="mobile"
                    name="mobile"
                    placeholder="9876543210"
                    required
                    autocomplete="tel"
                    inputmode="numeric"
                    pattern="[0-9]{10}"
                    maxlength="10"
                />
                <button class="auth-btn" type="submit">Get OTP</button>
            </form>

            <p class="auth-footer-text">
                <a href="/" class="auth-link">← Back to home</a>
            </p>
        </div>
    </main>
</body>

</html>

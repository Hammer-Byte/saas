<%- include('common/header') %>

<main class="min-vh-100 d-flex align-items-center bg-light">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-6 col-lg-4">
                <div class="text-center mb-4">
                    <a href="/">
                        <img
                            src="/public/images/hammerbyte-logo.avif"
                            alt="HammerByte"
                            class="img-fluid"
                            style="max-height: 64px;"
                        />
                    </a>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4 p-md-5">
                        <h1 class="h4 text-center mb-2">Login</h1>
                        <p class="text-secondary text-center small mb-4">
                            Sign in with your email to continue to HammerByte.
                        </p>

                        <form id="login-form" novalidate>
                            <div id="email-step">
                                <div class="mb-3">
                                    <label for="login-email" class="form-label">Email</label>
                                    <input
                                        type="email"
                                        class="form-control"
                                        id="login-email"
                                        name="email"
                                        placeholder="Enter email"
                                        autocomplete="email"
                                        required
                                    />
                                </div>
                                <button type="button" class="btn btn-primary w-100" id="get-otp-btn">
                                    Get OTP
                                </button>
                            </div>

                            <div id="otp-step" class="d-none">
                                <div class="mb-3">
                                    <label for="login-otp" class="form-label">OTP</label>
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="login-otp"
                                        name="otp"
                                        placeholder="Enter 4-digit OTP"
                                        inputmode="numeric"
                                        maxlength="4"
                                        autocomplete="one-time-code"
                                    />
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-outline-secondary w-100" id="cancel-otp-btn">
                                        Cancel
                                    </button>
                                    <button type="submit" class="btn btn-primary w-100" id="verify-otp-btn">
                                        Login
                                    </button>
                                </div>
                            </div>

                            <p id="login-status" class="small text-danger mb-0 mt-3" hidden></p>
                        </form>

                        <p class="text-center small mt-4 mb-0">
                            <a href="/" class="text-decoration-none">← Back to home</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<script src="/public/login.js" defer></script>
<%- include('common/footer') %>

<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= typeof username !== "undefined" && username ? username : "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> / Users
                </p>
                <h1 class="h3 mb-1">Users</h1>
                <p class="text-secondary mb-0">Create and manage users who can sign in with OTP.</p>
            </div>
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#user-modal"
                id="open-add-user-btn"
            >
                Add User
            </button>
        </div>

        <div id="users-alert" class="alert d-none" role="alert"></div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div id="users-empty" class="p-4 p-md-5 text-center text-secondary <%= users && users.length ? 'd-none' : '' %>">
                    No users found.
                </div>
                <div class="table-responsive <%= !users || !users.length ? 'd-none' : '' %>" id="users-table-wrap">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">Full name</th>
                                <th scope="col">Email</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="users-tbody">
                            <% (users || []).forEach(function (user) { %>
                                <tr
                                    data-id="<%= user.id %>"
                                    data-full-name="<%= user.full_name %>"
                                    data-email="<%= user.email %>"
                                >
                                    <td class="user-id"><%= user.id %></td>
                                    <td class="user-full-name"><%= user.full_name %></td>
                                    <td class="user-email"><%= user.email %></td>
                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">
                                            <button type="button" class="btn btn-sm btn-outline-secondary user-edit-btn">Edit</button>
                                            <button type="button" class="btn btn-sm btn-outline-danger user-delete-btn">Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="user-modal" tabindex="-1" aria-labelledby="user-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="user-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="user-modal-label">Add user</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="user-form-alert" class="alert d-none" role="alert"></div>
                    <input type="hidden" id="user-id" name="id" value="" />
                    <div class="mb-3">
                        <label for="user-full-name" class="form-label">Full name</label>
                        <input type="text" class="form-control" id="user-full-name" name="full_name" maxlength="128" required />
                    </div>
                    <div class="mb-0">
                        <label for="user-email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="user-email" name="email" maxlength="48" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="user-submit-btn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/users.js" defer></script>
<%- include('common/footer') %>

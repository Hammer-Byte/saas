<%- include('common/header') %>

<%
    const loginMethodLabels = USER_LOGIN_METHOD_LABELS || {};
    const loginMethods = USER_LOGIN_METHODS || {};
%>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> / Users
                </p>
                <h1 class="h3 mb-1">Users</h1>
                <p class="text-secondary mb-0">Create users and choose OTP, password, or both login methods.</p>
            </div>
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#user-modal"
                id="open-add-user-btn"
            >
                Add User
            </button>
        </div>

        <div id="users-alert" class="alert d-none" role="alert"></div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div id="users-empty" class="p-4 p-md-5 text-center text-secondary <%= users && users.length ? 'd-none' : '' %>">
                    No users found.
                </div>
                <div class="table-responsive <%= !users || !users.length ? 'd-none' : '' %>" id="users-table-wrap">
                    <table class="table table-hover align-middle mb-0" id="users-table">
                        <thead class="table-light">
                                <tr>
                                <th scope="col">ID</th>
                                <th scope="col">Full name</th>
                                <th scope="col">Professional email</th>
                                <th scope="col">Phone</th>
                                <th scope="col">Personal email</th>
                                <th
                                    scope="col"
                                    class="users-sortable"
                                    data-sort-key="hourlyRate"
                                    aria-sort="none"
                                >
                                    Rate / hr <span class="users-sort-indicator" aria-hidden="true"></span>
                                </th>
                                <th scope="col">Login method</th>
                                <th
                                    scope="col"
                                    class="users-sortable"
                                    data-sort-key="loginActive"
                                    aria-sort="descending"
                                >
                                    Login <span class="users-sort-indicator" aria-hidden="true"></span>
                                </th>
                                <th
                                    scope="col"
                                    class="users-sortable"
                                    data-sort-key="lastLogin"
                                    aria-sort="none"
                                >
                                    Last login <span class="users-sort-indicator" aria-hidden="true"></span>
                                </th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="users-tbody">
                            <% (users || []).forEach(function (user) { %>
                                <% const method = user.login_method || loginMethods.OTP || "otp"; %>
                                <% const loginActive = user.login_active !== false && user.login_active !== 0; %>
                                <tr
                                    data-id="<%= user.id %>"
                                    data-full-name="<%= user.full_name %>"
                                    data-email="<%= user.email %>"
                                    data-phone="<%= user.phone || '' %>"
                                    data-personal-email="<%= user.personal_email || '' %>"
                                    data-hourly-rate="<%= user.hourly_rate != null ? user.hourly_rate : '' %>"
                                    data-login-method="<%= method %>"
                                    data-login-active="<%= loginActive ? '1' : '0' %>"
                                    data-last-login="<%= user.last_login || '' %>"
                                >
                                    <td class="user-id"><%= user.id %></td>
                                    <td class="user-full-name"><%= user.full_name %></td>
                                    <td class="user-email"><%= user.email %></td>
                                    <td class="user-phone"><%= user.phone || "-" %></td>
                                    <td class="user-personal-email"><%= user.personal_email || "-" %></td>
                                    <td class="user-hourly-rate">
                                        <%= user.hourly_rate != null ? Number(user.hourly_rate).toFixed(2) : "—" %>
                                    </td>
                                    <td class="user-login-method"><%= loginMethodLabels[method] || method %></td>
                                    <td class="user-login-status">
                                        <% if (loginActive) { %>
                                            <span class="badge text-bg-success">Active</span>
                                        <% } else { %>
                                            <span class="badge text-bg-danger">Blocked</span>
                                        <% } %>
                                    </td>
                                    <td class="user-last-login">
                                        <% if (user.last_login) { %>
                                            <span
                                                data-readable-date="<%= user.last_login %>"
                                                data-date-format="DD/MM/YYYY HH:mm"
                                            ><%= user.last_login %></span>
                                        <% } else { %>
                                            —
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1 justify-content-end">
                                            <button
                                                type="button"
                                                class="btn btn-sm btn-outline-secondary user-edit-btn user-icon-btn"
                                                title="Edit"
                                                aria-label="Edit"
                                            >
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                    <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                                                </svg>
                                            </button>
                                            <button
                                                type="button"
                                                class="btn btn-sm btn-outline-danger user-delete-btn user-icon-btn"
                                                title="Delete"
                                                aria-label="Delete"
                                            >
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                                </svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="user-modal" tabindex="-1" aria-labelledby="user-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <form id="user-form" class="user-modal-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="user-modal-label">Add user</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="user-form-alert" class="alert d-none" role="alert"></div>
                    <input type="hidden" id="user-id" name="id" value="" />
                    <div class="mb-3">
                        <label for="user-full-name" class="form-label">Full name</label>
                        <input type="text" class="form-control" id="user-full-name" name="full_name" maxlength="128" required />
                    </div>
                    <div class="mb-3">
                        <label for="user-email" class="form-label">Professional email</label>
                        <input
                            type="email"
                            class="form-control"
                            id="user-email"
                            name="email"
                            maxlength="48"
                            placeholder="name@hammerbyte.co.in"
                            required
                        />
                        <div class="form-text">Must be an @hammerbyte.co.in address (login email).</div>
                    </div>
                    <div class="mb-3">
                        <label for="user-phone" class="form-label">Phone</label>
                        <input
                            type="text"
                            class="form-control"
                            id="user-phone"
                            name="phone"
                            maxlength="13"
                            placeholder="+919876543210"
                            required
                        />
                        <div class="form-text">Required. 10–13 digits, optional leading +.</div>
                    </div>
                    <div class="mb-3">
                        <label for="user-personal-email" class="form-label">Personal email</label>
                        <input
                            type="email"
                            class="form-control"
                            id="user-personal-email"
                            name="personal_email"
                            maxlength="128"
                            required
                        />
                        <div class="form-text">Required. Used for GEM tender eligibility reminders.</div>
                    </div>
                    <div class="mb-3">
                        <label for="user-hourly-rate" class="form-label">Rate per hour</label>
                        <input
                            type="number"
                            class="form-control"
                            id="user-hourly-rate"
                            name="hourly_rate"
                            min="0"
                            step="0.01"
                        />
                        <div class="form-text">Used to calculate task charge (hours × rate).</div>
                    </div>
                    <div class="mb-3">
                        <label for="user-login-method" class="form-label">Login method</label>
                        <select class="form-select" id="user-login-method" name="login_method" required>
                            <% Object.keys(loginMethodLabels).forEach(function (value) { %>
                                <option value="<%= value %>" <%= value === (loginMethods.OTP || 'otp') ? 'selected' : '' %>>
                                    <%= loginMethodLabels[value] %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3" id="user-password-wrap">
                        <label for="user-password" class="form-label">Password</label>
                        <div class="input-group">
                            <input
                                type="password"
                                class="form-control"
                                id="user-password"
                                name="password"
                                maxlength="128"
                                autocomplete="new-password"
                            />
                            <button
                                type="button"
                                class="btn btn-outline-secondary"
                                id="user-password-toggle-btn"
                                title="Show password"
                                aria-label="Show password"
                                aria-pressed="false"
                            >
                                <svg id="user-password-eye-open" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                                </svg>
                                <svg id="user-password-eye-closed" class="d-none" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7 7 0 0 0-2.79.588l.77.771A6 6 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755q-.247.248-.517.486z"/>
                                    <path d="M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829zm-2.943 1.288.823.823a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829"/>
                                    <path d="M3.35 5.47q-.27.24-.518.487A13 13 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7 7 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12z"/>
                                </svg>
                            </button>
                        </div>
                        <div class="form-text" id="user-password-help">
                            Required for password or OTP-or-password login. Leave blank on edit to keep the current password.
                        </div>
                    </div>
                    <div class="mb-3 d-none" id="user-login-active-wrap">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="user-login-active" name="login_active" checked />
                            <label class="form-check-label" for="user-login-active">Allow login</label>
                        </div>
                        <div class="form-text">When unchecked, the user is signed out and cannot log in.</div>
                    </div>
                    <% if ((authorities || []).includes(AUTHORITIES.MANAGE_USER_ROLES)) { %>
                    <div id="user-roles-section" class="d-none">
                        <label class="form-label">Roles</label>
                        <div id="user-roles-list" class="d-flex flex-column gap-2 border rounded p-3 bg-light">
                            <% (allRoles || []).forEach(function (role) { %>
                                <div class="form-check">
                                    <input
                                        type="checkbox"
                                        class="form-check-input user-role-checkbox"
                                        id="user-role-<%= role.id %>"
                                        data-role-id="<%= role.id %>"
                                        value="<%= role.id %>"
                                    />
                                    <label class="form-check-label" for="user-role-<%= role.id %>">
                                        <%= role.title %><% if (!role.active) { %> <span class="text-secondary">(inactive)</span><% } %>
                                    </label>
                                </div>
                            <% }) %>
                            <% if (!allRoles || !allRoles.length) { %>
                                <p class="text-secondary small mb-0">No roles available.</p>
                            <% } %>
                        </div>
                    </div>
                    <% } %>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="user-submit-btn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .user-icon-btn {
        width: 2rem;
        height: 2rem;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    /* Form sits between modal-content and header/body/footer; keep Bootstrap scroll layout working. */
    #user-modal .modal-dialog-scrollable .modal-content > .user-modal-form {
        display: flex;
        flex-direction: column;
        max-height: inherit;
        overflow: hidden;
    }

    #user-modal .modal-dialog-scrollable .modal-body {
        overflow-y: auto;
    }

    #users-table thead th.users-sortable {
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
    }

    #users-table thead th.users-sortable:hover,
    #users-table thead th.users-sortable:focus-visible {
        color: #0d6efd;
    }

    .users-sort-indicator::before {
        content: "↕";
        margin-left: 0.25rem;
        opacity: 0.45;
        font-size: 0.75em;
    }

    th.users-sortable[aria-sort="ascending"] .users-sort-indicator::before {
        content: "↑";
        opacity: 1;
    }

    th.users-sortable[aria-sort="descending"] .users-sort-indicator::before {
        content: "↓";
        opacity: 1;
    }
</style>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/users.js" defer></script>
<%- include('common/footer') %>

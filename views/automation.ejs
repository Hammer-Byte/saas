<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4">
            <p class="text-secondary small mb-1">
                <a href="/app" class="text-decoration-none">App</a> / Automation
            </p>
            <h1 class="h3 mb-1">Automation</h1>
            <p class="text-secondary mb-0">Manage shared accounts, LinkedIn ops, and content publishing.</p>
        </div>

        <div class="row g-4">
            <div class="col-12 col-sm-6 col-lg-3">
                <a href="/app/automation-users" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 app-section-card">
                        <div class="card-body p-4">
                            <div class="app-section-icon mb-3">U</div>
                            <h2 class="h5 text-dark mb-2">Users</h2>
                            <p class="text-secondary small mb-0">Global automation accounts and platform cookies.</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <a href="/app/linkedin" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 app-section-card">
                        <div class="card-body p-4">
                            <div class="app-section-icon mb-3">L</div>
                            <h2 class="h5 text-dark mb-2">LinkedIn</h2>
                            <p class="text-secondary small mb-0">GrowNetwork, SearchNetwork, MessageNetwork, and templates.</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <a href="/app/content-publish" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 app-section-card">
                        <div class="card-body p-4">
                            <div class="app-section-icon mb-3">P</div>
                            <h2 class="h5 text-dark mb-2">Content Publishing</h2>
                            <p class="text-secondary small mb-0">Image publish now; video / Shorts flow next.</p>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</main>

<style>
    .app-section-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .app-section-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1) !important;
    }
    .app-section-icon {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 0.5rem;
        background: #e9ecef;
        color: #212529;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }
</style>

<script src="/public/app.js" defer></script>
<%- include('common/footer') %>

<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= typeof username !== "undefined" && username ? username : "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> /
                    <a href="/app/applications" class="text-decoration-none">Applications</a> /
                    Services
                </p>
                <h1 class="h3 mb-1">Services for <%= application.title %></h1>
                <p class="text-secondary mb-0">
                    Services linked to this application via APPLICATION_SERVICES.
                </p>
            </div>
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#add-service-modal"
                <%= !availableServices || availableServices.length === 0 ? "disabled" : "" %>
            >
                Add Service
            </button>
        </div>

        <div id="application-services-alert" class="alert d-none" role="alert"></div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <% if (!services || services.length === 0) { %>
                    <div class="p-4 p-md-5 text-center text-secondary">
                        No services are associated with this application.
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">ID</th>
                                    <th scope="col">Service ID</th>
                                    <th scope="col">Title</th>
                                    <th scope="col">Description</th>
                                    <th scope="col">Active</th>
                                    <th scope="col">Created On</th>
                                    <th scope="col">Updated At</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% services.forEach(function (service) { %>
                                    <tr>
                                        <td><%= service.id %></td>
                                        <td><%= service.service_id %></td>
                                        <td><%= service.title %></td>
                                        <td><%= service.description %></td>
                                        <td>
                                            <div class="form-check form-switch mb-0">
                                                <input
                                                    class="form-check-input application-service-active"
                                                    type="checkbox"
                                                    role="switch"
                                                    data-application-id="<%= application.id %>"
                                                    data-application-service-id="<%= service.id %>"
                                                    <%= service.active ? "checked" : "" %>
                                                    aria-label="Toggle <%= service.title %> active"
                                                />
                                            </div>
                                        </td>
                                        <td><%= service.created_on ? new Date(service.created_on).toLocaleString() : "-" %></td>
                                        <td><%= service.updated_at ? new Date(service.updated_at).toLocaleString() : "-" %></td>
                                        <td>
                                            <a
                                                href="/app/applications/<%= application.id %>/application-services/<%= service.id %>"
                                                class="btn btn-sm btn-outline-primary"
                                            >
                                                Check Usage
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="mt-3">
            <a href="/app/applications" class="btn btn-outline-secondary btn-sm">← Back to Applications</a>
        </div>
    </div>
</main>

<div class="modal fade" id="add-service-modal" tabindex="-1" aria-labelledby="add-service-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="add-service-form" data-application-id="<%= application.id %>" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="add-service-modal-label">Add service</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="add-service-alert" class="alert d-none" role="alert"></div>
                    <div class="mb-3">
                        <label for="service_id" class="form-label">Service</label>
                        <select class="form-select" id="service_id" name="service_id" required>
                            <option value="">Select a service</option>
                            <% (availableServices || []).forEach(function (service) { %>
                                <option value="<%= service.id %>"><%= service.title %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-0">
                        <label for="service_configs" class="form-label">Service configs</label>
                        <textarea
                            class="form-control"
                            id="service_configs"
                            name="service_configs"
                            rows="3"
                            placeholder="Optional free text (not saved yet)"
                        ></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/application-services.js" defer></script>
<%- include('common/footer') %>

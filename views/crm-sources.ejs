<%- include('common/header') %>

<%- include('common/app-navbar') %>

<main class="hb-main">
    <div class="container hb-page">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> /
                    <a href="/app/crm" class="text-decoration-none">CRM</a> /
                    Sources
                </p>
                <h1 class="h3 mb-1">Sources</h1>
                <p class="text-secondary mb-0">Sources available when adding leads.</p>
            </div>
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#source-modal"
                id="open-add-source-btn"
            >
                Add source
            </button>
        </div>

        <div id="sources-alert" class="alert d-none" role="alert"></div>

        <%- include('common/table-filters', { searchId: "sources-search", searchPlaceholder: "Search sources…" }) %>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div id="sources-empty" class="p-4 p-md-5 text-center text-secondary <%= sources && sources.length ? 'd-none' : '' %>">
                    No sources found.
                </div>
                <div class="table-responsive <%= !sources || !sources.length ? 'd-none' : '' %>" id="sources-table-wrap">
                    <table class="table table-hover align-middle mb-0" id="sources-table">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="hb-sortable" data-sort-key="id">ID</th>
                                <th scope="col" class="hb-sortable" data-sort-key="title">Title</th>
                                <th scope="col" class="hb-sortable" data-sort-key="created">Created On</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="sources-tbody">
                            <% (sources || []).forEach(function (source) { %>
                                <tr
                                    data-id="<%= source.id %>"
                                    data-title="<%= source.title %>"
                                    data-created="<%= source.created_on || '' %>"
                                >
                                    <td><%= source.id %></td>
                                    <td><%= source.title %></td>
                                    <td>
                                        <% if (source.created_on) { %>
                                            <span
                                                data-readable-date="<%= source.created_on %>"
                                                data-date-format="DD/MM/YYYY HH:mm"
                                            ><%= source.created_on %></span>
                                        <% } else { %>
                                            —
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1 justify-content-end flex-wrap hb-icon-actions">
                                            <button type="button" class="btn btn-sm btn-outline-secondary hb-icon-btn source-edit-btn" title="Edit" aria-label="Edit"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/></svg></button>
                                            <button type="button" class="btn btn-sm btn-outline-danger hb-icon-btn source-delete-btn" title="Delete" aria-label="Delete"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/></svg></button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="source-modal" tabindex="-1" aria-labelledby="source-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="source-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="source-modal-label">Add source</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="source-form-alert" class="alert d-none" role="alert"></div>
                    <input type="hidden" id="source-id" name="id" value="" />
                    <div class="mb-0">
                        <label for="source-title" class="form-label">Title</label>
                        <input type="text" class="form-control" id="source-title" name="title" maxlength="128" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="source-submit-btn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/crm-sources.js" defer></script>
<%- include('common/footer') %>

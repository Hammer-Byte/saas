<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> / Expenses
                </p>
                <h1 class="h3 mb-1">Expenses</h1>
                <p class="text-secondary mb-0">Track expenses within a date range.</p>
            </div>
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#expense-modal"
                id="open-add-expense-btn"
            >
                Add Expense
            </button>
        </div>

        <div id="expenses-alert" class="alert d-none" role="alert"></div>

        <form class="card border-0 shadow-sm mb-4" method="get" action="/app/expenses">
            <div class="card-body p-4">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label for="start" class="form-label">Start date</label>
                        <input type="date" class="form-control" id="start" name="start" value="<%= start %>" required />
                    </div>
                    <div class="col-md-4">
                        <label for="end" class="form-label">End date</label>
                        <input type="date" class="form-control" id="end" name="end" value="<%= end %>" required />
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-outline-primary w-100">Apply range</button>
                    </div>
                </div>
            </div>
        </form>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Total amount</p>
                        <p class="h4 mb-0" id="expenses-total"><%= Number(totalAmount || 0).toFixed(2) %></p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Items</p>
                        <p class="h4 mb-0" id="expenses-count"><%= itemCount %></p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <label for="expenses-search" class="form-label">Search</label>
                        <input
                            type="search"
                            class="form-control"
                            id="expenses-search"
                            placeholder="Filter by title or description"
                        />
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div id="expenses-empty" class="p-4 p-md-5 text-center text-secondary <%= expenses && expenses.length ? 'd-none' : '' %>">
                    No expenses found for this date range.
                </div>
                <div class="table-responsive <%= !expenses || !expenses.length ? 'd-none' : '' %>" id="expenses-table-wrap">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Date</th>
                                <th scope="col">Title</th>
                                <th scope="col">Description</th>
                                <th scope="col">Amount</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="expenses-tbody">
                            <% (expenses || []).forEach(function (expense) { %>
                                <tr
                                    data-id="<%= expense.id %>"
                                    data-title="<%= expense.title %>"
                                    data-description="<%= expense.description || '' %>"
                                    data-amount="<%= expense.amount %>"
                                    data-expense-date="<%= expense.expense_date.slice(0, 10) %>"
                                >
                                    <td class="expense-date">
                                        <%= expense.expense_date.slice(0, 10) %>
                                    </td>
                                    <td class="expense-title"><%= expense.title %></td>
                                    <td class="expense-description"><%= expense.description || "-" %></td>
                                    <td class="expense-amount"><%= Number(expense.amount).toFixed(2) %></td>
                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">
                                            <button type="button" class="btn btn-sm btn-outline-secondary expense-edit-btn">Edit</button>
                                            <button type="button" class="btn btn-sm btn-outline-danger expense-delete-btn">Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="expense-modal" tabindex="-1" aria-labelledby="expense-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="expense-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="expense-modal-label">Add expense</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="expense-form-alert" class="alert d-none" role="alert"></div>
                    <input type="hidden" id="expense-id" name="id" value="" />
                    <div class="mb-3">
                        <label for="expense-title" class="form-label">Title</label>
                        <input type="text" class="form-control" id="expense-title" name="title" maxlength="128" required />
                    </div>
                    <div class="mb-3">
                        <label for="expense-description" class="form-label">Description</label>
                        <textarea class="form-control" id="expense-description" name="description" rows="3" maxlength="512"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="expense-amount" class="form-label">Amount</label>
                        <input type="number" class="form-control" id="expense-amount" name="amount" min="0" step="0.01" required />
                    </div>
                    <div class="mb-0">
                        <label for="expense-date" class="form-label">Date</label>
                        <input type="date" class="form-control" id="expense-date" name="expense_date" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="expense-submit-btn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/expenses.js" defer></script>
<%- include('common/footer') %>

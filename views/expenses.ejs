<%- include('common/header') %>

<%- include('common/app-navbar') %>

<main class="hb-main">
    <div class="container hb-page">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> / Expenses
                </p>
                <h1 class="h3 mb-1">Expenses</h1>
                <p class="text-secondary mb-0">Track expenses within a date range.</p>
            </div>
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#expense-modal"
                id="open-add-expense-btn"
            >
                Add expense
            </button>
        </div>

        <div id="expenses-alert" class="alert d-none" role="alert"></div>

        <form class="card border-0 shadow-sm mb-4" method="get" action="/app/expenses">
            <div class="card-body p-4">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label for="start" class="form-label">Start date</label>
                        <input
                            type="text"
                            class="form-control js-date-input"
                            id="start"
                            name="start"
                            placeholder="dd/mm/yyyy"
                            autocomplete="off"
                            inputmode="numeric"
                            data-date-value="<%= start %>"
                            value="<%= start %>"
                            required
                        />
                    </div>
                    <div class="col-md-4">
                        <label for="end" class="form-label">End date</label>
                        <input
                            type="text"
                            class="form-control js-date-input"
                            id="end"
                            name="end"
                            placeholder="dd/mm/yyyy"
                            autocomplete="off"
                            inputmode="numeric"
                            data-date-value="<%= end %>"
                            value="<%= end %>"
                            required
                        />
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-outline-primary w-100">Apply range</button>
                    </div>
                </div>
            </div>
        </form>

        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Non-loaned</p>
                        <p class="h4 mb-0" id="expenses-non-loaned-total"><%= Number(nonLoanedAmount || 0).toFixed(2) %></p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Loaned</p>
                        <p class="h4 mb-0" id="expenses-loaned-total"><%= Number(loanedAmount || 0).toFixed(2) %></p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Items</p>
                        <p class="h4 mb-0" id="expenses-count"><%= itemCount %></p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <label for="expenses-search" class="form-label">Search</label>
                        <input
                            type="search"
                            class="form-control"
                            id="expenses-search"
                            placeholder="Filter by title or description"
                        />
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div id="expenses-empty" class="p-4 p-md-5 text-center text-secondary <%= expenses && expenses.length ? 'd-none' : '' %>">
                    No expenses found for this date range.
                </div>
                <div class="table-responsive <%= !expenses || !expenses.length ? 'd-none' : '' %>" id="expenses-table-wrap">
                    <table class="table table-hover align-middle mb-0" id="expenses-table">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="hb-sortable" data-sort-key="expenseDate">Date</th>
                                <th scope="col" class="hb-sortable" data-sort-key="title">Title</th>
                                <th scope="col" class="hb-sortable" data-sort-key="description">Description</th>
                                <th scope="col" class="hb-sortable" data-sort-key="amount">Amount</th>
                                <th scope="col" class="hb-sortable" data-sort-key="loaned">Loaned</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="expenses-tbody">
                            <% (expenses || []).forEach(function (expense) { %>
                                <tr
                                    class="hb-row-link"
                                    data-href="/app/expenses/<%= expense.id %>"
                                    data-id="<%= expense.id %>"
                                    data-title="<%= expense.title %>"
                                    data-description="<%= expense.description || '' %>"
                                    data-amount="<%= expense.amount %>"
                                    data-expense-date="<%= expense.expense_date %>"
                                    data-loaned="<%= expense.loaned ? 'true' : 'false' %>"
                                >
                                    <td class="expense-date" data-readable-date="<%= expense.expense_date %>" data-date-format="DD/MM/YYYY"></td>
                                    <td class="expense-title"><%= expense.title %></td>
                                    <td class="expense-description"><%= expense.description || "-" %></td>
                                    <td class="expense-amount"><%= Number(expense.amount).toFixed(2) %></td>
                                    <td class="expense-loaned"><%= expense.loaned ? "Yes" : "No" %></td>
                                    <td>
<div class="d-inline-flex gap-1 justify-content-end hb-icon-actions">
                                            <button type="button" class="btn btn-sm btn-outline-secondary hb-icon-btn expense-edit-btn" title="Edit" aria-label="Edit"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/></svg></button>
                                            <button type="button" class="btn btn-sm btn-outline-danger hb-icon-btn expense-delete-btn" title="Delete" aria-label="Delete" ><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/></svg></button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="expense-modal" tabindex="-1" aria-labelledby="expense-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="expense-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="expense-modal-label">Add expense</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="expense-form-alert" class="alert d-none" role="alert"></div>
                    <input type="hidden" id="expense-id" name="id" value="" />
                    <div class="mb-3">
                        <label for="expense-title" class="form-label">Title</label>
                        <input type="text" class="form-control" id="expense-title" name="title" maxlength="128" required />
                    </div>
                    <div class="mb-3">
                        <label for="expense-description" class="form-label">Description</label>
                        <textarea class="form-control" id="expense-description" name="description" rows="3" maxlength="512"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="expense-amount" class="form-label">Amount</label>
                        <input type="number" class="form-control" id="expense-amount" name="amount" min="0" step="0.01" required />
                    </div>
                    <div class="mb-3">
                        <label for="expense-date" class="form-label">Date</label>
                        <input
                            type="text"
                            class="form-control js-date-input"
                            id="expense-date"
                            name="expense_date"
                            placeholder="dd/mm/yyyy"
                            autocomplete="off"
                            inputmode="numeric"
                            required
                        />
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="expense-loaned" name="loaned" />
                        <label class="form-check-label" for="expense-loaned">Loaned</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="expense-submit-btn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/expenses.js" defer></script>
<%- include('common/footer') %>

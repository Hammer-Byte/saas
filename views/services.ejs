<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> / Services
                </p>
                <h1 class="h3 mb-1">Services</h1>
                <p class="text-secondary mb-0">Manage platform services and their cost.</p>
            </div>
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#service-modal"
                id="open-add-service-btn"
            >
                Add Service
            </button>
        </div>

        <div id="services-alert" class="alert d-none" role="alert"></div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div id="services-empty" class="p-4 p-md-5 text-center text-secondary <%= services && services.length ? 'd-none' : '' %>">
                    No services found.
                </div>
                <div class="table-responsive <%= !services || !services.length ? 'd-none' : '' %>" id="services-table-wrap">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">Title</th>
                                <th scope="col">Description</th>
                                <th scope="col">Cost</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="services-tbody">
                            <% (services || []).forEach(function (service) { %>
                                <tr
                                    data-id="<%= service.id %>"
                                    data-title="<%= service.title %>"
                                    data-description="<%= service.description %>"
                                    data-cost="<%= service.cost %>"
                                >
                                    <td class="service-id"><%= service.id %></td>
                                    <td class="service-title"><%= service.title %></td>
                                    <td class="service-description"><%= service.description %></td>
                                    <td class="service-cost"><%= Number(service.cost || 0).toFixed(2) %></td>
                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">
                                            <button type="button" class="btn btn-sm btn-outline-secondary service-edit-btn">Edit</button>
                                            <button type="button" class="btn btn-sm btn-outline-danger service-delete-btn">Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="service-modal" tabindex="-1" aria-labelledby="service-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="service-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="service-modal-label">Add service</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="service-form-alert" class="alert d-none" role="alert"></div>
                    <input type="hidden" id="service-id" name="id" value="" />
                    <div class="mb-3">
                        <label for="service-title" class="form-label">Title</label>
                        <input type="text" class="form-control" id="service-title" name="title" maxlength="56" required />
                    </div>
                    <div class="mb-3">
                        <label for="service-description" class="form-label">Description</label>
                        <input type="text" class="form-control" id="service-description" name="description" maxlength="128" required />
                    </div>
                    <div class="mb-0">
                        <label for="service-cost" class="form-label">Cost</label>
                        <input type="number" class="form-control" id="service-cost" name="cost" min="0" step="0.01" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="service-submit-btn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/services.js" defer></script>
<%- include('common/footer') %>

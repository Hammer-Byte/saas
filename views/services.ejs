<%- include('common/header') %>

<%- include('common/app-navbar') %>

<main class="hb-main">
    <div class="container hb-page">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> / Services
                </p>
                <h1 class="h3 mb-1">Services</h1>
                <p class="text-secondary mb-0">Manage platform services and their cost.</p>
            </div>
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#service-modal"
                id="open-add-service-btn"
            >
                Add service
            </button>
        </div>

        <div id="services-alert" class="alert d-none" role="alert"></div>

        <%- include('common/table-filters', {
            searchId: "services-search",
            searchPlaceholder: "Search services…",
        }) %>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div id="services-empty" class="p-4 p-md-5 text-center text-secondary <%= services && services.length ? 'd-none' : '' %>">
                    No services found.
                </div>
                <div class="table-responsive <%= !services || !services.length ? 'd-none' : '' %>" id="services-table-wrap">
                    <table class="table table-hover align-middle mb-0" id="services-table">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="hb-sortable" data-sort-key="id">ID</th>
                                <th scope="col" class="hb-sortable" data-sort-key="title">Title</th>
                                <th scope="col" class="hb-sortable" data-sort-key="description">Description</th>
                                <th scope="col" class="hb-sortable" data-sort-key="cost">Cost</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="services-tbody">
                            <% (services || []).forEach(function (service) { %>
                                <tr
                                    class="hb-row-link"
                                    data-href="/app/services/<%= service.id %>"
                                    data-id="<%= service.id %>"
                                    data-title="<%= service.title %>"
                                    data-description="<%= service.description %>"
                                    data-cost="<%= service.cost %>"
                                >
                                    <td class="service-id"><%= service.id %></td>
                                    <td class="service-title"><%= service.title %></td>
                                    <td class="service-description"><%= service.description %></td>
                                    <td class="service-cost"><%= Number(service.cost || 0).toFixed(4) %></td>
                                    <td>
<div class="d-inline-flex gap-1 justify-content-end hb-icon-actions">
                                            <button
                                                type="button"
                                                class="btn btn-sm btn-outline-secondary hb-icon-btn service-edit-btn"
                                                title="Edit"
                                                aria-label="Edit"
                                                
                                            >
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                    <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                                                </svg>
                                            </button>
                                            <button
                                                type="button"
                                                class="btn btn-sm btn-outline-danger hb-icon-btn service-delete-btn"
                                                title="Delete"
                                                aria-label="Delete"
                                                
                                            >
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                                </svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="service-modal" tabindex="-1" aria-labelledby="service-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="service-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="service-modal-label">Add service</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="service-form-alert" class="alert d-none" role="alert"></div>
                    <input type="hidden" id="service-id" name="id" value="" />
                    <div class="mb-3">
                        <label for="service-title" class="form-label">Title</label>
                        <input type="text" class="form-control" id="service-title" name="title" maxlength="56" required />
                    </div>
                    <div class="mb-3">
                        <label for="service-description" class="form-label">Description</label>
                        <input type="text" class="form-control" id="service-description" name="description" maxlength="128" required />
                    </div>
                    <div class="mb-0">
                        <label for="service-cost" class="form-label">Cost</label>
                        <input type="number" class="form-control" id="service-cost" name="cost" min="0" step="0.0001" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="service-submit-btn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/services.js" defer></script>
<%- include('common/footer') %>

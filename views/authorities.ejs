<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> / Authorities
                </p>
                <h1 class="h3 mb-1">Authorities</h1>
                <p class="text-secondary mb-0">Manage the authority catalog used for UI access.</p>
            </div>
            <% if ((authorities || []).includes(AUTHORITIES.MANAGE_AUTHORITIES)) { %>
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#authority-modal"
                id="open-add-authority-btn"
            >
                Add Authority
            </button>
            <% } %>
        </div>

        <div id="authorities-alert" class="alert d-none" role="alert"></div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div id="authorities-empty" class="p-4 p-md-5 text-center text-secondary <%= allAuthorities && allAuthorities.length ? 'd-none' : '' %>">
                    No authorities found.
                </div>
                <div class="table-responsive <%= !allAuthorities || !allAuthorities.length ? 'd-none' : '' %>" id="authorities-table-wrap">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">Title</th>
                                <th scope="col">Description</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="authorities-tbody">
                            <% (allAuthorities || []).forEach(function (authority) { %>
                                <tr data-id="<%= authority.id %>">
                                    <td><%= authority.id %></td>
                                    <td><%= authority.title %></td>
                                    <td><%= authority.description %></td>
                                    <td>
                                        <% if ((authorities || []).includes(AUTHORITIES.MANAGE_AUTHORITIES)) { %>
                                        <button type="button" class="btn btn-sm btn-outline-danger authority-delete-btn">
                                            Delete
                                        </button>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="authority-modal" tabindex="-1" aria-labelledby="authority-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="authority-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="authority-modal-label">Add authority</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="authority-form-alert" class="alert d-none" role="alert"></div>
                    <div class="mb-3">
                        <label for="authority-title" class="form-label">Title</label>
                        <input type="text" class="form-control text-uppercase" id="authority-title" name="title" maxlength="72" required />
                    </div>
                    <div class="mb-0">
                        <label for="authority-description" class="form-label">Description</label>
                        <input type="text" class="form-control" id="authority-description" name="description" maxlength="128" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="authority-submit-btn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/manage-authorities.js" defer></script>
<%- include('common/footer') %>

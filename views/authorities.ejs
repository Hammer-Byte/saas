<%- include('common/header') %>

<%- include('common/app-navbar') %>

<main class="hb-main">
    <div class="container hb-page">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> / Authorities
                </p>
                <h1 class="h3 mb-1">Authorities</h1>
                <p class="text-secondary mb-0">Manage the authority catalog used for UI access.</p>
            </div>
            <% if ((authorities || []).includes(AUTHORITIES.MANAGE_AUTHORITIES)) { %>
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#authority-modal"
                id="open-add-authority-btn"
            >
                Add authority
            </button>
            <% } %>
        </div>

        <div id="authorities-alert" class="alert d-none" role="alert"></div>

        <%- include('common/table-filters', { searchId: "authorities-search", searchPlaceholder: "Search authorities…" }) %>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div id="authorities-empty" class="p-4 p-md-5 text-center text-secondary <%= allAuthorities && allAuthorities.length ? 'd-none' : '' %>">
                    No authorities found.
                </div>
                <div class="table-responsive <%= !allAuthorities || !allAuthorities.length ? 'd-none' : '' %>" id="authorities-table-wrap">
                    <table class="table table-hover align-middle mb-0" id="authorities-table">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="hb-sortable" data-sort-key="id">ID</th>
                                <th scope="col" class="hb-sortable" data-sort-key="title">Title</th>
                                <th scope="col" class="hb-sortable" data-sort-key="description">Description</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="authorities-tbody">
                            <% (allAuthorities || []).forEach(function (authority) { %>
                                <tr data-id="<%= authority.id %>" data-title="<%= authority.title %>" data-description="<%= authority.description %>">
                                    <td><%= authority.id %></td>
                                    <td><%= authority.title %></td>
                                    <td><%= authority.description %></td>
                                    <td>
                                        <% if ((authorities || []).includes(AUTHORITIES.MANAGE_AUTHORITIES)) { %>
                                        <div class="d-inline-flex gap-1 justify-content-end hb-icon-actions">
                                            <button type="button" class="btn btn-sm btn-outline-danger hb-icon-btn authority-delete-btn" title="Delete" aria-label="Delete" ><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/></svg></button>
                                        </div>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="authority-modal" tabindex="-1" aria-labelledby="authority-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="authority-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="authority-modal-label">Add authority</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="authority-form-alert" class="alert d-none" role="alert"></div>
                    <div class="mb-3">
                        <label for="authority-title" class="form-label">Title</label>
                        <input type="text" class="form-control text-uppercase" id="authority-title" name="title" maxlength="72" required />
                    </div>
                    <div class="mb-0">
                        <label for="authority-description" class="form-label">Description</label>
                        <input type="text" class="form-control" id="authority-description" name="description" maxlength="128" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="authority-submit-btn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/manage-authorities.js" defer></script>
<%- include('common/footer') %>

        position: sticky;
        top: 0;
        z-index: 2;
    }
    .gem-tenders-list-card {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .gem-tenders-loading {
        flex: 1 1 auto;

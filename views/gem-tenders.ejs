<%- include('common/header') %>

<%
    const pipelineStageLabels = GEM_TENDER_STAGE_LABELS || {};
    const manualStageValues = Object.keys(pipelineStageLabels).filter(function (stage) {
        return stage !== "filed";
    });
    // List "status" = the lock reason / pipeline stage / assignment state, in that priority.
    const stageLabels = Object.assign(
        { unassigned: "Unassigned", assigned: "Assigned", eligible: "Eligible" },
        pipelineStageLabels,
        {
            ineligible: (GEM_TENDER_ELIGIBILITY_CHOICE_LABELS || {}).ineligible || "Not eligible",
            out_of_scope: (GEM_TENDER_ELIGIBILITY_CHOICE_LABELS || {}).out_of_scope || "Out of scope",
            missed: "Missed",
            unattended: "Unattended",
        },
    );
    const stageValues = Object.keys(stageLabels);
    const tenderStatus = function (tender) {
        if (Number(tender.missed)) return "missed";
        if (Number(tender.unattended)) return "unattended";
        if (Number(tender.ineligible)) return "ineligible";
        if (Number(tender.out_of_scope)) return "out_of_scope";
        if (pipelineStageLabels[tender.stage]) return tender.stage;
        if (Number(tender.eligible)) return "eligible";
        return tender.assignee_user_id ? "assigned" : "unassigned";
    };
    const mseDisplay = function (value) {
        if (value === true || value === 1 || value === "1") return "Yes";
        if (value === false || value === 0 || value === "0") return "No";
        return "-";
    };
    const canAssignOthers = (authorities || []).includes(AUTHORITIES.ASSIGN_GEM_TENDER_ASSIGNEE);
    const canBulkChangeStage = (authorities || []).includes(AUTHORITIES.MARK_GEM_TENDER_MASS_STAGE_CHANGE);
    const currentUserId = Number(userId || 0);
%>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light gem-tenders-page">
    <div class="container-fluid px-3 px-lg-4 py-3 gem-tenders-page-inner">
        <div class="gem-tenders-page-header mb-3 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> /
                    <a href="/app/gem-tenders" class="text-decoration-none">GEM Tenders</a> /
                    Tenders
                </p>
                <h1 class="h3 mb-1">Tenders</h1>
                <p class="text-secondary mb-0">
                    GEM tenders ending
                    <span
                        class="gem-tenders-range-highlight"
                        title="Selected ends-at date range"
                    >
                        <span data-readable-date="<%= from %>" data-date-format="DD/MM/YYYY"><%= from %></span>
                        –
                        <span data-readable-date="<%= to %>" data-date-format="DD/MM/YYYY"><%= to %></span>
                    </span>.
                    Filters apply as you change them; open a tender for details and actions.
                </p>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <button
                    type="button"
                    class="btn btn-outline-secondary rounded-circle gem-tenders-refresh-btn"
                    id="gem-tenders-refresh-btn"
                    title="Refresh tenders"
                    aria-label="Refresh tenders"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        fill="currentColor"
                        viewBox="0 0 16 16"
                        aria-hidden="true"
                        class="gem-tenders-refresh-icon"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M8 3a5 5 0 1 0 4.546 2.5.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"
                        />
                        <path
                            d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.975 2.14a.25.25 0 0 1 0 .384l-2.975 2.14a.25.25 0 0 1-.41-.192"
                        />
                    </svg>
                </button>
                <button
                    type="button"
                    class="btn btn-outline-secondary"
                    id="gem-tenders-columns-toggle"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#gem-tenders-columns-panel"
                    aria-controls="gem-tenders-columns-panel"
                >
                    Columns
                </button>
                <button
                    type="button"
                    class="btn btn-primary"
                    id="gem-add-tender-btn"
                    data-bs-toggle="modal"
                    data-bs-target="#gem-add-tender-modal"
                >
                    Add tenders
                </button>
                <a
                    id="gem-tenders-report-link"
                    href="/app/gem-tender-report?from=<%= from %>&to=<%= to %>"
                    class="btn btn-outline-primary"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Report
                </a>
            </div>
        </div>
        <div class="card border-0 shadow-sm mb-3 gem-tenders-filter-card" id="gem-tenders-filters" autocomplete="off">
            <div class="card-body p-2 p-md-3">
                <div class="d-flex flex-wrap align-items-end gap-2">
                    <div class="gem-filter-search">
                        <label for="gem-tenders-search" class="form-label">Find</label>
                        <div class="input-group input-group-sm">
                            <input
                                type="search"
                                class="form-control"
                                id="gem-tenders-search"
                                placeholder="Tender ID, buyer, category or assignee…"
                                autocomplete="off"
                            />
                            <button
                                type="button"
                                class="btn btn-outline-secondary gem-filter-clear-btn gem-filter-clear-x"
                                data-clear-input="gem-tenders-search"
                                title="Clear search"
                                aria-label="Clear search"
                            >×</button>
                        </div>
                    </div>
                    <div>
                        <label for="gem-tenders-from" class="form-label">Ends between</label>
                        <div class="input-group input-group-sm gem-filter-dates">
                            <input
                                type="date"
                                class="form-control"
                                id="gem-tenders-from"
                                value="<%= from %>"
                                data-page-from="<%= from %>"
                                aria-label="Ends from"
                            />
                            <span class="input-group-text">–</span>
                            <input
                                type="date"
                                class="form-control"
                                id="gem-tenders-to"
                                value="<%= to %>"
                                data-page-to="<%= to %>"
                                aria-label="Ends to"
                            />
                            <button
                                class="btn btn-outline-secondary dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                title="Quick date ranges"
                            >Range</button>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li><button type="button" class="dropdown-item gem-date-quick-btn" data-range="today">Today</button></li>
                                <li><button type="button" class="dropdown-item gem-date-quick-btn" data-range="this-week">This week</button></li>
                                <li><button type="button" class="dropdown-item gem-date-quick-btn" data-range="next-15-days">Next 15 days</button></li>
                                <li><button type="button" class="dropdown-item gem-date-quick-btn" data-range="this-month">This month</button></li>
                                <li><button type="button" class="dropdown-item gem-date-quick-btn" data-range="last-month">Last month</button></li>
                                <li><button type="button" class="dropdown-item gem-date-quick-btn" data-range="this-quarter">This quarter</button></li>
                                <li><button type="button" class="dropdown-item gem-date-quick-btn" data-range="last-quarter">Last quarter</button></li>
                            </ul>
                        </div>
                    </div>
                    <div class="gem-filter-multi-wrap">
                        <span class="form-label d-block">Status</span>
                        <div class="dropdown gem-multi-filter" id="gem-filter-stage" data-empty-label="All statuses" data-chip-label="Status">
                            <button
                                class="btn btn-outline-secondary btn-sm dropdown-toggle w-100 text-start gem-multi-filter-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="outside"
                                aria-expanded="false"
                            >
                                <span class="gem-multi-filter-label">All statuses</span>
                            </button>
                            <div class="dropdown-menu gem-multi-filter-menu p-2 shadow">
                                <% stageValues.forEach(function (stage) { %>
                                    <div class="form-check">
                                        <input
                                            class="form-check-input gem-multi-filter-option"
                                            type="checkbox"
                                            value="<%= stage %>"
                                            id="gem-filter-stage-<%= stage %>"
                                            data-label="<%= stageLabels[stage] %>"
                                        />
                                        <label class="form-check-label" for="gem-filter-stage-<%= stage %>">
                                            <%= stageLabels[stage] %>
                                        </label>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                    <div class="gem-filter-multi-wrap">
                        <span class="form-label d-block">Assignee</span>
                        <div class="dropdown gem-multi-filter" id="gem-filter-assignee" data-empty-label="All assignees" data-chip-label="Assignee">
                            <button
                                class="btn btn-outline-secondary btn-sm dropdown-toggle w-100 text-start gem-multi-filter-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="outside"
                                aria-expanded="false"
                            >
                                <span class="gem-multi-filter-label">All assignees</span>
                            </button>
                            <div class="dropdown-menu gem-multi-filter-menu p-2 shadow">
                                <div class="form-check">
                                    <input
                                        class="form-check-input gem-multi-filter-option"
                                        type="checkbox"
                                        value="unassigned"
                                        id="gem-filter-assignee-unassigned"
                                        data-label="Unassigned"
                                    />
                                    <label class="form-check-label" for="gem-filter-assignee-unassigned">
                                        Unassigned
                                    </label>
                                </div>
                                <% (users || []).forEach(function (user) { %>
                                    <div class="form-check">
                                        <input
                                            class="form-check-input gem-multi-filter-option"
                                            type="checkbox"
                                            value="<%= user.id %>"
                                            id="gem-filter-assignee-<%= user.id %>"
                                            data-label="<%= user.full_name %>"
                                        />
                                        <label class="form-check-label" for="gem-filter-assignee-<%= user.id %>">
                                            <%= user.full_name %>
                                        </label>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                    <div class="gem-filter-multi-wrap">
                        <span class="form-label d-block">Category</span>
                        <div class="dropdown gem-multi-filter" id="gem-filter-category" data-empty-label="All categories" data-chip-label="Category">
                            <button
                                class="btn btn-outline-secondary btn-sm dropdown-toggle w-100 text-start gem-multi-filter-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="outside"
                                aria-expanded="false"
                            >
                                <span class="gem-multi-filter-label">All categories</span>
                            </button>
                            <div class="dropdown-menu gem-multi-filter-menu p-2 shadow">
                                <div class="form-check">
                                    <input
                                        class="form-check-input gem-multi-filter-option"
                                        type="checkbox"
                                        value="none"
                                        id="gem-filter-category-none"
                                        data-label="No category"
                                    />
                                    <label class="form-check-label" for="gem-filter-category-none">
                                        No category
                                    </label>
                                </div>
                                <% if ((tenderCategories || []).length) { %>
                                    <hr class="dropdown-divider my-2" />
                                <% } %>
                                <% (tenderCategories || []).forEach(function (category) { %>
                                    <div class="form-check">
                                        <input
                                            class="form-check-input gem-multi-filter-option"
                                            type="checkbox"
                                            value="<%= category.id %>"
                                            id="gem-filter-category-<%= category.id %>"
                                            data-label="<%= category.name %>"
                                        />
                                        <label class="form-check-label" for="gem-filter-category-<%= category.id %>">
                                            <%= category.name %>
                                        </label>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                    <button
                        type="button"
                        class="btn btn-sm btn-outline-secondary"
                        id="gem-more-filters-btn"
                        data-bs-toggle="collapse"
                        data-bs-target="#gem-tenders-more-filters"
                        aria-expanded="false"
                        aria-controls="gem-tenders-more-filters"
                    >
                        More filters <span class="badge text-bg-primary d-none" id="gem-more-filters-count"></span>
                    </button>
                </div>

                <div class="collapse" id="gem-tenders-more-filters">
                    <div class="d-flex flex-wrap align-items-end gap-2 pt-2">
                        <div class="gem-filter-small">
                            <label for="gem-filter-past-experience" class="form-label">Past exp.</label>
                            <select
                                class="form-select form-select-sm gem-tender-column-filter"
                                id="gem-filter-past-experience"
                                data-column="pastExperience"
                                data-chip-label="Past exp."
                            >
                                <option value="">All</option>
                            </select>
                        </div>
                        <div class="gem-filter-small">
                            <label for="gem-filter-mse-exp" class="form-label">Experience relaxation</label>
                            <select
                                class="form-select form-select-sm gem-tender-column-filter"
                                id="gem-filter-mse-exp"
                                data-column="mseExp"
                                data-chip-label="Experience relaxation"
                            >
                                <option value="">All</option>
                            </select>
                        </div>
                        <div class="gem-filter-small">
                            <label for="gem-filter-mse-turnover" class="form-label">Turnover relaxation</label>
                            <select
                                class="form-select form-select-sm gem-tender-column-filter"
                                id="gem-filter-mse-turnover"
                                data-column="mseTurnover"
                                data-chip-label="Turnover relaxation"
                            >
                                <option value="">All</option>
                            </select>
                        </div>
                        <div class="gem-filter-small">
                            <label for="gem-filter-quantity-upto" class="form-label">Quantity up to</label>
                            <input
                                type="number"
                                class="form-control form-control-sm"
                                id="gem-filter-quantity-upto"
                                min="1"
                                step="1"
                                placeholder="e.g. 10"
                                inputmode="numeric"
                                autocomplete="off"
                            />
                        </div>
                        <div class="gem-filter-small">
                            <label for="gem-filter-locked" class="form-label">Locked</label>
                            <select class="form-select form-select-sm" id="gem-filter-locked">
                                <option value="">Any</option>
                                <option value="locked">Locked</option>
                                <option value="unlocked">Not locked</option>
                            </select>
                        </div>
                        <div class="form-check mb-1">
                            <input class="form-check-input" type="checkbox" id="gem-filter-include-hidden" />
                            <label class="form-check-label small" for="gem-filter-include-hidden">
                                Include hidden
                            </label>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-1 mt-2" id="gem-quick-views" role="group" aria-label="Quick views">
                    <button type="button" class="btn btn-sm gem-quick-view" data-view="all" title="Every tender matching the filters">
                        All <span class="badge gem-quick-view-count"></span>
                    </button>
                    <button type="button" class="btn btn-sm gem-quick-view" data-view="mine" title="Tenders assigned to you">
                        My tenders <span class="badge gem-quick-view-count"></span>
                    </button>
                    <button type="button" class="btn btn-sm gem-quick-view" data-view="needs_decision" title="Assigned, not locked, eligibility not decided yet">
                        Needs decision <span class="badge gem-quick-view-count"></span>
                    </button>
                    <button type="button" class="btn btn-sm gem-quick-view" data-view="in_progress" title="Eligible and not filed yet">
                        In progress <span class="badge gem-quick-view-count"></span>
                    </button>
                    <button type="button" class="btn btn-sm gem-quick-view" data-view="ending_soon" title="Ends within 24 hours and still open">
                        Ending in 24h <span class="badge gem-quick-view-count"></span>
                    </button>
                    <button type="button" class="btn btn-sm gem-quick-view" data-view="unassigned" title="Nobody is assigned">
                        Unassigned <span class="badge gem-quick-view-count"></span>
                    </button>
                    <button type="button" class="btn btn-sm gem-quick-view" data-view="filed" title="Filed tenders">
                        Filed <span class="badge gem-quick-view-count"></span>
                    </button>
                    <button type="button" class="btn btn-sm gem-quick-view" data-view="missed" title="Missed or unattended (includes hidden tenders)">
                        Missed / unattended <span class="badge gem-quick-view-count"></span>
                    </button>
                    <button type="button" class="btn btn-sm gem-quick-view" data-view="rejected" title="Not eligible or out of scope (includes hidden tenders)">
                        Not eligible / out of scope <span class="badge gem-quick-view-count"></span>
                    </button>
                </div>

                <div
                    class="alert alert-info py-1 px-2 small mt-2 mb-0 d-none"
                    id="gem-tenders-search-mode"
                    role="status"
                >
                    <span id="gem-tenders-search-mode-text"></span>
                    <button type="button" class="btn btn-sm btn-link p-0 ms-2 align-baseline" id="gem-tenders-search-back-btn">
                        Back to date range
                    </button>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-1 mt-2 small" id="gem-tenders-active-filters">
                    <span class="text-secondary me-1" id="gem-tenders-filter-status" role="status"></span>
                    <span class="d-flex flex-wrap gap-1" id="gem-tenders-filter-chips"></span>
                    <button type="button" class="btn btn-sm btn-link p-0 d-none" id="gem-tenders-search-all-btn"></button>
                    <button type="button" class="btn btn-sm btn-link p-0 ms-auto d-none" id="gem-filters-reset-btn">
                        Clear all filters
                    </button>
                </div>
            </div>
        </div>

        <div id="gem-add-tender-alert" class="alert d-none" role="alert"></div>

        <div
            id="gem-tenders-bulk-bar"
            class="card border-0 shadow-sm mb-3 d-none"
            data-current-user-id="<%= currentUserId %>"
            data-can-assign-others="<%= canAssignOthers ? '1' : '0' %>"
            data-can-bulk-change-stage="<%= canBulkChangeStage ? '1' : '0' %>"
        >
            <div class="card-body py-2 px-3">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                    <span class="small text-secondary" id="gem-tenders-selected-count">0 selected</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="gem-bulk-clear-btn">
                        Clear selection
                    </button>
                </div>

                <ul class="nav nav-tabs mb-3" id="gem-bulk-action-tabs" role="tablist">
                    <% if (canBulkChangeStage) { %>
                        <li class="nav-item" role="presentation">
                            <button
                                class="nav-link active"
                                id="gem-bulk-tab-stage"
                                data-bs-toggle="tab"
                                data-bs-target="#gem-bulk-pane-stage"
                                type="button"
                                role="tab"
                                aria-controls="gem-bulk-pane-stage"
                                aria-selected="true"
                            >
                                Change stage
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button
                                class="nav-link"
                                id="gem-bulk-tab-eligibility"
                                data-bs-toggle="tab"
                                data-bs-target="#gem-bulk-pane-eligibility"
                                type="button"
                                role="tab"
                                aria-controls="gem-bulk-pane-eligibility"
                                aria-selected="false"
                            >
                                Eligibility
                            </button>
                        </li>
                    <% } %>
                    <li class="nav-item" role="presentation">
                        <button
                            class="nav-link<%= canBulkChangeStage ? '' : ' active' %>"
                            id="gem-bulk-tab-assign"
                            data-bs-toggle="tab"
                            data-bs-target="#gem-bulk-pane-assign"
                            type="button"
                            role="tab"
                            aria-controls="gem-bulk-pane-assign"
                            aria-selected="<%= canBulkChangeStage ? 'false' : 'true' %>"
                        >
                            Assign
                        </button>
                    </li>
                </ul>

                <div class="mb-3">
                    <label for="gem-bulk-comment" class="form-label small mb-1">
                        Comment <span class="text-danger">*</span>
                    </label>
                    <textarea
                        class="form-control form-control-sm"
                        id="gem-bulk-comment"
                        rows="2"
                        placeholder="Required comment for this mass action…"
                        maxlength="2000"
                    ></textarea>
                </div>

                <div class="tab-content">
                    <% if (canBulkChangeStage) { %>
                        <div
                            class="tab-pane fade show active"
                            id="gem-bulk-pane-stage"
                            role="tabpanel"
                            aria-labelledby="gem-bulk-tab-stage"
                            tabindex="0"
                        >
                            <div class="d-flex flex-wrap align-items-end gap-2">
                                <div style="min-width: 180px; max-width: 240px;">
                                    <label for="gem-bulk-stage" class="form-label small mb-1">
                                        Stage <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select form-select-sm" id="gem-bulk-stage">
                                        <option value="">Choose stage…</option>
                                        <% manualStageValues.forEach(function (stage) { %>
                                            <option value="<%= stage %>"><%= pipelineStageLabels[stage] || stage %></option>
                                        <% }) %>
                                    </select>
                                </div>
                                <p class="form-text small mb-0 align-self-center">
                                    Only eligible tenders. Filed needs documents, so file from the tender page.
                                </p>
                                <button type="button" class="btn btn-sm btn-primary" id="gem-bulk-stage-btn" disabled>
                                    Change stage
                                </button>
                            </div>
                        </div>
                        <div
                            class="tab-pane fade"
                            id="gem-bulk-pane-eligibility"
                            role="tabpanel"
                            aria-labelledby="gem-bulk-tab-eligibility"
                            tabindex="0"
                        >
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <button
                                    type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    id="gem-bulk-out-of-scope-btn"
                                    disabled
                                >
                                    Mark out of scope
                                </button>
                                <button
                                    type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    id="gem-bulk-not-eligible-btn"
                                    disabled
                                >
                                    Mark not eligible
                                </button>
                            </div>
                        </div>
                    <% } %>
                    <div
                        class="tab-pane fade<%= canBulkChangeStage ? '' : ' show active' %>"
                        id="gem-bulk-pane-assign"
                        role="tabpanel"
                        aria-labelledby="gem-bulk-tab-assign"
                        tabindex="0"
                    >
                        <div class="d-flex flex-wrap align-items-end gap-2">
                            <div style="min-width: 220px; max-width: 320px;">
                                <label for="gem-bulk-assignee" class="form-label small mb-1">
                                    Assignee <span class="text-danger">*</span>
                                </label>
                                <select class="form-select form-select-sm" id="gem-bulk-assignee">
                                    <option value="">Choose assignee…</option>
                                    <% if (currentUserId) { %>
                                        <option value="<%= currentUserId %>">Assign to me</option>
                                    <% } %>
                                    <% if (canAssignOthers) { %>
                                        <% (users || []).forEach(function (user) { %>
                                            <% if (Number(user.id) !== currentUserId) { %>
                                                <option value="<%= user.id %>"><%= user.full_name %> (<%= user.email %>)</option>
                                            <% } %>
                                        <% }) %>
                                    <% } %>
                                </select>
                            </div>
                            <button type="button" class="btn btn-sm btn-primary" id="gem-bulk-assign-btn" disabled>
                                Assign
                            </button>
                        </div>
                    </div>
                </div>

                <span class="small text-danger d-none mt-2 d-inline-block" id="gem-bulk-status" role="status"></span>
            </div>
        </div>

        <div
            class="offcanvas offcanvas-end gem-tenders-columns-panel"
            tabindex="-1"
            id="gem-tenders-columns-panel"
            aria-labelledby="gem-tenders-columns-panel-label"
        >
            <div class="offcanvas-header border-bottom">
                <h2 class="offcanvas-title h5 mb-0" id="gem-tenders-columns-panel-label">Columns</h2>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                <p class="text-secondary small mb-3">
                    Choose which table columns to show. Selection is saved for this browser.
                </p>
                <div class="d-flex flex-wrap gap-1 mb-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="gem-columns-show-all-btn">
                        Show all
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="gem-columns-reset-btn">
                        Reset columns
                    </button>
                </div>
                <div class="d-grid gap-2" id="gem-tenders-column-checks">
                    <div class="form-check">
                        <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-tenderId" value="tenderId" checked disabled />
                        <label class="form-check-label" for="gem-col-tenderId">Tender ID</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-endAt" value="endAt" checked />
                        <label class="form-check-label" for="gem-col-endAt">Ends at</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-category" value="category" checked />
                        <label class="form-check-label" for="gem-col-category">Category</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-buyer" value="buyer" checked />
                        <label class="form-check-label" for="gem-col-buyer">Buyer</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-quantity" value="quantity" checked />
                        <label class="form-check-label" for="gem-col-quantity">Quantity</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-emd" value="emd" checked />
                        <label class="form-check-label" for="gem-col-emd">EMD</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-pastExp" value="pastExp" checked />
                        <label class="form-check-label" for="gem-col-pastExp">Past exp.</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-mseExp" value="mseExp" checked />
                        <label class="form-check-label" for="gem-col-mseExp">Experience Relaxation</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-mseTurnover" value="mseTurnover" checked />
                        <label class="form-check-label" for="gem-col-mseTurnover">Turnover Relaxation</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-stage" value="stage" checked />
                        <label class="form-check-label" for="gem-col-stage">Status</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-locked" value="locked" checked />
                        <label class="form-check-label" for="gem-col-locked">Locked</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input gem-column-toggle" type="checkbox" id="gem-col-assignee" value="assignee" checked />
                        <label class="form-check-label" for="gem-col-assignee">Assignee</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm gem-tenders-list-card position-relative">
            <div
                id="gem-tenders-loading"
                class="gem-tenders-loading <%= !tenders || !tenders.length ? 'd-none' : '' %>"
                role="status"
                aria-live="polite"
            >
                <div class="spinner-border text-primary" aria-hidden="true"></div>
                <span class="ms-2">Loading tenders…</span>
            </div>
            <div
                id="gem-tenders-empty"
                class="p-4 p-md-5 text-center text-secondary d-none"
            >
                No tenders ending in this date range.
            </div>
            <div
                id="gem-tenders-table-wrap"
                class="gem-tenders-list-scroll d-none"
                aria-busy="true"
            >
                <div class="table-responsive">
                    <table
                        class="table table-hover align-middle mb-0 small"
                        id="gem-tenders-table"
                        data-stage-labels="<%= JSON.stringify(stageLabels).replace(/"/g, '&quot;') %>"
                    >
                        <thead class="table-light">
                            <tr>
                                <th scope="col" data-col="select" style="width: 2rem;">
                                    <input
                                        type="checkbox"
                                        class="form-check-input"
                                        id="gem-tenders-select-all"
                                        aria-label="Select all visible tenders"
                                    />
                                </th>
                                <th scope="col" data-col="tenderId">Tender ID</th>
                                <th
                                    scope="col"
                                    data-col="endAt"
                                    class="gem-tenders-sortable"
                                    data-sort-key="endAt"
                                    aria-sort="none"
                                    role="columnheader"
                                    tabindex="0"
                                    title="Sort by ends at"
                                >
                                    Ends at <span class="gem-tenders-sort-indicator" aria-hidden="true"></span>
                                </th>
                                <th scope="col" data-col="category">Category</th>
                                <th scope="col" data-col="buyer" class="gem-tenders-buyer-col">Buyer</th>
                                <th
                                    scope="col"
                                    data-col="quantity"
                                    class="gem-tenders-sortable"
                                    data-sort-key="quantity"
                                    aria-sort="none"
                                    role="columnheader"
                                    tabindex="0"
                                    title="Sort by quantity"
                                >
                                    Quantity <span class="gem-tenders-sort-indicator" aria-hidden="true"></span>
                                </th>
                                <th scope="col" data-col="emd">EMD</th>
                                <th scope="col" data-col="pastExp">Past exp.</th>
                                <th scope="col" data-col="mseExp">Experience Relaxation</th>
                                <th scope="col" data-col="mseTurnover">Turnover Relaxation</th>
                                <th scope="col" data-col="stage">Status</th>
                                <th scope="col" data-col="locked" class="text-center" style="width: 4.5rem;">Locked</th>
                                <th scope="col" data-col="assignee">Assignee</th>
                            </tr>
                        </thead>
                        <tbody id="gem-tenders-tbody">
                                <% (tenders || []).forEach(function (tender) { %>
                                    <% const stage = tenderStatus(tender); %>
                                    <% const emdAmount = Number(tender.emd_amount || 0); %>
                                    <%
                                        const buyerParts = [
                                            tender.ministry,
                                            tender.department,
                                            tender.organization,
                                            tender.office,
                                        ].filter(Boolean);
                                        const buyerText = buyerParts.length ? buyerParts.join(" / ") : "-";
                                        const assigneeName = tender.assignee_full_name || "-";
                                        const stageLabel = stageLabels[stage] || stage;
                                        const isLocked = !!Number(tender.locked);
                                        const isHidden = !!Number(tender.hidden) || tender.hidden === true;
                                    %>
                                    <tr
                                        data-id="<%= tender.id %>"
                                        data-tender-category-id="<%= tender.tender_category_id != null ? tender.tender_category_id : '' %>"
                                        data-tender-category-name="<%= tender.tender_category_name || '' %>"
                                        data-locked="<%= isLocked ? '1' : '0' %>"
                                        data-hidden="<%= isHidden ? '1' : '0' %>"
                                        data-assignee-user-id="<%= tender.assignee_user_id != null ? tender.assignee_user_id : '' %>"
                                        data-stage="<%= stage %>"
                                        data-past-experience="<%= tender.required_past_experice_years || '' %>"
                                        data-mse-exp="<%= mseDisplay(tender.mse_experience_relaxation) === '-' ? '' : mseDisplay(tender.mse_experience_relaxation) %>"
                                        data-mse-turnover="<%= mseDisplay(tender.mse_turnover_relaxation) === '-' ? '' : mseDisplay(tender.mse_turnover_relaxation) %>"
                                        data-quantity="<%= Number(tender.quantity || 0) %>"
                                        data-end-at="<%= tender.end_date_time || '' %>"
                                        data-buyer="<%= buyerParts.concat(tender.buyer_name || []).join(' ') %>"
                                        data-assignee-name="<%= tender.assignee_full_name || '' %>"
                                    >
                                    <td data-col="select">
                                        <input
                                            type="checkbox"
                                            class="form-check-input gem-tender-select"
                                            value="<%= tender.id %>"
                                            aria-label="Select tender <%= tender.tender_id %>"
                                        />
                                    </td>
                                    <td data-col="tenderId">
                                        <a
                                            href="/app/gem-tenders/<%= tender.id %>"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            <%= tender.tender_id %>
                                        </a>
                                    </td>
                                    <td
                                        data-col="endAt"
                                        class="gem-tenders-ends-at"
                                        data-readable-date="<%= tender.end_date_time || '' %>"
                                        data-date-format="DD/MM/YYYY HH:mm:ss"
                                    ></td>
                                    <td data-col="category"><%= tender.tender_category_name || "-" %></td>
                                    <td data-col="buyer" class="gem-tenders-buyer-col">
                                        <span class="gem-tenders-buyer-text" title="<%= buyerText %>">
                                            <%= buyerText %>
                                        </span>
                                    </td>
                                    <td data-col="quantity"><%= Number(tender.quantity || 0) > 0 ? Number(tender.quantity) : "NA" %></td>
                                    <td data-col="emd">
                                        <%= emdAmount > 0
                                            ? emdAmount.toLocaleString("en-IN", { maximumFractionDigits: 2 })
                                            : "NA" %>
                                    </td>
                                    <td data-col="pastExp"><%= tender.required_past_experice_years || "-" %></td>
                                    <td data-col="mseExp"><%= mseDisplay(tender.mse_experience_relaxation) %></td>
                                    <td data-col="mseTurnover"><%= mseDisplay(tender.mse_turnover_relaxation) %></td>
                                    <td data-col="stage">
                                        <span class="gem-tender-tag gem-tender-stage-tag gem-tender-stage-<%= stage %>">
                                            <%= stageLabel %>
                                        </span>
                                    </td>
                                    <td data-col="locked" class="text-center">
                                        <input
                                            type="checkbox"
                                            class="form-check-input gem-tender-locked-check"
                                            <%= isLocked ? "checked" : "" %>
                                            disabled
                                            aria-label="<%= isLocked ? (tender.lock_message || 'Locked') : 'Not locked' %>"
                                            title="<%= isLocked ? (tender.lock_message || 'Locked') : 'Not locked' %>"
                                        />
                                    </td>
                                    <td data-col="assignee">
                                        <span class="gem-tender-tag gem-tender-assignee-tag<%= tender.assignee_user_id ? '' : ' gem-tender-assignee-empty' %>">
                                            <%= assigneeName %>
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<style>

    }
    .gem-tenders-refresh-btn.is-loading .gem-tenders-refresh-icon {
        animation: gem-tenders-refresh-spin 0.8s linear infinite;
    }
    @keyframes gem-tenders-refresh-spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .gem-tenders-columns-panel {
        width: min(22rem, 100vw);
    }
    .gem-filter-clear-x {
        width: 2rem;
        min-width: 2rem;
        padding-left: 0;

<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4">
            <p class="text-secondary small mb-1">
                <a href="/app" class="text-decoration-none">App</a> /
                <a href="/app/applications" class="text-decoration-none">Applications</a> /
                <%= application.title %>
            </p>
            <h1 class="h3 mb-1"><%= application.title %></h1>
            <p class="text-secondary mb-0">Application details and linked services.</p>
        </div>

        <div id="application-alert" class="alert d-none" role="alert"></div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h2 class="h5 mb-0">Application details</h2>
            </div>
            <div class="card-body p-4">
                <form id="application-edit-form" data-application-id="<%= application.id %>" novalidate>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="title" class="form-label">Title</label>
                            <input
                                type="text"
                                class="form-control"
                                id="title"
                                name="title"
                                maxlength="56"
                                value="<%= application.title %>"
                                required
                            />
                        </div>
                        <div class="col-md-6">
                            <label for="token" class="form-label">Token</label>
                            <input
                                type="text"
                                class="form-control"
                                id="token"
                                name="token"
                                maxlength="16"
                                value="<%= application.token %>"
                                required
                            />
                        </div>
                        <div class="col-md-6">
                            <label for="project_id" class="form-label">Customer project</label>
                            <select class="form-select" id="project_id" name="project_id" required>
                                <option value="">Select a project</option>
                                <% (customerProjects || []).forEach(function (project) { %>
                                    <option
                                        value="<%= project.id %>"
                                        <%= application.project_id == project.id ? "selected" : "" %>
                                    >
                                        <%= project.customer_name %> — <%= project.title %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label for="active" class="form-label">Status</label>
                            <select class="form-select" id="active" name="active">
                                <option value="true" <%= application.active ? "selected" : "" %>>Active</option>
                                <option value="false" <%= !application.active ? "selected" : "" %>>Inactive</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4 flex-wrap">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <% if (application.project_id) { %>
                            <a href="/app/projects/<%= application.project_id %>" class="btn btn-outline-secondary">Project</a>
                        <% } %>
                    </div>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center pt-4 px-4">
                <h2 class="h5 mb-0">Services</h2>
                <button
                    type="button"
                    class="btn btn-sm btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#add-service-modal"
                    <%= !availableServices || availableServices.length === 0 ? "disabled" : "" %>
                >
                    Add Service
                </button>
            </div>
            <div class="card-body p-0">
                <div id="application-services-alert" class="alert d-none mx-4 mt-3" role="alert"></div>
                <% if (!services || services.length === 0) { %>
                    <div class="p-4 text-center text-secondary">
                        No services are associated with this application.
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">ID</th>
                                    <th scope="col">Service ID</th>
                                    <th scope="col">Title</th>
                                    <th scope="col">Description</th>
                                    <th scope="col">Active</th>
                                    <th scope="col">Created On</th>
                                    <th scope="col">Updated At</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% services.forEach(function (service) { %>
                                    <tr>
                                        <td><%= service.id %></td>
                                        <td><%= service.service_id %></td>
                                        <td><%= service.title %></td>
                                        <td><%= service.description %></td>
                                        <td>
                                            <div class="form-check form-switch mb-0">
                                                <input
                                                    class="form-check-input application-service-active"
                                                    type="checkbox"
                                                    role="switch"
                                                    data-application-service-id="<%= service.id %>"
                                                    <%= service.active ? "checked" : "" %>
                                                    aria-label="Toggle <%= service.title %> active"
                                                />
                                            </div>
                                        </td>
                                        <td
                                            data-readable-date="<%= service.created_on || '' %>"
                                            data-date-format="YYYY-MM-DD HH:mm:ss"
                                        ></td>
                                        <td
                                            data-readable-date="<%= service.updated_at || '' %>"
                                            data-date-format="YYYY-MM-DD HH:mm:ss"
                                        ></td>
                                        <td>
                                            <a
                                                href="/app/application-services/<%= service.id %>"
                                                class="btn btn-sm btn-outline-primary"
                                            >
                                                Check Usage
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="add-service-modal" tabindex="-1" aria-labelledby="add-service-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="add-service-form" data-application-id="<%= application.id %>" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="add-service-modal-label">Add service</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="add-service-alert" class="alert d-none" role="alert"></div>
                    <div class="mb-0">
                        <label for="service_id" class="form-label">Service</label>
                        <select class="form-select" id="service_id" name="service_id" required>
                            <option value="">Select a service</option>
                            <% (availableServices || []).forEach(function (service) { %>
                                <option value="<%= service.id %>"><%= service.title %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/application.js" defer></script>
<%- include('common/footer') %>

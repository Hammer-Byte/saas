<%- include('common/header') %>

<%- include('common/app-navbar') %>

<main class="hb-main">
    <div class="container hb-page">
        <div class="mb-4">
            <p class="text-secondary small mb-1">
                <a href="/app" class="text-decoration-none">App</a> /
                CRM
            </p>
            <h1 class="h3 mb-1">CRM</h1>
            <p class="text-secondary mb-0">Manage lead sources and leads.</p>
        </div>

        <div class="row g-4">
            <div class="col-12 col-sm-6 col-lg-3">
                <a href="/app/crm/sources" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 app-section-card">
                        <div class="card-body p-4">
                            <div class="app-section-icon mb-3">S</div>
                            <h2 class="h5 text-dark mb-2">Sources</h2>
                            <p class="text-secondary small mb-0">Create and manage lead sources.</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <a href="/app/crm/leads" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 app-section-card">
                        <div class="card-body p-4">
                            <div class="app-section-icon mb-3">L</div>
                            <h2 class="h5 text-dark mb-2">Leads</h2>
                            <p class="text-secondary small mb-0">Browse leads, filter by date, and open detail pages.</p>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</main>

<style>
    .app-section-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .app-section-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1) !important;
    }
    .app-section-icon {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 0.5rem;
        background: #e9ecef;
        color: #212529;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }
</style>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<%- include('common/footer') %>

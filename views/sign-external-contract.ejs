<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title || "Contract — HammerByte" %></title>
    <meta name="robots" content="noindex, nofollow" />
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous"
    />
    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            background: #eee;
            color: #434343;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 14px;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }

        .page {
            position: relative;
            width: min(210mm, 100%);
            min-height: 297mm;
            margin: 15px auto;
            background: #fff;
            padding: 0 0 28mm;
            box-shadow: 0 2px 15px rgba(0, 0, 0, 0.15);
        }

        .header-art,
        .footer-art {
            width: 100%;
            display: block;
        }

        .footer-art {
            position: absolute;
            bottom: 0;
            left: 0;
        }

        .content {
            padding: 0 14mm 28mm;
        }

        .parties-preamble {
            margin-top: 8mm;
            text-align: justify;
            color: #111;
        }

        .parties-preamble p {
            margin: 0 0 1rem;
        }

        .parties-and {
            text-align: center;
            font-weight: 700;
            margin: 1rem 0;
        }

        .contract-title {
            margin: 10mm 0 6mm;
            font-size: 18px;
            font-weight: 700;
            color: #111;
            text-align: center;
        }

        .clauses {
            margin: 0;
            padding-left: 1.25rem;
        }

        .clauses > li {
            margin-bottom: 1rem;
        }

        .clause-title {
            font-weight: 700;
            color: #111;
            margin-bottom: 0.35rem;
        }

        .subclauses {
            margin: 0.35rem 0 0;
            padding-left: 1.25rem;
        }

        .subclauses li {
            margin-bottom: 0.35rem;
            white-space: pre-wrap;
        }

        .empty-clauses {
            text-align: center;
            color: #6b7280;
            padding: 12mm 0;
        }

        .execution-block {
            margin-top: 10mm;
            color: #111;
        }

        .execution-heading {
            font-size: 16px;
            font-weight: 700;
            text-align: center;
            margin: 0 0 4mm;
            letter-spacing: 0.02em;
        }

        .execution-witness {
            text-align: justify;
            margin: 0 0 8mm;
        }

        .party-sign-block {
            margin-bottom: 8mm;
        }

        .party-sign-label {
            font-weight: 700;
            margin: 0 0 2mm;
        }

        .party-sign-for {
            margin: 0 0 1mm;
        }

        .party-sign-date {
            margin: 0 0 3mm;
            color: #434343;
        }

        .hb-signature-area {
            position: relative;
            width: 76mm;
            height: 22mm;
        }

        .stamp {
            position: absolute;
            width: 72mm;
            height: 20mm;
            object-fit: contain;
            left: 0;
            top: 0;
        }

        .hb-signature {
            position: absolute;
            width: 24mm;
            height: 13mm;
            object-fit: contain;
            left: 52mm;
            top: 2mm;
            z-index: 2;
        }

        .contractor-media {
            display: flex;
            gap: 6mm;
            align-items: flex-start;
        }

        .contractor-media img {
            width: 32mm;
            height: 32mm;
            object-fit: cover;
            border: 1px solid #d1d5db;
            background: #f9fafb;
        }

        .media-placeholder {
            width: 32mm;
            height: 32mm;
            border: 1px dashed #9ca3af;
            background: #f3f4f6;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #6b7280;
            font-size: 11px;
            text-align: center;
            padding: 2mm;
        }

        .signing-panel {
            margin-top: 12mm;
            padding-top: 8mm;
            border-top: 1px solid #e5e7eb;
        }

        .signing-panel h2 {
            margin: 0 0 12px;
            font-size: 16px;
            font-weight: 700;
            color: #111;
        }

        .upload-status {
            font-size: 12px;
            color: #6b7280;
            margin-top: 4px;
        }

        .upload-status.is-ready {
            color: #157347;
        }

        .upload-status.is-error {
            color: #b02a37;
        }

        @media print {
            html,
            body {
                background: #fff;
            }

            .page {
                margin: 0;
                box-shadow: none;
                width: 210mm;
            }

            .signing-panel {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="page">
        <img
            class="header-art"
            src="<%= header_image_src %>"
            alt="HammerByte"
        />

        <div class="content">
            <div class="parties-preamble">
                <p>
                    <strong>HAMMERBYTE</strong>, a business entity registered in December 2025, having its principal place of business in India, represented by its Authorized Signatory (hereinafter referred to as the <strong>"Company"</strong> or <strong>"Hammerbyte"</strong>, which expression shall unless repugnant to the context include its successors and permitted assigns), of the <strong>FIRST PART</strong>;
                </p>
                <p class="parties-and"><strong>AND</strong></p>
                <p>
                    <strong><%= contract.contractor_name %></strong>, an individual professional / sole proprietorship / registered business entity, represented by its authorized representative where applicable (hereinafter referred to as the <strong>"Contractor"</strong>, which expression shall unless repugnant to the context include her/its legal heirs, executors, legal representatives, successors, and permitted assigns), of the <strong>SECOND PART</strong>.
                </p>
                <p>
                    (<strong>Hammerbyte</strong> and <strong>Contractor</strong> are individually referred to as a <strong>"Party"</strong> and collectively as the <strong>"Parties"</strong>.)
                </p>
            </div>

            <h1 class="contract-title">Contract Terms &amp; Conditions</h1>

            <% if (!clauses || clauses.length === 0) { %>
                <div class="empty-clauses">No clauses on this contract.</div>
            <% } else { %>
                <ol class="clauses">
                    <% clauses.forEach(function (clause) { %>
                        <li>
                            <div class="clause-title"><%= clause.title %></div>
                            <% if (clause.subclauses && clause.subclauses.length > 0) { %>
                                <ol type="a" class="subclauses">
                                    <% clause.subclauses.forEach(function (subclause) { %>
                                        <li><%= subclause.body %></li>
                                    <% }) %>
                                </ol>
                            <% } %>
                        </li>
                    <% }) %>
                </ol>
            <% } %>

            <div class="execution-block">
                <h2 class="execution-heading">SIGNATURES AND EXECUTION</h2>
                <p class="execution-witness">
                    IN WITNESS WHEREOF, the Parties hereto have executed this Independent Contractor Agreement through their duly authorized representatives as of the Effective Date written above.
                </p>

                <div class="party-sign-block">
                    <p class="party-sign-label">FIRST PART:</p>
                    <p class="party-sign-for">For <strong>HAMMERBYTE</strong></p>
                    <p class="party-sign-date">Date: <%= contract.created_on %></p>
                    <div class="hb-signature-area">
                        <img class="stamp" src="<%= stamp_image_src %>" alt="HammerByte stamp" />
                        <img
                            class="hb-signature"
                            src="<%= signature_image_src %>"
                            alt="Authorized signature"
                        />
                    </div>
                </div>

                <div class="party-sign-block">
                    <p class="party-sign-label">SECOND PART:</p>
                    <p class="party-sign-for">
                        For / By <strong>CONTRACTOR (<%= contract.contractor_name %>)</strong>
                    </p>
                    <p class="party-sign-date">Date: <%= contract.created_on %></p>
                    <div class="contractor-media">
                        <% if (is_signed && contract.selfie_src && contract.signature_src) { %>
                            <img src="<%= contract.selfie_src %>" alt="Contractor selfie" />
                            <img src="<%= contract.signature_src %>" alt="Contractor signature" />
                        <% } else { %>
                            <div class="media-placeholder">Selfie<br />(will appear here)</div>
                            <div class="media-placeholder">Signature<br />(will appear here)</div>
                        <% } %>
                    </div>
                </div>
            </div>

            <% if (is_signed) { %>
                <div class="signing-panel">
                    <a
                        class="btn btn-primary"
                        href="/api/external-contracts/<%= contract.signing_code %>/signed"
                    >
                        Download
                    </a>
                </div>
            <% } else { %>
            <div class="signing-panel" data-signing-code="<%= contract.signing_code %>">
                <h2>Sign this contract</h2>
                <div id="sign-alert" class="alert d-none" role="alert"></div>
                <div class="mb-3">
                    <label for="signature-file" class="form-label">Signature</label>
                    <input type="file" class="form-control" id="signature-file" accept="image/*" />
                    <div class="upload-status" id="signature-status">Not uploaded</div>
                </div>
                <div class="mb-3">
                    <label for="selfie-file" class="form-label">Selfie</label>
                    <input type="file" class="form-control" id="selfie-file" accept="image/*" />
                    <div class="upload-status" id="selfie-status">Not uploaded</div>
                </div>
                <div class="mb-3">
                    <label for="identity-file" class="form-label">Identity</label>
                    <input type="file" class="form-control" id="identity-file" accept="image/*" />
                    <div class="upload-status" id="identity-status">Not uploaded</div>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="read-contract-checkbox" />
                    <label class="form-check-label" for="read-contract-checkbox">
                        I have read the contract
                    </label>
                </div>
                <button type="button" class="btn btn-primary" id="sign-contract-btn" disabled>
                    Sign
                </button>
            </div>
            <% } %>
        </div>

        <img class="footer-art" src="<%= footer_image_src %>" alt="" />
    </div>

    <% if (!is_signed) { %>
    <div
        class="modal fade"
        id="signed-success-modal"
        tabindex="-1"
        aria-labelledby="signed-success-modal-label"
        aria-hidden="true"
        data-bs-backdrop="static"
        data-bs-keyboard="false"
    >
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="signed-success-modal-label">Signed successfully</h2>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Your contract has been signed successfully.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" id="signed-success-ok-btn">OK</button>
                </div>
            </div>
        </div>
    </div>
    <% } %>

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"
    ></script>
    <% if (!is_signed) { %>
    <script src="/public/sign-external-contract.js" defer></script>
    <% } %>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title || "Contract — HammerByte" %></title>
    <meta name="robots" content="noindex, nofollow" />
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous"
    />
    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            background: #eee;
            color: #434343;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 14px;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
        }

        .page {
            position: relative;
            width: min(210mm, 100%);
            min-height: 297mm;
            margin: 15px auto;
            background: #fff;
            padding: 0 0 28mm;
            box-shadow: 0 2px 15px rgba(0, 0, 0, 0.15);
        }

        .header-art,
        .footer-art {
            width: 100%;
            display: block;
        }

        .footer-art {
            position: absolute;
            bottom: 0;
            left: 0;
        }

        .content {
            padding: 0 14mm 28mm;
        }

        .party-area {
            width: 100%;
            border-collapse: collapse;
            margin-top: 8mm;
            table-layout: fixed;
        }

        .party-area td {
            vertical-align: top;
        }

        .party-title {
            font-weight: 700;
            font-size: 16px;
            margin-bottom: 6px;
            color: #111;
        }

        .party-line {
            margin: 0 0 4px;
        }

        .meta-table {
            width: 100%;
            border-collapse: collapse;
        }

        .meta-table td {
            padding: 2px 0;
        }

        .meta-label {
            width: 40%;
            color: #6b7280;
        }

        .meta-value {
            font-weight: 700;
            text-align: right;
        }

        .contract-title {
            margin: 10mm 0 6mm;
            font-size: 18px;
            font-weight: 700;
            color: #111;
            text-align: center;
        }

        .clauses {
            margin: 0;
            padding-left: 1.25rem;
        }

        .clauses > li {
            margin-bottom: 1rem;
        }

        .clause-title {
            font-weight: 700;
            color: #111;
            margin-bottom: 0.35rem;
        }

        .subclauses {
            margin: 0.35rem 0 0;
            padding-left: 1.25rem;
        }

        .subclauses li {
            margin-bottom: 0.35rem;
            white-space: pre-wrap;
        }

        .empty-clauses {
            text-align: center;
            color: #6b7280;
            padding: 12mm 0;
        }

        .signature-area {
            position: relative;
            width: 76mm;
            height: 22mm;
            margin: 8mm 0 0 auto;
        }

        .stamp {
            position: absolute;
            width: 72mm;
            height: 20mm;
            object-fit: contain;
            left: 0;
            top: 0;
        }

        .authorized-signature {
            position: absolute;
            width: 24mm;
            height: 13mm;
            object-fit: contain;
            left: 52mm;
            top: 2mm;
            z-index: 2;
        }

        .authorized {
            text-align: right;
            margin-top: 3mm;
            font-size: 12px;
            color: #434343;
        }

        .signing-panel {
            margin-top: 12mm;
            padding-top: 8mm;
            border-top: 1px solid #e5e7eb;
        }

        .signing-panel h2 {
            margin: 0 0 12px;
            font-size: 16px;
            font-weight: 700;
            color: #111;
        }

        .upload-status {
            font-size: 12px;
            color: #6b7280;
            margin-top: 4px;
        }

        .upload-status.is-ready {
            color: #157347;
        }

        .upload-status.is-error {
            color: #b02a37;
        }

        @media print {
            html,
            body {
                background: #fff;
            }

            .page {
                margin: 0;
                box-shadow: none;
                width: 210mm;
            }

            .signing-panel {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="page">
        <img
            class="header-art"
            src="<%= header_image_src %>"
            alt="HammerByte"
        />

        <div class="content">
            <table class="party-area">
                <tr>
                    <td>
                        <div class="party-title">Party</div>
                        <p class="party-line"><%= contract.full_name %></p>
                        <p class="party-line"><%= contract.company %></p>
                        <p class="party-line"><%= contract.email %></p>
                        <p class="party-line"><%= contract.phone %></p>
                        <p class="party-line"><%= contract.address %></p>
                    </td>
                    <td>
                        <table class="meta-table">
                            <tr>
                                <td class="meta-label">Document</td>
                                <td class="meta-value">External Contract</td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>

            <h1 class="contract-title">Formal Contract</h1>

            <% if (!clauses || clauses.length === 0) { %>
                <div class="empty-clauses">No clauses on this contract.</div>
            <% } else { %>
                <ol class="clauses">
                    <% clauses.forEach(function (clause) { %>
                        <li>
                            <div class="clause-title"><%= clause.title %></div>
                            <% if (clause.subclauses && clause.subclauses.length > 0) { %>
                                <ol type="a" class="subclauses">
                                    <% clause.subclauses.forEach(function (subclause) { %>
                                        <li><%= subclause.body %></li>
                                    <% }) %>
                                </ol>
                            <% } %>
                        </li>
                    <% }) %>
                </ol>
            <% } %>

            <div class="signature-area">
                <img class="stamp" src="<%= stamp_image_src %>" alt="HammerByte stamp" />
                <img
                    class="authorized-signature"
                    src="<%= signature_image_src %>"
                    alt="Authorized signature"
                />
            </div>
            <div class="authorized">For HammerByte Authorized Personnel Only</div>

            <% if (is_signed) { %>
                <div class="signing-panel">
                    <a
                        class="btn btn-primary"
                        href="/api/external-contracts/<%= contract.signing_code %>/signed"
                    >
                        Download
                    </a>
                </div>
            <% } else { %>
            <div class="signing-panel" data-signing-code="<%= contract.signing_code %>">
                <h2>Sign this contract</h2>
                <div id="sign-alert" class="alert d-none" role="alert"></div>
                <div class="mb-3">
                    <label for="signature-file" class="form-label">Signature</label>
                    <input type="file" class="form-control" id="signature-file" accept="image/*" />
                    <div class="upload-status" id="signature-status">Not uploaded</div>
                </div>
                <div class="mb-3">
                    <label for="selfie-file" class="form-label">Selfie</label>
                    <input type="file" class="form-control" id="selfie-file" accept="image/*" />
                    <div class="upload-status" id="selfie-status">Not uploaded</div>
                </div>
                <div class="mb-3">
                    <label for="identity-file" class="form-label">Identity</label>
                    <input type="file" class="form-control" id="identity-file" accept="image/*" />
                    <div class="upload-status" id="identity-status">Not uploaded</div>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="read-contract-checkbox" />
                    <label class="form-check-label" for="read-contract-checkbox">
                        I have read the contract
                    </label>
                </div>
                <button type="button" class="btn btn-primary" id="sign-contract-btn" disabled>
                    Sign
                </button>
            </div>
            <% } %>
        </div>

        <img class="footer-art" src="<%= footer_image_src %>" alt="" />
    </div>

    <% if (!is_signed) { %>
    <div
        class="modal fade"
        id="signed-success-modal"
        tabindex="-1"
        aria-labelledby="signed-success-modal-label"
        aria-hidden="true"
        data-bs-backdrop="static"
        data-bs-keyboard="false"
    >
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="signed-success-modal-label">Signed successfully</h2>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Your contract has been signed successfully.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" id="signed-success-ok-btn">OK</button>
                </div>
            </div>
        </div>
    </div>
    <% } %>

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"
    ></script>
    <% if (!is_signed) { %>
    <script src="/public/sign-external-contract.js" defer></script>
    <% } %>
</body>
</html>

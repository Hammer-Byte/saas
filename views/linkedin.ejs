<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4">
            <p class="text-secondary small mb-1">
                <a href="/app" class="text-decoration-none">App</a> /
                <a href="/app/automation" class="text-decoration-none">Automation</a> /
                LinkedIn
            </p>
            <h1 class="h3 mb-1">LinkedIn</h1>
            <p class="text-secondary mb-0">
                LinkedIn automation ops. Manage shared cookies on
                <a href="/app/automation-users">Automation Users</a>.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-12 col-sm-6 col-lg-3">
                <a href="/app/linkedin-grow-network" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 app-section-card">
                        <div class="card-body p-4">
                            <div class="app-section-icon mb-3">G</div>
                            <h2 class="h5 text-dark mb-2">GrowNetwork</h2>
                            <p class="text-secondary small mb-0">Select designations and users, then start connect requests.</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <a href="/app/linkedin-search-network" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 app-section-card">
                        <div class="card-body p-4">
                            <div class="app-section-icon mb-3">S</div>
                            <h2 class="h5 text-dark mb-2">SearchNetwork</h2>
                            <p class="text-secondary small mb-0">Search people by designation and send connect requests.</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <a href="/app/linkedin-designations" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 app-section-card">
                        <div class="card-body p-4">
                            <div class="app-section-icon mb-3">D</div>
                            <h2 class="h5 text-dark mb-2">Designations</h2>
                            <p class="text-secondary small mb-0">Manage designations shared by GrowNetwork and SearchNetwork.</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <a href="/app/linkedin-messages" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 app-section-card">
                        <div class="card-body p-4">
                            <div class="app-section-icon mb-3">M</div>
                            <h2 class="h5 text-dark mb-2">Messages</h2>
                            <p class="text-secondary small mb-0">Store message templates against each designation.</p>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <a href="/app/linkedin-message-network" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 app-section-card">
                        <div class="card-body p-4">
                            <div class="app-section-icon mb-3">N</div>
                            <h2 class="h5 text-dark mb-2">MessageNetwork</h2>
                            <p class="text-secondary small mb-0">Message new connections by designation from your Connections list.</p>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</main>

<style>
    .app-section-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .app-section-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1) !important;
    }
    .app-section-icon {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 0.5rem;
        background: #e9ecef;
        color: #212529;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }
</style>

<script src="/public/app.js" defer></script>
<%- include('common/footer') %>

<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= typeof username !== "undefined" && username ? username : "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4">
            <p class="text-secondary small mb-1">
                <a href="/app" class="text-decoration-none">App</a> /
                <a href="/app/applications" class="text-decoration-none">Applications</a> /
                Customer
            </p>
            <h1 class="h3 mb-1">Customer for <%= application.title %></h1>
            <p class="text-secondary mb-0">One customer profile linked to this application.</p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center pt-4 px-4">
                <h2 class="h5 mb-0">Customer details</h2>
                <button
                    type="button"
                    id="edit-customer-btn"
                    class="btn btn-sm btn-outline-secondary"
                    aria-label="Edit customer"
                    title="Edit"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                    </svg>
                </button>
            </div>
            <div class="card-body p-4">
                <div id="customer-alert" class="alert d-none" role="alert"></div>

                <form id="customer-form" data-application-id="<%= application.id %>" novalidate>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="full_name" class="form-label">Full name</label>
                            <input
                                type="text"
                                class="form-control"
                                id="full_name"
                                name="full_name"
                                maxlength="128"
                                value="<%= customer?.full_name || '' %>"
                                disabled
                                required
                            />
                        </div>
                        <div class="col-md-6">
                            <label for="company" class="form-label">Company</label>
                            <input
                                type="text"
                                class="form-control"
                                id="company"
                                name="company"
                                maxlength="128"
                                value="<%= customer?.company || '' %>"
                                disabled
                                required
                            />
                        </div>
                        <div class="col-md-6">
                            <label for="pan_gst" class="form-label">PAN / GST</label>
                            <input
                                type="text"
                                class="form-control"
                                id="pan_gst"
                                name="pan_gst"
                                maxlength="32"
                                value="<%= customer?.pan_gst || '' %>"
                                disabled
                                required
                            />
                        </div>
                        <div class="col-md-6">
                            <label for="hsn" class="form-label">HSN</label>
                            <input
                                type="text"
                                class="form-control"
                                id="hsn"
                                name="hsn"
                                maxlength="16"
                                value="<%= customer?.hsn || '' %>"
                                disabled
                                required
                            />
                        </div>
                        <div class="col-12">
                            <label for="address" class="form-label">Address</label>
                            <textarea
                                class="form-control"
                                id="address"
                                name="address"
                                rows="3"
                                maxlength="512"
                                disabled
                                required
                            ><%= customer?.address || '' %></textarea>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Emails</label>
                            <div id="emails-chips" class="d-flex flex-wrap gap-2 mb-2">
                                <% (emails || []).forEach(function (email) { %>
                                    <span class="badge rounded-pill text-bg-secondary d-inline-flex align-items-center gap-1 py-2 px-3" data-value="<%= email %>">
                                        <span><%= email %></span>
                                        <button type="button" class="btn-close btn-close-white chip-remove d-none" aria-label="Remove" style="font-size: 0.55rem;"></button>
                                    </span>
                                <% }) %>
                            </div>
                            <div class="input-group">
                                <input
                                    type="email"
                                    class="form-control"
                                    id="email-input"
                                    placeholder="Type email and press Enter"
                                    maxlength="255"
                                    disabled
                                />
                                <button type="button" class="btn btn-outline-secondary" id="add-email-btn" disabled>Add</button>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Phones</label>
                            <div id="phones-chips" class="d-flex flex-wrap gap-2 mb-2">
                                <% (phones || []).forEach(function (phone) { %>
                                    <span class="badge rounded-pill text-bg-secondary d-inline-flex align-items-center gap-1 py-2 px-3" data-value="<%= phone %>">
                                        <span><%= phone %></span>
                                        <button type="button" class="btn-close btn-close-white chip-remove d-none" aria-label="Remove" style="font-size: 0.55rem;"></button>
                                    </span>
                                <% }) %>
                            </div>
                            <div class="input-group">
                                <input
                                    type="tel"
                                    class="form-control"
                                    id="phone-input"
                                    placeholder="Type phone and press Enter"
                                    maxlength="13"
                                    disabled
                                />
                                <button type="button" class="btn btn-outline-secondary" id="add-phone-btn" disabled>Add</button>
                            </div>
                        </div>
                    </div>

                    <div id="customer-actions" class="d-flex gap-2 mt-4 d-none">
                        <button type="submit" id="save-customer-btn" class="btn btn-primary">Save</button>
                        <button type="button" id="clear-customer-btn" class="btn btn-outline-secondary">Clear</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="mt-3">
            <a href="/app/applications" class="btn btn-outline-secondary btn-sm">← Back to Applications</a>
        </div>
    </div>
</main>

<script src="/public/app.js" defer></script>
<script src="/public/application-customer.js" defer></script>
<%- include('common/footer') %>

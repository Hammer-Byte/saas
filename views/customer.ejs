<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= typeof username !== "undefined" && username ? username : "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4">
            <p class="text-secondary small mb-1">
                <a href="/app" class="text-decoration-none">App</a> /
                <a href="/app/customers" class="text-decoration-none">Customers</a> /
                <%= customer.full_name %>
            </p>
            <h1 class="h3 mb-1"><%= customer.full_name %></h1>
            <p class="text-secondary mb-0">Customer details and linked projects.</p>
        </div>

        <div id="customer-alert" class="alert d-none" role="alert"></div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h2 class="h5 mb-0">Customer details</h2>
            </div>
            <div class="card-body p-4">
                <form id="customer-detail-form" data-customer-id="<%= customer.id %>" novalidate>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="full_name" class="form-label">Full name</label>
                            <input type="text" class="form-control" id="full_name" name="full_name" maxlength="128" value="<%= customer.full_name %>" required disabled />
                        </div>
                        <div class="col-md-6">
                            <label for="company" class="form-label">Company</label>
                            <input type="text" class="form-control" id="company" name="company" maxlength="128" value="<%= customer.company %>" required disabled />
                        </div>
                        <div class="col-md-6">
                            <label for="pan_gst" class="form-label">PAN / GST <span class="text-secondary fw-normal">(optional)</span></label>
                            <input type="text" class="form-control" id="pan_gst" name="pan_gst" maxlength="32" value="<%= customer.pan_gst || '' %>" disabled />
                        </div>
                        <div class="col-md-6">
                            <label for="hsn" class="form-label">HSN <span class="text-secondary fw-normal">(optional)</span></label>
                            <input type="text" class="form-control" id="hsn" name="hsn" maxlength="16" value="<%= customer.hsn || '' %>" disabled />
                        </div>
                        <div class="col-12">
                            <label for="address" class="form-label">Address</label>
                            <textarea class="form-control" id="address" name="address" rows="3" maxlength="512" required disabled><%= customer.address %></textarea>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4 flex-wrap">
                        <button type="submit" id="save-customer-btn" class="btn btn-primary d-none">Save</button>
                        <button type="button" id="cancel-edit-customer-btn" class="btn btn-outline-secondary d-none">Cancel</button>
                        <button type="button" id="edit-customer-btn" class="btn btn-outline-primary">Edit</button>
                        <button type="button" id="delete-customer-btn" class="btn btn-outline-danger">Delete</button>
                        <a href="/app/customers" class="btn btn-outline-secondary">Back</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center pt-4 px-4">
                <h2 class="h5 mb-0">Customer projects</h2>
                <button
                    type="button"
                    class="btn btn-sm btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#customer-project-modal"
                    id="open-add-customer-project-btn"
                >
                    Add Project
                </button>
            </div>
            <div class="card-body p-0">
                <% if (!customerProjects || customerProjects.length === 0) { %>
                    <div class="p-4 text-center text-secondary">
                        No projects for this customer.
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Title</th>
                                    <th scope="col">Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% customerProjects.forEach(function (row) { %>
                                    <tr
                                        class="customer-project-row"
                                        role="link"
                                        tabindex="0"
                                        data-href="/app/projects/<%= row.id %>"
                                        style="cursor: pointer"
                                    >
                                        <td><%= row.title %></td>
                                        <td><%= row.description || "-" %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="customer-project-modal" tabindex="-1" aria-labelledby="customer-project-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="customer-project-form" data-customer-id="<%= customer.id %>" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="customer-project-modal-label">Add project</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="customer-project-form-alert" class="alert d-none" role="alert"></div>
                    <div class="mb-3">
                        <label for="customer-project-title" class="form-label">Title</label>
                        <input type="text" class="form-control" id="customer-project-title" name="title" maxlength="128" required />
                    </div>
                    <div class="mb-0">
                        <label for="customer-project-description" class="form-label">Description</label>
                        <textarea class="form-control" id="customer-project-description" name="description" rows="3" maxlength="512"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/customer.js" defer></script>
<%- include('common/footer') %>

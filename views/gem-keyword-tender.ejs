<%- include('common/header') %>

<%
    const canAssignOthers =
        !!super_admin ||
        (authorities || []).includes(AUTHORITIES.ASSIGN_GEM_TENDER_ASSIGNEE);
    const currentUserId = Number(userId || 0);
    const isSuperAdmin = !!super_admin;
    const assigneeUserId = tender.assignee_user_id ? Number(tender.assignee_user_id) : null;
    const stageLabels = GEM_KEYWORD_TENDER_STAGE_LABELS || {};
    const stageValues = Object.keys(stageLabels);
    const currentStage = tender.stage || "new";
    const systemManagedStages = new Set(["unattended", "missed"]);
    const terminalStages = new Set(
        Array.isArray(GEM_KEYWORD_TENDER_TERMINAL_STAGES)
            ? GEM_KEYWORD_TENDER_TERMINAL_STAGES
            : ["filed", "out_of_scope", "not_eligible", "unattended", "missed"],
    );
    const pipelineStages = Array.isArray(GEM_KEYWORD_TENDER_PIPELINE_STAGES)
        ? GEM_KEYWORD_TENDER_PIPELINE_STAGES
        : [
              "new",
              "assigned",
              "eligible",
              "waiting_for_docs",
              "waiting_for_gem",
              "waiting_for_quote",
              "preparing_docs",
              "filed",
          ];
    const assigneeRequiredStages = [
        "assigned",
        "waiting_for_docs",
        "waiting_for_gem",
        "waiting_for_quote",
        "preparing_docs",
    ];
    const isSystemManagedStage = systemManagedStages.has(currentStage);
    const isTerminalStage = terminalStages.has(currentStage);
    const quoteDisabledStages = new Set([
        "new",
        "assigned",
        "out_of_scope",
        "missed",
        "unattended",
        "filed",
        "not_eligible",
    ]);
    const quoteStageEnabled = !quoteDisabledStages.has(currentStage);
    const canOperateAssigned = isTerminalStage
        ? isSuperAdmin
        : isSuperAdmin || (assigneeUserId && assigneeUserId === currentUserId);
    const canChangeStage = isTerminalStage
        ? isSuperAdmin
        : !!assigneeUserId && canOperateAssigned;
    const canEditQuote = quoteStageEnabled && canOperateAssigned;
    const canManageDocs = !!canManageDocuments;
    const canUseComments = !isTerminalStage || isSuperAdmin;
    const selectableStageValues = stageValues.filter(function (stage) {
        return !systemManagedStages.has(stage) || stage === currentStage;
    });

    const labelToStage = {};
    Object.keys(stageLabels).forEach(function (stage) {
        labelToStage[String(stageLabels[stage]).toLowerCase()] = stage;
    });
    const stageReachedAt = { new: tender.created_on || null };
    (activities || [])
        .slice()
        .reverse()
        .forEach(function (activity) {
            const text = String(activity.activity || "");
            const match = text.match(/^Changed stage from .+ to (.+)$/);
            if (!match) return;
            const toLabel = String(match[1] || "").trim().toLowerCase();
            const toStage = labelToStage[toLabel];
            if (!toStage || stageReachedAt[toStage]) return;
            stageReachedAt[toStage] = activity.created_on || null;
        });

    let pipelineCurrentIndex = pipelineStages.indexOf(currentStage);
    if (pipelineCurrentIndex < 0) {
        let farthest = -1;
        pipelineStages.forEach(function (stage, index) {
            if (stageReachedAt[stage]) farthest = index;
        });
        pipelineCurrentIndex = farthest;
    }
    const showSideBranch =
        currentStage === "missed" ||
        currentStage === "out_of_scope" ||
        currentStage === "not_eligible" ||
        currentStage === "unattended";

    let specificationLinks = [];
    if (tender.specification_links) {
        try {
            const parsed =
                typeof tender.specification_links === "string"
                    ? JSON.parse(tender.specification_links)
                    : tender.specification_links;
            if (Array.isArray(parsed)) {
                specificationLinks = parsed.filter((item) => item && item.url);
            }
        } catch (error) {
            specificationLinks = [];
        }
    }
%>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> /
                    <a href="/app/gem-tenders" class="text-decoration-none">GEM Tenders</a> /
                    <a href="/app/gem-keyword-tenders" class="text-decoration-none">Tenders</a> /
                    <%= tender.tender_id %>
                </p>
                <h1 class="h3 mb-1">
                    <% if (tender.document) { %>
                        <a href="<%= tender.document %>" target="_blank" rel="noopener noreferrer">
                            <%= tender.tender_id %>
                        </a>
                    <% } else { %>
                        <%= tender.tender_id %>
                    <% } %>
                </h1>
                <p class="text-secondary mb-0">
                    Group: <%= tender.category_group_name || "-" %>
                </p>
            </div>
        </div>

        <div id="gem-tender-alert" class="alert d-none" role="alert"></div>

        <div
            class="card border-0 shadow-sm mb-4"
            id="gem-tender-detail"
            data-id="<%= tender.id %>"
            data-stage="<%= currentStage %>"
            data-assignee-user-id="<%= assigneeUserId || '' %>"
            data-category-group-id="<%= tender.category_group_id != null ? tender.category_group_id : '' %>"
            data-quote="<%= encodeURIComponent(tender.quote || '') %>"
            data-current-user-id="<%= currentUserId %>"
            data-super-admin="<%= isSuperAdmin ? '1' : '0' %>"
            data-can-assign-others="<%= canAssignOthers ? '1' : '0' %>"
            data-can-manage-documents="<%= canManageDocs ? '1' : '0' %>"
            data-system-managed-stage="<%= isSystemManagedStage ? '1' : '0' %>"
            data-terminal-stage="<%= isTerminalStage ? '1' : '0' %>"
        >
            <div class="card-body p-4">
                <% if (isTerminalStage) { %>
                    <div class="alert alert-secondary py-2" role="status">
                        This tender is <strong><%= stageLabels[currentStage] || currentStage %></strong>
                        <% if (isSystemManagedStage) { %>
                            (set automatically).
                        <% } else { %>
                            (one-way stage).
                        <% } %>
                        <%= isSuperAdmin
                            ? "Only a super admin can change it."
                            : "Details are locked; only a super admin can change them." %>
                    </div>
                <% } %>

                <div class="gem-tender-timeline mb-4" aria-label="Tender stage timeline">
                    <div class="gem-tender-timeline-track">
                        <% pipelineStages.forEach(function (stage, index) { %>
                            <%
                                const reachedAt = stageReachedAt[stage] || null;
                                let nodeState = "future";
                                if (pipelineCurrentIndex >= 0) {
                                    if (index < pipelineCurrentIndex) nodeState = "done";
                                    else if (index === pipelineCurrentIndex && !showSideBranch) nodeState = "current";
                                    else if (index === pipelineCurrentIndex && showSideBranch) nodeState = "done";
                                    else nodeState = "future";
                                } else if (reachedAt) {
                                    nodeState = "done";
                                }
                                if (currentStage === stage) nodeState = "current";
                            %>
                            <% if (index > 0) { %>
                                <div class="gem-tender-timeline-arrow <%= nodeState !== 'future' || (pipelineCurrentIndex >= index) ? 'is-active' : '' %>" aria-hidden="true">→</div>
                            <% } %>
                            <div class="gem-tender-timeline-node gem-tender-timeline-node-<%= nodeState %>">
                                <div class="gem-tender-timeline-dot"></div>
                                <div class="gem-tender-timeline-label"><%= stageLabels[stage] || stage %></div>
                                <% if (reachedAt) { %>
                                    <div
                                        class="gem-tender-timeline-time"
                                        data-readable-date="<%= reachedAt %>"
                                        data-date-format="DD/MM/YYYY HH:mm"
                                    ></div>
                                <% } else if (nodeState === "current") { %>
                                    <div class="gem-tender-timeline-time text-secondary">Now</div>
                                <% } else { %>
                                    <div class="gem-tender-timeline-time text-secondary">—</div>
                                <% } %>
                            </div>
                        <% }) %>
                    </div>
                    <% if (showSideBranch) { %>
                        <div class="gem-tender-timeline-branch mt-3">
                            <span class="gem-tender-timeline-branch-badge gem-tender-stage-<%= currentStage %>">
                                <%= stageLabels[currentStage] || currentStage %>
                            </span>
                            <% if (stageReachedAt[currentStage]) { %>
                                <span
                                    class="gem-tender-timeline-time ms-2"
                                    data-readable-date="<%= stageReachedAt[currentStage] %>"
                                    data-date-format="DD/MM/YYYY HH:mm"
                                ></span>
                            <% } %>
                        </div>
                    <% } %>
                </div>

                <div class="row g-3 mb-2 align-items-end">
                    <div class="col-md-4">
                        <label for="gem-tender-category-group" class="form-label">Group</label>
                        <select
                            class="form-select"
                            id="gem-tender-category-group"
                            <%= !canOperateAssigned ? "disabled" : "" %>
                        >
                            <option value="">No group</option>
                            <% (categoryGroups || []).forEach(function (group) { %>
                                <option
                                    value="<%= group.id %>"
                                    <%= Number(tender.category_group_id) === Number(group.id) ? 'selected' : '' %>
                                >
                                    <%= group.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="gem-tender-stage" class="form-label">Stage</label>
                        <select
                            class="form-select"
                            id="gem-tender-stage"
                            <%= !canChangeStage ? "disabled" : "" %>
                        >
                            <% selectableStageValues.forEach(function (stage) { %>
                                <option
                                    value="<%= stage %>"
                                    <%= currentStage === stage ? 'selected' : '' %>
                                    <%= assigneeRequiredStages.includes(stage) && !assigneeUserId ? 'disabled' : '' %>
                                    <%= stage === 'new' && currentStage !== 'new' ? 'disabled' : '' %>
                                    <%= systemManagedStages.has(stage) ? 'disabled' : '' %>
                                >
                                    <%= stageLabels[stage] %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="gem-tender-assignee" class="form-label">Assignee</label>
                        <% if (canAssignOthers && (!isTerminalStage || isSuperAdmin)) { %>
                            <select
                                class="form-select"
                                id="gem-tender-assignee"
                                <%= isTerminalStage && !isSuperAdmin ? "disabled" : "" %>
                            >
                                <option value="">Unassigned</option>
                                <% (users || []).forEach(function (user) { %>
                                    <option
                                        value="<%= user.id %>"
                                        <%= assigneeUserId === Number(user.id) ? 'selected' : '' %>
                                    >
                                        <%= user.full_name %> (<%= user.email %>)
                                    </option>
                                <% }) %>
                            </select>
                        <% } else { %>
                            <input
                                type="text"
                                class="form-control"
                                value="<%= tender.assignee_full_name || 'Unassigned' %>"
                                disabled
                            />
                        <% } %>
                    </div>
                    <div
                        class="col-md-12 <%= (!assigneeUserId && !isTerminalStage) ? '' : 'd-none' %>"
                        id="gem-tender-assign-me-wrap"
                    >
                        <button
                            type="button"
                            class="btn btn-outline-primary w-100"
                            id="gem-tender-assign-me-btn"
                            <%= (!assigneeUserId && !isTerminalStage) ? '' : 'disabled' %>
                        >
                            Assign to me
                        </button>
                    </div>
                </div>
                <% if (isTerminalStage && !isSuperAdmin) { %>
                    <p class="form-text mb-3">Only a super admin can change a one-way stage tender.</p>
                <% } else if (!assigneeUserId && !isTerminalStage) { %>
                    <p class="form-text mb-3">Assign someone before changing stage.</p>
                <% } else if (assigneeUserId && !canChangeStage) { %>
                    <p class="form-text mb-3">Only the assignee or a super admin can change stage.</p>
                <% } else { %>
                    <div class="mb-3"></div>
                <% } %>

                <div class="row g-3 small">
                    <div class="col-md-4">
                        <strong>End</strong><br />
                        <span
                            data-readable-date="<%= tender.end_date_time || '' %>"
                            data-date-format="DD/MM/YYYY HH:mm:ss"
                        ></span>
                    </div>
                    <div class="col-md-4"><strong>Ministry</strong><br /><%= tender.ministry || "-" %></div>
                    <div class="col-md-4"><strong>Department</strong><br /><%= tender.department || "-" %></div>
                    <div class="col-md-4"><strong>Organization</strong><br /><%= tender.organization || "-" %></div>
                    <div class="col-md-4"><strong>Office</strong><br /><%= tender.office || "-" %></div>
                    <div class="col-md-4"><strong>Required Minimum Average Turnover</strong><br /><%= tender.required_minimum_average_turnover || "-" %></div>
                    <div class="col-md-4"><strong>Required Past Experience Years</strong><br /><%= tender.required_past_experice_years || "-" %></div>
                    <div class="col-md-4"><strong>Experience Relaxation</strong><br /><%= tender.mse_experience_relaxation || "-" %></div>
                    <div class="col-md-4"><strong>Turnover Relaxation</strong><br /><%= tender.mse_turnover_relaxation || "-" %></div>
                    <div class="col-md-4"><strong>Quantity</strong><br /><%= Number(tender.quantity || 0) > 0 ? Number(tender.quantity) : "NA" %></div>
                    <div class="col-md-4">
                        <strong>EMD amount</strong><br />
                        <% const emdAmount = Number(tender.emd_amount || 0); %>
                        <%= emdAmount > 0 ? emdAmount.toLocaleString("en-IN", { maximumFractionDigits: 2 }) : "NA" %>
                    </div>
                    <div class="col-md-4"><strong>Asked documents</strong><br /><%= tender.asked_documents || "-" %></div>
                    <div class="col-md-4"><strong>HOD email</strong><br /><%= tender.hod_email || "-" %></div>
                    <div class="col-md-4"><strong>Buyer email</strong><br /><%= tender.buyer_email || "-" %></div>
                    <div class="col-md-4"><strong>Buyer phone</strong><br /><%= tender.buyer_phone || "-" %></div>
                    <div class="col-md-4">
                        <strong>Bid document</strong><br />
                        <% if (tender.document) { %>
                            <a href="<%= tender.document %>" target="_blank" rel="noopener noreferrer">Open bid PDF</a>
                        <% } else { %>
                            -
                        <% } %>
                    </div>
                    <div class="col-12">
                        <strong>Specification / Scope of Work</strong><br />
                        <% if (specificationLinks.length) { %>
                            <ul class="mb-0 ps-3">
                                <% specificationLinks.forEach(function (link) { %>
                                    <li>
                                        <a href="<%= link.url %>" target="_blank" rel="noopener noreferrer">
                                            <%= link.label || "Specification" %>
                                        </a>
                                    </li>
                                <% }) %>
                            </ul>
                        <% } else { %>
                            -
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <ul class="nav nav-tabs" id="gem-tender-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link active"
                    id="gem-tender-comments-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#gem-tender-comments-pane"
                    type="button"
                    role="tab"
                    aria-controls="gem-tender-comments-pane"
                    aria-selected="true"
                >
                    Comments
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link"
                    id="gem-tender-documents-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#gem-tender-documents-pane"
                    type="button"
                    role="tab"
                    aria-controls="gem-tender-documents-pane"
                    aria-selected="false"
                >
                    Documents
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link"
                    id="gem-tender-quote-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#gem-tender-quote-pane"
                    type="button"
                    role="tab"
                    aria-controls="gem-tender-quote-pane"
                    aria-selected="false"
                >
                    Quote
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button
                    class="nav-link"
                    id="gem-tender-activities-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#gem-tender-activities-pane"
                    type="button"
                    role="tab"
                    aria-controls="gem-tender-activities-pane"
                    aria-selected="false"
                >
                    Activities
                </button>
            </li>
        </ul>

        <div class="tab-content border border-top-0 bg-white shadow-sm rounded-bottom p-4 mb-4">
            <div
                class="tab-pane fade show active"
                id="gem-tender-comments-pane"
                role="tabpanel"
                aria-labelledby="gem-tender-comments-tab"
            >
                <% if (canUseComments) { %>
                <form id="gem-tender-comment-form" class="mb-4" novalidate>
                    <label for="gem-tender-comment-text" class="form-label">Add comment</label>
                    <textarea
                        class="form-control"
                        id="gem-tender-comment-text"
                        rows="3"
                        required
                    ></textarea>
                    <div class="mt-2">
                        <label for="gem-tender-comment-file" class="form-label">Attachment (optional)</label>
                        <input
                            type="file"
                            class="form-control"
                            id="gem-tender-comment-file"
                        />
                    </div>
                    <button type="submit" class="btn btn-primary mt-3" id="gem-tender-comment-submit-btn">
                        Add comment
                    </button>
                </form>
                <% } else { %>
                    <p class="text-secondary small mb-4">
                        Comments are locked on Unattended / Missed tenders (super admin only).
                    </p>
                <% } %>

                <div
                    id="gem-tender-comments-empty"
                    class="text-secondary <%= comments && comments.length ? 'd-none' : '' %>"
                >
                    No comments yet.
                </div>
                <ul class="list-group list-group-flush" id="gem-tender-comments-list">
                    <% (comments || []).forEach(function (comment) { %>
                        <li
                            class="list-group-item px-0"
                            data-id="<%= comment.id %>"
                            data-user-id="<%= comment.user_id %>"
                            data-comment="<%= encodeURIComponent(comment.comment || '') %>"
                        >
                            <div class="d-flex justify-content-between gap-3 mb-2">
                                <strong><%= comment.user_full_name || comment.user_email %></strong>
                                <span
                                    class="text-secondary small text-nowrap"
                                    data-readable-date="<%= comment.created_on %>"
                                    data-date-format="YYYY-MM-DD HH:mm:ss"
                                ></span>
                            </div>
                            <p class="mb-2 gem-tender-comment-body"><%= comment.comment %></p>
                            <% if (comment.media_id && comment.attachment_name) { %>
                                <p class="mb-2 small">
                                    <a
                                        href="/api/media/<%= comment.media_id %>"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="gem-tender-comment-attachment"
                                    >
                                        Attachment: <%= comment.attachment_name %>
                                    </a>
                                </p>
                            <% } %>
                            <% if (canUseComments && Number(comment.user_id) === currentUserId) { %>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary gem-tender-comment-edit-btn">
                                        Edit
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger gem-tender-comment-delete-btn">
                                        Delete
                                    </button>
                                </div>
                            <% } %>
                        </li>
                    <% }) %>
                </ul>
            </div>

            <div
                class="tab-pane fade"
                id="gem-tender-documents-pane"
                role="tabpanel"
                aria-labelledby="gem-tender-documents-tab"
            >
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <p class="text-secondary small mb-0">Tender documents for this bid.</p>
                    <% if (canManageDocs) { %>
                        <button
                            type="button"
                            class="btn btn-sm btn-primary"
                            id="gem-tender-documents-add-btn"
                            data-bs-toggle="modal"
                            data-bs-target="#gem-tender-documents-modal"
                        >
                            Add documents
                        </button>
                    <% } %>
                </div>

                <div
                    id="gem-tender-documents-empty"
                    class="text-secondary <%= documents && documents.length ? 'd-none' : '' %>"
                >
                    No documents yet.
                </div>

                <div
                    class="table-responsive <%= !documents || !documents.length ? 'd-none' : '' %>"
                    id="gem-tender-documents-table-wrap"
                >
                    <table class="table table-hover align-middle mb-0" id="gem-tender-documents-table">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Name</th>
                                <th scope="col">Uploaded</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="gem-tender-documents-tbody">
                            <% (documents || []).forEach(function (document) { %>
                                <tr data-id="<%= document.id %>">
                                    <td><%= document.name || document.media_name || "—" %></td>
                                    <td
                                        data-readable-date="<%= document.created_on || '' %>"
                                        data-date-format="DD/MM/YYYY HH:mm:ss"
                                    ></td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1 justify-content-end">
                                            <a
                                                href="/api/media/<%= document.media_id %>"
                                                class="btn btn-sm btn-outline-primary document-icon-btn"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                title="View"
                                                aria-label="View"
                                            >
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                                    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                                                </svg>
                                            </a>
                                            <% if (canManageDocs) { %>
                                                <button
                                                    type="button"
                                                    class="btn btn-sm btn-outline-danger document-icon-btn gem-tender-document-delete-btn"
                                                    title="Delete"
                                                    aria-label="Delete"
                                                >
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                                        <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                                    </svg>
                                                </button>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div
                class="tab-pane fade"
                id="gem-tender-quote-pane"
                role="tabpanel"
                aria-labelledby="gem-tender-quote-tab"
            >
                <div class="mb-3" style="max-width: 40rem;">
                    <label for="gem-tender-quote" class="form-label">Quote</label>
                    <textarea
                        class="form-control"
                        id="gem-tender-quote"
                        rows="6"
                        <%= !canEditQuote ? "disabled" : "" %>
                    ><%= tender.quote || "" %></textarea>
                    <button
                        type="button"
                        class="btn btn-sm btn-primary mt-2"
                        id="gem-tender-quote-save-btn"
                        <%= !canEditQuote ? "disabled" : "" %>
                    >
                        Save quote
                    </button>
                    <% if (!quoteStageEnabled) { %>
                        <p class="form-text mb-0">Quote is not available in this stage.</p>
                    <% } else if (!canEditQuote) { %>
                        <p class="form-text mb-0">Only the assignee or a super admin can edit the quote.</p>
                    <% } %>
                </div>
            </div>

            <div
                class="tab-pane fade"
                id="gem-tender-activities-pane"
                role="tabpanel"
                aria-labelledby="gem-tender-activities-tab"
            >
                <div
                    id="gem-tender-activities-empty"
                    class="text-secondary <%= activities && activities.length ? 'd-none' : '' %>"
                >
                    No activities yet.
                </div>
                <ul class="list-group list-group-flush" id="gem-tender-activities-list">
                    <% (activities || []).forEach(function (activity) { %>
                        <li class="list-group-item px-0">
                            <div class="d-flex justify-content-between gap-3">
                                <div>
                                    <strong><%= activity.user_full_name || activity.user_email %></strong>
                                    <span class="text-secondary">— <%= activity.activity %></span>
                                </div>
                                <span
                                    class="text-secondary small text-nowrap"
                                    data-readable-date="<%= activity.created_on %>"
                                    data-date-format="YYYY-MM-DD HH:mm:ss"
                                ></span>
                            </div>
                        </li>
                    <% }) %>
                </ul>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="gem-tender-comment-edit-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="gem-tender-comment-edit-form" novalidate>
                <input type="hidden" id="gem-tender-comment-edit-id" value="" />
                <div class="modal-header">
                    <h2 class="modal-title h5">Edit comment</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="gem-tender-comment-edit-alert" class="alert d-none" role="alert"></div>
                    <textarea class="form-control" id="gem-tender-comment-edit-text" rows="5" required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="gem-tender-comment-edit-save-btn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<% if (canManageDocs) { %>
<div class="modal fade" id="gem-tender-documents-modal" tabindex="-1" aria-labelledby="gem-tender-documents-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="gem-tender-documents-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="gem-tender-documents-modal-label">Add documents</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="gem-tender-documents-form-alert" class="alert d-none" role="alert"></div>
                    <div class="mb-3">
                        <label for="gem-tender-documents-files" class="form-label">Files</label>
                        <input
                            type="file"
                            class="form-control"
                            id="gem-tender-documents-files"
                            multiple
                            required
                        />
                        <div class="form-text">Select one or more files. A visible name is required for each.</div>
                    </div>
                    <div id="gem-tender-documents-name-list" class="d-none">
                        <p class="form-label">Visible names</p>
                        <div id="gem-tender-documents-name-fields" class="d-grid gap-2"></div>
                    </div>
                    <div id="gem-tender-documents-upload-progress" class="d-none mt-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small text-secondary" id="gem-tender-documents-upload-status">Uploading…</span>
                            <span class="small text-secondary" id="gem-tender-documents-upload-percent">0%</span>
                        </div>
                        <div
                            class="progress"
                            role="progressbar"
                            aria-valuemin="0"
                            aria-valuemax="100"
                            aria-valuenow="0"
                            id="gem-tender-documents-upload-progressbar"
                        >
                            <div
                                class="progress-bar progress-bar-striped progress-bar-animated"
                                id="gem-tender-documents-upload-bar"
                                style="width: 0%"
                            ></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="gem-tender-documents-submit-btn" disabled>
                        Upload
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<% } %>

<style>
    .document-icon-btn {
        width: 2rem;
        height: 2rem;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .gem-tender-timeline-track {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 0.35rem 0.4rem;
        overflow-x: auto;
        padding-bottom: 0.25rem;
    }
    .gem-tender-timeline-node {
        min-width: 5.5rem;
        max-width: 7.5rem;
        text-align: center;
    }
    .gem-tender-timeline-dot {
        width: 0.75rem;
        height: 0.75rem;
        border-radius: 50%;
        margin: 0 auto 0.35rem;
        background: #ced4da;
        border: 2px solid #adb5bd;
    }
    .gem-tender-timeline-label {
        font-size: 0.72rem;
        font-weight: 600;
        line-height: 1.2;
        color: #6c757d;
    }
    .gem-tender-timeline-time {
        font-size: 0.68rem;
        color: #868e96;
        margin-top: 0.15rem;
    }
    .gem-tender-timeline-arrow {
        align-self: center;
        color: #adb5bd;
        font-weight: 700;
        padding-top: 0.1rem;
    }
    .gem-tender-timeline-arrow.is-active {
        color: #0d6efd;
    }
    .gem-tender-timeline-node-done .gem-tender-timeline-dot {
        background: #198754;
        border-color: #146c43;
    }
    .gem-tender-timeline-node-done .gem-tender-timeline-label {
        color: #146c43;
    }
    .gem-tender-timeline-node-current .gem-tender-timeline-dot {
        background: #0d6efd;
        border-color: #0a58ca;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
    }
    .gem-tender-timeline-node-current .gem-tender-timeline-label {
        color: #0a58ca;
    }
    .gem-tender-timeline-branch-badge {
        display: inline-block;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
        background: #e9ecef;
        color: #495057;
    }
    .gem-tender-timeline-branch-badge.gem-tender-stage-missed,
    .gem-tender-timeline-branch-badge.gem-tender-stage-unattended {
        background: #fff3cd;
        color: #7a5b00;
    }
    .gem-tender-timeline-branch-badge.gem-tender-stage-out_of_scope,
    .gem-tender-timeline-branch-badge.gem-tender-stage-not_eligible {
        background: #f8d7da;
        color: #842029;
    }
</style>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/gem-keyword-tender.js" defer></script>
<%- include('common/footer') %>

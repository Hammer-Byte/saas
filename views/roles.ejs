<%- include('common/header') %>

<%- include('common/app-navbar') %>

<main class="hb-main">
    <div class="container hb-page">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> / Roles
                </p>
                <h1 class="h3 mb-1">Roles</h1>
                <p class="text-secondary mb-0">Create roles and assign authorities to them.</p>
            </div>
            <% if ((authorities || []).includes(AUTHORITIES.MANAGE_ROLES)) { %>
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#role-modal"
                id="open-add-role-btn"
            >
                Add role
            </button>
            <% } %>
        </div>

        <div id="roles-alert" class="alert d-none" role="alert"></div>

        <%- include('common/table-filters', { searchId: "roles-search", searchPlaceholder: "Search roles…" }) %>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div id="roles-empty" class="p-4 p-md-5 text-center text-secondary <%= allRoles && allRoles.length ? 'd-none' : '' %>">
                    No roles found.
                </div>
                <div class="table-responsive <%= !allRoles || !allRoles.length ? 'd-none' : '' %>" id="roles-table-wrap">
                    <table class="table table-hover align-middle mb-0" id="roles-table">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="hb-sortable" data-sort-key="id">ID</th>
                                <th scope="col" class="hb-sortable" data-sort-key="title">Title</th>
                                <th scope="col" class="hb-sortable" data-sort-key="active">Active</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="roles-tbody">
                            <% (allRoles || []).forEach(function (role) { %>
                                <tr
                                    class="hb-row-link"
                                    data-href="/app/roles/<%= role.id %>"
                                    data-id="<%= role.id %>"
                                    data-title="<%= role.title %>"
                                    data-active="<%= role.active ? '1' : '0' %>"
                                >
                                    <td><%= role.id %></td>
                                    <td><%= role.title %></td>
                                    <td><%= role.active ? "Yes" : "No" %></td>
                                    <td>
                                        <div class="d-inline-flex gap-1 justify-content-end flex-wrap hb-icon-actions">
                                            <% if ((authorities || []).includes(AUTHORITIES.MANAGE_ROLE_AUTHORITIES)) { %>
                                            <button type="button" class="btn btn-sm btn-outline-secondary role-authorities-btn">Authorities</button>
                                            <% } %>
                                            <% if ((authorities || []).includes(AUTHORITIES.MANAGE_ROLES)) { %>
                                            <button type="button" class="btn btn-sm btn-outline-secondary hb-icon-btn role-edit-btn" title="Edit" aria-label="Edit"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/></svg></button>
                                            <button type="button" class="btn btn-sm btn-outline-danger hb-icon-btn role-delete-btn" title="Delete" aria-label="Delete"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/></svg></button>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="role-modal" tabindex="-1" aria-labelledby="role-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="role-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="role-modal-label">Add role</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="role-form-alert" class="alert d-none" role="alert"></div>
                    <input type="hidden" id="role-id" name="id" value="" />
                    <div class="mb-3">
                        <label for="role-title" class="form-label">Title</label>
                        <input type="text" class="form-control text-uppercase" id="role-title" name="title" maxlength="36" required />
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="role-active" name="active" checked />
                        <label class="form-check-label" for="role-active">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="role-submit-btn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="role-authorities-modal" tabindex="-1" aria-labelledby="role-authorities-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="role-authorities-modal-label">Role authorities</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="role-authorities-alert" class="alert d-none" role="alert"></div>
                <input type="hidden" id="role-authorities-role-id" value="" />
                <div id="role-authorities-list" class="d-flex flex-column gap-2">
                    <% (allAuthorities || []).forEach(function (authority) { %>
                        <div class="form-check">
                            <input
                                type="checkbox"
                                class="form-check-input role-authority-checkbox"
                                id="role-authority-<%= authority.id %>"
                                data-authority-id="<%= authority.id %>"
                                value="<%= authority.id %>"
                            />
                            <label class="form-check-label" for="role-authority-<%= authority.id %>">
                                <strong><%= authority.title %></strong>
                                <span class="text-secondary small"> — <%= authority.description %></span>
                            </label>
                        </div>
                    <% }) %>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    window.__ALL_AUTHORITIES__ = <%- JSON.stringify(allAuthorities || []) %>;
</script>
<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/roles.js" defer></script>
<%- include('common/footer') %>

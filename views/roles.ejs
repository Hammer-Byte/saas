<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> / Roles
                </p>
                <h1 class="h3 mb-1">Roles</h1>
                <p class="text-secondary mb-0">Create roles and assign authorities to them.</p>
            </div>
            <% if ((authorities || []).includes(AUTHORITIES.MANAGE_ROLES)) { %>
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#role-modal"
                id="open-add-role-btn"
            >
                Add Role
            </button>
            <% } %>
        </div>

        <div id="roles-alert" class="alert d-none" role="alert"></div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div id="roles-empty" class="p-4 p-md-5 text-center text-secondary <%= allRoles && allRoles.length ? 'd-none' : '' %>">
                    No roles found.
                </div>
                <div class="table-responsive <%= !allRoles || !allRoles.length ? 'd-none' : '' %>" id="roles-table-wrap">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">Title</th>
                                <th scope="col">Active</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="roles-tbody">
                            <% (allRoles || []).forEach(function (role) { %>
                                <tr
                                    data-id="<%= role.id %>"
                                    data-title="<%= role.title %>"
                                    data-active="<%= role.active ? '1' : '0' %>"
                                >
                                    <td><%= role.id %></td>
                                    <td><%= role.title %></td>
                                    <td><%= role.active ? "Yes" : "No" %></td>
                                    <td>
                                        <div class="d-flex gap-2 flex-wrap">
                                            <% if ((authorities || []).includes(AUTHORITIES.MANAGE_ROLE_AUTHORITIES)) { %>
                                            <button type="button" class="btn btn-sm btn-outline-secondary role-authorities-btn">
                                                Authorities
                                            </button>
                                            <% } %>
                                            <% if ((authorities || []).includes(AUTHORITIES.MANAGE_ROLES)) { %>
                                            <button type="button" class="btn btn-sm btn-outline-primary role-edit-btn">Edit</button>
                                            <button type="button" class="btn btn-sm btn-outline-danger role-delete-btn">Delete</button>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="role-modal" tabindex="-1" aria-labelledby="role-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="role-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="role-modal-label">Add role</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="role-form-alert" class="alert d-none" role="alert"></div>
                    <input type="hidden" id="role-id" name="id" value="" />
                    <div class="mb-3">
                        <label for="role-title" class="form-label">Title</label>
                        <input type="text" class="form-control text-uppercase" id="role-title" name="title" maxlength="36" required />
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="role-active" name="active" checked />
                        <label class="form-check-label" for="role-active">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="role-submit-btn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="role-authorities-modal" tabindex="-1" aria-labelledby="role-authorities-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="role-authorities-modal-label">Role authorities</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="role-authorities-alert" class="alert d-none" role="alert"></div>
                <input type="hidden" id="role-authorities-role-id" value="" />
                <div id="role-authorities-list" class="d-flex flex-column gap-2">
                    <% (allAuthorities || []).forEach(function (authority) { %>
                        <div class="form-check">
                            <input
                                type="checkbox"
                                class="form-check-input role-authority-checkbox"
                                id="role-authority-<%= authority.id %>"
                                data-authority-id="<%= authority.id %>"
                                value="<%= authority.id %>"
                            />
                            <label class="form-check-label" for="role-authority-<%= authority.id %>">
                                <strong><%= authority.title %></strong>
                                <span class="text-secondary small"> — <%= authority.description %></span>
                            </label>
                        </div>
                    <% }) %>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    window.__ALL_AUTHORITIES__ = <%- JSON.stringify(allAuthorities || []) %>;
</script>
<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/roles.js" defer></script>
<%- include('common/footer') %>

<%- include('common/header') %>

<%- include('common/app-navbar') %>

<main class="hb-main">
    <div class="container hb-page">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> / Invoices
                </p>
                <h1 class="h3 mb-1">Invoices</h1>
                <p class="text-secondary mb-0">Customer project invoices.</p>
            </div>
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#invoice-modal"
            >
                Add invoice
            </button>
        </div>

        <div id="invoices-alert" class="alert d-none" role="alert"></div>

        <%- include('common/table-filters', { searchId: "invoices-search", searchPlaceholder: "Search invoices…" }) %>
        <p class="text-secondary small mb-3 d-none" id="invoices-empty-filter" role="status">No invoices match your search.</p>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <% if (!invoices || invoices.length === 0) { %>
                    <div class="p-4 p-md-5 text-center text-secondary">
                        No invoices found.
                    </div>
                <% } else { %>
                    <div class="table-responsive" id="invoices-table-wrap">
                        <table class="table table-hover align-middle mb-0" id="invoices-table">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="hb-sortable" data-sort-key="id">ID</th>
                                    <th scope="col" class="hb-sortable" data-sort-key="customer">Customer</th>
                                    <th scope="col" class="hb-sortable" data-sort-key="project">Project</th>
                                    <th scope="col" class="hb-sortable" data-sort-key="dueDate">Due date</th>
                                    <th scope="col" class="hb-sortable" data-sort-key="total">Total</th>
                                    <th scope="col" class="hb-sortable" data-sort-key="pending">Pending</th>
                                    <th scope="col" class="hb-sortable" data-sort-key="status">Status</th>
                                    <th scope="col" class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% invoices.forEach(function (invoice) { %>
                                    <%
                                        const grandTotal = Number(invoice.total) + Number(invoice.gst);
                                        const paidTotal = Number(invoice.paid_total || 0);
                                        const pendingTotal = Math.max(grandTotal - paidTotal, 0);
                                        let billStatus = "Due";
                                        if (paidTotal >= grandTotal && grandTotal > 0) {
                                            billStatus = "Paid";
                                        } else if (paidTotal > 0) {
                                            billStatus = "Partial";
                                        }
                                    %>
                                    <tr
                                        class="invoice-row hb-row-link"
                                        data-href="/app/invoices/<%= invoice.id %>"
                                        data-id="<%= invoice.id %>"
                                        data-customer="<%= invoice.customer_name || '' %>"
                                        data-project="<%= invoice.project_title || '' %>"
                                        data-due-date="<%= invoice.due_date || '' %>"
                                        data-total="<%= grandTotal %>"
                                        data-pending="<%= pendingTotal %>"
                                        data-status="<%= billStatus %>"
                                    >
                                        <td>
                                            <%= resolveInvoiceNumber({
                                                hbt_sequence: invoice.hbt_sequence,
                                                id: invoice.id,
                                            }) %>
                                        </td>
                                        <td><%= invoice.customer_name %></td>
                                        <td><%= invoice.project_title || "-" %></td>
                                        <td data-readable-date="<%= invoice.due_date %>" data-date-format="DD/MM/YYYY"></td>
                                        <td><%= grandTotal.toFixed(2) %></td>
                                        <td><%= pendingTotal.toFixed(2) %></td>
                                        <td><%= billStatus %></td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-1 justify-content-end hb-icon-actions">
                                            <button type="button" class="btn btn-sm btn-outline-danger hb-icon-btn invoice-delete-btn" title="Delete" aria-label="Delete" data-id="<%= invoice.id %>"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/></svg></button>
                                        </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="invoice-modal" tabindex="-1" aria-labelledby="invoice-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form id="invoice-form" class="hb-modal-scrollable-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="invoice-modal-label">Add invoice</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="invoice-form-alert" class="alert d-none" role="alert"></div>
                    <div class="mb-3">
                        <label for="customer_id" class="form-label">Customer</label>
                        <select class="form-select" id="customer_id" name="customer_id" required>
                            <option value="">Select a customer</option>
                            <% (customers || []).forEach(function (customer) { %>
                                <option value="<%= customer.id %>"><%= customer.full_name %> — <%= customer.company %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="project_id" class="form-label">Project</label>
                        <select class="form-select" id="project_id" name="project_id" required>
                            <option value="">Select a project</option>
                            <% (customerProjects || []).forEach(function (project) { %>
                                <option value="<%= project.id %>" data-customer-id="<%= project.customer_id %>">
                                    <%= project.customer_name %> — <%= project.title %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="invoice-date" class="form-label">Date</label>
                        <input type="month" class="form-control" id="invoice-date" name="date" required />
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label mb-0">Items</label>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="add-invoice-item-btn">
                            Add item
                        </button>
                    </div>
                    <div id="invoice-items" class="d-flex flex-column gap-3 mb-0"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/invoices.js" defer></script>
<%- include('common/footer') %>

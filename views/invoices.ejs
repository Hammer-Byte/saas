<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= typeof username !== "undefined" && username ? username : "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> / Invoices
                </p>
                <h1 class="h3 mb-1">Invoices</h1>
                <p class="text-secondary mb-0">Customer invoices from CUSTOMER_INVOICES.</p>
            </div>
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#invoice-modal"
                id="open-add-invoice-btn"
            >
                Add Invoice
            </button>
        </div>

        <div id="invoices-alert" class="alert d-none" role="alert"></div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <% if (!invoices || invoices.length === 0) { %>
                    <div class="p-4 p-md-5 text-center text-secondary">
                        No invoices found.
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">ID</th>
                                    <th scope="col">Customer</th>
                                    <th scope="col">Due date</th>
                                    <th scope="col">Total</th>
                                    <th scope="col">GST</th>
                                    <th scope="col">Created</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% invoices.forEach(function (invoice) { %>
                                    <tr>
                                        <td><%= invoice.id %></td>
                                        <td><%= invoice.customer_name %><% if (invoice.customer_company) { %> <span class="text-secondary">(<%= invoice.customer_company %>)</span><% } %></td>
                                        <td><%= invoice.due_date %></td>
                                        <td><%= Number(invoice.total).toFixed(2) %></td>
                                        <td><%= Number(invoice.gst).toFixed(2) %></td>
                                        <td><%= invoice.created_on ? new Date(invoice.created_on).toLocaleString() : "-" %></td>
                                        <td>
                                            <button
                                                type="button"
                                                class="btn btn-sm btn-outline-danger invoice-delete-btn"
                                                data-id="<%= invoice.id %>"
                                            >
                                                Delete
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="invoice-modal" tabindex="-1" aria-labelledby="invoice-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="invoice-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="invoice-modal-label">Add invoice</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="invoice-form-alert" class="alert d-none" role="alert"></div>
                    <div class="mb-3">
                        <label for="customer_id" class="form-label">Customer</label>
                        <select class="form-select" id="customer_id" name="customer_id" required>
                            <option value="">Select a customer</option>
                            <% (customers || []).forEach(function (customer) { %>
                                <option value="<%= customer.id %>"><%= customer.full_name %> — <%= customer.company %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="due_date" class="form-label">Due date</label>
                        <input type="date" class="form-control" id="due_date" name="due_date" required />
                    </div>
                    <div class="mb-3">
                        <label for="total" class="form-label">Total</label>
                        <input type="number" class="form-control" id="total" name="total" min="0" step="0.01" value="0" />
                    </div>
                    <div class="mb-0">
                        <label for="gst" class="form-label">GST</label>
                        <input type="number" class="form-control" id="gst" name="gst" min="0" step="0.01" value="0" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/invoices.js" defer></script>
<%- include('common/footer') %>

<%- include('common/header') %>

<%
    const stateLabels = INQUIRY_STATE_LABELS || {};
    const stateValues = Object.keys(stateLabels);
    const sourceLabels = INQUIRY_SOURCE_LABELS || {};
    const followupOffsets = INQUIRY_FOLLOWUP_DAY_OFFSETS || { 1: 3, 2: 7, 3: 15 };
    const canAssignOthers = (authorities || []).includes(AUTHORITIES.ASSIGN_INQUIRY_ASSIGNEE)
        || !!super_admin
        || (Array.isArray(roles) && roles.includes("ADMIN"));
    const isAdmin = !!super_admin || (Array.isArray(roles) && roles.includes("ADMIN"));
    const currentUserId = Number(userId || 0);

    function displaySource(source) {
        if (!source) return "website";
        return source;
    }

    function sourceLabel(source) {
        const key = displaySource(source);
        return sourceLabels[key] || key;
    }
%>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light inquiries-page">
    <div class="container-fluid px-3 px-lg-4 py-3 inquiries-page-inner">
        <div class="mb-3 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> / Inquiries
                </p>
                <h1 class="h3 mb-1">Inquiries</h1>
                <p class="text-secondary mb-0">
                    Created
                    <span data-readable-date="<%= from %>" data-date-format="DD/MM/YYYY"><%= from %></span>
                    –
                    <span data-readable-date="<%= to %>" data-date-format="DD/MM/YYYY"><%= to %></span>.
                </p>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <button
                    type="button"
                    class="btn btn-outline-secondary"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#inquiries-filters-panel"
                    aria-controls="inquiries-filters-panel"
                >
                    Filters
                </button>
                <% if (isAdmin) { %>
                    <button
                        type="button"
                        class="btn btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#inquiry-add-modal"
                    >
                        Add inquiry
                    </button>
                <% } %>
                <a
                    href="/app/inquiries-report?from=<%= from %>&to=<%= to %>"
                    class="btn btn-outline-primary"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Report
                </a>
            </div>
        </div>

        <p class="text-secondary small mb-3" id="inquiries-filter-status" role="status"></p>
        <div id="inquiry-add-alert" class="alert d-none" role="alert"></div>

        <div
            class="offcanvas offcanvas-end"
            tabindex="-1"
            id="inquiries-filters-panel"
            aria-labelledby="inquiries-filters-panel-label"
        >
            <div class="offcanvas-header border-bottom">
                <h2 class="offcanvas-title h5 mb-0" id="inquiries-filters-panel-label">Filters</h2>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column p-0">
                <div class="flex-grow-1 overflow-auto p-3" id="inquiries-filters-form">
                    <div class="mb-3">
                        <div class="row g-2">
                            <div class="col-6">
                                <label for="inquiries-from" class="form-label">Created from</label>
                                <input
                                    type="date"
                                    class="form-control form-control-sm"
                                    id="inquiries-from"
                                    value="<%= from %>"
                                    data-page-from="<%= from %>"
                                    autocomplete="off"
                                />
                            </div>
                            <div class="col-6">
                                <label for="inquiries-to" class="form-label">Created to</label>
                                <input
                                    type="date"
                                    class="form-control form-control-sm"
                                    id="inquiries-to"
                                    value="<%= to %>"
                                    data-page-to="<%= to %>"
                                    autocomplete="off"
                                />
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm inquiries-date-quick-btn" data-range="today">
                                Today
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm inquiries-date-quick-btn" data-range="this-week">
                                This week
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm inquiries-date-quick-btn" data-range="last-7-days">
                                Last 7 days
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm inquiries-date-quick-btn" data-range="last-15-days">
                                Last 15 days
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm inquiries-date-quick-btn" data-range="last-30-days">
                                Last 30 days
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm inquiries-date-quick-btn" data-range="this-month">
                                This month
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm inquiries-date-quick-btn" data-range="last-month">
                                Last month
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm inquiries-date-quick-btn" data-range="this-quarter">
                                This quarter
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm inquiries-date-quick-btn" data-range="last-quarter">
                                Last quarter
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="inquiries-search" class="form-label">Search</label>
                        <div class="input-group input-group-sm">
                            <input
                                type="search"
                                class="form-control"
                                id="inquiries-search"
                                placeholder="Name, phone, email…"
                                autocomplete="off"
                            />
                            <button
                                type="button"
                                class="btn btn-outline-secondary inquiries-filter-clear-btn inquiries-filter-clear-x"
                                data-clear-input="inquiries-search"
                                title="Clear search"
                                aria-label="Clear search"
                            >×</button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <span class="form-label d-block">State</span>
                        <div class="d-flex gap-1 align-items-stretch">
                            <div
                                class="dropdown inquiries-multi-filter flex-grow-1"
                                id="inquiries-filter-state"
                                data-empty-label="All states"
                            >
                                <button
                                    class="btn btn-outline-secondary btn-sm dropdown-toggle w-100 text-start inquiries-multi-filter-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    data-bs-auto-close="outside"
                                    data-bs-display="static"
                                    aria-expanded="false"
                                >
                                    <span class="inquiries-multi-filter-label">All states</span>
                                </button>
                                <div class="dropdown-menu inquiries-multi-filter-menu p-2 shadow">
                                    <% stateValues.forEach(function (state) { %>
                                        <div class="form-check">
                                            <input
                                                class="form-check-input inquiries-multi-filter-option"
                                                type="checkbox"
                                                value="<%= state %>"
                                                data-label="<%= stateLabels[state] %>"
                                                id="filter-state-<%= state %>"
                                            />
                                            <label class="form-check-label" for="filter-state-<%= state %>">
                                                <%= stateLabels[state] %>
                                            </label>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                            <button
                                type="button"
                                class="btn btn-outline-secondary btn-sm inquiries-filter-clear-btn inquiries-filter-clear-x"
                                data-clear-multi="inquiries-filter-state"
                                title="Clear state"
                                aria-label="Clear state"
                            >×</button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <span class="form-label d-block">Source</span>
                        <div class="d-flex gap-1 align-items-stretch">
                            <div
                                class="dropdown inquiries-multi-filter flex-grow-1"
                                id="inquiries-filter-source"
                                data-empty-label="All sources"
                            >
                                <button
                                    class="btn btn-outline-secondary btn-sm dropdown-toggle w-100 text-start inquiries-multi-filter-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    data-bs-auto-close="outside"
                                    data-bs-display="static"
                                    aria-expanded="false"
                                >
                                    <span class="inquiries-multi-filter-label">All sources</span>
                                </button>
                                <div class="dropdown-menu inquiries-multi-filter-menu p-2 shadow">
                                    <% Object.keys(sourceLabels).forEach(function (source) { %>
                                        <div class="form-check">
                                            <input
                                                class="form-check-input inquiries-multi-filter-option"
                                                type="checkbox"
                                                value="<%= source %>"
                                                data-label="<%= sourceLabels[source] %>"
                                                id="filter-source-<%= source %>"
                                            />
                                            <label class="form-check-label" for="filter-source-<%= source %>">
                                                <%= sourceLabels[source] %>
                                            </label>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                            <button
                                type="button"
                                class="btn btn-outline-secondary btn-sm inquiries-filter-clear-btn inquiries-filter-clear-x"
                                data-clear-multi="inquiries-filter-source"
                                title="Clear source"
                                aria-label="Clear source"
                            >×</button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <span class="form-label d-block">Assignee</span>
                        <div class="d-flex gap-1 align-items-stretch">
                            <div
                                class="dropdown inquiries-multi-filter flex-grow-1"
                                id="inquiries-filter-assignee"
                                data-empty-label="All assignees"
                            >
                                <button
                                    class="btn btn-outline-secondary btn-sm dropdown-toggle w-100 text-start inquiries-multi-filter-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    data-bs-auto-close="outside"
                                    data-bs-display="static"
                                    aria-expanded="false"
                                >
                                    <span class="inquiries-multi-filter-label">All assignees</span>
                                </button>
                                <div class="dropdown-menu inquiries-multi-filter-menu p-2 shadow">
                                    <div class="form-check">
                                        <input
                                            class="form-check-input inquiries-multi-filter-option"
                                            type="checkbox"
                                            value="unassigned"
                                            data-label="Unassigned"
                                            id="filter-assignee-unassigned"
                                        />
                                        <label class="form-check-label" for="filter-assignee-unassigned">
                                            Unassigned
                                        </label>
                                    </div>
                                    <% (users || []).forEach(function (user) { %>
                                        <div class="form-check">
                                            <input
                                                class="form-check-input inquiries-multi-filter-option"
                                                type="checkbox"
                                                value="<%= user.id %>"
                                                data-label="<%= user.full_name %>"
                                                id="filter-assignee-<%= user.id %>"
                                            />
                                            <label class="form-check-label" for="filter-assignee-<%= user.id %>">
                                                <%= user.full_name %>
                                            </label>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                            <button
                                type="button"
                                class="btn btn-outline-secondary btn-sm inquiries-filter-clear-btn inquiries-filter-clear-x"
                                data-clear-multi="inquiries-filter-assignee"
                                title="Clear assignee"
                                aria-label="Clear assignee"
                            >×</button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="inquiries-filter-followup" class="form-label">Follow-ups</label>
                        <div class="input-group input-group-sm">
                            <select class="form-select" id="inquiries-filter-followup">
                                <option value="">Any</option>
                                <option value="pending">Pending follow-ups</option>
                                <option value="1">1st follow-up</option>
                                <option value="2">2nd follow-up</option>
                                <option value="3">3rd follow-up</option>
                            </select>
                            <button
                                type="button"
                                class="btn btn-outline-secondary inquiries-filter-clear-btn inquiries-filter-clear-x"
                                data-clear-select="inquiries-filter-followup"
                                title="Clear follow-ups"
                                aria-label="Clear follow-ups"
                            >×</button>
                        </div>
                    </div>
                </div>
                <div class="border-top p-3 d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary flex-grow-1" id="inquiries-filters-reset-btn">
                        Reset
                    </button>
                    <button type="button" class="btn btn-primary flex-grow-1" id="inquiries-filters-apply-btn">
                        Apply
                    </button>
                </div>
            </div>
        </div>

        <div id="inquiries-loading" class="text-center text-secondary py-5">Loading inquiries…</div>
        <div id="inquiries-empty" class="text-center text-secondary py-5 d-none">No inquiries match the filters.</div>

        <div id="inquiries-table-wrap" class="card border-0 shadow-sm d-none">
            <div class="card-body p-0">
                <div class="table-responsive inquiries-table-scroll">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">Created</th>
                                <th scope="col">Name</th>
                                <th scope="col">Phone</th>
                                <th scope="col">Email</th>
                                <th scope="col">Source</th>
                                <th scope="col">State</th>
                                <th scope="col">Assignee</th>
                                <th scope="col">Follow-up</th>
                            </tr>
                        </thead>
                        <tbody id="inquiries-tbody">
                            <% (inquiries || []).forEach(function (inquiry) { %>
                                <%
                                    const sourceKey = displaySource(inquiry.source);
                                    const followupCount = Number(inquiry.followup_count || 0);
                                    const openSlot = inquiry.state === "potential" && followupCount < 3
                                        ? followupCount + 1
                                        : 0;
                                %>
                                <tr
                                    class="inquiry-row"
                                    data-id="<%= inquiry.id %>"
                                    data-state="<%= inquiry.state || 'new' %>"
                                    data-source="<%= sourceKey %>"
                                    data-assignee-user-id="<%= inquiry.assignee_user_id || 'unassigned' %>"
                                    data-potential-entered-on="<%= inquiry.potential_entered_on || '' %>"
                                    data-followup-count="<%= followupCount %>"
                                    data-open-slot="<%= openSlot %>"
                                    data-search="<%= [inquiry.full_name, inquiry.phone, inquiry.email].filter(Boolean).join(' ').toLowerCase() %>"
                                >
                                    <td>
                                        <a href="/app/inquiries/<%= inquiry.id %>" target="_blank" rel="noopener noreferrer">
                                            #<%= inquiry.id %>
                                        </a>
                                    </td>
                                    <td
                                        data-readable-date="<%= inquiry.created_on || '' %>"
                                        data-date-format="DD/MM/YYYY HH:mm"
                                    ></td>
                                    <td><%= inquiry.full_name || "—" %></td>
                                    <td><%= inquiry.phone %></td>
                                    <td><%= inquiry.email || "—" %></td>
                                    <td><%= sourceLabel(inquiry.source) %></td>
                                    <td>
                                        <span class="badge text-bg-secondary inquiry-state-tag">
                                            <%= stateLabels[inquiry.state] || inquiry.state || "New" %>
                                        </span>
                                    </td>
                                    <td><%= inquiry.assignee_full_name || "Unassigned" %></td>
                                    <td class="inquiry-followup-cell">
                                        <% if (inquiry.state === "potential") { %>
                                            <%= followupCount %>/3
                                            <% if (openSlot) { %>
                                                <span class="text-secondary small">(next #<%= openSlot %>)</span>
                                            <% } %>
                                        <% } else { %>
                                            —
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<% if (isAdmin) { %>
    <div class="modal fade" id="inquiry-add-modal" tabindex="-1" aria-labelledby="inquiry-add-modal-label" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="inquiry-add-form" novalidate>
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="inquiry-add-modal-label">Add inquiry</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div id="inquiry-add-form-alert" class="alert d-none" role="alert"></div>
                        <div class="mb-3">
                            <label for="inquiry-add-full-name" class="form-label">Full name</label>
                            <input type="text" class="form-control" id="inquiry-add-full-name" maxlength="128" />
                        </div>
                        <div class="mb-3">
                            <label for="inquiry-add-phone" class="form-label">Phone <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="inquiry-add-phone" maxlength="13" required />
                        </div>
                        <div class="mb-3">
                            <label for="inquiry-add-email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="inquiry-add-email" maxlength="255" />
                        </div>
                        <div class="mb-3">
                            <label for="inquiry-add-institute" class="form-label">Institute</label>
                            <input type="text" class="form-control" id="inquiry-add-institute" maxlength="128" />
                        </div>
                        <div class="mb-3">
                            <label for="inquiry-add-city" class="form-label">City</label>
                            <input type="text" class="form-control" id="inquiry-add-city" maxlength="64" />
                        </div>
                        <div class="mb-3">
                            <label for="inquiry-add-assignee" class="form-label">Assignee</label>
                            <select class="form-select" id="inquiry-add-assignee">
                                <option value="">Unassigned</option>
                                <% (users || []).forEach(function (user) { %>
                                    <option value="<%= user.id %>"><%= user.full_name %> (<%= user.email %>)</option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="mb-0">
                            <label for="inquiry-add-quote" class="form-label">Quote</label>
                            <textarea class="form-control" id="inquiry-add-quote" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" id="inquiry-add-submit-btn">Create</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
<% } %>

<style>
    .inquiries-page {
        min-height: calc(100vh - 56px);
    }
    .inquiries-table-scroll {
        max-height: calc(100vh - 220px);
        overflow: auto;
    }
    .inquiries-table-scroll thead th {
        z-index: 1;
    }
    .inquiries-filter-clear-x {
        width: 2rem;
        min-width: 2rem;
        padding-left: 0;
        padding-right: 0;
        line-height: 1;
        font-size: 1.1rem;
        font-weight: 600;
    }
    .input-group .inquiries-filter-clear-x {
        width: 2rem;
    }
    .inquiries-multi-filter .inquiries-multi-filter-toggle {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .inquiries-multi-filter-menu {
        max-height: 240px;
        overflow: auto;
        min-width: 100%;
    }
    .inquiries-multi-filter-menu .form-check {
        margin-bottom: 0.25rem;
    }
</style>

<script>
    window.INQUIRY_FOLLOWUP_DAY_OFFSETS = <%- JSON.stringify(followupOffsets) %>;
</script>
<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/inquiries.js" defer></script>
<%- include('common/footer') %>

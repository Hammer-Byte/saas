<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title || "Careers — HammerByte" %></title>
    <meta
        name="description"
        content="Open roles and internships at HammerByte in Nadiad. Apply online with your resume."
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://hammerbyte.co.in/careers" />
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/public/app.css" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark hb-navbar">
        <div class="container">
            <a class="navbar-brand" href="/">HammerByte</a>
            <div class="d-flex gap-2">
                <a href="/" class="btn btn-sm btn-outline-light">Home</a>
                <a href="/careers" class="btn btn-sm btn-outline-light">Careers</a>
            </div>
        </div>
    </nav>

    <main class="container hb-page">
        <div class="mb-4">
            <h1 class="h3 mb-1">Careers</h1>
            <p class="text-secondary mb-0">
                Open roles at HammerByte. View details or apply online with your resume.
            </p>
        </div>

        <% if (!jobs || jobs.length === 0) { %>
            <div class="card border-0 shadow-sm">
                <div class="card-body hb-empty">
                    No open positions right now. Check back soon.
                </div>
            </div>
        <% } else { %>
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="careers-table">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Title</th>
                                    <th scope="col">Experience</th>
                                    <th scope="col">Published</th>
                                    <th scope="col" class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% jobs.forEach(function (job) { %>
                                    <tr
                                        class="hb-row-link"
                                        data-href="/careers/<%= job.id %>"
                                    >
                                        <td><%= job.title %></td>
                                        <td><%= job.experience %></td>
                                        <td
                                            data-readable-date="<%= job.created_on || '' %>"
                                            data-date-format="DD/MM/YYYY"
                                        ></td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-2 justify-content-end">
                                                <a href="/careers/<%= job.id %>" class="btn btn-sm btn-outline-primary">Details</a>
                                                <a href="/careers/<%= job.id %>/apply" class="btn btn-sm btn-primary">Apply</a>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        <% } %>
    </main>

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"
    ></script>
    <script src="/public/utils.js" defer></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title || "Job details — HammerByte" %></title>
    <meta name="robots" content="index, follow" />
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous"
    />
    <link rel="stylesheet" href="/public/app.css" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark hb-navbar">
        <div class="container">
            <a class="navbar-brand" href="/">HammerByte</a>
            <div class="d-flex gap-2">
                <a href="/" class="btn btn-sm btn-outline-light">Home</a>
                <a href="/careers" class="btn btn-sm btn-outline-light">Careers</a>
            </div>
        </div>
    </nav>

    <main class="container hb-page">
        <div class="mb-4">
            <p class="text-secondary small mb-1">
                <a href="/careers" class="text-decoration-none">Careers</a> / <%= job.title %>
            </p>
            <h1 class="h3 mb-2"><%= job.title %></h1>
            <p class="text-secondary mb-1">Experience: <%= job.experience %></p>
            <p class="text-secondary mb-0">
                Published:
                <span
                    data-readable-date="<%= job.created_on || '' %>"
                    data-date-format="DD/MM/YYYY"
                ></span>
            </p>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">About the role</h2>
                <p class="mb-0" style="white-space: pre-wrap;"><%= job.description %></p>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a href="/careers/<%= job.id %>/apply" class="btn btn-primary">Apply</a>
            <a href="/careers" class="btn btn-outline-secondary">Back to careers</a>
        </div>
    </main>

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"
    ></script>
    <script src="/public/utils.js" defer></script>
</body>
</html>

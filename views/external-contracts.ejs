<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> / External Contracts
                </p>
                <h1 class="h3 mb-1">External Contracts</h1>
                <p class="text-secondary mb-0">Contracts with external parties.</p>
            </div>
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#external-contract-modal"
            >
                Add Contract
            </button>
        </div>

        <div id="external-contracts-alert" class="alert d-none" role="alert"></div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <% if (!contracts || contracts.length === 0) { %>
                    <div class="p-4 p-md-5 text-center text-secondary">
                        No external contracts found.
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Full name</th>
                                    <th scope="col">Company</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% contracts.forEach(function (contract) { %>
                                    <%
                                        const isSigned = contract.signature && contract.selfie && contract.identity;
                                    %>
                                    <tr>
                                        <td><%= contract.full_name %></td>
                                        <td><%= contract.company || "-" %></td>
                                        <td>
                                            <% if (isSigned) { %>
                                                <span class="badge text-bg-success">Signed</span>
                                            <% } else { %>
                                                <span class="badge text-bg-secondary">Unsigned</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 flex-wrap">
                                                <a
                                                    href="/external-contracts/<%= contract.signing_code %>/sign"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                >
                                                    View
                                                </a>
                                                <a
                                                    href="/app/external-contracts/<%= contract.id %>"
                                                    class="btn btn-sm btn-outline-primary"
                                                >
                                                    Edit
                                                </a>
                                                <button
                                                    type="button"
                                                    class="btn btn-sm btn-outline-danger external-contract-delete-btn"
                                                    data-id="<%= contract.id %>"
                                                >
                                                    Delete
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<div
    class="modal fade"
    id="external-contract-modal"
    tabindex="-1"
    aria-labelledby="external-contract-modal-label"
    aria-hidden="true"
>
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="external-contract-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="external-contract-modal-label">Add contract</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="external-contract-form-alert" class="alert d-none" role="alert"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="company" class="form-label">Company <span class="text-secondary fw-normal">(optional)</span></label>
                            <input
                                type="text"
                                class="form-control"
                                id="company"
                                name="company"
                                maxlength="128"
                            />
                        </div>
                        <div class="col-md-6">
                            <label for="full_name" class="form-label">Full name</label>
                            <input
                                type="text"
                                class="form-control"
                                id="full_name"
                                name="full_name"
                                maxlength="128"
                                required
                            />
                        </div>
                        <div class="col-md-6">
                            <label for="email" class="form-label">Email</label>
                            <input
                                type="email"
                                class="form-control"
                                id="email"
                                name="email"
                                maxlength="255"
                                required
                            />
                        </div>
                        <div class="col-md-6">
                            <label for="phone" class="form-label">Phone</label>
                            <input
                                type="text"
                                class="form-control"
                                id="phone"
                                name="phone"
                                maxlength="13"
                                required
                            />
                        </div>
                        <div class="col-12">
                            <label for="address" class="form-label">Address</label>
                            <textarea
                                class="form-control"
                                id="address"
                                name="address"
                                rows="3"
                                maxlength="512"
                                required
                            ></textarea>
                        </div>
                        <div class="col-md-6">
                            <label for="signable_till" class="form-label">Signable till</label>
                            <input
                                type="datetime-local"
                                class="form-control"
                                id="signable_till"
                                name="signable_till"
                                required
                            />
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    id="active"
                                    name="active"
                                    checked
                                />
                                <label class="form-check-label" for="active">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/external-contracts.js" defer></script>
<%- include('common/footer') %>

<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> /
                    <a href="/app/inquiries?from=<%= from %>&to=<%= to %>" class="text-decoration-none">Inquiries</a> /
                    Report
                </p>
                <h1 class="h3 mb-1">Inquiries report</h1>
                <p class="text-secondary mb-0">
                    Created
                    <strong data-readable-date="<%= from %>" data-date-format="DD/MM/YYYY"></strong>
                    to
                    <strong data-readable-date="<%= to %>" data-date-format="DD/MM/YYYY"></strong>.
                </p>
            </div>
            <a href="/app/inquiries?from=<%= from %>&to=<%= to %>" class="btn btn-outline-secondary">
                Back to inquiries
            </a>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3 p-md-4">
                <form class="row g-3 align-items-end" method="get" action="/app/inquiries-report">
                    <div class="col-6 col-md-3 col-lg-2">
                        <label for="report-from" class="form-label">From</label>
                        <input
                            type="text"
                            class="form-control js-date-input"
                            id="report-from"
                            name="from"
                            placeholder="dd/mm/yyyy"
                            autocomplete="off"
                            inputmode="numeric"
                            data-date-value="<%= from %>"
                            value="<%= from %>"
                            required
                        />
                    </div>
                    <div class="col-6 col-md-3 col-lg-2">
                        <label for="report-to" class="form-label">To</label>
                        <input
                            type="text"
                            class="form-control js-date-input"
                            id="report-to"
                            name="to"
                            placeholder="dd/mm/yyyy"
                            autocomplete="off"
                            inputmode="numeric"
                            data-date-value="<%= to %>"
                            value="<%= to %>"
                            required
                        />
                    </div>
                    <div class="col-12 col-md-3 col-lg-2">
                        <button type="submit" class="btn btn-primary w-100">Apply range</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-6 col-md-4 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Total inquiries</p>
                        <p class="h4 mb-0"><%= report.totals.inquiries %></p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">With assignee</p>
                        <p class="h4 mb-0"><%= report.totals.assigned %></p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Unassigned</p>
                        <p class="h4 mb-0"><%= report.totals.unassigned %></p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Potential</p>
                        <p class="h4 mb-0"><%= report.totals.potential %></p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">Pending follow-ups</p>
                        <p class="h4 mb-0"><%= report.totals.pending_followups %></p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <p class="text-secondary small mb-1">1st / 2nd / 3rd done</p>
                        <p class="h4 mb-0">
                            <%= report.totals.followup_1_done %> /
                            <%= report.totals.followup_2_done %> /
                            <%= report.totals.followup_3_done %>
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h2 class="h6 mb-3">By state</h2>
                        <canvas id="inquiries-report-states-chart" height="220"></canvas>
                        <div class="table-responsive mt-3">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>State</th>
                                        <th class="text-end">Count</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% (report.stateRows || []).forEach(function (row) { %>
                                        <tr>
                                            <td><%= row.label %></td>
                                            <td class="text-end"><%= row.count %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h2 class="h6 mb-3">By source</h2>
                        <canvas id="inquiries-report-sources-chart" height="220"></canvas>
                        <div class="table-responsive mt-3">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Source</th>
                                        <th class="text-end">Count</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% (report.sourceRows || []).forEach(function (row) { %>
                                        <tr>
                                            <td><%= row.label %></td>
                                            <td class="text-end"><%= row.count %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h6 mb-3">By assignee</h2>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Assignee</th>
                                <th class="text-end">Total</th>
                                <th class="text-end">New</th>
                                <th class="text-end">Assigned</th>
                                <th class="text-end">In progress</th>
                                <th class="text-end">Potential</th>
                                <th class="text-end">Closed</th>
                                <th class="text-end">Activities</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% (report.assignees || []).forEach(function (row) { %>
                                <tr>
                                    <td><%= row.label %></td>
                                    <td class="text-end"><%= row.count %></td>
                                    <td class="text-end"><%= row.state_new %></td>
                                    <td class="text-end"><%= row.state_assigned %></td>
                                    <td class="text-end"><%= row.state_in_progress %></td>
                                    <td class="text-end"><%= row.state_potential %></td>
                                    <td class="text-end"><%= row.state_closed %></td>
                                    <td class="text-end"><%= row.activity_count %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<script id="inquiries-report-data" type="application/json">
<%- JSON.stringify(report.chart || { states: [], sources: [] }) %>
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.6/dist/chart.umd.min.js" defer></script>
<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/inquiries-report.js" defer></script>
<%- include('common/footer') %>

<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> / Servers
                </p>
                <h1 class="h3 mb-1">Servers</h1>
                <p class="text-secondary mb-0">Monitor health and drive sync. Run EXEs as Administrator once — monitor installs to <code>%ProgramData%\HammerByte\ServerMonitor</code>, drive sync to <code>%ProgramData%\HammerByte\DriveSync</code>.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-sm btn-outline-secondary" href="/public/server-monitors/supervisor.exe">Download supervisor</a>
                <a class="btn btn-sm btn-outline-secondary" href="/public/server-monitors/drive-sync.exe">Download drive sync</a>
            </div>
        </div>

        <div id="servers-alert" class="alert d-none" role="alert"></div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <h2 class="h5 mb-0">Fleet</h2>
                    <button type="button" class="btn btn-sm btn-outline-danger" id="delete-logs-btn" disabled>
                        Delete logs
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <% if (!servers || servers.length === 0) { %>
                    <div class="p-4 text-center text-secondary">No servers have checked in yet.</div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 2.5rem">
                                        <input type="checkbox" class="form-check-input" id="select-all-servers" aria-label="Select all servers" />
                                    </th>
                                    <th scope="col">Tag</th>
                                    <th scope="col">Name</th>
                                    <th scope="col">Project</th>
                                    <th scope="col">Agent</th>
                                    <th scope="col">Last seen</th>
                                    <th scope="col">Sync</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% servers.forEach(function (server) {
                                    const syncStatus = String(server.last_sync_status || "").toLowerCase();
                                    const syncBadge =
                                        syncStatus === "ok"
                                            ? "text-bg-success"
                                            : syncStatus === "partial"
                                              ? "text-bg-warning"
                                              : syncStatus === "error"
                                                ? "text-bg-danger"
                                                : "text-bg-light border";
                                %>
                                    <tr data-id="<%= server.id %>">
                                        <td>
                                            <input
                                                type="checkbox"
                                                class="form-check-input server-select"
                                                value="<%= server.id %>"
                                                aria-label="Select server <%= server.tag %>"
                                            />
                                        </td>
                                        <td><code class="small"><%= server.tag %></code></td>
                                        <td><%= server.name || "—" %></td>
                                        <td>
                                            <% if (server.project_id) { %>
                                                <a href="/app/projects/<%= server.project_id %>" class="text-decoration-none">
                                                    <%= server.project_title || ("#" + server.project_id) %>
                                                </a>
                                            <% } else { %>
                                                —
                                            <% } %>
                                        </td>
                                        <td><%= server.agent_version || "—" %></td>
                                        <td
                                            data-readable-date="<%= server.last_seen_at || '' %>"
                                            data-date-format="DD/MM/YYYY HH:mm:ss"
                                        ></td>
                                        <td>
                                            <% if (server.last_sync_at) { %>
                                                <div class="d-flex flex-column gap-1">
                                                    <span class="badge <%= syncBadge %> align-self-start"><%= syncStatus || "unknown" %></span>
                                                    <span
                                                        class="small text-secondary"
                                                        data-readable-date="<%= server.last_sync_at || '' %>"
                                                        data-date-format="DD/MM/YYYY HH:mm:ss"
                                                    ></span>
                                                </div>
                                            <% } else { %>
                                                <span class="text-secondary">—</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 flex-wrap">
                                                <a href="/app/servers/<%= server.id %>" class="btn btn-sm btn-outline-primary">View</a>
                                                <button
                                                    type="button"
                                                    class="btn btn-sm btn-outline-secondary server-rename-btn"
                                                    data-id="<%= server.id %>"
                                                    data-name="<%= server.name || '' %>"
                                                    data-tag="<%= server.tag %>"
                                                >
                                                    Name
                                                </button>
                                                <button
                                                    type="button"
                                                    class="btn btn-sm btn-outline-secondary server-edit-btn"
                                                    data-id="<%= server.id %>"
                                                    data-tag="<%= server.tag %>"
                                                    data-project-id="<%= server.project_id || '' %>"
                                                >
                                                    Edit
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="rename-modal" tabindex="-1" aria-labelledby="rename-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="rename-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="rename-modal-label">Set server name</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="rename-form-alert" class="alert d-none" role="alert"></div>
                    <input type="hidden" name="id" id="rename-id" />
                    <p class="text-secondary small" id="rename-tag-label"></p>
                    <div class="mb-0">
                        <label for="rename-name" class="form-label">Name</label>
                        <input type="text" class="form-control" id="rename-name" name="name" maxlength="128" placeholder="Delhi DC-01" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="edit-server-modal" tabindex="-1" aria-labelledby="edit-server-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="edit-server-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="edit-server-modal-label">Edit server</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="edit-server-form-alert" class="alert d-none" role="alert"></div>
                    <input type="hidden" name="id" id="edit-server-id" />
                    <p class="text-secondary small" id="edit-server-tag-label"></p>
                    <div class="mb-0">
                        <label for="edit-server-project-id" class="form-label">Project</label>
                        <select class="form-select" id="edit-server-project-id" name="project_id">
                            <option value="">— None —</option>
                            <% (projects || []).forEach(function (project) { %>
                                <option value="<%= project.id %>">
                                    <%= project.title %><%= project.customer_name ? (" — " + project.customer_name) : "" %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="delete-logs-modal" tabindex="-1" aria-labelledby="delete-logs-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="delete-logs-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="delete-logs-modal-label">Delete logs</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="delete-logs-form-alert" class="alert d-none" role="alert"></div>
                    <p class="text-secondary small" id="delete-logs-selection-label"></p>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="mode" id="delete-mode-all" value="all" checked />
                            <label class="form-check-label" for="delete-mode-all">All logs</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="mode" id="delete-mode-range" value="range" />
                            <label class="form-check-label" for="delete-mode-range">Date range</label>
                        </div>
                    </div>
                    <div id="delete-range-fields" class="row g-3 d-none">
                        <div class="col-md-6">
                            <label for="delete-from" class="form-label">From</label>
                            <input
                                type="text"
                                class="form-control js-date-input"
                                id="delete-from"
                                name="from"
                                placeholder="dd/mm/yyyy"
                                autocomplete="off"
                                inputmode="numeric"
                            />
                        </div>
                        <div class="col-md-6">
                            <label for="delete-to" class="form-label">To</label>
                            <input
                                type="text"
                                class="form-control js-date-input"
                                id="delete-to"
                                name="to"
                                placeholder="dd/mm/yyyy"
                                autocomplete="off"
                                inputmode="numeric"
                            />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete logs</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/servers.js" defer></script>

<%- include('common/footer') %>

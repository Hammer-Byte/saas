<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> / Servers
                </p>
                <h1 class="h3 mb-1">Servers</h1>
                <p class="text-secondary mb-0">
                    HammerByte Agent for Windows Server 2012+ and Windows 10/11. Download, unzip, run
                    <strong>install-agent.cmd</strong> as Administrator, then approve the machine here.
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-sm btn-primary" href="/public/agents/hammerbyte-agent.zip">Download Agent</a>
                <a class="btn btn-sm btn-outline-secondary" href="/app/agent-releases">Agent releases</a>
            </div>
        </div>

        <div id="servers-alert" class="alert d-none" role="alert"></div>

        <%
            const stateBadge = function (service) {
                if (!service.enabled) return "text-bg-light border";
                if (service.state === "running") return "text-bg-success";
                if (service.state === "backoff" || service.state === "error") return "text-bg-danger";
                return "text-bg-warning";
            };
        %>

        <% if (pendingServers && pendingServers.length) { %>
            <div class="card border-0 shadow-sm mb-4 border-start border-warning border-4">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h2 class="h5 mb-1">Pending approval</h2>
                    <p class="text-secondary small mb-0">
                        These machines installed the agent and are waiting. Nothing runs on them until you approve.
                    </p>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Host</th>
                                    <th scope="col">OS</th>
                                    <th scope="col">Tag</th>
                                    <th scope="col">Registered</th>
                                    <th scope="col">Last poll</th>
                                    <th scope="col" class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% pendingServers.forEach(function (server) { %>
                                    <tr>
                                        <td><strong><%= server.hostname || "—" %></strong></td>
                                        <td class="small"><%= server.os_caption || "—" %><% if (server.os_build) { %> <span class="text-secondary">(<%= server.os_build %>)</span><% } %></td>
                                        <td><code class="small"><%= server.tag %></code></td>
                                        <td data-readable-date="<%= server.created_on || '' %>" data-date-format="DD/MM/YYYY HH:mm:ss"></td>
                                        <td>
                                            <span class="badge <%= server.online ? 'text-bg-success' : 'text-bg-secondary' %>"><%= server.online ? "online" : "offline" %></span>
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-success server-approval-btn" data-id="<%= server.id %>" data-status="approved">Approve</button>
                                            <button type="button" class="btn btn-sm btn-outline-danger server-approval-btn" data-id="<%= server.id %>" data-status="rejected">Reject</button>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        <% } %>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <h2 class="h5 mb-0">Fleet</h2>
                    <button type="button" class="btn btn-sm btn-outline-danger" id="delete-logs-btn" disabled>
                        Delete logs
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <% if (!servers || servers.length === 0) { %>
                    <div class="p-4 text-center text-secondary">No approved servers yet. Install the agent on a machine and approve it above.</div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 2.5rem">
                                        <input type="checkbox" class="form-check-input" id="select-all-servers" aria-label="Select all servers" />
                                    </th>
                                    <th scope="col">Tag</th>
                                    <th scope="col">Name</th>
                                    <th scope="col">Project</th>
                                    <th scope="col">Agent</th>
                                    <th scope="col">Last poll</th>
                                    <th scope="col">Services</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% servers.forEach(function (server) { %>
                                    <tr data-id="<%= server.id %>">
                                        <td>
                                            <input
                                                type="checkbox"
                                                class="form-check-input server-select"
                                                value="<%= server.id %>"
                                                aria-label="Select server <%= server.tag %>"
                                            />
                                        </td>
                                        <td><code class="small"><%= server.tag %></code></td>
                                        <td>
                                            <%= server.name || "—" %>
                                            <% if (server.hostname) { %><div class="small text-secondary"><%= server.hostname %></div><% } %>
                                        </td>
                                        <td>
                                            <% if (server.project_id) { %>
                                                <a href="/app/projects/<%= server.project_id %>" class="text-decoration-none">
                                                    <%= server.project_title || ("#" + server.project_id) %>
                                                </a>
                                            <% } else { %>
                                                —
                                            <% } %>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column gap-1 align-items-start">
                                                <% if (server.approval_status === "rejected") { %>
                                                    <span class="badge text-bg-danger">rejected</span>
                                                <% } else if (!server.agent_active) { %>
                                                    <span class="badge text-bg-warning">paused</span>
                                                <% } else { %>
                                                    <span class="badge <%= server.online ? 'text-bg-success' : 'text-bg-secondary' %>"><%= server.online ? "online" : "offline" %></span>
                                                <% } %>
                                                <span class="small text-secondary"><%= server.agent_version ? ("v" + server.agent_version) : "no agent yet" %></span>
                                            </div>
                                        </td>
                                        <td
                                            data-readable-date="<%= server.last_poll_at || '' %>"
                                            data-date-format="DD/MM/YYYY HH:mm:ss"
                                        ><%= server.last_poll_at ? "" : "—" %></td>
                                        <td>
                                            <div class="d-flex flex-wrap gap-1">
                                                <% server.services.forEach(function (service) { %>
                                                    <span
                                                        class="badge <%= stateBadge(service) %>"
                                                        title="<%= service.last_error || '' %>"
                                                    ><%= service.label %>: <%= service.enabled ? (service.state || "pending") : "off" %></span>
                                                <% }) %>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2 flex-wrap">
                                                <a href="/app/servers/<%= server.id %>" class="btn btn-sm btn-outline-primary">View</a>
                                                <button
                                                    type="button"
                                                    class="btn btn-sm btn-outline-secondary server-edit-btn"
                                                    data-id="<%= server.id %>"
                                                    data-name="<%= server.name || '' %>"
                                                    data-tag="<%= server.tag %>"
                                                    data-project-id="<%= server.project_id || '' %>"
                                                >
                                                    Edit
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="edit-server-modal" tabindex="-1" aria-labelledby="edit-server-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="edit-server-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="edit-server-modal-label">Edit server</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="edit-server-form-alert" class="alert d-none" role="alert"></div>
                    <input type="hidden" name="id" id="edit-server-id" />
                    <p class="text-secondary small" id="edit-server-tag-label"></p>
                    <div class="mb-3">
                        <label for="edit-server-name" class="form-label">Name</label>
                        <input
                            type="text"
                            class="form-control"
                            id="edit-server-name"
                            name="name"
                            maxlength="128"
                            placeholder="Delhi DC-01"
                        />
                    </div>
                    <div class="mb-0">
                        <label for="edit-server-project-id" class="form-label">Project</label>
                        <select class="form-select" id="edit-server-project-id" name="project_id">
                            <option value="">— None —</option>
                            <% (projects || []).forEach(function (project) { %>
                                <option value="<%= project.id %>">
                                    <%= project.title %><%= project.customer_name ? (" — " + project.customer_name) : "" %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="delete-logs-modal" tabindex="-1" aria-labelledby="delete-logs-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="delete-logs-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="delete-logs-modal-label">Delete logs</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="delete-logs-form-alert" class="alert d-none" role="alert"></div>
                    <p class="text-secondary small" id="delete-logs-selection-label"></p>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="mode" id="delete-mode-all" value="all" checked />
                            <label class="form-check-label" for="delete-mode-all">All logs</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="mode" id="delete-mode-range" value="range" />
                            <label class="form-check-label" for="delete-mode-range">Date range</label>
                        </div>
                    </div>
                    <div id="delete-range-fields" class="row g-3 d-none">
                        <div class="col-md-6">
                            <label for="delete-from" class="form-label">From</label>
                            <input
                                type="text"
                                class="form-control js-date-input"
                                id="delete-from"
                                name="from"
                                placeholder="dd/mm/yyyy"
                                autocomplete="off"
                                inputmode="numeric"
                            />
                        </div>
                        <div class="col-md-6">
                            <label for="delete-to" class="form-label">To</label>
                            <input
                                type="text"
                                class="form-control js-date-input"
                                id="delete-to"
                                name="to"
                                placeholder="dd/mm/yyyy"
                                autocomplete="off"
                                inputmode="numeric"
                            />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete logs</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/servers.js" defer></script>

<%- include('common/footer') %>

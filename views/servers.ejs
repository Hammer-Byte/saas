<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4">
            <p class="text-secondary small mb-1">
                <a href="/app" class="text-decoration-none">App</a> / Servers
            </p>
            <h1 class="h3 mb-1">Servers</h1>
            <p class="text-secondary mb-0">Monitor Windows agents, name tags, and publish supervisor/agent releases.</p>
        </div>

        <div id="servers-alert" class="alert d-none" role="alert"></div>

        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <h2 class="h5 mb-1">Supervisor release</h2>
                        <p class="text-secondary small mb-3">
                            Latest:
                            <% if (latestSupervisor) { %>
                                <strong>v<%= latestSupervisor.version %></strong>
                                <a class="ms-2" href="/api/servers/supervisor">Download</a>
                            <% } else { %>
                                <span>none published</span>
                            <% } %>
                        </p>
                        <button
                            type="button"
                            class="btn btn-sm btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#release-modal"
                            data-kind="supervisor"
                        >
                            Upload supervisor.exe
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <h2 class="h5 mb-1">Agent release</h2>
                        <p class="text-secondary small mb-3">
                            Latest:
                            <% if (latestAgent) { %>
                                <strong>v<%= latestAgent.version %></strong>
                                <a class="ms-2" href="/api/servers/agent">Download</a>
                            <% } else { %>
                                <span>none published</span>
                            <% } %>
                        </p>
                        <button
                            type="button"
                            class="btn btn-sm btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#release-modal"
                            data-kind="agent"
                        >
                            Upload agent.exe
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <h2 class="h5 mb-0">Fleet</h2>
                    <button type="button" class="btn btn-sm btn-outline-danger" id="delete-logs-btn" disabled>
                        Delete logs
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <% if (!servers || servers.length === 0) { %>
                    <div class="p-4 text-center text-secondary">No servers have checked in yet.</div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 2.5rem">
                                        <input type="checkbox" class="form-check-input" id="select-all-servers" aria-label="Select all servers" />
                                    </th>
                                    <th scope="col">Tag</th>
                                    <th scope="col">Name</th>
                                    <th scope="col">Agent</th>
                                    <th scope="col">Last seen</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% servers.forEach(function (server) { %>
                                    <tr data-id="<%= server.id %>">
                                        <td>
                                            <input
                                                type="checkbox"
                                                class="form-check-input server-select"
                                                value="<%= server.id %>"
                                                aria-label="Select server <%= server.tag %>"
                                            />
                                        </td>
                                        <td><code class="small"><%= server.tag %></code></td>
                                        <td><%= server.name || "—" %></td>
                                        <td><%= server.agent_version || "—" %></td>
                                        <td
                                            data-readable-date="<%= server.last_seen_at || '' %>"
                                            data-date-format="DD/MM/YYYY HH:mm:ss"
                                        ></td>
                                        <td>
                                            <div class="d-flex gap-2 flex-wrap">
                                                <a href="/app/servers/<%= server.id %>" class="btn btn-sm btn-outline-primary">Logs</a>
                                                <button
                                                    type="button"
                                                    class="btn btn-sm btn-outline-secondary server-rename-btn"
                                                    data-id="<%= server.id %>"
                                                    data-name="<%= server.name || '' %>"
                                                    data-tag="<%= server.tag %>"
                                                >
                                                    Name
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="release-modal" tabindex="-1" aria-labelledby="release-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="release-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="release-modal-label">Upload release</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="release-form-alert" class="alert d-none" role="alert"></div>
                    <input type="hidden" name="kind" id="release-kind" value="agent" />
                    <div class="mb-3">
                        <label for="release-version" class="form-label">Version</label>
                        <input type="text" class="form-control" id="release-version" name="version" maxlength="32" required placeholder="1.0.0" />
                    </div>
                    <div class="mb-0">
                        <label for="release-file" class="form-label">EXE file</label>
                        <input type="file" class="form-control" id="release-file" name="file" accept=".exe,application/octet-stream" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="release-submit-btn">Publish</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="rename-modal" tabindex="-1" aria-labelledby="rename-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="rename-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="rename-modal-label">Set server name</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="rename-form-alert" class="alert d-none" role="alert"></div>
                    <input type="hidden" name="id" id="rename-id" />
                    <p class="text-secondary small" id="rename-tag-label"></p>
                    <div class="mb-0">
                        <label for="rename-name" class="form-label">Name</label>
                        <input type="text" class="form-control" id="rename-name" name="name" maxlength="128" placeholder="Delhi DC-01" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="delete-logs-modal" tabindex="-1" aria-labelledby="delete-logs-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="delete-logs-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="delete-logs-modal-label">Delete logs</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="delete-logs-form-alert" class="alert d-none" role="alert"></div>
                    <p class="text-secondary small" id="delete-logs-selection-label"></p>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="mode" id="delete-mode-all" value="all" checked />
                            <label class="form-check-label" for="delete-mode-all">All logs</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="mode" id="delete-mode-range" value="range" />
                            <label class="form-check-label" for="delete-mode-range">Date range</label>
                        </div>
                    </div>
                    <div id="delete-range-fields" class="row g-3 d-none">
                        <div class="col-md-6">
                            <label for="delete-from" class="form-label">From</label>
                            <input type="date" class="form-control" id="delete-from" name="from" />
                        </div>
                        <div class="col-md-6">
                            <label for="delete-to" class="form-label">To</label>
                            <input type="date" class="form-control" id="delete-to" name="to" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete logs</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/servers.js" defer></script>

<%- include('common/footer') %>

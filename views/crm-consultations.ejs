<%- include('common/header') %>

<%
    const currentUserId = Number(userId || 0);
    const isSuperAdmin = !!super_admin;
    const statusLabels = CONSULTATION_STATUS_LABELS || {};
    const statuses = CONSULTATION_STATUSES || {};
%>

<%- include('common/app-navbar', { wide: true }) %>

<main class="hb-main">
    <div class="container-fluid hb-page-wide">
        <div class="mb-3 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> /
                    <a href="/app/crm" class="text-decoration-none">CRM</a> /
                    Bookings
                </p>
                <h1 class="h3 mb-1">Consultation bookings</h1>
                <p class="text-secondary mb-0">
                    <span data-readable-date="<%= from %>" data-date-format="DD/MM/YYYY"><%= from %></span>
                    –
                    <span data-readable-date="<%= to %>" data-date-format="DD/MM/YYYY"><%= to %></span>.
                </p>
            </div>
            <form class="d-flex flex-wrap gap-2 align-items-end" method="get" action="/app/crm/consultations">
                <div>
                    <label for="bookings-from" class="form-label small mb-1">From</label>
                    <input type="date" class="form-control form-control-sm" id="bookings-from" name="from" value="<%= from %>" />
                </div>
                <div>
                    <label for="bookings-to" class="form-label small mb-1">To</label>
                    <input type="date" class="form-control form-control-sm" id="bookings-to" name="to" value="<%= to %>" />
                </div>
                <button type="submit" class="btn btn-sm btn-outline-secondary">Apply</button>
            </form>
        </div>

        <div id="bookings-alert" class="alert d-none" role="alert"></div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Topic</th>
                        <th>Guest</th>
                        <th>Owner</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <% (bookings || []).forEach((booking) => {
                        const canManage = isSuperAdmin || Number(booking.slot_owner_user_id) === currentUserId;
                    %>
                    <tr
                        data-id="<%= booking.id %>"
                        data-status="<%= booking.status %>"
                        data-can-manage="<%= canManage ? '1' : '0' %>"
                    >
                        <td>
                            <span data-readable-date="<%= booking.starts_at %>" data-date-format="DD/MM/YYYY HH:mm">
                                <%= booking.starts_at %>
                            </span>
                        </td>
                        <td><%= booking.topic_title %></td>
                        <td>
                            <div><%= booking.full_name %></div>
                            <div class="small text-secondary"><%= booking.phone %> · <%= booking.email %></div>
                        </td>
                        <td><%= booking.owner_name || '—' %></td>
                        <td>
                            <select
                                class="form-select form-select-sm booking-status-select"
                                data-can-cancel="<%= canManage ? '1' : '0' %>"
                            >
                                <% Object.values(statuses).forEach((status) => {
                                    const isCancel = status === statuses.CANCELLED;
                                    if (isCancel && !canManage && booking.status !== status) {
                                        return;
                                    }
                                %>
                                <option value="<%= status %>" <%= booking.status === status ? 'selected' : '' %>>
                                    <%= statusLabels[status] || status %>
                                </option>
                                <% }) %>
                            </select>
                        </td>
                        <td class="text-end">
                            <% if (canManage && booking.status === statuses.OPEN) { %>
                            <button type="button" class="btn btn-sm btn-outline-primary booking-reschedule-btn">
                                Reschedule
                            </button>
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <% if (!(bookings || []).length) { %>
        <p class="text-secondary mt-3">No bookings in this range.</p>
        <% } %>
    </div>
</main>

<div class="modal fade" id="reschedule-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" id="reschedule-form">
            <div class="modal-header">
                <h2 class="modal-title h5">Reschedule booking</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="reschedule-form-alert" class="alert d-none" role="alert"></div>
                <input type="hidden" id="reschedule-booking-id" value="" />
                <div class="mb-3">
                    <label for="reschedule-slot-id" class="form-label">Available slot</label>
                    <select class="form-select" id="reschedule-slot-id">
                        <option value="">Loading…</option>
                    </select>
                </div>
                <div class="mb-0">
                    <label for="reschedule-starts-at" class="form-label">Or create new start (IST)</label>
                    <input type="datetime-local" class="form-control" id="reschedule-starts-at" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" id="reschedule-submit-btn">Reschedule</button>
            </div>
        </form>
    </div>
</div>

<script>
    window.__CONSULTATION_STATUSES__ = <%- JSON.stringify(CONSULTATION_STATUSES || {}) %>;
</script>
<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/crm-consultations.js" defer></script>
<%- include('common/footer') %>

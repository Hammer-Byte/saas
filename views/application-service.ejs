<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= typeof username !== "undefined" && username ? username : "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4">
            <p class="text-secondary small mb-1">
                <a href="/app" class="text-decoration-none">App</a> /
                <a href="/app/applications" class="text-decoration-none">Applications</a> /
                <a href="/app/applications/<%= application.id %>/services" class="text-decoration-none">Services</a> /
                Usage
            </p>
            <h1 class="h3 mb-1">
                Usage — <%= applicationService.title %>
            </h1>
            <p class="text-secondary mb-0">
                Application: <strong><%= application.title %></strong>
                · Application Service ID: <code><%= applicationService.id %></code>
            </p>
        </div>

        <form class="row g-2 align-items-end mb-3" method="get">
            <div class="col-auto">
                <label for="month" class="form-label mb-1">Month</label>
                <select class="form-select form-select-sm" id="month" name="month">
                    <% for (let m = 1; m <= 12; m++) { %>
                        <option value="<%= m %>" <%= Number(month) === m ? "selected" : "" %>>
                            <%= String(m).padStart(2, "0") %>
                        </option>
                    <% } %>
                </select>
            </div>
            <div class="col-auto">
                <label for="year" class="form-label mb-1">Year</label>
                <input
                    class="form-control form-control-sm"
                    type="number"
                    id="year"
                    name="year"
                    min="2000"
                    max="2100"
                    value="<%= year %>"
                />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">Apply</button>
            </div>
        </form>

        <div class="d-flex justify-content-between align-items-center mb-2">
            <p class="mb-0 text-secondary">
                Showing usage for <strong><%= String(month).padStart(2, "0") %>/<%= year %></strong>
            </p>
            <p class="mb-0">
                <span class="badge text-bg-primary"><%= usage ? usage.length : 0 %> records</span>
            </p>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <% if (!usage || usage.length === 0) { %>
                    <div class="p-4 p-md-5 text-center text-secondary">
                        No usage found for this application service in <%= String(month).padStart(2, "0") %>/<%= year %>.
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">ID</th>
                                    <th scope="col">Recipient</th>
                                    <th scope="col">Subject</th>
                                    <th scope="col">Created On</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% usage.forEach(function (row) { %>
                                    <tr>
                                        <td><%= row.id %></td>
                                        <td><%= row.recipient %></td>
                                        <td><%= row.subject %></td>
                                        <td><%= row.created_on ? new Date(row.created_on).toLocaleString() : "-" %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="mt-3">
            <a href="/app/applications/<%= application.id %>/services" class="btn btn-outline-secondary btn-sm">
                ← Back to Services
            </a>
        </div>
    </div>
</main>

<script src="/public/app.js" defer></script>
<%- include('common/footer') %>

<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= typeof username !== "undefined" && username ? username : "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> / Customers
                </p>
                <h1 class="h3 mb-1">Customers</h1>
                <p class="text-secondary mb-0">Manage customers from the CUSTOMERS table.</p>
            </div>
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#customer-modal"
                id="open-add-customer-btn"
            >
                Add Customer
            </button>
        </div>

        <div id="customers-alert" class="alert d-none" role="alert"></div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <% if (!customers || customers.length === 0) { %>
                    <div class="p-4 p-md-5 text-center text-secondary">
                        No customers found.
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">ID</th>
                                    <th scope="col">Full name</th>
                                    <th scope="col">Company</th>
                                    <th scope="col">PAN / GST</th>
                                    <th scope="col">HSN</th>
                                    <th scope="col">Address</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% customers.forEach(function (customer) { %>
                                    <tr>
                                        <td><%= customer.id %></td>
                                        <td>
                                            <a href="/app/customers/<%= customer.id %>" class="text-decoration-none">
                                                <%= customer.full_name %>
                                            </a>
                                        </td>
                                        <td><%= customer.company %></td>
                                        <td><%= customer.pan_gst %></td>
                                        <td><%= customer.hsn %></td>
                                        <td><%= customer.address %></td>
                                        <td>
                                            <a href="/app/customers/<%= customer.id %>" class="btn btn-sm btn-outline-primary">
                                                Open
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="customer-modal" tabindex="-1" aria-labelledby="customer-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="customer-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="customer-modal-label">Add customer</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="customer-form-alert" class="alert d-none" role="alert"></div>
                    <div class="mb-3">
                        <label for="customer-full-name" class="form-label">Full name</label>
                        <input type="text" class="form-control" id="customer-full-name" name="full_name" maxlength="128" required />
                    </div>
                    <div class="mb-3">
                        <label for="customer-company" class="form-label">Company</label>
                        <input type="text" class="form-control" id="customer-company" name="company" maxlength="128" required />
                    </div>
                    <div class="mb-3">
                        <label for="customer-pan-gst" class="form-label">PAN / GST</label>
                        <input type="text" class="form-control" id="customer-pan-gst" name="pan_gst" maxlength="32" required />
                    </div>
                    <div class="mb-3">
                        <label for="customer-hsn" class="form-label">HSN</label>
                        <input type="text" class="form-control" id="customer-hsn" name="hsn" maxlength="16" required />
                    </div>
                    <div class="mb-0">
                        <label for="customer-address" class="form-label">Address</label>
                        <textarea class="form-control" id="customer-address" name="address" rows="3" maxlength="512" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/customers.js" defer></script>
<%- include('common/footer') %>

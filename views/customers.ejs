<%- include('common/header') %>

<%- include('common/app-navbar') %>

<main class="hb-main">
    <div class="container hb-page">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> / Customers
                </p>
                <h1 class="h3 mb-1">Customers</h1>
                <p class="text-secondary mb-0">Manage customers from the CUSTOMERS table.</p>
            </div>
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#customer-modal"
                id="open-add-customer-btn"
            >
                Add customer
            </button>
        </div>

        <%- include('common/page-alert', { id: "customers-alert" }) %>

        <% if (!customers || customers.length === 0) { %>
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5 text-center text-secondary">
                    No customers found.
                </div>
            </div>
        <% } else { %>
            <%- include('common/table-filters', {
                searchId: "customers-search",
                searchPlaceholder: "Search customers…",
            }) %>
            <p class="text-secondary small mb-3 d-none" id="customers-empty" role="status">No customers match your search.</p>
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive" id="customers-table-wrap">
                        <table class="table table-hover align-middle mb-0" id="customers-table">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="hb-sortable" data-sort-key="id">ID</th>
                                    <th scope="col" class="hb-sortable" data-sort-key="fullName">Full name</th>
                                    <th scope="col" class="hb-sortable" data-sort-key="company">Company</th>
                                    <th scope="col" class="hb-sortable" data-sort-key="panGst">PAN / GST</th>
                                    <th scope="col" class="hb-sortable" data-sort-key="hsn">HSN</th>
                                    <th scope="col" class="hb-sortable" data-sort-key="address">Address</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% customers.forEach(function (customer) { %>
                                    <tr
                                        class="hb-row-link"
                                        data-href="/app/customers/<%= customer.id %>"
                                        data-id="<%= customer.id %>"
                                        data-full-name="<%= customer.full_name %>"
                                        data-company="<%= customer.company %>"
                                        data-pan-gst="<%= customer.pan_gst || '' %>"
                                        data-hsn="<%= customer.hsn || '' %>"
                                        data-address="<%= customer.address %>"
                                    >
                                        <td><%= customer.id %></td>
                                        <td><%= customer.full_name %></td>
                                        <td><%= customer.company %></td>
                                        <td><%= customer.pan_gst || "-" %></td>
                                        <td><%= customer.hsn || "-" %></td>
                                        <td><%= customer.address %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</main>

<div class="modal fade" id="customer-modal" tabindex="-1" aria-labelledby="customer-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="customer-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="customer-modal-label">Add customer</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="customer-form-alert" class="alert d-none" role="alert"></div>
                    <div class="mb-3">
                        <label for="customer-full-name" class="form-label">Full name</label>
                        <input type="text" class="form-control" id="customer-full-name" name="full_name" maxlength="128" required />
                    </div>
                    <div class="mb-3">
                        <label for="customer-company" class="form-label">Company</label>
                        <input type="text" class="form-control" id="customer-company" name="company" maxlength="128" required />
                    </div>
                    <div class="mb-3">
                        <label for="customer-pan-gst" class="form-label">PAN / GST <span class="text-secondary fw-normal">(optional)</span></label>
                        <input type="text" class="form-control" id="customer-pan-gst" name="pan_gst" maxlength="32" />
                    </div>
                    <div class="mb-3">
                        <label for="customer-hsn" class="form-label">HSN <span class="text-secondary fw-normal">(optional)</span></label>
                        <input type="text" class="form-control" id="customer-hsn" name="hsn" maxlength="16" />
                    </div>
                    <div class="mb-3">
                        <label for="customer-address" class="form-label">Address</label>
                        <textarea class="form-control" id="customer-address" name="address" rows="3" maxlength="512" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="customer-phones" class="form-label">Phones <span class="text-secondary fw-normal">(optional, one per line)</span></label>
                        <textarea class="form-control" id="customer-phones" name="phones" rows="2" placeholder="+919876543210"></textarea>
                    </div>
                    <div class="mb-0">
                        <label for="customer-emails" class="form-label">Emails <span class="text-secondary fw-normal">(optional, one per line)</span></label>
                        <textarea class="form-control" id="customer-emails" name="emails" rows="2" placeholder="billing@example.com"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/customers.js" defer></script>
<%- include('common/footer') %>

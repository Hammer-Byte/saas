<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= typeof username !== "undefined" && username ? username : "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> / Applications
                </p>
                <h1 class="h3 mb-1">Applications</h1>
                <p class="text-secondary mb-0">Registered client applications from the APPLICATIONS table.</p>
            </div>
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#add-application-modal"
            >
                Add Application
            </button>
        </div>

        <div id="applications-alert" class="alert d-none" role="alert"></div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <% if (!applications || applications.length === 0) { %>
                    <div class="p-4 p-md-5 text-center text-secondary">
                        No applications found.
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">ID</th>
                                    <th scope="col">Title</th>
                                    <th scope="col">Project</th>
                                    <th scope="col">Token</th>
                                    <th scope="col">Active</th>
                                    <th scope="col">Created On</th>
                                    <th scope="col">Updated At</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% applications.forEach(function (application) { %>
                                    <tr>
                                        <td><%= application.id %></td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <span><%= application.title %></span>
                                                <a
                                                    href="/app/applications/<%= application.id %>/edit"
                                                    class="btn btn-sm btn-outline-secondary p-1"
                                                    aria-label="Edit application"
                                                    title="Edit"
                                                >
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                                                    </svg>
                                                </a>
                                            </div>
                                        </td>
                                        <td><%= application.project_tag_title || "-" %></td>
                                        <td><code><%= application.token %></code></td>
                                        <td>
                                            <% if (application.active) { %>
                                                <span class="badge text-bg-success">Active</span>
                                            <% } else { %>
                                                <span class="badge text-bg-secondary">Inactive</span>
                                            <% } %>
                                        </td>
                                        <td><%= application.created_on ? new Date(application.created_on).toLocaleString() : "-" %></td>
                                        <td><%= application.updated_at ? new Date(application.updated_at).toLocaleString() : "-" %></td>
                                        <td>
                                            <div class="d-flex gap-2 flex-wrap">
                                                <a href="/app/applications/<%= application.id %>/services" class="btn btn-sm btn-outline-primary">
                                                    Manage Services
                                                </a>
                                                <a href="/app/applications/<%= application.id %>/customer" class="btn btn-sm btn-outline-dark">
                                                    Manage Customer
                                                </a>
                                                <a href="/app/applications/<%= application.id %>/invoices" class="btn btn-sm btn-outline-secondary">
                                                    Invoices
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="add-application-modal" tabindex="-1" aria-labelledby="add-application-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="add-application-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="add-application-modal-label">Add application</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="add-application-alert" class="alert d-none" role="alert"></div>
                    <div class="mb-3">
                        <label for="application-title" class="form-label">Title</label>
                        <input
                            type="text"
                            class="form-control"
                            id="application-title"
                            name="title"
                            maxlength="56"
                            required
                        />
                    </div>
                    <div class="mb-3">
                        <label for="application-project-tag" class="form-label">Project</label>
                        <select class="form-select" id="application-project-tag" name="project_tag_id">
                            <option value="">No project</option>
                            <% (projectTags || []).forEach(function (tag) { %>
                                <option value="<%= tag.id %>"><%= tag.title %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-0">
                        <label for="application-active" class="form-label">Status</label>
                        <select class="form-select" id="application-active" name="active">
                            <option value="true" selected>Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                    <p class="form-text mb-0 mt-3">Token is generated automatically.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/applications.js" defer></script>
<%- include('common/footer') %>

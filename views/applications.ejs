<%- include('common/header') %>

<%- include('common/app-navbar') %>

<main class="hb-main">
    <div class="container hb-page">
        <div class="mb-4">
            <p class="text-secondary small mb-1">
                <a href="/app" class="text-decoration-none">App</a> / Applications
            </p>
            <h1 class="h3 mb-1">Applications</h1>
            <p class="text-secondary mb-0">All project applications. Add new ones from a project page.</p>
        </div>

        <% if (!applications || applications.length === 0) { %>
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5 text-center text-secondary">
                    No applications found.
                </div>
            </div>
        <% } else { %>
            <%- include('common/table-filters', {
                searchId: "applications-search",
                searchPlaceholder: "Search applications…",
            }) %>
            <p class="text-secondary small mb-3 d-none" id="applications-empty" role="status">No applications match your search.</p>
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive" id="applications-table-wrap">
                        <table class="table table-hover align-middle mb-0" id="applications-table">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="hb-sortable" data-sort-key="id">ID</th>
                                    <th scope="col" class="hb-sortable" data-sort-key="title">Title</th>
                                    <th scope="col" class="hb-sortable" data-sort-key="project">Project</th>
                                    <th scope="col" class="hb-sortable" data-sort-key="active">Active</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% applications.forEach(function (application) { %>
                                    <tr
                                        class="hb-row-link"
                                        data-href="/app/applications/<%= application.id %>"
                                        data-id="<%= application.id %>"
                                        data-title="<%= application.title || '' %>"
                                        data-project="<%= application.project_title || '' %>"
                                        data-active="<%= application.active ? '1' : '0' %>"
                                    >
                                        <td><%= application.id %></td>
                                        <td><%= application.title %></td>
                                        <td><%= application.project_title || "-" %></td>
                                        <td>
                                            <% if (application.active) { %>
                                                <span class="badge text-bg-success">Active</span>
                                            <% } else { %>
                                                <span class="badge text-bg-secondary">Inactive</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</main>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/applications.js" defer></script>
<%- include('common/footer') %>
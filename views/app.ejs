<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= typeof username !== "undefined" && username ? username : "user" %></strong>
            </span>
            <a href="/" class="btn btn-sm btn-outline-light">Website</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4">
            <h1 class="h3 mb-1">Welcome<%= typeof username !== "undefined" && username ? `, ${username}` : "" %></h1>
            <p class="text-secondary mb-0">Choose a section to manage your SaaS platform.</p>
        </div>

        <div class="row g-4">
            <div class="col-12 col-sm-6 col-lg-3">
                <a href="/app/projects" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 app-section-card">
                        <div class="card-body p-4">
                            <div class="app-section-icon mb-3">P</div>
                            <h2 class="h5 text-dark mb-2">Projects</h2>
                            <p class="text-secondary small mb-0">View and manage projects.</p>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <a href="/app/expenses" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 app-section-card">
                        <div class="card-body p-4">
                            <div class="app-section-icon mb-3">E</div>
                            <h2 class="h5 text-dark mb-2">Expenses</h2>
                            <p class="text-secondary small mb-0">Track and manage platform expenses by date range.</p>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <a href="/app/customers" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 app-section-card">
                        <div class="card-body p-4">
                            <div class="app-section-icon mb-3">C</div>
                            <h2 class="h5 text-dark mb-2">Customers</h2>
                            <p class="text-secondary small mb-0">Manage customers, projects, and applications.</p>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <a href="/app/invoices" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 app-section-card">
                        <div class="card-body p-4">
                            <div class="app-section-icon mb-3">$</div>
                            <h2 class="h5 text-dark mb-2">Invoices</h2>
                            <p class="text-secondary small mb-0">Manage customer invoices.</p>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <a href="/app/inquiries" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 app-section-card">
                        <div class="card-body p-4">
                            <div class="app-section-icon mb-3">I</div>
                            <h2 class="h5 text-dark mb-2">Inquiries</h2>
                            <p class="text-secondary small mb-0">View contact form submissions from the website.</p>
                        </div>
                    </div>
                </a>
            </div>
        </div>

        <hr class="my-5" />

        <div class="row g-4">
            <div class="col-12 col-sm-6 col-lg-3">
                <a href="/app/applications" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 app-section-card">
                        <div class="card-body p-4">
                            <div class="app-section-icon mb-3">A</div>
                            <h2 class="h5 text-dark mb-2">Applications</h2>
                            <p class="text-secondary small mb-0">View project applications, tokens, and services.</p>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <a href="/app/services" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 app-section-card">
                        <div class="card-body p-4">
                            <div class="app-section-icon mb-3">S</div>
                            <h2 class="h5 text-dark mb-2">Services</h2>
                            <p class="text-secondary small mb-0">Configure mailer, bucketizer, and other platform services.</p>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <a href="/app/users" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 app-section-card">
                        <div class="card-body p-4">
                            <div class="app-section-icon mb-3">U</div>
                            <h2 class="h5 text-dark mb-2">Users</h2>
                            <p class="text-secondary small mb-0">Create and manage users who can sign in with OTP.</p>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</main>

<style>
    .app-section-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .app-section-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.12) !important;
    }
    .app-section-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #5c8aa5;
        color: #fff;
        font-weight: 700;
        font-size: 1.1rem;
    }
</style>

<script src="/public/app.js" defer></script>
<%- include('common/footer') %>

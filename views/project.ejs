<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= typeof username !== "undefined" && username ? username : "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4">
            <p class="text-secondary small mb-1">
                <a href="/app" class="text-decoration-none">App</a> /
                <a href="/app/projects" class="text-decoration-none">Projects</a> /
                <%= customerProject.title %>
            </p>
            <h1 class="h3 mb-1"><%= customerProject.title %></h1>
            <p class="text-secondary mb-0">
                Customer:
                <a href="/app/customers/<%= customer.id %>" class="text-decoration-none"><%= customer.full_name %></a>
            </p>
        </div>

        <div id="customer-project-alert" class="alert d-none" role="alert"></div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h2 class="h5 mb-0">Project details</h2>
            </div>
            <div class="card-body p-4">
                <form
                    id="customer-project-detail-form"
                    data-customer-id="<%= customer.id %>"
                    data-project-id="<%= customerProject.id %>"
                    novalidate
                >
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="title" class="form-label">Title</label>
                            <input type="text" class="form-control" id="title" name="title" maxlength="128" value="<%= customerProject.title %>" required disabled />
                        </div>
                        <div class="col-12">
                            <label for="description" class="form-label">Description</label>
                            <textarea class="form-control" id="description" name="description" rows="3" maxlength="512" disabled><%= customerProject.description || '' %></textarea>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4 flex-wrap">
                        <button type="submit" id="save-project-btn" class="btn btn-primary d-none">Save</button>
                        <button type="button" id="cancel-edit-project-btn" class="btn btn-outline-secondary d-none">Cancel</button>
                        <button type="button" id="edit-project-btn" class="btn btn-outline-primary">Edit</button>
                        <button type="button" id="delete-project-btn" class="btn btn-outline-danger">Delete</button>
                        <a href="/app/customers/<%= customer.id %>" class="btn btn-outline-secondary">Back to customer</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center pt-4 px-4">
                <h2 class="h5 mb-0">Applications</h2>
                <button
                    type="button"
                    class="btn btn-sm btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#add-application-modal"
                    id="open-add-application-btn"
                >
                    Add Application
                </button>
            </div>
            <div class="card-body p-0">
                <% if (!applications || applications.length === 0) { %>
                    <div class="p-4 text-center text-secondary">
                        No applications for this project.
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">ID</th>
                                    <th scope="col">Title</th>
                                    <th scope="col">Token</th>
                                    <th scope="col">Active</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% applications.forEach(function (application) { %>
                                    <tr>
                                        <td><%= application.id %></td>
                                        <td><%= application.title %></td>
                                        <td><code><%= application.token %></code></td>
                                        <td>
                                            <% if (application.active) { %>
                                                <span class="badge text-bg-success">Active</span>
                                            <% } else { %>
                                                <span class="badge text-bg-secondary">Inactive</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <a href="/app/applications/<%= application.id %>" class="btn btn-sm btn-outline-primary">
                                                Open
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center pt-4 px-4">
                <h2 class="h5 mb-0">Invoices</h2>
                <button
                    type="button"
                    class="btn btn-sm btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#invoice-modal"
                >
                    Add Invoice
                </button>
            </div>
            <div class="card-body p-0">
                <div id="invoices-alert" class="alert d-none mx-4 mt-3" role="alert"></div>
                <% if (!invoices || invoices.length === 0) { %>
                    <div class="p-4 text-center text-secondary">
                        No invoices for this project.
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">ID</th>
                                    <th scope="col">Due date</th>
                                    <th scope="col">Total</th>
                                    <th scope="col">GST</th>
                                    <th scope="col">Created</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% invoices.forEach(function (invoice) { %>
                                    <tr
                                        class="invoice-row"
                                        role="link"
                                        tabindex="0"
                                        data-href="/app/invoices/<%= invoice.id %>"
                                        style="cursor: pointer;"
                                    >
                                        <td><%= invoice.id %></td>
                                        <td><%= invoice.due_date %></td>
                                        <td><%= Number(invoice.total).toFixed(2) %></td>
                                        <td><%= Number(invoice.gst).toFixed(2) %></td>
                                        <td><%= invoice.created_on ? new Date(invoice.created_on).toLocaleString() : "-" %></td>
                                        <td>
                                            <button
                                                type="button"
                                                class="btn btn-sm btn-outline-danger invoice-delete-btn"
                                                data-id="<%= invoice.id %>"
                                            >
                                                Delete
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="add-application-modal" tabindex="-1" aria-labelledby="add-application-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="add-application-form" data-project-id="<%= customerProject.id %>" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="add-application-modal-label">Add application</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="add-application-alert" class="alert d-none" role="alert"></div>
                    <div class="mb-3">
                        <label for="application-title" class="form-label">Title</label>
                        <input type="text" class="form-control" id="application-title" name="title" maxlength="56" required />
                    </div>
                    <div class="mb-0">
                        <label for="application-active" class="form-label">Status</label>
                        <select class="form-select" id="application-active" name="active">
                            <option value="true" selected>Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                    <p class="form-text mb-0 mt-3">Token is generated automatically.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="invoice-modal" tabindex="-1" aria-labelledby="invoice-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form
                id="invoice-form"
                data-customer-id="<%= customer.id %>"
                data-project-id="<%= customerProject.id %>"
                novalidate
            >
                <div class="modal-header">
                    <h2 class="modal-title h5" id="invoice-modal-label">Add invoice</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="invoice-form-alert" class="alert d-none" role="alert"></div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label mb-0">Items</label>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="add-invoice-item-btn">
                            Add item
                        </button>
                    </div>
                    <div id="invoice-items" class="d-flex flex-column gap-3"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/project.js" defer></script>
<%- include('common/footer') %>

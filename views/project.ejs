<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= typeof username !== "undefined" && username ? username : "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4">
            <p class="text-secondary small mb-1">
                <a href="/app" class="text-decoration-none">App</a> /
                <a href="/app/projects" class="text-decoration-none">Projects</a> /
                <%= project.title %>
            </p>
            <h1 class="h3 mb-1"><%= project.title %></h1>
            <p class="text-secondary mb-0">Project details.</p>
        </div>

        <div id="project-alert" class="alert d-none" role="alert"></div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <form id="project-form" data-project-id="<%= project.id %>" novalidate>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="title" class="form-label">Title</label>
                            <input
                                type="text"
                                class="form-control"
                                id="title"
                                name="title"
                                maxlength="56"
                                value="<%= project.title %>"
                                required
                            />
                        </div>
                        <div class="col-12">
                            <label for="description" class="form-label">Description</label>
                            <textarea
                                class="form-control"
                                id="description"
                                name="description"
                                rows="4"
                                maxlength="512"
                            ><%= project.description || '' %></textarea>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4 flex-wrap">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <button type="button" id="delete-project-btn" class="btn btn-outline-danger">Delete</button>
                        <a href="/app/projects" class="btn btn-outline-secondary">Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

<script src="/public/app.js" defer></script>
<script src="/public/project.js" defer></script>
<%- include('common/footer') %>

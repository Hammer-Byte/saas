<%- include('common/header') %>

<%- include('common/app-navbar') %>

<main class="hb-main">
    <div class="container hb-page">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> / Contracts
                </p>
                <h1 class="h3 mb-1">Contracts</h1>
                <p class="text-secondary mb-0">Contracts with external parties.</p>
            </div>
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#contract-modal"
            >
                Add contract
            </button>
        </div>

        <div id="contracts-alert" class="alert d-none" role="alert"></div>

        <%- include('common/table-filters', { searchId: "contracts-search", searchPlaceholder: "Search contracts…" }) %>
        <p class="text-secondary small mb-3 d-none" id="contracts-empty-filter" role="status">No contracts match your search.</p>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <% if (!contracts || contracts.length === 0) { %>
                    <div class="p-4 p-md-5 text-center text-secondary">
                        No contracts found.
                    </div>
                <% } else { %>
                    <div class="table-responsive" id="contracts-table-wrap">
                        <table class="table table-hover align-middle mb-0" id="contracts-table">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="hb-sortable" data-sort-key="fullName">Full name</th>
                                    <th scope="col" class="hb-sortable" data-sort-key="company">Company</th>
                                    <th scope="col" class="hb-sortable" data-sort-key="status">Status</th>
                                    <th scope="col" class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% contracts.forEach(function (contract) { %>
                                    <%
                                        const isSigned =
                                            Number(contract.required_attachments_count) > 0 &&
                                            Number(contract.required_attachments_count) ===
                                                Number(contract.attached_media_count);
                                        const isBroken = !!(contract.broken && contract.broken !== 0);
                                    %>
                                    <tr
                                        class="hb-row-link"
                                        data-href="/app/contracts/<%= contract.id %>"
                                        data-full-name="<%= contract.full_name %>"
                                        data-company="<%= contract.company || '' %>"
                                        data-status="<%= isBroken ? 'broken' : (isSigned ? 'signed' : 'unsigned') %>"
                                    >
                                        <td><%= contract.full_name %></td>
                                        <td><%= contract.company || "-" %></td>
                                        <td>
                                            <% if (isBroken) { %>
                                                <span class="badge text-bg-danger">Broken</span>
                                            <% } %>
                                            <% if (isSigned) { %>
                                                <span class="badge text-bg-success">Signed</span>
                                            <% } else { %>
                                                <span class="badge text-bg-secondary">Unsigned</span>
                                            <% } %>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-1 justify-content-end hb-icon-actions">
                                                <a href="/contracts/<%= contract.signing_code %>/sign" class="btn btn-sm btn-outline-primary hb-icon-btn" title="View" aria-label="View" target="_blank" rel="noopener noreferrer"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/><path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/></svg></a>
                                                <a href="/app/contracts/<%= contract.id %>" class="btn btn-sm btn-outline-secondary hb-icon-btn" title="Edit" aria-label="Edit"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/></svg></a>
                                                <button type="button" class="btn btn-sm btn-outline-danger hb-icon-btn contract-delete-btn" title="Delete" aria-label="Delete" data-id="<%= contract.id %>"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/></svg></button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<div
    class="modal fade"
    id="contract-modal"
    tabindex="-1"
    aria-labelledby="contract-modal-label"
    aria-hidden="true"
>
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="contract-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="contract-modal-label">Add contract</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="contract-form-alert" class="alert d-none" role="alert"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="company" class="form-label">Company <span class="text-secondary fw-normal">(optional)</span></label>
                            <input
                                type="text"
                                class="form-control"
                                id="company"
                                name="company"
                                maxlength="128"
                            />
                        </div>
                        <div class="col-md-6">
                            <label for="full_name" class="form-label">Full name</label>
                            <input
                                type="text"
                                class="form-control"
                                id="full_name"
                                name="full_name"
                                maxlength="128"
                                required
                            />
                        </div>
                        <div class="col-md-6">
                            <label for="email" class="form-label">Email</label>
                            <input
                                type="email"
                                class="form-control"
                                id="email"
                                name="email"
                                maxlength="255"
                                required
                            />
                        </div>
                        <div class="col-md-6">
                            <label for="phone" class="form-label">Phone</label>
                            <input
                                type="text"
                                class="form-control"
                                id="phone"
                                name="phone"
                                maxlength="13"
                                required
                            />
                        </div>
                        <div class="col-12">
                            <label for="address" class="form-label">Address</label>
                            <textarea
                                class="form-control"
                                id="address"
                                name="address"
                                rows="3"
                                maxlength="512"
                                required
                            ></textarea>
                        </div>
                        <div class="col-md-6">
                            <label for="signable_till" class="form-label">Signable till</label>
                            <input
                                type="text"
                                class="form-control js-datetime-input"
                                id="signable_till"
                                name="signable_till"
                                placeholder="dd/mm/yyyy hh:mm"
                                autocomplete="off"
                                required
                            />
                        </div>
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    id="active"
                                    name="active"
                                    checked
                                />
                                <label class="form-check-label" for="active">Active</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Required attachments</label>
                            <div class="row g-2" id="required-attachments-options">
                                <% (attachments || []).forEach(function (attachment) { %>
                                    <div class="col-md-4">
                                        <div class="form-check">
                                            <input
                                                class="form-check-input required-attachment-checkbox"
                                                type="checkbox"
                                                id="required-attachment-<%= attachment.id %>"
                                                value="<%= attachment.id %>"
                                            />
                                            <label
                                                class="form-check-label"
                                                for="required-attachment-<%= attachment.id %>"
                                            >
                                                <%= attachment.title %>
                                            </label>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/contracts.js" defer></script>
<%- include('common/footer') %>

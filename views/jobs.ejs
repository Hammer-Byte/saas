<%- include('common/header') %>

<%- include('common/app-navbar') %>

<main class="bg-light min-vh-100">
    <div class="container py-5" id="jobs-page">
        <div class="mb-4">
            <p class="text-secondary small mb-1">
                <a href="/app" class="text-decoration-none">App</a> / Jobs
            </p>
            <h1 class="h3 mb-1">Jobs</h1>
            <p class="text-secondary mb-0">Publish openings shown on the public careers page.</p>
        </div>

        <div id="jobs-alert" class="alert d-none" role="alert"></div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                    <h2 class="h5 mb-0">Openings</h2>
                    <button
                        type="button"
                        class="btn btn-sm btn-primary"
                        id="open-add-job-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#job-modal"
                    >
                        Add job
                    </button>
                </div>
                <div class="mb-0">
                    <label for="jobs-search" class="form-label visually-hidden">Search jobs</label>
                    <input
                        type="search"
                        class="form-control"
                        id="jobs-search"
                        placeholder="Search by title or experience…"
                        autocomplete="off"
                    />
                </div>
            </div>
            <div class="card-body p-0">
                <% if (!jobs || jobs.length === 0) { %>
                    <div id="jobs-empty" class="p-4 text-center text-secondary">
                        No job openings yet.
                    </div>
                <% } else { %>
                    <div id="jobs-filter-empty" class="p-4 text-center text-secondary d-none">
                        No jobs match your search.
                    </div>
                    <div class="table-responsive" id="jobs-table-wrap">
                        <table class="table table-hover align-middle mb-0" id="jobs-table">
                            <thead class="table-light">
                                <tr>
                                    <th
                                        scope="col"
                                        class="hb-sortable jobs-sortable"
                                        data-sort-key="id"
                                        role="button"
                                        tabindex="0"
                                        aria-sort="none"
                                    >ID</th>
                                    <th
                                        scope="col"
                                        class="hb-sortable jobs-sortable"
                                        data-sort-key="title"
                                        role="button"
                                        tabindex="0"
                                        aria-sort="none"
                                    >Title</th>
                                    <th
                                        scope="col"
                                        class="hb-sortable jobs-sortable"
                                        data-sort-key="experience"
                                        role="button"
                                        tabindex="0"
                                        aria-sort="none"
                                    >Experience</th>
                                    <th
                                        scope="col"
                                        class="hb-sortable jobs-sortable"
                                        data-sort-key="active"
                                        role="button"
                                        tabindex="0"
                                        aria-sort="none"
                                    >Active</th>
                                    <th
                                        scope="col"
                                        class="hb-sortable jobs-sortable"
                                        data-sort-key="applications"
                                        role="button"
                                        tabindex="0"
                                        aria-sort="none"
                                    >Applications</th>
                                    <th
                                        scope="col"
                                        class="hb-sortable jobs-sortable"
                                        data-sort-key="created"
                                        role="button"
                                        tabindex="0"
                                        aria-sort="none"
                                    >Created On</th>
                                    <th scope="col" class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="jobs-tbody">
                                <% jobs.forEach(function (job) { %>
                                    <tr
                                        data-id="<%= job.id %>"
                                        data-title="<%= job.title || '' %>"
                                        data-description="<%= job.description || '' %>"
                                        data-experience="<%= job.experience || '' %>"
                                        data-reply-email="<%= job.reply_email || '' %>"
                                        data-active="<%= job.active ? '1' : '0' %>"
                                        data-applications="<%= Number(job.application_count || 0) %>"
                                        data-created="<%= job.created_on || '' %>"
                                        data-href="/app/jobs/<%= job.id %>"
                                        class="job-row hb-row-link"
                                    >
                                        <td><%= job.id %></td>
                                        <td><%= job.title %></td>
                                        <td><%= job.experience %></td>
                                        <td>
                                            <span class="badge text-bg-<%= job.active ? 'success' : 'secondary' %>">
                                                <%= job.active ? "Active" : "Inactive" %>
                                            </span>
                                        </td>
                                        <td><%= Number(job.application_count || 0) %></td>
                                        <td
                                            data-readable-date="<%= job.created_on || '' %>"
                                            data-date-format="DD/MM/YYYY HH:mm:ss"
                                        ></td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-1 justify-content-end hb-icon-actions">
                                            <button
                                                type="button"
                                                class="btn btn-sm btn-outline-secondary hb-icon-btn job-edit-btn"
                                                title="Edit"
                                                aria-label="Edit"
                                                
                                            >
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                    <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                                                </svg>
                                            </button>
                                            <button
                                                type="button"
                                                class="btn btn-sm btn-outline-danger hb-icon-btn job-delete-btn"
                                                title="Delete"
                                                aria-label="Delete"
                                                
                                            >
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                                </svg>
                                            </button>
                                        </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="job-modal" tabindex="-1" aria-labelledby="job-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form id="job-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="job-modal-label">Add job</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="job-form-alert" class="alert d-none" role="alert"></div>
                    <input type="hidden" name="id" id="job-id" value="" />
                    <div class="mb-3">
                        <label for="job-title" class="form-label">Title</label>
                        <input
                            type="text"
                            class="form-control"
                            id="job-title"
                            name="title"
                            maxlength="128"
                            required
                        />
                    </div>
                    <div class="mb-3">
                        <label for="job-experience" class="form-label">Experience</label>
                        <input
                            type="text"
                            class="form-control"
                            id="job-experience"
                            name="experience"
                            maxlength="128"
                            required
                            placeholder="e.g. 0 to 2 Years"
                        />
                    </div>
                    <div class="mb-3">
                        <label for="job-description" class="form-label">Description</label>
                        <textarea
                            class="form-control"
                            id="job-description"
                            name="description"
                            rows="8"
                            required
                        ></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="job-reply-email" class="form-label">Reply email</label>
                        <input
                            type="email"
                            class="form-control"
                            id="job-reply-email"
                            name="reply_email"
                            maxlength="255"
                            required
                            placeholder="CC on interview invites for reschedule replies"
                        />
                        <div class="form-text">
                            Interview invites CC this address so applicants can reply to reschedule.
                        </div>
                    </div>
                    <div class="form-check">
                        <input
                            class="form-check-input"
                            type="checkbox"
                            id="job-active"
                            name="active"
                            checked
                        />
                        <label class="form-check-label" for="job-active">
                            Accepting applications (shown on careers page)
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="job-submit-btn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/jobs.js" defer></script>
<%- include('common/footer') %>

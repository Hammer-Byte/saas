<%- include('common/header') %>

<%
    const totals = report.totals || {};
    const actionTypes = report.actionTypes || [];
    const employees = report.employees || [];
%>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container-fluid px-3 px-lg-4 py-4">
        <div class="mb-4 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> /
                    <a href="/app/gem-tenders" class="text-decoration-none">GEM Tenders</a> /
                    <a href="/app/gem-tenders/list?from=<%= from %>&to=<%= to %>" class="text-decoration-none">Tenders</a> /
                    Report
                </p>
                <h1 class="h3 mb-1">Employee activity</h1>
                <p class="text-secondary mb-0">
                    What each person did on GEM tenders from
                    <strong data-readable-date="<%= from %>" data-date-format="DD/MM/YYYY"></strong>
                    to
                    <strong data-readable-date="<%= to %>" data-date-format="DD/MM/YYYY"></strong>.
                </p>
            </div>
            <a
                href="/app/gem-tenders/list?from=<%= from %>&to=<%= to %>"
                class="btn btn-outline-secondary"
            >
                Back to tenders
            </a>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3 p-md-4">
                <form class="row g-3 align-items-end" method="get" action="/app/gem-tender-report" id="gem-report-range-form">
                    <div class="col-6 col-md-3 col-lg-2">
                        <label for="report-from" class="form-label">From</label>
                        <input type="date" class="form-control" id="report-from" name="from" value="<%= from %>" required />
                    </div>
                    <div class="col-6 col-md-3 col-lg-2">
                        <label for="report-to" class="form-label">To</label>
                        <input type="date" class="form-control" id="report-to" name="to" value="<%= to %>" required />
                    </div>
                    <div class="col-12 col-md-3 col-lg-2">
                        <button type="submit" class="btn btn-primary w-100">Apply range</button>
                    </div>
                    <div class="col-12">
                        <div class="d-flex flex-wrap gap-1" id="gem-report-quick-ranges">
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-report-quick-btn" data-range="today">Today</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-report-quick-btn" data-range="this-week">This week</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-report-quick-btn" data-range="last-7-days">Last 7 days</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-report-quick-btn" data-range="last-15-days">Last 15 days</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-report-quick-btn" data-range="this-month">This month</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-report-quick-btn" data-range="last-month">Last month</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-report-quick-btn" data-range="this-quarter">This quarter</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm gem-report-quick-btn" data-range="last-quarter">Last quarter</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <% [
                { label: "Actions", value: totals.actions },
                { label: "Active people", value: totals.active_people },
                { label: "Tenders worked on", value: totals.tenders_touched },
                { label: "Marked eligible", value: totals.eligible },
                { label: "Filed", value: totals.filed },
                { label: "Missed (due in range)", value: totals.missed, danger: true },
                { label: "Unattended (due in range)", value: totals.unattended, danger: true },
            ].forEach(function (card) { %>
                <div class="col-6 col-md-4 col-xl">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <p class="text-secondary small mb-1"><%= card.label %></p>
                            <p class="h4 mb-0<%= card.danger && Number(card.value) ? ' text-danger' : '' %>"><%= Number(card.value || 0) %></p>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3 p-md-4">
                <h2 class="h5 mb-1">By employee</h2>
                <p class="text-secondary small mb-3">
                    Actions are counted from the activity log in this range. <strong>Open now</strong> is the
                    person's current unlocked workload. <strong>Missed</strong> counts their tenders whose due
                    date falls in this range and were missed. Click a row to see that person below.
                </p>
                <% if (!employees.length) { %>
                    <p class="text-secondary mb-0">No activity or assigned work in this range.</p>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0" id="gem-report-employees">
                            <thead class="table-light">
                                <tr>
                                    <th rowspan="2">Employee</th>
                                    <th colspan="<%= actionTypes.length + 2 %>" class="text-center border-start">Actions in range</th>
                                    <th colspan="2" class="text-center border-start">Open now</th>
                                    <th rowspan="2" class="text-end border-start">Missed</th>
                                    <th rowspan="2" class="border-start">Last active</th>
                                </tr>
                                <tr>
                                    <% actionTypes.forEach(function (type, index) { %>
                                        <th class="text-end small<%= index === 0 ? ' border-start' : '' %>"><%= type.label %></th>
                                    <% }) %>
                                    <th class="text-end small">Total</th>
                                    <th class="text-end small">Tenders</th>
                                    <th class="text-end small border-start">Undecided</th>
                                    <th class="text-end small">In progress</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% employees.forEach(function (person) { %>
                                    <tr class="gem-report-employee-row" data-user-id="<%= person.user_id %>" role="button">
                                        <td class="fw-semibold"><%= person.label %></td>
                                        <% actionTypes.forEach(function (type, index) { %>
                                            <td class="text-end<%= index === 0 ? ' border-start' : '' %><%= person.counts[type.key] ? '' : ' text-body-tertiary' %>">
                                                <%= person.counts[type.key] || 0 %>
                                            </td>
                                        <% }) %>
                                        <td class="text-end fw-semibold"><%= person.total %></td>
                                        <td class="text-end"><%= person.tenders_touched %></td>
                                        <td class="text-end border-start"><%= person.open_undecided %></td>
                                        <td class="text-end"><%= person.open_in_progress %></td>
                                        <td class="text-end border-start<%= person.missed ? ' text-danger fw-semibold' : ' text-body-tertiary' %>"><%= person.missed %></td>
                                        <td class="border-start small text-nowrap"><%= person.last_active || "-" %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3 p-md-4">
                <h2 class="h5 mb-1">Actions per day</h2>
                <p class="text-secondary small mb-3">Each bar is split by employee.</p>
                <div class="gem-report-chart-box">
                    <canvas id="chart-daily-by-employee"></canvas>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4" id="gem-report-person">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
                    <div>
                        <h2 class="h5 mb-1">Employee detail</h2>
                        <p class="text-secondary small mb-0">Daily actions by type, and everything the person logged in this range.</p>
                    </div>
                    <div style="min-width: 220px; max-width: 320px;">
                        <label for="gem-report-person-select" class="form-label small mb-1">Employee</label>
                        <select class="form-select form-select-sm" id="gem-report-person-select">
                            <% if (!employees.length) { %>
                                <option value="">No employees</option>
                            <% } %>
                            <% employees.forEach(function (person, index) { %>
                                <option value="<%= person.user_id %>" <%= index === 0 ? "selected" : "" %>>
                                    <%= person.label %> (<%= person.total %>)
                                </option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div class="gem-report-chart-box mb-4">
                    <canvas id="chart-daily-person"></canvas>
                </div>
                <h3 class="h6 mb-2">Activity log</h3>
                <% if (report.logTruncated) { %>
                    <p class="small text-warning mb-2">
                        This range has a lot of activity; the log shows the most recent entries only. Choose a shorter range to see everything.
                    </p>
                <% } %>
                <div class="table-responsive gem-report-log">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="text-nowrap">When</th>
                                <th>Tender</th>
                                <th>Action</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody id="gem-report-log-body"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<style>
    .gem-report-chart-box {
        position: relative;
        width: 100%;
        height: 300px;
        max-height: 300px;
        overflow: hidden;
    }

    .gem-report-chart-box canvas {
        display: block;
        width: 100% !important;
        height: 100% !important;
        max-width: 100%;
    }

    .gem-report-employee-row.table-active td {
        background-color: var(--bs-primary-bg-subtle);
    }

    .gem-report-log {
        max-height: 420px;
        overflow-y: auto;
    }
</style>
<script id="gem-tender-report-data" type="application/json">
<%- JSON.stringify(report.charts || {}).replace(/</g, "\\u003c") %>
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>
<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/gem-tender-report.js" defer></script>
<%- include('common/footer') %>

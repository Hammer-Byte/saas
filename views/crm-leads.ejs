<%- include('common/header') %>

<%
    const emailKindLabels = LEAD_EMAIL_KIND_LABELS || {};
    const emailKinds = LEAD_EMAIL_KINDS || { PERSONAL: "personal", PROFESSIONAL: "professional" };
%>

<%- include('common/app-navbar', { wide: true }) %>

<main class="hb-main">
    <div class="container-fluid hb-page-wide">
        <div class="mb-3 d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <p class="text-secondary small mb-1">
                    <a href="/app" class="text-decoration-none">App</a> /
                    <a href="/app/crm" class="text-decoration-none">CRM</a> /
                    Leads
                </p>
                <h1 class="h3 mb-1">Leads</h1>
                <p class="text-secondary mb-0">
                    Created
                    <span data-readable-date="<%= from %>" data-date-format="DD/MM/YYYY"><%= from %></span>
                    –
                    <span data-readable-date="<%= to %>" data-date-format="DD/MM/YYYY"><%= to %></span>.
                </p>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <button
                    type="button"
                    class="btn btn-outline-secondary"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#leads-filters-panel"
                    aria-controls="leads-filters-panel"
                >
                    Filters
                </button>
                <button
                    type="button"
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#lead-modal"
                    id="open-add-lead-btn"
                >
                    Add lead
                </button>
            </div>
        </div>

        <p class="text-secondary small mb-3" id="leads-filter-status" role="status"></p>
        <div id="leads-alert" class="alert d-none" role="alert"></div>

        <div
            class="offcanvas offcanvas-end hb-filter-offcanvas"
            tabindex="-1"
            id="leads-filters-panel"
            aria-labelledby="leads-filters-panel-label"
        >
            <div class="offcanvas-header border-bottom">
                <h2 class="offcanvas-title h5 mb-0" id="leads-filters-panel-label">Filters</h2>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column p-0">
                <div class="hb-filter-offcanvas-scroll p-3" id="leads-filters-form">
                    <div class="mb-3">
                        <div class="row g-2">
                            <div class="col-6">
                                <label for="leads-from" class="form-label">Created from</label>
                                <input
                                    type="date"
                                    class="form-control form-control-sm"
                                    id="leads-from"
                                    value="<%= from %>"
                                    data-page-from="<%= from %>"
                                    autocomplete="off"
                                />
                            </div>
                            <div class="col-6">
                                <label for="leads-to" class="form-label">Created to</label>
                                <input
                                    type="date"
                                    class="form-control form-control-sm"
                                    id="leads-to"
                                    value="<%= to %>"
                                    data-page-to="<%= to %>"
                                    autocomplete="off"
                                />
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="leads-search" class="form-label">Search</label>
                        <input
                            type="search"
                            class="form-control form-control-sm"
                            id="leads-search"
                            placeholder="Name, phone, email, organization…"
                            autocomplete="off"
                        />
                    </div>
                    <div class="mb-3">
                        <label for="leads-filter-organization" class="form-label">Organization</label>
                        <input type="search" class="form-control form-control-sm" id="leads-filter-organization" autocomplete="off" />
                    </div>
                    <div class="mb-3">
                        <label for="leads-filter-phone" class="form-label">Phone</label>
                        <input type="search" class="form-control form-control-sm" id="leads-filter-phone" autocomplete="off" />
                    </div>
                    <div class="mb-3">
                        <label for="leads-filter-email" class="form-label">Email</label>
                        <input type="search" class="form-control form-control-sm" id="leads-filter-email" autocomplete="off" />
                    </div>
                    <div class="mb-3">
                        <label for="leads-filter-designation" class="form-label">Designation</label>
                        <input type="search" class="form-control form-control-sm" id="leads-filter-designation" autocomplete="off" />
                    </div>
                    <div class="mb-3">
                        <label for="leads-filter-location" class="form-label">Location</label>
                        <input type="search" class="form-control form-control-sm" id="leads-filter-location" autocomplete="off" />
                    </div>
                    <div class="mb-3">
                        <label for="leads-filter-targeted-for" class="form-label">Targeted for</label>
                        <input type="search" class="form-control form-control-sm" id="leads-filter-targeted-for" autocomplete="off" />
                    </div>
                    <div class="mb-3">
                        <label for="leads-filter-source" class="form-label">Source</label>
                        <select class="form-select form-select-sm" id="leads-filter-source">
                            <option value="">All sources</option>
                            <% (sources || []).forEach(function (source) { %>
                                <option value="<%= source.id %>"><%= source.title %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div class="border-top p-3 d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" id="leads-filters-clear-btn">Clear</button>
                    <button type="button" class="btn btn-primary" id="leads-filters-apply-btn">Apply</button>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div id="leads-empty" class="p-4 p-md-5 text-center text-secondary <%= leads && leads.length ? 'd-none' : '' %>">
                    No leads in this date range.
                </div>
                <div class="hb-table-scroll <%= !leads || !leads.length ? 'd-none' : '' %>" id="leads-table-wrap">
                    <table class="table table-hover align-middle mb-0 hb-table-sticky" id="leads-table">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="hb-sortable" data-sort-key="name">Name</th>
                                <th scope="col" class="hb-sortable" data-sort-key="organization">Organization</th>
                                <th scope="col" class="hb-sortable" data-sort-key="phone">Phone</th>
                                <th scope="col" class="hb-sortable" data-sort-key="email">Email</th>
                                <th scope="col" class="hb-sortable" data-sort-key="targeted">Targeted for</th>
                                <th scope="col" class="hb-sortable" data-sort-key="source">Source</th>
                                <th scope="col" class="hb-sortable" data-sort-key="created">Created On</th>
                            </tr>
                        </thead>
                        <tbody id="leads-tbody">
                            <% (leads || []).forEach(function (lead) { %>
                                <tr
                                    class="hb-row-link"
                                    data-href="/app/crm/leads/<%= lead.id %>"
                                    data-id="<%= lead.id %>"
                                    data-name="<%= lead.full_name || '' %>"
                                    data-organization="<%= lead.organization || '' %>"
                                    data-designation="<%= lead.designation || '' %>"
                                    data-location="<%= lead.location || '' %>"
                                    data-targeted="<%= lead.targeted_for || '' %>"
                                    data-source-id="<%= lead.source_id || '' %>"
                                    data-source="<%= lead.source_title || '' %>"
                                    data-phone="<%= lead.phones_search || lead.primary_phone || '' %>"
                                    data-email="<%= lead.emails_search || lead.primary_email || '' %>"
                                    data-created="<%= lead.created_on || '' %>"
                                    data-search="<%= [lead.full_name, lead.organization, lead.designation, lead.location, lead.targeted_for, lead.refer_by, lead.website, lead.source_title, lead.phones_search, lead.emails_search].filter(Boolean).join(' ') %>"
                                >
                                    <td><%= lead.full_name %></td>
                                    <td><%= lead.organization || "—" %></td>
                                    <td><%= lead.primary_phone || "—" %></td>
                                    <td><%= lead.primary_email || "—" %></td>
                                    <td><%= lead.targeted_for || "—" %></td>
                                    <td><%= lead.source_title || "—" %></td>
                                    <td>
                                        <% if (lead.created_on) { %>
                                            <span
                                                data-readable-date="<%= lead.created_on %>"
                                                data-date-format="DD/MM/YYYY HH:mm"
                                            ><%= lead.created_on %></span>
                                        <% } else { %>
                                            —
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</main>

<div class="modal fade" id="lead-modal" tabindex="-1" aria-labelledby="lead-modal-label" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form id="lead-form" class="hb-modal-scrollable-form" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5" id="lead-modal-label">Add lead</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="lead-form-alert" class="alert d-none" role="alert"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="lead-full-name" class="form-label">Full name</label>
                            <input type="text" class="form-control" id="lead-full-name" maxlength="128" required />
                        </div>
                        <div class="col-md-6">
                            <label for="lead-organization" class="form-label">Organization</label>
                            <input type="text" class="form-control" id="lead-organization" maxlength="128" />
                        </div>
                        <div class="col-md-6">
                            <label for="lead-designation" class="form-label">Designation</label>
                            <input type="text" class="form-control" id="lead-designation" maxlength="128" />
                        </div>
                        <div class="col-md-6">
                            <label for="lead-website" class="form-label">Website</label>
                            <input type="text" class="form-control" id="lead-website" maxlength="255" />
                        </div>
                        <div class="col-md-6">
                            <label for="lead-location" class="form-label">Location</label>
                            <input type="text" class="form-control" id="lead-location" maxlength="128" />
                        </div>
                        <div class="col-md-6">
                            <label for="lead-refer-by" class="form-label">Refer by</label>
                            <input type="text" class="form-control" id="lead-refer-by" maxlength="128" />
                        </div>
                        <div class="col-md-6">
                            <label for="lead-targeted-for" class="form-label">Targeted for</label>
                            <input type="text" class="form-control" id="lead-targeted-for" maxlength="255" />
                        </div>
                        <div class="col-md-6">
                            <label for="lead-source-id" class="form-label">Source</label>
                            <select class="form-select" id="lead-source-id">
                                <option value="">Select source…</option>
                                <% (sources || []).forEach(function (source) { %>
                                    <option value="<%= source.id %>"><%= source.title %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h3 class="h6 mb-0">Phone numbers</h3>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="lead-add-phone-btn">+</button>
                    </div>
                    <div id="lead-phones-list" class="d-flex flex-column gap-2 mb-4"></div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h3 class="h6 mb-0">Emails</h3>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="lead-add-email-btn">+</button>
                    </div>
                    <div id="lead-emails-list" class="d-flex flex-column gap-2"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="lead-submit-btn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    window.__LEAD_EMAIL_KINDS__ = <%- JSON.stringify(emailKinds) %>;
    window.__LEAD_EMAIL_KIND_LABELS__ = <%- JSON.stringify(emailKindLabels) %>;
</script>
<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/crm-leads.js" defer></script>
<%- include('common/footer') %>

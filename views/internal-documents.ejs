<%- include('common/header') %>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
        <a class="navbar-brand" href="/app">HammerByte App</a>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white-50 small">
                Signed in as <strong class="text-white"><%= username || "user" %></strong>
            </span>
            <a href="/app" class="btn btn-sm btn-outline-light">Dashboard</a>
            <button type="button" id="logout-btn" class="btn btn-sm btn-warning">Logout</button>
        </div>
    </div>
</nav>

<main class="bg-light min-vh-100">
    <div class="container py-5">
        <div class="mb-4">
            <p class="text-secondary small mb-1">
                <a href="/app" class="text-decoration-none">App</a> / Internal Documents
            </p>
            <h1 class="h3 mb-1">Internal Documents</h1>
            <p class="text-secondary mb-0">Store and manage internal files.</p>
        </div>

        <div id="internal-documents-alert" class="alert d-none" role="alert"></div>

        <div
            id="internal-documents-bulk-bar"
            class="card border-0 shadow-sm mb-3 d-none"
        >
            <div class="card-body py-2 px-3 d-flex flex-wrap align-items-center gap-2">
                <span class="small text-secondary" id="internal-documents-selected-count">0 selected</span>
                <button
                    type="button"
                    class="btn btn-sm btn-outline-danger"
                    id="internal-documents-bulk-delete-btn"
                    disabled
                >
                    Delete
                </button>
                <button
                    type="button"
                    class="btn btn-sm btn-outline-secondary"
                    id="internal-documents-bulk-clear-btn"
                >
                    Clear selection
                </button>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                    <h2 class="h5 mb-0">Documents</h2>
                    <button
                        type="button"
                        class="btn btn-sm btn-primary"
                        id="open-add-document-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#document-modal"
                    >
                        Add document
                    </button>
                </div>
                <div class="mb-0">
                    <label for="documents-search" class="form-label visually-hidden">Search documents</label>
                    <input
                        type="search"
                        class="form-control"
                        id="documents-search"
                        placeholder="Search by file name or description…"
                        autocomplete="off"
                    />
                </div>
            </div>
            <div class="card-body p-0">
                <% if (!documents || documents.length === 0) { %>
                    <div id="documents-empty" class="p-4 text-center text-secondary">
                        No internal documents yet.
                    </div>
                <% } else { %>
                    <div id="documents-empty" class="p-4 text-center text-secondary d-none">
                        No documents match your search.
                    </div>
                    <div class="table-responsive" id="documents-table-wrap">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 2.5rem;">
                                        <input
                                            type="checkbox"
                                            class="form-check-input"
                                            id="documents-select-all"
                                            aria-label="Select all visible documents"
                                        />
                                    </th>
                                    <th scope="col">File name</th>
                                    <th scope="col">Description</th>
                                    <th scope="col">Created On</th>
                                    <th scope="col" class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="documents-tbody">
                                <% documents.forEach(function (document) { %>
                                    <tr
                                        data-id="<%= document.id %>"
                                        data-name="<%= document.media_name || '' %>"
                                        data-description="<%= document.description || '' %>"
                                    >
                                        <td>
                                            <input
                                                type="checkbox"
                                                class="form-check-input document-select"
                                                value="<%= document.id %>"
                                                aria-label="Select document"
                                            />
                                        </td>
                                        <td><%= document.media_name || "—" %></td>
                                        <td><%= document.description || "—" %></td>
                                        <td
                                            data-readable-date="<%= document.created_on || '' %>"
                                            data-date-format="DD/MM/YYYY HH:mm:ss"
                                        ></td>
                                        <td class="text-end">
                                            <div class="d-inline-flex gap-1 justify-content-end">
                                                <a
                                                    href="/api/media/<%= document.media_id %>"
                                                    class="btn btn-sm btn-outline-primary document-icon-btn"
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    title="View"
                                                    aria-label="View"
                                                >
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z"/>
                                                        <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                                                    </svg>
                                                </a>
                                                <button
                                                    type="button"
                                                    class="btn btn-sm btn-outline-secondary document-edit-btn document-icon-btn"
                                                    title="Edit"
                                                    aria-label="Edit"
                                                >
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                                                    </svg>
                                                </button>
                                                <button
                                                    type="button"
                                                    class="btn btn-sm btn-outline-danger document-delete-btn document-icon-btn"
                                                    title="Delete"
                                                    aria-label="Delete"
                                                >
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                                        <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                                                    </svg>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<style>
    .document-icon-btn {
        width: 2rem;
        height: 2rem;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
</style>

<div class="modal fade" id="document-modal" tabindex="-1" aria-labelledby="document-modal-label" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="document-form" novalidate>
                <input type="hidden" id="document-id" name="id" value="" />
                <div class="modal-header">
                    <h2 class="modal-title h5" id="document-modal-label">Add document</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="document-form-alert" class="alert d-none" role="alert"></div>
                    <div class="mb-3">
                        <label for="document-file" class="form-label">File</label>
                        <input type="file" class="form-control" id="document-file" name="file" required />
                    </div>
                    <div class="mb-3">
                        <label for="document-description" class="form-label">Description</label>
                        <textarea
                            class="form-control"
                            id="document-description"
                            name="description"
                            rows="3"
                            maxlength="512"
                        ></textarea>
                    </div>
                    <div id="document-upload-progress" class="d-none">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small text-secondary" id="document-upload-status">Uploading…</span>
                            <span class="small text-secondary" id="document-upload-percent">0%</span>
                        </div>
                        <div
                            class="progress"
                            role="progressbar"
                            aria-valuemin="0"
                            aria-valuemax="100"
                            aria-valuenow="0"
                            id="document-upload-progressbar"
                        >
                            <div
                                class="progress-bar progress-bar-striped progress-bar-animated"
                                id="document-upload-bar"
                                style="width: 0%"
                            ></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="document-submit-btn">Upload</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/public/app.js" defer></script>
<script src="/public/utils.js" defer></script>
<script src="/public/internal-documents.js" defer></script>
<%- include('common/footer') %>
